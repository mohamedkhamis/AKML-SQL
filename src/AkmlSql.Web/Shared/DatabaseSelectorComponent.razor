@*
    Spec 041 (research R28, FR-082) — the toolbar's database selector, as SSMS's "Available Databases" box: the
    current database, a list loaded when it opens (the current one checked, even when the list lacks it), and a
    switch on the same connection (#temp tables and SET options survive). Disabled without the engine's
    session.database.v1, without a connection, or while a query runs; it follows a script's USE.
*@
@using AkmlSql.Core
@using AkmlSql.Web.Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject ISqlConnectionService Sql
@inject INotificationService Notifications
@inject IServiceProvider Services

<span class="akml-db-selector">
    <button type="button" class="akml-btn" data-testid="db-selector" disabled="@Disabled" title="@Title"
            aria-haspopup="menu" aria-label="@($"Database: {Current}")" @onclick="OpenAsync">
        <Icon Name="database" Size="14" />
        <span class="akml-db-selector-name">@Current</span>
        <Icon Name="chevron-down" Size="12" />
    </button>
    @if (_busy)
    {
        <span class="akml-db-selector-busy" data-testid="db-selector-busy" role="status" aria-label="Loading databases">
            <Icon Name="loader-circle" Size="14" Class="akml-spin" />
        </span>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <span class="akml-field-error" data-testid="db-selector-error" role="alert">@_error</span>
    }
</span>

@if (_menu != null)
{
    <ContextMenu Items="_menu" X="_x" Y="_y" OnClose="() => _menu = null" TestId="db-selector-list" AriaLabel="Database" />
}

<style>
    .akml-db-selector { display: inline-flex; align-items: center; gap: var(--akml-scalar-spacing-xs); }
    /* One width whatever the name, so the toolbar does not shift when the database changes; the full name is in the title. */
    .akml-db-selector-name { display: inline-block; width: 10em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
</style>

@code {
    /// <summary>A query is running: the database cannot change under it.</summary>
    [Parameter] public bool IsRunning { get; set; }

    private bool _busy;
    private string? _error;
    private IReadOnlyList<MenuItem>? _menu;
    private double _x, _y;

    private string Current => string.IsNullOrEmpty(Sql.Database) ? "No database" : Sql.Database!;

    private bool Disabled => !Sql.IsConnected || !Sql.CanChangeDatabase || IsRunning || _busy;

    private bool IsPostgres => Sql.Kind == DatabaseKind.PostgreSql;

    private string Title =>
        !Sql.IsConnected ? "Connect to a database server to choose a database"
        : !Sql.CanChangeDatabase ? "Switching database needs a newer engine"
        : IsRunning ? "The database cannot change while a query runs"
        : IsPostgres ? "Change the database (PostgreSQL reconnects: temporary tables and session settings are lost)"
        : "Change the database (the connection, its #temp tables and SET options are kept)";

    protected override void OnInitialized() => Sql.StateChanged += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OpenAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (Disabled) return;
        _error = null;
        _busy = true;
        _x = e.ClientX;
        _y = e.ClientY + 12;
        StateHasChanged();
        var (ok, databases, error) = await Sql.ListDatabasesForSessionAsync(CancellationToken.None);
        _busy = false;
        if (!ok)
        {
            _error = error ?? "Could not list databases.";
            StateHasChanged();
            return;
        }
        var current = Sql.Database;
        var names = new List<string>();
        if (!string.IsNullOrEmpty(current) && !databases.Contains(current, StringComparer.OrdinalIgnoreCase)) names.Add(current!);
        names.AddRange(databases);
        _menu = names.Select(name => new MenuItem
        {
            Label = name,
            IsChecked = string.Equals(name, current, StringComparison.OrdinalIgnoreCase),
            OnSelect = () => SwitchAsync(name),
        }).ToList();
        StateHasChanged();
    }

    private async Task SwitchAsync(string database)
    {
        _menu = null;
        if (string.Equals(database, Sql.Database, StringComparison.OrdinalIgnoreCase)) return;

        // Spec 042 (FR-031, FR-009): a PostgreSQL connection is to one database, so the switch is a reconnect. Say what it costs
        // before doing it, and when a transaction is open say it will be rolled back (never committed).
        if (IsPostgres && !await ConfirmReconnectAsync(database)) return;

        _busy = true;
        StateHasChanged();
        var (ok, error, wasReset) = await Sql.ChangeDatabaseAsync(database, CancellationToken.None);
        _busy = false;
        if (!ok) _error = error ?? "Could not switch database.";
        else if (wasReset && IsPostgres) Notifications.Notify($"Switched to {database}. The connection was reopened: temporary tables and session settings were lost.", NotificationKind.Warning);
        else if (wasReset) Notifications.Notify($"Switched to {database}. The connection was reopened: #temp tables and SET options were lost.", NotificationKind.Warning);
        StateHasChanged();
    }

    // Resolved when used: a page that never switches a PostgreSQL database needs no dialog service.
    private async Task<bool> ConfirmReconnectAsync(string database)
    {
        var dialogs = Services.GetService<IDialogService>();
        if (dialogs == null) return true;

        var open = Sql.TransactionState != TransactionState.None;
        var aborted = Sql.TransactionState == TransactionState.Aborted;
        var request = new DialogRequest
        {
            DialogId = "db-switch-confirm",
            Title = open ? (aborted ? "Aborted transaction" : "Open transaction") : $"Switch to {database}?",
            Message = open
                ? (aborted ? "The current session has a transaction that an error aborted. " : "The current session has an open transaction. ")
                  + $"Switching to {database} reconnects and rolls it back. Nothing is committed."
                : $"PostgreSQL connects to one database at a time, so switching to {database} reconnects. Temporary tables and session settings are lost.",
            ConfirmLabel = open ? "Roll back and switch" : "Switch",
            Destructive = open,
        };
        return await dialogs.ConfirmAsync(request);
    }

    public void Dispose() => Sql.StateChanged -= OnStateChanged;
}
