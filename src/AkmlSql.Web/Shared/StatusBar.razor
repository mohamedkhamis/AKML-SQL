@*
    Spec 021 (web edition) -- M3 task T075; extended by spec 027 (M5 offline closure) T028
    (US5). Footer status indicator. Surfaces a CACHE-AWARE IntelliSense-availability state
    (Live / Cached / Offline / Disconnected) derived from BOTH the bridge state and whether a
    schema snapshot is cached for the active (server, db) — not bridge state alone. This makes
    the already-shipped offline IntelliSense legible: "disconnected but cached completions
    still work" reads as **Cached**, distinct from **Offline** (keyword-only).
*@
@using AkmlSql.Core
@using AkmlSql.Web.Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IEngineBridge Bridge
@inject ISchemaCacheStore SchemaCache
@inject ISchemaSync SchemaSync
@inject ISqlConnectionService SqlConn
@inject ISavedSqlConnectionStore SavedSqlConnections
@inject IConnectionManagerController ConnManager
@inject IEngineAutoConnect AutoConnect
@inject NavigationManager Nav
@inject IServiceProvider Services

<div class="akml-status">
    @* Spec 041 (T160): the engine indicator opens Settings › Diagnostics, where the engine's log is. *@
    <a class="akml-status-pill @PillClass" href="settings/diagnostics" data-testid="status-pill"
       title="Engine status — open Diagnostics">@PillLabel</a>
    <span class="akml-status-text" title="@StatusText">@StatusText</span>

    @* Spec 041 (R41, FR-027) — how the last execute went, as SSMS's status bar says it. Always rendered so a
       screen reader announces each change of the live region. *@
    <span class="akml-status-outcome @OutcomeClass" role="status" aria-live="polite" data-testid="status-outcome"
          title="@(Workspace?.ErrorMessage)">
        @if (Workspace?.Outcome is { } outcome)
        {
            @if (Workspace.Phase == ExecutionPhase.Running)
            {
                <Icon Name="loader-circle" Size="14" Class="akml-status-spin" />
            }
            else if (Workspace.Phase == ExecutionPhase.Succeeded)
            {
                <Icon Name="circle-check" Size="14" />
            }
            else
            {
                <Icon Name="circle-alert" Size="14" />
            }
            <span>@outcome</span>
        }
    </span>

    @* A stalled bridge used to be a dead end: the pill said "Offline" and nothing said why or what
       to do, so the only way forward was knowing to open Settings. The reason and the way out now
       sit next to the pill, and only appear when there is actually something wrong. *@
    @if (_bridgeState != BridgeState.Open && AutoConnect.LastFailure is { } failure)
    {
        <span class="akml-status-issue" data-testid="engine-issue">
            <span class="akml-status-issue-text">@failure.Message</span>
            @if (failure.Kind == EngineConnectFailureKind.NotPaired
                 || failure.Kind == EngineConnectFailureKind.PairingRequired)
            {
                <button type="button" class="akml-btn akml-btn--compact"
                        @onclick="@(() => Nav.NavigateTo("settings/connections"))"
                        data-testid="engine-setup">Set up engine</button>
            }
            else
            {
                <button type="button" class="akml-btn akml-btn--compact"
                        @onclick="RetryEngineAsync" data-testid="engine-retry">
                    @RetryLabel
                </button>
            }
        </span>
    }

    <span class="akml-status-spacer"></span>
    @if (RowsText is { } rows)
    {
        <span class="akml-status-text akml-status-rows" data-testid="status-rows">@rows</span>
    }
    @* Spec 041 (R65, FR-083): the caret, as SSMS's status bar shows it. *@
    @if (Workspace != null)
    {
        <span class="akml-status-text" data-testid="status-caret">Ln @Workspace.CaretLine, Col @Workspace.CaretColumn</span>
    }
    @* Spec 042 (FR-005): which kind of server this is, in words and an icon, never by colour alone. *@
    @if (SqlConn.IsConnected)
    {
        <span class="akml-status-text akml-status-kind" data-testid="status-kind" title="@KindTooltip">
            <Icon Name="@(SqlConn.Kind == DatabaseKind.PostgreSql ? "database" : "plug")" Size="12" />
            <span>@(SqlConn.Kind == DatabaseKind.PostgreSql ? "PostgreSQL" : "SQL Server")</span>
        </span>
    }
    <button type="button" class="akml-status-conn" @onclick="@(() => ConnManager.Open())"
            aria-label="Manage SQL connection" title="@ConnTooltip" data-testid="status-connection">
        <span class="akml-status-conn-icon"><Icon Name="plug" Size="12" /></span>
        <span>@ConnLabel</span>
    </button>
    @if (SqlConn.IsConnected && !string.IsNullOrEmpty(SqlConn.Login))
    {
        <span class="akml-status-text" data-testid="status-login" title="@(SqlConn.Kind == DatabaseKind.PostgreSql ? "Login" : "SQL Server login")">@SqlConn.Login</span>
    }
    @* Spec 042 (FR-016): an open transaction, or one an error has aborted, with a one-click rollback. *@
    @if (SqlConn.IsConnected && SqlConn.TransactionState != TransactionState.None)
    {
        var aborted = SqlConn.TransactionState == TransactionState.Aborted;
        <span class="akml-status-txn @(aborted ? "akml-status-txn--aborted" : null)" role="status" aria-live="polite" data-testid="status-txn">
            <Icon Name="@(aborted ? "triangle-alert" : "database")" Size="12" />
            <span>@(aborted ? "Transaction aborted" : "Transaction open")</span>
            @if (aborted)
            {
                <span class="akml-status-txn-note" data-testid="status-txn-note">Every statement fails until ROLLBACK.</span>
            }
            <button type="button" class="akml-btn akml-btn--compact" @onclick="RollbackAsync" disabled="@_rollingBack"
                    title="Run ROLLBACK; to end the transaction" data-testid="status-txn-rollback">
                <Icon Name="rotate-ccw" Size="12" /> Rollback
            </button>
        </span>
    }
    @* Short versions; the full build string on hover; a marker when the web app and the engine are different builds. *@
    @if (!string.IsNullOrEmpty(Bridge.EngineVersion))
    {
        <span class="akml-status-text" data-testid="status-version-engine" title="@Bridge.EngineVersion">Engine @AkmlSql.Core.AppVersion.StripBuildMetadata(Bridge.EngineVersion)</span>
        @if (VersionsDiffer)
        {
            <span class="akml-status-mismatch" data-testid="status-version-mismatch" role="img" aria-label="The web app and the engine are different builds"
                  title="The web app and the engine are different builds. Update the older one so they match.">
                <Icon Name="triangle-alert" Size="14" />
            </span>
        }
    }
    <span class="akml-status-text" data-testid="status-version-web" title="@AkmlSql.Core.AppVersion.Informational">Web @AkmlSql.Core.AppVersion.Current</span>
</div>

<style>
    .akml-status {
        display: flex;
        align-items: center;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-m);
        background-color: var(--akml-surface-panel);
        border-top: 1px solid var(--akml-border-default);
        color: var(--akml-text-secondary);
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
    }
    /* The problem strip. Deliberately quiet: it is information, not an alarm, and it sits inline
       rather than as a banner so a transient engine restart does not shove the editor down the
       page and back again. */
    .akml-status-issue {
        display: inline-flex;
        align-items: center;
        gap: var(--akml-scalar-spacing-xs);
        min-width: 0;
    }
    .akml-status-issue-text {
        color: var(--akml-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 42ch;
    }

    .akml-status-outcome { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
    .akml-status-outcome--ok { color: var(--akml-statustext-success); }
    .akml-status-outcome--failed { color: var(--akml-statustext-danger); }
    .akml-status-rows { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .akml-status-spin { animation: akml-status-spin 1.1s linear infinite; }
    @@keyframes akml-status-spin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .akml-status-spin { animation: none; } }

    .akml-status-mismatch { display: inline-flex; color: var(--akml-statustext-warning); }
    .akml-status-pill {
        text-decoration: none;
        padding: 1px var(--akml-scalar-spacing-xs);
        border-radius: var(--akml-scalar-radius-xs);
        color: var(--akml-text-onaccent);
        font-size: 11px;
    }
    .akml-status-pill-live { background-color: var(--akml-badge-success); }
    .akml-status-pill-bridgeonly { background-color: var(--akml-badge-warning); }
    .akml-status-pill-cached { background-color: var(--akml-accent-primary); }
    .akml-status-pill-offline,
    .akml-status-pill-disconnected { background-color: var(--akml-badge-neutral); color: var(--akml-badge-neutraltext); }
    .akml-status-pill-connecting { background-color: var(--akml-accent-primary); }
    .akml-status-pill-reconnecting { background-color: var(--akml-badge-warning); }
    .akml-status-pill-failed { background-color: var(--akml-badge-error); }
    /* Shrinks with an ellipsis when the bar runs out of room (a phone): a fixed-width status
       line used to make every page wider than the screen. The full text is its tooltip. */
    .akml-status-text { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .akml-status-spacer { flex: 1 1 auto; }

    /* Clickable connection indicator — the third entry point into the connection manager
       (alongside the command palette + Settings). Token-styled button reset. */
    .akml-status-kind { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
    .akml-status-txn { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
    .akml-status-txn--aborted { color: var(--akml-statustext-danger); font-weight: 600; }
    .akml-status-txn-note { font-weight: normal; }
    .akml-status-conn {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: none;
        border: 1px solid transparent;
        border-radius: var(--akml-scalar-radius-xs);
        padding: 1px var(--akml-scalar-spacing-xs);
        color: var(--akml-text-secondary);
        font-family: inherit;
        font-size: var(--akml-type-chrome-size);
        cursor: pointer;
    }
    .akml-status-conn:hover {
        background-color: var(--akml-surface-hover);
        color: var(--akml-text-primary);
        border-color: var(--akml-border-default);
    }
    .akml-status-conn-icon { display: inline-flex; }

    /* A phone: the bar wraps onto a second line rather than squeezing its buttons into each other. */
    @@media (max-width: 600px) {
        .akml-status { flex-wrap: wrap; row-gap: 2px; }
        .akml-status-spacer { display: none; }
    }
    .akml-status .akml-btn--compact { flex: 0 0 auto; }
</style>

@code {
    /// <summary>The user-facing IntelliSense-availability states (FR-023), derived from bridge
    /// state + cache presence. Connecting / Reconnecting / Failed surface directly (with the
    /// reconnect countdown) only when no cache softens them to Cached.
    /// Spec 032 (FR-032, campaign finding 5): BridgeOnly = engine bridge up but NO SQL session —
    /// after an F5 reload the bridge auto-reconnects while the SQL session is gone, and the old
    /// binary state showed a full-green "Live" while completions silently degraded.</summary>
    private enum Availability { Live, BridgeOnly, Cached, Offline, Disconnected, Connecting, Reconnecting, Failed }

    // Spec 041 (R41) — the execute outcome. Resolved optionally so a host without it keeps working.
    private IWorkspaceStatus? Workspace => _workspace ??= Services.GetService<IWorkspaceStatus>();
    private IWorkspaceStatus? _workspace;
    private System.Threading.Timer? _elapsedTimer;

    private string? OutcomeClass => Workspace?.Phase switch
    {
        ExecutionPhase.Succeeded => "akml-status-outcome--ok",
        ExecutionPhase.Failed => "akml-status-outcome--failed",
        _ => null,
    };

    /// <summary>"16 rows · 87 ms" after a run; the elapsed time (hh:mm:ss) while one runs.</summary>
    private string? RowsText
    {
        get
        {
            var w = Workspace;
            if (w == null || w.Phase == ExecutionPhase.Idle) return null;
            if (w.Phase == ExecutionPhase.Running)
                return TimeSpan.FromMilliseconds(w.ElapsedMs).ToString(@"hh\:mm\:ss", System.Globalization.CultureInfo.InvariantCulture);
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            return $"{w.RowCount.ToString("N0", inv)} row{(w.RowCount == 1 ? "" : "s")} · {w.ElapsedMs.ToString("N0", inv)} ms";
        }
    }

    private void OnWorkspaceChanged() => _ = InvokeAsync(() =>
    {
        // The elapsed clock ticks on its own timer, only while a query runs.
        bool running = Workspace?.Phase == ExecutionPhase.Running;
        _elapsedTimer?.Change(running ? TimeSpan.FromSeconds(1) : System.Threading.Timeout.InfiniteTimeSpan, TimeSpan.FromSeconds(1));
        StateHasChanged();
    });

    private BridgeState _bridgeState = BridgeState.Disconnected;
    private bool _cachePresent;
    private Availability _state = Availability.Disconnected;
    private bool _retrying;

    private void OnFailureChanged() => _ = InvokeAsync(() =>
    {
        SyncCountdownTimer();
        StateHasChanged();
    });

    /// <summary>
    /// Runs the one-second tick while EITHER countdown is pending.
    ///
    /// <para>
    /// The timer was originally owned solely by <c>Bridge.RetryScheduled</c>, which fires for a
    /// connection that dropped. An auto-connect failure never raises that event, so its "Retry
    /// (40s)" label rendered once and then sat frozen until the next attempt — reading as a stuck
    /// UI rather than a countdown. Both sources drive the same timer now.
    /// </para>
    /// </summary>
    private void SyncCountdownTimer()
    {
        var pending = _nextRetryAt is not null || AutoConnect.LastFailure?.NextAttemptAt is not null;
        _countdownTimer?.Change(
            pending ? TimeSpan.FromSeconds(1) : System.Threading.Timeout.InfiniteTimeSpan,
            TimeSpan.FromSeconds(1));
    }

    /// <summary>
    /// The label doubles as the countdown, so one control answers both "when will it try again?"
    /// and "can I make it try now?" — a separate timer readout would be noise in a status bar.
    /// </summary>
    private string RetryLabel
    {
        get
        {
            if (_retrying) return "Retrying…";
            var next = AutoConnect.LastFailure?.NextAttemptAt;
            if (next is null) return "Retry";
            var secs = (int)Math.Ceiling((next.Value - DateTimeOffset.UtcNow).TotalSeconds);
            return secs > 1 ? $"Retry ({secs}s)" : "Retry";
        }
    }

    private async Task RetryEngineAsync()
    {
        if (_retrying) return;
        _retrying = true;
        try
        {
            await AutoConnect.RetryNowAsync();
            // Give the attempt a beat to land so the button does not flicker back to "Retry"
            // before the pill has had a chance to turn green.
            await Task.Delay(600);
        }
        finally
        {
            _retrying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Spec 025 US3: reconnect countdown plumbing (preserved).
    private DateTimeOffset? _nextRetryAt;
    private System.Threading.Timer? _countdownTimer;

    protected override void OnInitialized()
    {
        _bridgeState = Bridge.State;
        Bridge.StateChanged += OnStateChanged;
        Bridge.RetryScheduled += OnRetryScheduled;
        AutoConnect.FailureChanged += OnFailureChanged;
        SchemaSync.ChecksumDrifted += OnChecksumDrifted;
        SqlConn.StateChanged += OnSqlConnChanged;
        _countdownTimer = new System.Threading.Timer(_ => TickCountdown(), null,
            System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        if (Workspace != null)
        {
            Workspace.Changed += OnWorkspaceChanged;
            _elapsedTimer = new System.Threading.Timer(_ => TickCountdown(), null,
                System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ProbeCacheAsync();
        Recompute();
        await TryAutoRestoreSqlConnectionAsync(); // spec 032 FR-032
    }

    /// <summary>Probe whether a schema snapshot exists for the active connection's (server, db).
    /// Best-effort: any failure leaves <c>_cachePresent</c> false (⇒ Offline, never a crash).</summary>
    private async Task ProbeCacheAsync()
    {
        try
        {
            // Spec 041 (T195): the SAME key the schema sync writes under — the SQL connection's (server, database),
            // not the engine pairing's host:port with a "master" placeholder, which never matched.
            if (!SqlConn.IsConnected || string.IsNullOrEmpty(SqlConn.Server) || string.IsNullOrEmpty(SqlConn.Database))
            {
                _cachePresent = false;
                return;
            }
            var snapshot = await SchemaCache.GetAsync(SqlConn.SchemaIdentity ?? SqlConn.Server!, SqlConn.Database!);
            _cachePresent = snapshot?.PhaseA is { Length: > 0 };
        }
        catch
        {
            _cachePresent = false;
        }
    }

    private void OnStateChanged(BridgeState newState)
    {
        InvokeAsync(async () =>
        {
            _bridgeState = newState;
            if (newState != BridgeState.Reconnecting) _nextRetryAt = null;
            await ProbeCacheAsync();
            Recompute();
            await TryAutoRestoreSqlConnectionAsync(); // spec 032 FR-032 — bridge may open after first render
            StateHasChanged();
        });
    }

    private void OnChecksumDrifted(ChecksumDriftNotice _)
    {
        // A drift means a fresh snapshot just landed — re-probe so the indicator reflects the
        // cache without a reload.
        InvokeAsync(async () =>
        {
            await ProbeCacheAsync();
            Recompute();
            StateHasChanged();
        });
    }

    /// <summary>Derive the user-facing state per the contract matrix (FR-023). No flicker: while
    /// Reconnecting with a cache present, hold Cached; flip to Live only on Open.</summary>
    private void Recompute()
    {
        _state = _bridgeState switch
        {
            // Spec 032 FR-032: "Live" requires BOTH the bridge AND a SQL session — the
            // pill must never claim full IntelliSense while SessionId-less requests
            // degrade to keywords+snippets.
            BridgeState.Open => SqlConn.IsConnected ? Availability.Live : Availability.BridgeOnly,
            BridgeState.Connecting => _cachePresent ? Availability.Cached : Availability.Connecting,
            BridgeState.Reconnecting => _cachePresent ? Availability.Cached : Availability.Reconnecting,
            BridgeState.Failed => _cachePresent ? Availability.Cached : Availability.Failed,
            _ /* Disconnected */ => _cachePresent ? Availability.Cached : Availability.Offline,
        };
    }

    /// <summary>
    /// Spec 032 FR-032 (auto-restore): once per page load, when the bridge is up but no SQL
    /// session exists, silently reconnect the most-recently-used SAVED connection — Windows
    /// auth only (no password is at rest by design; SQL-auth rows keep the honest BridgeOnly
    /// pill and a one-click connect). ConnectAsync re-runs the loopback/SSRF guard itself.
    /// Non-blocking and best-effort: any failure just leaves the honest BridgeOnly state.
    /// </summary>
    private bool _restoreAttempted;

    private async Task TryAutoRestoreSqlConnectionAsync()
    {
        if (_restoreAttempted || _bridgeState != BridgeState.Open || SqlConn.IsConnected) return;
        _restoreAttempted = true;

        try
        {
            var activeId = await SavedSqlConnections.GetActiveIdAsync();
            if (string.IsNullOrEmpty(activeId)) return;
            var saved = await SavedSqlConnections.GetAsync(activeId!);
            if (saved == null || !saved.WindowsAuth) return;

            await SqlConn.ConnectAsync(saved.Server, saved.Database, windowsAuth: true,
                user: null, password: null, System.Threading.CancellationToken.None);
        }
        catch
        {
            // Best-effort — the BridgeOnly pill remains and the Connect button is one click away.
        }
    }

    private void OnRetryScheduled(DateTimeOffset? nextRetryAt)
    {
        InvokeAsync(() =>
        {
            _nextRetryAt = nextRetryAt;
            SyncCountdownTimer();
            StateHasChanged();
        });
    }

    private void TickCountdown() => InvokeAsync(StateHasChanged);

    // SQL-connection indicator: reflects ISqlConnectionService (the SQL session), distinct from the
    // bridge/cache pill above. Clicking opens the connection manager. Spec 032: the pill itself
    // now also depends on the SQL session (Live vs BridgeOnly) — recompute, don't just repaint.
    private void OnSqlConnChanged() => InvokeAsync(async () =>
    {
        await ProbeCacheAsync();   // spec 041: the cache key is the SQL connection's (server, database)
        Recompute();
        StateHasChanged();
    });

    private string ConnLabel => SqlConn.IsConnected ? $"{SqlConn.Server}/{SqlConn.Database}" : "Connect";

    /// <summary>Spec 041 (R65): the web app and the engine are different builds (build metadata aside).</summary>
    private bool VersionsDiffer =>
        !string.IsNullOrEmpty(Bridge.EngineVersion)
        && !string.Equals(AkmlSql.Core.AppVersion.StripBuildMetadata(Bridge.EngineVersion), AkmlSql.Core.AppVersion.Current, StringComparison.Ordinal);

    private bool _rollingBack;

    /// <summary>Spec 042 (FR-016): the version, so the segment can stay short.</summary>
    private string KindTooltip => SqlConn.Kind == DatabaseKind.PostgreSql
        ? (string.IsNullOrEmpty(SqlConn.ServerVersionText) ? "PostgreSQL" : $"PostgreSQL {SqlConn.ServerVersionText}")
        : "SQL Server";

    // Spec 042 (FR-016): ends the transaction through the same execute path as any statement, so the session's
    // transaction state follows the engine's answer. Resolved when used: a bare status bar needs no execute service.
    private async Task RollbackAsync()
    {
        if (_rollingBack) return;
        _rollingBack = true;
        try
        {
            var exec = Services.GetService<IQueryExecutionService>();
            if (exec == null) return;
            var result = await exec.ExecuteAsync("ROLLBACK;", 1, 30, Guid.NewGuid().ToString("N"), System.Threading.CancellationToken.None);
            if (result.Status != AkmlSql.Core.Ipc.Messages.ExecuteStatus.Ok)
            {
                Services.GetService<INotificationService>()?.Notify(
                    "Rollback failed: " + (result.ErrorMessage ?? "the engine reported an error."), NotificationKind.Error);
            }
        }
        finally
        {
            _rollingBack = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string ConnTooltip => SqlConn.IsConnected
        ? $"Connected to {SqlConn.Server} / {SqlConn.Database} — click to manage connections"
        : "Not connected to SQL Server — click to connect";

    private string PillLabel => _state switch
    {
        Availability.Live => "Live",
        Availability.BridgeOnly => "Live · no SQL",
        Availability.Cached => "Cached",
        Availability.Offline => "Offline",
        Availability.Connecting => "Connecting",
        Availability.Reconnecting => "Reconnecting",
        Availability.Failed => "Failed",
        _ => "Disconnected",
    };

    private string PillClass => "akml-status-pill-" + _state.ToString().ToLowerInvariant();

    private string StatusText => _state switch
    {
        Availability.Live => "Live IntelliSense available.",
        Availability.BridgeOnly => "Engine connected — connect to SQL Server for schema-aware IntelliSense.",
        Availability.Cached => "Engine offline — IntelliSense served from the local schema cache.",
        Availability.Offline => "Offline — keyword-only IntelliSense; formatter / analyser run in-browser.",
        Availability.Connecting => "Handshaking with engine…",
        Availability.Reconnecting => ReconnectingText(),
        Availability.Failed => "Handshake failed. Check engine pairing.",
        _ => "Disconnected.",
    };

    private string ReconnectingText()
    {
        // Spec 025 US3 contract: "Reconnecting · next try in 4s" / "Reconnecting · trying now…"
        if (_nextRetryAt == null) return "Reconnecting · trying now…";
        var remaining = _nextRetryAt.Value - DateTimeOffset.UtcNow;
        var seconds = Math.Max(0, (int)Math.Ceiling(remaining.TotalSeconds));
        return $"Reconnecting · next try in {seconds}s";
    }

    public void Dispose()
    {
        Bridge.StateChanged -= OnStateChanged;
        Bridge.RetryScheduled -= OnRetryScheduled;
        AutoConnect.FailureChanged -= OnFailureChanged;
        SchemaSync.ChecksumDrifted -= OnChecksumDrifted;
        SqlConn.StateChanged -= OnSqlConnChanged;
        _countdownTimer?.Dispose();
        if (_workspace != null) _workspace.Changed -= OnWorkspaceChanged;
        _elapsedTimer?.Dispose();
    }
}
