@*
    Spec 021 T029 — main layout wrapper for the web edition. Consumes theme tokens
    via CSS variables emitted by scripts/generate-theme-css.ps1 (T004).
    Real page slots for Editor / Settings / About land in M2 (T031 onwards).
*@
@using System.Threading
@using AkmlSql.Web.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService Theme
@inject IEngineBridge Bridge
@inject IConnectionStore Connections
@inject IPairingTokenVault Vault
@inject ISqlConnectionService SqlConn
@inject ISchemaSync SchemaSync

<div class="akml-app">
    <NavMenu />
    @* Spec 024 T004: error-banner contract — see
       `specs/024-m2-web-closure/contracts/playwright-harness-contract.md`
       §"data-testid contract" (the `error-banner` row, asserted empty in every
       scenario). The selector is reserved for the future global-error surface (an
       `IErrorBroker` service or cascading parameter). It is intentionally absent
       from the DOM today — `Assert.Empty(Page.GetByTestId("error-banner")...)` is
       satisfied by absence. When a real error path lands, it adds the conditional
       <div data-testid="error-banner"> here. *@
    @* Spec 025 follow-on: TLS fingerprint mismatch banner. Conditional render only —
       absent from the DOM when no drift has been seen, identical absence semantics to
       the spec 024 error-banner contract. *@
    <TlsFingerprintMismatchBanner />
    <main class="akml-main">
        @Body
    </main>
    <StatusBar />
    @* Spec 030 — ⌘P command palette. Hosted at the layout level so it overlays every page and its
       global Ctrl/Cmd+P capture-phase listener is alive regardless of which route is mounted. *@
    <CommandPalette />
    @* Phase 4 — the "Connect to SQL Server" modal. App-global (overlays every page) so the command
       palette / Settings / StatusBar can open it from any route via IConnectionManagerController. *@
    <ConnectionManagerModal />
</div>

<style>
    /* Layout-only styling — colours/fonts come from theme tokens (CSS variables). */
    .akml-app {
        display: grid;
        grid-template-rows: auto 1fr auto;
        height: 100vh;
        background-color: var(--akml-surface-canvas);
        color: var(--akml-text-primary);
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
        font-weight: var(--akml-type-chrome-weight);
    }
    .akml-main {
        overflow: auto;
        padding: var(--akml-scalar-spacing-m);
    }

    /* Global tweaks. Theme CSS files are auto-generated -- editing them is forbidden,
       so cross-cutting rules live here instead. Inline style blocks are global
       (CSS isolation only applies to .razor.css companion files). */
    a { color: var(--akml-text-link); text-decoration: none; }
    a:hover { color: var(--akml-accent-primaryhover); text-decoration: underline; }
    input[type="radio"], input[type="checkbox"] { accent-color: var(--akml-accent-primary); }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Phase 4 — THE single owner of SchemaSync's lifecycle. Subscribe to the SQL-connection
        // state so a connect (from the connection-manager modal, or anywhere else) starts schema
        // polling, and a disconnect stops it. This is the ONLY place SchemaSync.StartAsync is called:
        // it uses SqlConn.SessionId — the SAME id sent in ConnectionChanged / DocumentChanged / every
        // completion request — so the engine's SessionManager actually knows the session. The old
        // picker path passed EngineConnection.Id (a pairing GUID the engine never registered), which
        // is why its SchemaIdentify always reported HasConnection=false; that path is now neutralized.
        SqlConn.StateChanged += OnSqlConnStateChanged;

        // Pull the persisted theme override before any page reads Theme.Current.
        // ThemeService.InitializeAsync is idempotent (Task is cached), so pages that
        // also await it (Editor, Settings) share this Task instead of racing.
        await Theme.InitializeAsync();

        // Spec 025 (M3) — auto-reconnect the active engine connection on app startup, so re-opening
        // the web edition restores the live bridge without a manual Connect (the connection picker
        // lives only on /settings, so this has to be a layout-level hook to cover the editor landing
        // page too). No PIN is needed: localhost auto-accepts; LAN replays the wrapped bearer from
        // IndexedDB. Fire-and-forget so a slow / unreachable engine never blocks first paint — on any
        // failure the bridge simply stays Offline and the user can click Connect.
        _ = TryAutoConnectActiveAsync();
    }

    private async Task TryAutoConnectActiveAsync()
    {
        try
        {
            if (Bridge.State != BridgeState.Disconnected) return;   // already connecting / open
            var activeId = await Connections.GetActiveIdAsync();
            if (string.IsNullOrEmpty(activeId)) return;
            var conn = await Connections.GetAsync(activeId);
            if (conn == null) return;

            // Localhost auto-accepts (no PIN, no bearer); LAN replays the stored bearer so reconnect
            // needs no PIN. A null bearer for LAN just means the engine will demand a fresh PIN —
            // handled gracefully (the handshake returns PinRequired and we leave the bridge Offline).
            string? bearer = conn.IsLocalhost ? null : await Vault.RetrieveAsync(conn.Id);
            await Bridge.ConnectAsync(conn, bearer, pairingPin: null, CancellationToken.None);
            // StatusBar subscribes to Bridge state changes, so it reflects Open/Live on its own.
        }
        catch
        {
            // Engine unreachable / no stored bearer / transient error — stay Offline by design.
        }
    }

    /// <summary>
    /// Phase 4 — the SINGLE SchemaSync owner. StateChanged fires on BOTH connect and disconnect, and
    /// DisconnectAsync nulls Server/Database, so we MUST guard on IsConnected before starting. StopAsync
    /// runs first unconditionally: StartAsync early-returns if already running, so the Stop is what lets
    /// switching saved connections actually re-key to the new (server, db). Fire-and-forget so a slow
    /// engine never blocks the UI; PollOnceAsync self-heals (no-ops gracefully on HasConnection=false /
    /// bridge-closed) until the engine's fire-and-forget Phase-A connection opens.
    /// </summary>
    private void OnSqlConnStateChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            await SchemaSync.StopAsync();
            if (SqlConn.IsConnected)
            {
                await SchemaSync.StartAsync(SqlConn.SessionId, SqlConn.Server!, SqlConn.Database!);
            }
        }
        catch
        {
            // Schema sync is best-effort; a failure here must never break the layout.
        }
    });

    public void Dispose()
    {
        SqlConn.StateChanged -= OnSqlConnStateChanged;
    }
}
