@*
    Spec 021 T029 — main layout wrapper for the web edition. Consumes theme tokens
    via CSS variables emitted by scripts/generate-theme-css.ps1 (T004).
    Real page slots for Editor / Settings / About land in M2 (T031 onwards).
*@
@using AkmlSql.Web.Services
@inherits LayoutComponentBase
@inject IThemeService Theme

<div class="akml-app">
    <NavMenu />
    @* Spec 024 T004: error-banner contract. Rendered only when an error surfaces;
       Playwright tests assert this element is absent from the DOM in the happy path. *@
    @if (!string.IsNullOrEmpty(GlobalError))
    {
        <div data-testid="error-banner" role="alert" class="akml-error-banner">@GlobalError</div>
    }
    <main class="akml-main">
        @Body
    </main>
    <StatusBar />
</div>

<style>
    /* Layout-only styling — colours/fonts come from theme tokens (CSS variables). */
    .akml-app {
        display: grid;
        grid-template-rows: auto 1fr auto;
        height: 100vh;
        background-color: var(--akml-surface-canvas);
        color: var(--akml-text-primary);
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
        font-weight: var(--akml-type-chrome-weight);
    }
    .akml-main {
        overflow: auto;
        padding: var(--akml-scalar-spacing-m);
    }

    /* Global tweaks. Theme CSS files are auto-generated -- editing them is forbidden,
       so cross-cutting rules live here instead. Inline style blocks are global
       (CSS isolation only applies to .razor.css companion files). */
    a { color: var(--akml-text-link); text-decoration: none; }
    a:hover { color: var(--akml-accent-primaryhover); text-decoration: underline; }
    input[type="radio"], input[type="checkbox"] { accent-color: var(--akml-accent-primary); }
</style>

@code {
    /// <summary>Spec 024 T004: surfaces a top-level error banner with the
    /// <c>error-banner</c> testid when set. Reserved for catch-all error rendering
    /// the Playwright suite asserts against. Currently always null in the happy path.</summary>
    public static string? GlobalError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Pull the persisted theme override before any page reads Theme.Current.
        // ThemeService.InitializeAsync is idempotent (Task is cached), so pages that
        // also await it (Editor, Settings) share this Task instead of racing.
        await Theme.InitializeAsync();
    }
}
