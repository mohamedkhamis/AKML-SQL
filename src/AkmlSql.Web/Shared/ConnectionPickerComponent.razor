@*
    Spec 021 (web edition) -- M3 task T070. Connection picker:
      * Lists EngineConnection records (Localhost + LAN)
      * Add: host / port / PIN form; on submit, performs WSS handshake + stores
        wrapped bearer + sets active
      * Edit / Remove
      * TLS fingerprint pinning per contracts/pairing-flow.md is recorded on first
        successful LAN connect; subsequent mismatches surface a "Engine certificate
        changed -- re-pair?" prompt (handled inside EngineBridge.ConnectAsync today;
        UI dialog lands with the M4 installer cert work).
*@
@using AkmlSql.Web.Services
@implements IDisposable
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Core.Ipc
@inject IConnectionStore Connections
@inject IPairingTokenVault Vault
@inject IEngineBridge Bridge
@inject IDiagnosticsRingBuffer Diagnostics
@inject IDialogService Dialogs
@inject INotificationService Notifications
@inject IServiceProvider ServiceProvider

<div class="akml-connections">
    <div class="akml-connections-header">
        @if (ShowTitle)
        {
            <h3>Engine connections</h3>
        }
        <button class="akml-btn" @onclick="ShowAddDialog">Add</button>
    </div>

    @* The question users actually have: "does the other server need AKML on it?" Answered here,
       where they are about to add one. *@
    <p class="akml-connections-intro" data-testid="engine-connections-intro">
        The engine is the AKML SQL service that does the work for this page. You normally use the one on this
        computer. <b>To query a SQL Server on another machine you don't need an engine there</b> — use
        <i>Connect to database</i> with that server's address and SQL Server authentication. Add a remote engine
        only when AKML SQL Web is installed in network mode on the other computer.
    </p>

    @if (_connections == null || _connections.Count == 0)
    {
        <p class="akml-connections-empty">
            No connections yet. Click <b>Add</b> to pair with a local or LAN engine.
        </p>
    }
    else
    {
        <ul class="akml-connections-list">
            @foreach (var c in _connections)
            {
                <li class="akml-connections-row @(c.Id == _activeId ? "akml-connections-row-active" : "")">
                    <span class="akml-connections-name">@c.Name</span>
                    <span class="akml-connections-host">@c.Host:@c.Port</span>
                    @* Where the engine is, from its address: a network-mode engine paired at localhost is still local. *@
                    <span class="akml-connections-badge">@(EngineEndpoint.IsLoopbackHost(c.Host) ? "Local" : "LAN")</span>
                    @if (c.Id == _activeId && Bridge.State == BridgeState.Open)
                    {
                        @* The engine this page is using says so, instead of offering to connect to it again. *@
                        <span class="akml-connections-badge akml-connections-badge--active" data-testid="@($"engine-connected-{c.Id}")"
                              title="This page is using this engine">Connected</span>
                    }
                    else
                    {
                        <button class="akml-btn" data-testid="@($"engine-connect-{c.Id}")" @onclick="@(() => ConnectAsync(c))">Connect</button>
                    }
                    @if (!c.IsLocalhost)
                    {
                        @* Spec 041 (FR-057): a new PIN replaces the stored pairing token (an engine re-installed, or
                           a token that expired). *@
                        <button class="akml-btn" data-testid="@($"engine-repair-{c.Id}")" @onclick="@(() => RepairAsync(c))">Re-pair…</button>
                    }
                    <button class="akml-btn" data-testid="@($"engine-remove-{c.Id}")" @onclick="@(() => RemoveAsync(c))">Remove…</button>
                </li>
            }
        </ul>
    }

    @if (_showAdd)
    {
        <div class="akml-connections-dialog">
            <h4>Add connection</h4>
            <label class="akml-field"><span class="akml-field-label">Name</span>
                <input class="akml-input" @bind="_form.Name" placeholder="optional" data-testid="engine-add-name" /></label>
            <label class="akml-field"><span class="akml-field-label">Address</span>
                <input class="akml-input" @bind="_form.Host" @bind:event="oninput" placeholder="localhost, a server name or IP, or host:port"
                       data-testid="engine-add-host" />
            </label>
            <label class="akml-field"><span class="akml-field-label">Port</span>
                <input class="akml-input" type="number" min="1" max="65535" @bind="_form.Port" data-testid="engine-add-port" />
            </label>
            <p class="akml-connections-hint">
                Use the <b>Bridge port</b> from <code>%ProgramData%\AKML SQL Web\INSTALL-SUMMARY.txt</code> on the engine
                computer. The default is @EngineEndpoint.DefaultPort, but the installer can choose another.
            </p>
            @if (NeedsPin && !_secureStorage)
            {
                <SecureContextNotice What="the pairing token" />
            }
            @if (NeedsPin)
            {
                <label class="akml-field"><span class="akml-field-label">Pairing PIN</span>
                    <input class="akml-input" @bind="_form.PairingPin" inputmode="numeric" autocomplete="off" placeholder="PIN from the engine computer"
                           data-testid="engine-add-pin" />
                </label>
                <p class="akml-connections-hint" data-testid="engine-add-pin-hint">
                    @if (_pinRequested)
                    {
                        <text>This engine was installed for network (LAN) use, so it needs its PIN even from this computer. The PIN is in
                        <code>%ProgramData%\AKML SQL Web\pairing-pin.txt</code>, and it changes each time it is used.</text>
                    }
                    else
                    {
                        <text>An engine on another computer needs its PIN, from
                        <code>%ProgramData%\AKML SQL Web\pairing-pin.txt</code> on that computer.</text>
                    }
                </p>
            }
            <div class="akml-connections-dialog-buttons">
                <button class="akml-btn" @onclick="SubmitAddAsync" data-testid="engine-add-pair">Pair</button>
                <button class="akml-btn" @onclick="() => _showAdd = false">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_lastError))
            {
                <p class="akml-connections-error" data-testid="engine-add-error">@_lastError</p>
            }
        </div>
    }

    @if (_diagnosis is { } d)
    {
        <div class="akml-connections-diagnosis" role="alert" data-testid="engine-connect-diagnosis">
            <p class="akml-connections-diagnosis-summary">@d.Summary</p>
            <ol>
                @foreach (var step in d.Steps)
                {
                    <li>@step</li>
                }
            </ol>
            @if (d.TrustUrl is not null)
            {
                <p>
                    <a class="akml-btn" href="@d.TrustUrl" target="_blank" rel="noopener noreferrer"
                       data-testid="engine-trust-link">Open the engine address in a new tab</a>
                </p>
            }
            <details>
                <summary>Technical detail</summary>
                <code>@d.RawError</code>
            </details>
        </div>
    }
</div>

<style>
    .akml-connections { padding: var(--akml-scalar-spacing-m); max-width: 720px; }
    .akml-connections-header { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); }
    .akml-connections-empty { color: var(--akml-text-secondary); font-style: italic; }
    .akml-connections-list { list-style: none; padding: 0; margin: var(--akml-scalar-spacing-m) 0; }
    .akml-connections-row {
        display: grid;
        grid-template-columns: 1fr 200px 50px auto auto;
        gap: var(--akml-scalar-spacing-s);
        align-items: center;
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        border-bottom: 1px solid var(--akml-border-subtle);
    }
    .akml-connections-row-active {
        background-color: var(--akml-surface-selection);
        box-shadow: inset 2px 0 0 0 var(--akml-accent-primary);
    }
    .akml-connections-name { font-weight: bold; }
    .akml-connections-host { color: var(--akml-text-secondary); font-family: var(--akml-type-editor-family); }
    /* On the active row the background is --akml-surface-selection, which is a saturated system
       Highlight in the high-contrast theme. The de-emphasised host colour (text-secondary = GrayText)
       drops to ~1.15:1 on it — effectively invisible. Promote it to text-primary on the active row so
       it reads against the selection fill in every theme (light/dark selection tints are subtle, so
       primary text stays readable there too). */
    .akml-connections-row-active .akml-connections-host { color: var(--akml-text-primary); }
    .akml-connections-badge {
        font-size: 11px;
        padding: 0 var(--akml-scalar-spacing-xs);
        /* Spec 043 (FR-032): a badge token behind white text; the status colour read under 3:1 in the dark theme. */
        background-color: var(--akml-accent-primary);
        color: var(--akml-text-onaccent);
        border-radius: var(--akml-scalar-radius-xs);
        text-align: center;
    }
    .akml-connections-badge--active { background-color: var(--akml-status-success); }
    .akml-connections-dialog {
        margin-top: var(--akml-scalar-spacing-l);
        padding: var(--akml-scalar-spacing-m);
        background-color: var(--akml-surface-panel);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
    }
    .akml-connections-dialog-buttons {
        display: flex;
        gap: var(--akml-scalar-spacing-s);
        margin-top: var(--akml-scalar-spacing-s);
    }
    .akml-connections-error { color: var(--akml-status-danger); margin-top: var(--akml-scalar-spacing-s); }
    .akml-connections-intro,
    .akml-connections-hint {
        color: var(--akml-text-secondary);
        line-height: 1.5;
    }
    .akml-connections-hint { margin: 0 0 var(--akml-scalar-spacing-s); font-size: 12px; }
    .akml-connections-intro b { color: var(--akml-text-primary); }
    .akml-connections-diagnosis {
        margin-top: var(--akml-scalar-spacing-m);
        padding: var(--akml-scalar-spacing-m);
        border: 1px solid var(--akml-status-danger);
        border-left-width: 3px;
        border-radius: var(--akml-scalar-radius-xs);
        background-color: var(--akml-surface-panel);
        line-height: 1.5;
    }
    .akml-connections-diagnosis-summary { margin-top: 0; font-weight: bold; }
    .akml-connections-diagnosis ol { padding-left: 1.25rem; }
    .akml-connections-diagnosis li { margin-bottom: var(--akml-scalar-spacing-xs); }
    .akml-connections-diagnosis code { overflow-wrap: anywhere; }
</style>

@code {
    /// <summary>Show the "Engine connections" heading; off where the host (Settings › Connections) has one.</summary>
    [Parameter] public bool ShowTitle { get; set; } = true;

    private IReadOnlyList<EngineConnection>? _connections;
    private string? _activeId;
    private bool _showAdd;
    private AddForm _form = new();
    private string? _lastError;

    /// <summary>Why the last connect failed, when it failed before any engine answered.</summary>
    private EngineConnectDiagnosis? _diagnosis;

    /// <summary>
    /// The engine answered a PIN-less handshake at a loopback address with <see cref="HandshakeStatus.PinRequired"/>:
    /// it was installed for network (LAN) use, and such an engine wants pairing from every browser,
    /// this computer's included. Until then nothing in the address says so.
    /// </summary>
    private bool _pinRequested;

    /// <summary>
    /// A PIN is needed for any engine that is not on this computer, and for one on this computer that
    /// asked for it. Worked out from the address as it is typed, rather than from a "Localhost"
    /// checkbox the user had to remember to untick.
    /// </summary>
    private bool NeedsPin =>
        _pinRequested
        || (EngineEndpoint.TryParseAddress(_form.Host, _form.Port, out var host, out _)
            && !EngineEndpoint.IsLoopbackHost(host));

    // Review WEB-03: whether a pairing token can be stored here (a secure context). Assumed until the browser says otherwise.
    private bool _secureStorage = true;

    internal const string InsecurePairingMessage =
        "This page was opened over plain HTTP from another computer, so the pairing token could not be stored. " +
        "Open the site's HTTPS address, then pair again.";

    protected override async Task OnInitializedAsync()
    {
        try { _secureStorage = ServiceProvider.GetService(typeof(IWebCryptoWrapper)) is not IWebCryptoWrapper crypto || await crypto.IsSecureStorageAvailableAsync(); }
        catch (JSException) { _secureStorage = false; }
        catch (JSDisconnectedException) { }
        Bridge.StateChanged += OnBridgeStateChanged;
        await ReloadAsync();
    }

    // Connected / Connect follows the bridge, and the active engine can change from another page or tab.
    private void OnBridgeStateChanged(BridgeState state) => _ = InvokeAsync(ReloadAsync);

    public void Dispose() => Bridge.StateChanged -= OnBridgeStateChanged;

    private async Task ReloadAsync()
    {
        _connections = await Connections.ListAsync();
        _activeId = await Connections.GetActiveIdAsync();
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _form = new AddForm();
        _lastError = null;
        _diagnosis = null;
        _pinRequested = false;
        _showAdd = true;
    }

    private async Task SubmitAddAsync()
    {
        _lastError = null;
        _diagnosis = null;

        // A pasted "host:port" or whole URL fills both fields; a port in the text wins.
        if (!EngineEndpoint.TryParseAddress(_form.Host, _form.Port, out var host, out var port))
        {
            _lastError = "Enter the engine computer's name or IP address, optionally with :port.";
            return;
        }

        var isLocalhost = EngineEndpoint.IsLoopbackHost(host);
        var sendPin = !isLocalhost || _pinRequested;
        // Review WEB-03: a PIN pairing returns a token that must be stored; without a secure context it cannot be, and the
        // engine has already spent the PIN. Refuse before the handshake.
        if (sendPin && !_secureStorage)
        {
            _lastError = InsecurePairingMessage;
            return;
        }
        if (sendPin && string.IsNullOrWhiteSpace(_form.PairingPin))
        {
            _lastError = isLocalhost ? "Enter the engine's pairing PIN." : "An engine on another computer needs its pairing PIN.";
            return;
        }

        _form.Host = host;
        _form.Port = port;
        try
        {
            var connection = new EngineConnection
            {
                Id = Guid.NewGuid().ToString(),
                Name = string.IsNullOrWhiteSpace(_form.Name) ? host : _form.Name.Trim(),
                Host = host,
                Port = port,
                IsLocalhost = isLocalhost,
            };

            // Attempt the handshake first. On localhost we skip the PIN unless the engine asked for it; on LAN we send it.
            var response = await Bridge.ConnectAsync(
                connection, bearerToken: null, pairingPin: sendPin ? _form.PairingPin.Trim() : null,
                CancellationToken.None);

            if (response.Status == HandshakeStatus.PinRequired && !sendPin)
            {
                // A network-mode engine reached at its loopback address: show the PIN field rather than a dead end.
                _pinRequested = true;
                _lastError = "This engine needs its pairing PIN, even from this computer. Enter it and press Pair again.";
                Diagnostics.Log(DiagnosticLevel.Info, "connections", $"{host}:{port} asked for a pairing PIN.");
                return;
            }

            if (response.Status != HandshakeStatus.Ok)
            {
                _lastError = $"Engine rejected the handshake: {response.Status} -- {response.ErrorMessage}";
                Diagnostics.Log(DiagnosticLevel.Warn, "connections", _lastError);
                return;
            }

            // Persist the bearer token (a PIN pairing only -- a localhost-mode handshake returns null). A connection
            // that paired needs its token on every reconnect, whatever its address, so it is not "localhost" any more.
            if (!string.IsNullOrEmpty(response.NewBearerToken))
            {
                connection.IsLocalhost = false;
                connection.BearerTokenWrappedRef = await Vault.StoreAsync(
                    connection.Id, response.NewBearerToken!, DateTimeOffset.UtcNow.AddDays(60));
            }
            connection.LastConnectedAt = DateTimeOffset.UtcNow;
            connection.LastKnownEngineVersion = response.EngineVersion;
            connection.LastKnownCapabilities = response.EngineCapabilities;

            await Connections.AddAsync(connection);
            await Connections.SetActiveIdAsync(connection.Id);

            // Phase 4: SchemaSync is now owned SOLELY by the MainLayout SqlConn.StateChanged
            // subscriber, keyed on the canonical SqlConn.SessionId. This component is engine-PAIRING
            // only; it no longer starts SchemaSync (the old TryStartSchemaSyncAsync passed
            // EngineConnection.Id — a pairing GUID the engine never registered as a session — so its
            // SchemaIdentify always returned HasConnection=false). Removed to keep one owner.

            _showAdd = false;
            await ReloadAsync();
        }
        catch (Exception ex) when (IsSocketFailure(ex))
        {
            // Nothing answered (or the page itself refused the address): explain, don't dump the stack.
            _diagnosis = EngineConnectDiagnosis.For(host, port, ex);
            Diagnostics.Log(DiagnosticLevel.Warn, "connections", _diagnosis.RawError);
        }
        catch (Exception ex)
        {
            _lastError = EngineConnectDiagnosis.FirstLine(ex.Message);
            Diagnostics.Log(DiagnosticLevel.Error, "connections", _lastError, new { Exception = ex.GetType().Name });
        }
    }

    /// <summary>
    /// True for a failure before any engine answered: the WebSocket never opened. Those get the
    /// diagnosis; a handshake refusal (wrong PIN, expired token) already says what is wrong.
    /// </summary>
    private static bool IsSocketFailure(Exception ex) =>
        ex is Microsoft.JSInterop.JSException
        && (ex.Message.Contains("WebSocket", StringComparison.Ordinal)
            || ex.Message.Contains(EngineConnectDiagnosis.PolicyMarker, StringComparison.Ordinal));

    private async Task ConnectAsync(EngineConnection c)
    {
        _lastError = null;
        _diagnosis = null;
        try
        {
            string? bearer = null;
            if (!c.IsLocalhost)
            {
                bearer = await Vault.RetrieveAsync(c.Id);
            }
            var response = await Bridge.ConnectAsync(c, bearer, pairingPin: null, CancellationToken.None);
            if (response.Status == HandshakeStatus.Ok)
            {
                await Connections.SetActiveIdAsync(c.Id);
                c.LastConnectedAt = DateTimeOffset.UtcNow;
                c.LastKnownEngineVersion = response.EngineVersion;
                c.LastKnownCapabilities = response.EngineCapabilities;
                await Connections.UpdateAsync(c);
                // Phase 4: SchemaSync start removed — owned solely by the MainLayout SQL-connection
                // owner (keyed on SqlConn.SessionId). This component remains engine-pairing only.
                await ReloadAsync();
            }
            else
            {
                _lastError = $"Handshake declined: {response.Status} -- {response.ErrorMessage}";
            }
        }
        catch (Exception ex) when (IsSocketFailure(ex))
        {
            _diagnosis = EngineConnectDiagnosis.For(c.Host, c.Port, ex);
        }
        catch (Exception ex)
        {
            _lastError = EngineConnectDiagnosis.FirstLine(ex.Message);
        }
        StateHasChanged();
    }

    private async Task RemoveAsync(EngineConnection c)
    {
        // Spec 041 (FR-057, FR-102): removing an engine connection confirms, naming it.
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Remove engine connection",
            Message = $"Remove the engine connection “{c.Name}” ({c.Host}:{c.Port})?",
            Details = c.IsLocalhost ? null : new[] { "Its pairing token is deleted: adding it again needs the engine's PIN." },
            ConfirmLabel = "Remove",
            Destructive = true,
        });
        if (!ok) return;
        try
        {
            if (c.BearerTokenWrappedRef != null) await Vault.RemoveAsync(c.Id);
            await Connections.RemoveAsync(c.Id);
            Notifications.Notify($"Removed the engine connection “{c.Name}”.", NotificationKind.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
            StateHasChanged();
        }
    }

    /// <summary>Spec 041 (FR-057): pair again with a new PIN; the new token replaces the stored one.</summary>
    private async Task RepairAsync(EngineConnection c)
    {
        // Review WEB-03: the new token could not be stored; ask for no PIN the engine would spend for nothing.
        if (!_secureStorage)
        {
            _lastError = InsecurePairingMessage;
            StateHasChanged();
            return;
        }
        var pin = await Dialogs.PromptAsync(new PromptRequest
        {
            Title = "Re-pair engine",
            Message = $"Enter the pairing PIN of “{c.Name}” ({c.Host}:{c.Port}). It is in %ProgramData%\\AKML SQL Web\\pairing-pin.txt on that computer.",
            Label = "Pairing PIN",
            ConfirmLabel = "Re-pair",
            Validate = v => string.IsNullOrWhiteSpace(v) ? "Enter the PIN." : null,
        });
        if (string.IsNullOrWhiteSpace(pin)) return;
        _lastError = null;
        _diagnosis = null;
        try
        {
            var response = await Bridge.ConnectAsync(c, bearerToken: null, pairingPin: pin.Trim(), CancellationToken.None);
            if (response.Status != HandshakeStatus.Ok)
            {
                _lastError = $"The engine refused the PIN: {response.Status} — {response.ErrorMessage}";
                StateHasChanged();
                return;
            }
            if (!string.IsNullOrEmpty(response.NewBearerToken))
            {
                if (c.BearerTokenWrappedRef != null) await Vault.RemoveAsync(c.Id);
                c.BearerTokenWrappedRef = await Vault.StoreAsync(c.Id, response.NewBearerToken!, DateTimeOffset.UtcNow.AddDays(60));
            }
            c.LastConnectedAt = DateTimeOffset.UtcNow;
            c.LastKnownEngineVersion = response.EngineVersion;
            c.LastKnownCapabilities = response.EngineCapabilities;
            await Connections.UpdateAsync(c);
            await Connections.SetActiveIdAsync(c.Id);
            Notifications.Notify($"Paired again with “{c.Name}”.", NotificationKind.Success);
            await ReloadAsync();
        }
        catch (Exception ex) when (IsSocketFailure(ex))
        {
            _diagnosis = EngineConnectDiagnosis.For(c.Host, c.Port, ex);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _lastError = EngineConnectDiagnosis.FirstLine(ex.Message);
            StateHasChanged();
        }
    }

    private sealed class AddForm
    {
        public string Name { get; set; } = string.Empty;
        public string Host { get; set; } = "127.0.0.1";
        // Default to the engine bridge's default port (BridgeOptions.Port / installer /WEB_PORT),
        // so accepting the pre-filled value just works against a default install. (Was 5081, which
        // matched nothing the engine listens on.)
        public int Port { get; set; } = EngineEndpoint.DefaultPort;
        public string PairingPin { get; set; } = string.Empty;
    }
}
