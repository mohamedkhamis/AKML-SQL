@*
    Spec 021 (web edition) -- M3 task T070. Connection picker:
      * Lists EngineConnection records (Localhost + LAN)
      * Add: host / port / PIN form; on submit, performs WSS handshake + stores
        wrapped bearer + sets active
      * Edit / Remove
      * TLS fingerprint pinning per contracts/pairing-flow.md is recorded on first
        successful LAN connect; subsequent mismatches surface a "Engine certificate
        changed -- re-pair?" prompt (handled inside EngineBridge.ConnectAsync today;
        UI dialog lands with the M4 installer cert work).
*@
@using AkmlSql.Web.Services
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Core.Ipc
@inject IConnectionStore Connections
@inject IPairingTokenVault Vault
@inject IEngineBridge Bridge
@inject ISchemaSync SchemaSync
@inject IDiagnosticsRingBuffer Diagnostics

<div class="akml-connections">
    <div class="akml-connections-header">
        <h3>Engine connections</h3>
        <button class="akml-tool-button" @onclick="ShowAddDialog">Add</button>
    </div>

    @if (_connections == null || _connections.Count == 0)
    {
        <p class="akml-connections-empty">
            No connections yet. Click <b>Add</b> to pair with a local or LAN engine.
        </p>
    }
    else
    {
        <ul class="akml-connections-list">
            @foreach (var c in _connections)
            {
                <li class="akml-connections-row @(c.Id == _activeId ? "akml-connections-row-active" : "")">
                    <span class="akml-connections-name">@c.Name</span>
                    <span class="akml-connections-host">@c.Host:@c.Port</span>
                    <span class="akml-connections-badge">@(c.IsLocalhost ? "Local" : "LAN")</span>
                    <button class="akml-tool-button" @onclick="@(() => ConnectAsync(c))">Connect</button>
                    <button class="akml-tool-button" @onclick="@(() => RemoveAsync(c))">Remove</button>
                </li>
            }
        </ul>
    }

    @if (_showAdd)
    {
        <div class="akml-connections-dialog">
            <h4>Add connection</h4>
            <label>Name <input @bind="_form.Name" /></label>
            <label>Host <input @bind="_form.Host" placeholder="127.0.0.1 or fqdn" /></label>
            <label>Port <input type="number" min="1024" max="65535" @bind="_form.Port" /></label>
            <label>
                <input type="checkbox" @bind="_form.IsLocalhost" /> Localhost (no PIN required)
            </label>
            @if (!_form.IsLocalhost)
            {
                <label>Pairing PIN <input @bind="_form.PairingPin" placeholder="6-digit PIN from installer" /></label>
            }
            <div class="akml-connections-dialog-buttons">
                <button class="akml-tool-button" @onclick="SubmitAddAsync">Pair</button>
                <button class="akml-tool-button" @onclick="() => _showAdd = false">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(_lastError))
            {
                <p class="akml-connections-error">@_lastError</p>
            }
        </div>
    }
</div>

<style>
    .akml-connections { padding: var(--akml-scalar-spacing-m); max-width: 720px; }
    .akml-connections-header { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); }
    .akml-connections-empty { color: var(--akml-text-secondary); font-style: italic; }
    .akml-connections-list { list-style: none; padding: 0; margin: var(--akml-scalar-spacing-m) 0; }
    .akml-connections-row {
        display: grid;
        grid-template-columns: 1fr 200px 50px auto auto;
        gap: var(--akml-scalar-spacing-s);
        align-items: center;
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        border-bottom: 1px solid var(--akml-border-subtle);
    }
    .akml-connections-row-active { background-color: var(--akml-surface-hover); }
    .akml-connections-name { font-weight: bold; }
    .akml-connections-host { color: var(--akml-text-secondary); font-family: var(--akml-type-editor-family); }
    .akml-connections-badge {
        font-size: 11px;
        padding: 0 var(--akml-scalar-spacing-xs);
        background-color: var(--akml-status-info);
        color: var(--akml-text-onaccent);
        border-radius: 2px;
        text-align: center;
    }
    .akml-connections-dialog {
        margin-top: var(--akml-scalar-spacing-l);
        padding: var(--akml-scalar-spacing-m);
        background-color: var(--akml-surface-panel);
        border: 1px solid var(--akml-border-default);
        border-radius: 4px;
    }
    .akml-connections-dialog label { display: block; margin-bottom: var(--akml-scalar-spacing-s); }
    .akml-connections-dialog input {
        margin-left: var(--akml-scalar-spacing-xs);
        background-color: var(--akml-surface-canvas);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default);
        padding: var(--akml-scalar-spacing-xs);
    }
    .akml-connections-dialog-buttons {
        display: flex;
        gap: var(--akml-scalar-spacing-s);
        margin-top: var(--akml-scalar-spacing-s);
    }
    .akml-connections-error { color: var(--akml-status-danger); margin-top: var(--akml-scalar-spacing-s); }
    .akml-tool-button {
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel); color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default); border-radius: 3px;
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer;
    }
    .akml-tool-button:hover { background-color: var(--akml-surface-hover); }
</style>

@code {
    private IReadOnlyList<EngineConnection>? _connections;
    private string? _activeId;
    private bool _showAdd;
    private AddForm _form = new();
    private string? _lastError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _connections = await Connections.ListAsync();
        _activeId = await Connections.GetActiveIdAsync();
        StateHasChanged();
    }

    private void ShowAddDialog()
    {
        _form = new AddForm();
        _lastError = null;
        _showAdd = true;
    }

    private async Task SubmitAddAsync()
    {
        _lastError = null;
        try
        {
            var connection = new EngineConnection
            {
                Id = Guid.NewGuid().ToString(),
                Name = string.IsNullOrEmpty(_form.Name) ? _form.Host : _form.Name,
                Host = _form.Host,
                Port = _form.Port,
                IsLocalhost = _form.IsLocalhost,
            };

            // Attempt the handshake first. On localhost we skip the PIN; on LAN we send it.
            var response = await Bridge.ConnectAsync(
                connection, bearerToken: null, pairingPin: _form.IsLocalhost ? null : _form.PairingPin,
                CancellationToken.None);

            if (response.Status != HandshakeStatus.Ok)
            {
                _lastError = $"Engine rejected the handshake: {response.Status} -- {response.ErrorMessage}";
                Diagnostics.Log(DiagnosticLevel.Warn, "connections", _lastError);
                return;
            }

            // Persist the bearer token (LAN only -- localhost handshake returns null).
            if (!string.IsNullOrEmpty(response.NewBearerToken))
            {
                connection.BearerTokenWrappedRef = await Vault.StoreAsync(
                    connection.Id, response.NewBearerToken!, DateTimeOffset.UtcNow.AddDays(60));
            }
            connection.LastConnectedAt = DateTimeOffset.UtcNow;
            connection.LastKnownEngineVersion = response.EngineVersion;
            connection.LastKnownCapabilities = response.EngineCapabilities;

            await Connections.AddAsync(connection);
            await Connections.SetActiveIdAsync(connection.Id);

            // T109 follow-up Issue 2: after handshake, ask the engine which
            // (server, database) its current session is on, and if it has one,
            // start the SchemaSync polling loop so Phase A/B blobs flow into the
            // browser cache.
            await TryStartSchemaSyncAsync(connection.Id);

            _showAdd = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "connections", _lastError, new { Exception = ex.GetType().Name });
        }
    }

    private async Task ConnectAsync(EngineConnection c)
    {
        _lastError = null;
        try
        {
            string? bearer = null;
            if (!c.IsLocalhost)
            {
                bearer = await Vault.RetrieveAsync(c.Id);
            }
            var response = await Bridge.ConnectAsync(c, bearer, pairingPin: null, CancellationToken.None);
            if (response.Status == HandshakeStatus.Ok)
            {
                await Connections.SetActiveIdAsync(c.Id);
                c.LastConnectedAt = DateTimeOffset.UtcNow;
                c.LastKnownEngineVersion = response.EngineVersion;
                c.LastKnownCapabilities = response.EngineCapabilities;
                await Connections.UpdateAsync(c);
                await TryStartSchemaSyncAsync(c.Id);
                await ReloadAsync();
            }
            else
            {
                _lastError = $"Handshake declined: {response.Status} -- {response.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
        }
        StateHasChanged();
    }

    /// <summary>
    /// T109 follow-up Issue 2: post-handshake schema initialisation.
    ///
    /// Sends <see cref="SchemaIdentifyRequest"/> to resolve the canonical (server, db)
    /// pair the engine sees on this session, then starts <see cref="ISchemaSync"/>
    /// which immediately fires its first poll (no 30 s wait). The sync's
    /// PollOnceAsync detects checksum drift versus the cached snapshot (initially:
    /// "" vs the engine's current checksum), fetches Phase A synchronously, and
    /// fire-and-forgets Phase B.
    ///
    /// <para>Known limitation: today the engine only has an active session when a
    /// <see cref="MessageTypes.ConnectionChanged"/> message has populated it. The
    /// web edition doesn't yet have UI for "connect to SQL Server" — that lives on
    /// the shell extension. Until the browser grows that affordance, SchemaIdentify
    /// returns HasConnection = false here and we log the reason. The architectural
    /// piece is in place so the moment a connect-to-SQL UI lands, IntelliSense
    /// starts flowing automatically.</para>
    ///
    /// <para><b>TODO (PR #236 review):</b> we pass <paramref name="connectionId"/>
    /// (a browser-minted GUID from <c>EngineConnection.Id</c>) as the engine's
    /// <c>SessionId</c>. The engine's existing handlers look it up in
    /// <c>SessionManager.GetSession(sessionId)</c>, which only contains sessions
    /// the shell extension registered via <c>ConnectionChanged</c>. Until the
    /// browser sends <c>ConnectionChanged</c> too — OR the engine starts assigning
    /// a session id at handshake and echoing it back to the browser — this id will
    /// never match a real engine session, and SchemaIdentify will always report
    /// HasConnection=false. When the connect-to-SQL UI lands, decide which side
    /// owns the session-id source of truth before wiring more bridge calls.</para>
    /// </summary>
    private async Task TryStartSchemaSyncAsync(string connectionId)
    {
        // Reset any previous sync before starting a new one — we may be switching
        // engines mid-session.
        await SchemaSync.StopAsync();

        SchemaIdentifyResponse identify;
        try
        {
            identify = await Bridge.SendAsync<SchemaIdentifyRequest, SchemaIdentifyResponse>(
                MessageTypes.SchemaIdentifyRequest,
                new SchemaIdentifyRequest { SessionId = connectionId },
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "connections",
                $"SchemaIdentify failed: {ex.Message}");
            return;
        }

        if (!identify.HasConnection)
        {
            Diagnostics.Log(DiagnosticLevel.Info, "connections",
                $"Engine has no active SQL session yet — schema fallback stays empty. {identify.ErrorMessage}");
            return;
        }

        await SchemaSync.StartAsync(connectionId, identify.ServerCanonicalIdentity, identify.DatabaseName);
        Diagnostics.Log(DiagnosticLevel.Info, "connections",
            $"Schema sync started for {identify.ServerCanonicalIdentity}/{identify.DatabaseName}.");
    }

    private async Task RemoveAsync(EngineConnection c)
    {
        try
        {
            if (c.BearerTokenWrappedRef != null) await Vault.RemoveAsync(c.Id);
            await Connections.RemoveAsync(c.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _lastError = ex.Message;
            StateHasChanged();
        }
    }

    private sealed class AddForm
    {
        public string Name { get; set; } = string.Empty;
        public string Host { get; set; } = "127.0.0.1";
        public int Port { get; set; } = 5081;
        public bool IsLocalhost { get; set; } = true;
        public string PairingPin { get; set; } = string.Empty;
    }
}
