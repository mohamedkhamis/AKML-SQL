@*
    Spec 021 (web edition) -- M2 task T039. Profile picker:
      * Built-in profiles (read-only)
      * User profiles (editable / deletable)
      * Import via <InputFile>; export via Blob + download link

    Built-in profile ids start with "builtin." -- the store rejects writes to those.
*@
@using AkmlSql.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IProfileStore ProfileStore
@inject IDialogService Dialogs
@implements IDisposable

<div class="akml-profile-picker">
    @* Spec 041 (FR-054): "Style", the word Settings › Format and the Format styles page use. *@
    <label for="@_selectId" class="akml-profile-label">Style</label>
    <select id="@_selectId" class="akml-profile-select" data-testid="profile-picker" value="@_activeId" @onchange="OnSelectionChanged">
        @if (_profiles != null)
        {
            @if (_profiles.Any(p => p.Location == ProfileLocation.Engine) || _unlistedEngineStyle != null)
            {
                @* Spec 041 (FR-063): "Shared with SSMS" only when SSMS started the engine. *@
                <optgroup label="@ProfileStore.EngineStylesGroupName">
                    @foreach (var p in _profiles.Where(p => p.Location == ProfileLocation.Engine))
                    {
                        <option value="@p.Id">@OptionText(p)</option>
                    }
                    @if (_unlistedEngineStyle != null)
                    {
                        <option value="@_activeId" data-testid="profile-unlisted">@_unlistedEngineStyle (engine not answering)</option>
                    }
                </optgroup>
            }
            @if (_profiles.Any(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.BuiltIn))
            {
                <optgroup label="Built-in">
                    @foreach (var p in _profiles.Where(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.BuiltIn))
                    {
                        <option value="@p.Id">@OptionText(p)</option>
                    }
                </optgroup>
            }
            @if (_profiles.Any(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.User))
            {
                <optgroup label="User">
                    @foreach (var p in _profiles.Where(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.User))
                    {
                        <option value="@p.Id">@OptionText(p)</option>
                    }
                </optgroup>
            }
            @if (_profiles.Any(p => p.Origin == ProfileOrigin.SqlPromptImport))
            {
                <optgroup label="SQL Prompt">
                    @foreach (var p in _profiles.Where(p => p.Origin == ProfileOrigin.SqlPromptImport))
                    {
                        <option value="@p.Id">@OptionText(p)</option>
                    }
                </optgroup>
            }
        }
    </select>

    @* Built-in profiles are non-deletable. *@
    @if (_active != null && _active.Origin != ProfileOrigin.BuiltIn)
    {
        <button type="button" class="akml-btn akml-btn--destructive" @onclick="DeleteActiveAsync" title="Delete this style">Delete…</button>
    }
    <a class="akml-btn" href="/styles" title="Edit formatting styles (SQL Prompt style editor)" data-testid="profile-edit-styles">Edit…</a>
</div>

<style>
    .akml-profile-picker {
        display: inline-flex;
        align-items: center;
        gap: var(--akml-scalar-spacing-xs);
    }
    .akml-profile-label {
        font-size: var(--akml-type-chrome-size);
        color: var(--akml-text-secondary);
    }
    .akml-profile-select {
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs);
        min-width: 200px;
    }
</style>

@code {
    [Parameter] public EventCallback<ProfileRecord> OnProfileChanged { get; set; }

    private readonly string _selectId = $"akml-profile-{Guid.NewGuid():N}";
    private IReadOnlyList<ProfileRecord>? _profiles;
    private string _activeId = "builtin.khamis";
    private ProfileRecord? _active;

    // The active id this picker last resolved (null until the first load). The editor loads the
    // active style itself at mount, so the first load does not notify; after that, any reload that
    // resolves a DIFFERENT style -- the engine connecting and its style becoming active, or the
    // engine going away and the default taking over -- tells the editor, so Format never uses a
    // style other than the one the dropdown shows.
    private string? _resolvedId;

    // The active engine style's name while the engine cannot list its styles (first load, no
    // earlier list to fall back on): shown as it is, rather than falling back to another style
    // and telling the editor to switch to it.
    private string? _unlistedEngineStyle;

    protected override async Task OnInitializedAsync()
    {
        ProfileStore.StylesChanged += OnStylesChanged;
        await ReloadAsync();
    }

    private void OnStylesChanged() => _ = InvokeAsync(ReloadAsync);

    /// <summary>
    /// Spec 041 (FR-084): a closed select shows only the option's text, so a name used in two groups says which:
    /// "Khamis Style (built-in)" beside "Khamis Style (on this engine)". A unique name is shown as it is.
    /// </summary>
    private string OptionText(ProfileRecord p)
    {
        if (_profiles == null || _profiles.Count(o => string.Equals(o.Name, p.Name, StringComparison.OrdinalIgnoreCase)) < 2) return p.Name;
        var group = p.Location == ProfileLocation.Engine ? (ProfileStore.EngineStylesGroupName == "Shared with SSMS" ? "shared with SSMS" : "on this engine")
            : p.Origin == ProfileOrigin.BuiltIn ? "built-in"
            : p.Origin == ProfileOrigin.SqlPromptImport ? "SQL Prompt"
            : "in this browser";
        return $"{p.Name} ({group})";
    }

    public void Dispose() => ProfileStore.StylesChanged -= OnStylesChanged;

    private async Task ReloadAsync()
    {
        _profiles = await ProfileStore.ListAsync();
        _activeId = await ProfileStore.GetActiveIdAsync();
        _active = _profiles.FirstOrDefault(p => p.Id == _activeId);
        _unlistedEngineStyle = null;
        if (_active == null && _activeId.StartsWith("engine:", StringComparison.Ordinal) && ProfileStore.EngineStylesError != null)
        {
            // The engine is there but did not list its styles: the active style has not gone, it
            // just could not be listed. Keep it; nothing changes for the editor.
            _unlistedEngineStyle = _activeId["engine:".Length..];
            StateHasChanged();
            return;
        }
        _active ??= _profiles.FirstOrDefault();
        if (_active != null && _active.Id != _activeId)
        {
            _activeId = _active.Id;
        }

        var changed = _resolvedId != null && _resolvedId != _activeId;
        // Recorded before any await: a second reload running meanwhile (StylesChanged fires often)
        // then sees no change and does not notify twice.
        _resolvedId = _activeId;
        StateHasChanged();
        if (changed && _active != null) await NotifyAsync(_active);
    }

    /// <summary>
    /// Hands the editor the whole style: engine styles are listed by name only. Reading one can
    /// take a while; if another style was chosen meanwhile, this one is stale and is dropped —
    /// otherwise it would land after the newer choice and Format would use a style the dropdown
    /// no longer shows.
    /// </summary>
    private async Task NotifyAsync(ProfileRecord record)
    {
        try
        {
            var full = record.IsSummary ? await ProfileStore.GetAsync(record.Id) : record;
            if (full == null || record.Id != _activeId) return;
            await OnProfileChanged.InvokeAsync(full);
        }
        catch (Exception)
        {
            // The engine went away while the style was being read; the next StylesChanged reload
            // resolves the style that is active then.
        }
    }

    private async Task OnSelectionChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString() ?? "builtin.default";
        if (newId == _activeId) return;

        _activeId = newId;
        _resolvedId = newId;
        await ProfileStore.SetActiveIdAsync(newId);
        _active = _profiles?.FirstOrDefault(p => p.Id == newId);
        if (_active != null) await NotifyAsync(_active);
    }

    private async Task DeleteActiveAsync()
    {
        if (_active == null || _active.Origin == ProfileOrigin.BuiltIn) return;

        // Spec 041 (FR-054, FR-102): the in-app confirmation, naming the style.
        var confirmed = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Delete style",
            Message = $"Delete the style “{_active.Name}”? Format SQL goes back to the default style.",
            ConfirmLabel = "Delete",
            Destructive = true,
        });
        if (!confirmed) return;

        await ProfileStore.DeleteAsync(_active.Id);
        // Back to the store's default — the same one Settings › Format and Restore defaults use.
        await ProfileStore.ResetActiveAsync();
        // The active style changes, so the reload notifies the editor (with the full style).
        await ReloadAsync();
    }
}
