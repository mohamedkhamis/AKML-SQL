@*
    Spec 021 (web edition) -- M2 task T039. Profile picker:
      * Built-in profiles (read-only)
      * User profiles (editable / deletable)
      * Import via <InputFile>; export via Blob + download link

    Built-in profile ids start with "builtin." -- the store rejects writes to those.
*@
@using AkmlSql.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IProfileStore ProfileStore
@inject IJSRuntime JS
@implements IDisposable

<div class="akml-profile-picker">
    <label for="@_selectId" class="akml-profile-label">Profile</label>
    <select id="@_selectId" class="akml-profile-select" data-testid="profile-picker" value="@_activeId" @onchange="OnSelectionChanged">
        @if (_profiles != null)
        {
            @if (_profiles.Any(p => p.Location == ProfileLocation.Engine))
            {
                <optgroup label="Shared with SSMS">
                    @foreach (var p in _profiles.Where(p => p.Location == ProfileLocation.Engine))
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </optgroup>
            }
            <optgroup label="Built-in">
                @foreach (var p in _profiles.Where(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.BuiltIn))
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </optgroup>
            @if (_profiles.Any(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.User))
            {
                <optgroup label="User">
                    @foreach (var p in _profiles.Where(p => p.Location == ProfileLocation.Browser && p.Origin == ProfileOrigin.User))
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </optgroup>
            }
            @if (_profiles.Any(p => p.Origin == ProfileOrigin.SqlPromptImport))
            {
                <optgroup label="SQL Prompt">
                    @foreach (var p in _profiles.Where(p => p.Origin == ProfileOrigin.SqlPromptImport))
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </optgroup>
            }
        }
    </select>

    @* Built-in profiles are non-deletable. *@
    @if (_active != null && _active.Origin != ProfileOrigin.BuiltIn)
    {
        <button class="akml-profile-button" @onclick="DeleteActiveAsync" title="Delete profile">Delete</button>
    }
    <a class="akml-profile-button" href="/styles" title="Edit formatting styles (SQL Prompt style editor)" data-testid="profile-edit-styles">Edit…</a>
</div>

<style>
    .akml-profile-picker {
        display: inline-flex;
        align-items: center;
        gap: var(--akml-scalar-spacing-xs);
    }
    .akml-profile-label {
        font-size: var(--akml-type-chrome-size);
        color: var(--akml-text-secondary);
    }
    .akml-profile-select {
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs);
        min-width: 200px;
    }
    .akml-profile-button {
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
        background-color: transparent;
        color: var(--akml-text-secondary);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        cursor: pointer;
    }
    .akml-profile-button:hover {
        background-color: var(--akml-surface-hover);
        color: var(--akml-text-primary);
    }
</style>

@code {
    [Parameter] public EventCallback<ProfileRecord> OnProfileChanged { get; set; }

    private readonly string _selectId = $"akml-profile-{Guid.NewGuid():N}";
    private IReadOnlyList<ProfileRecord>? _profiles;
    private string _activeId = "builtin.khamis";
    private ProfileRecord? _active;

    // The active id this picker last resolved (null until the first load). The editor loads the
    // active style itself at mount, so the first load does not notify; after that, any reload that
    // resolves a DIFFERENT style -- the engine connecting and its style becoming active, or the
    // engine going away and the default taking over -- tells the editor, so Format never uses a
    // style other than the one the dropdown shows.
    private string? _resolvedId;

    protected override async Task OnInitializedAsync()
    {
        ProfileStore.StylesChanged += OnStylesChanged;
        await ReloadAsync();
    }

    private void OnStylesChanged() => _ = InvokeAsync(ReloadAsync);

    public void Dispose() => ProfileStore.StylesChanged -= OnStylesChanged;

    private async Task ReloadAsync()
    {
        _profiles = await ProfileStore.ListAsync();
        _activeId = await ProfileStore.GetActiveIdAsync();
        _active = _profiles.FirstOrDefault(p => p.Id == _activeId) ?? _profiles.FirstOrDefault();
        if (_active != null && _active.Id != _activeId)
        {
            _activeId = _active.Id;
        }

        var changed = _resolvedId != null && _resolvedId != _activeId;
        // Recorded before any await: a second reload running meanwhile (StylesChanged fires often)
        // then sees no change and does not notify twice.
        _resolvedId = _activeId;
        StateHasChanged();
        if (changed && _active != null) await NotifyAsync(_active);
    }

    /// <summary>Hands the editor the whole style: engine styles are listed by name only.</summary>
    private async Task NotifyAsync(ProfileRecord record)
    {
        try
        {
            var full = record.IsSummary ? await ProfileStore.GetAsync(record.Id) : record;
            if (full != null) await OnProfileChanged.InvokeAsync(full);
        }
        catch (Exception)
        {
            // The engine went away while the style was being read; the next StylesChanged reload
            // resolves the style that is active then.
        }
    }

    private async Task OnSelectionChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString() ?? "builtin.default";
        if (newId == _activeId) return;

        _activeId = newId;
        _resolvedId = newId;
        await ProfileStore.SetActiveIdAsync(newId);
        _active = _profiles?.FirstOrDefault(p => p.Id == newId);
        if (_active != null) await NotifyAsync(_active);
    }

    private async Task DeleteActiveAsync()
    {
        if (_active == null || _active.Origin == ProfileOrigin.BuiltIn) return;

        // Lightweight confirm via JS to keep the UI clean -- a real modal lands with the
        // Settings page redesign.
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete profile '{_active.Name}'?");
        if (!confirmed) return;

        await ProfileStore.DeleteAsync(_active.Id);
        await ProfileStore.SetActiveIdAsync("builtin.default");
        // The active style changes, so the reload notifies the editor (with the full style).
        await ReloadAsync();
    }
}
