@*
    Spec 027 (M5 offline closure) T021 (US3) — input dialog for heavyweight refactorings.
    Smart Rename collects OriginalIdentifier + NewName; Extract Procedure collects a unit
    name; Parameterize Values needs no extra input. The parent wires the collected values
    into a RefactorPreviewRequest and runs the bridge preview/apply.
*@

<div class="akml-scrim" @onclick="OnCancel" data-testid="refactor-input">
    <div class="akml-dialog akml-rid" role="dialog" aria-modal="true" aria-labelledby="akml-rid-title" @onclick:stopPropagation="true">
        <div class="akml-dialog-header"><h2 class="akml-dialog-title" id="akml-rid-title">@Title</h2></div>
        <div class="akml-dialog-body">
            @if (NeedsOriginalIdentifier)
            {
                <div class="akml-field">
                    <label class="akml-field-label" for="akml-rid-original">Identifier to rename</label>
                    <input id="akml-rid-original" class="akml-input" data-testid="rid-original" value="@_original"
                           @oninput="@(e => _original = e.Value?.ToString() ?? "")" />
                </div>
            }
            @if (NeedsNewName)
            {
                <div class="akml-field">
                    <label class="akml-field-label" for="akml-rid-newname">New name</label>
                    <input id="akml-rid-newname" class="akml-input" data-testid="rid-newname" value="@_newName"
                           @oninput="@(e => _newName = e.Value?.ToString() ?? "")" />
                </div>
            }
            @if (NeedsUnitName)
            {
                <div class="akml-field">
                    <label class="akml-field-label" for="akml-rid-unitname">Procedure name</label>
                    <input id="akml-rid-unitname" class="akml-input" data-testid="rid-unitname" value="@_unitName"
                           @oninput="@(e => _unitName = e.Value?.ToString() ?? "")" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="akml-field-error" role="alert">@_error</p>
            }
        </div>
        <div class="akml-dialog-footer">
            <button type="button" class="akml-btn" @onclick="OnCancel">Cancel</button>
            <button type="button" class="akml-btn akml-btn--primary" data-testid="rid-preview" @onclick="SubmitAsync">Preview</button>
        </div>
    </div>
</div>


@code {
    /// <summary>Dialog title (the operation name).</summary>
    [Parameter] public string Title { get; set; } = "Refactor";

    /// <summary>Show the "identifier to rename" field (Smart Rename).</summary>
    [Parameter] public bool NeedsOriginalIdentifier { get; set; }

    /// <summary>Show the "new name" field (Smart Rename).</summary>
    [Parameter] public bool NeedsNewName { get; set; }

    /// <summary>Show the "procedure name" field (Extract Procedure).</summary>
    [Parameter] public bool NeedsUnitName { get; set; }

    /// <summary>Raised with the collected inputs when the user clicks Preview.</summary>
    [Parameter] public EventCallback<RefactorInputs> OnSubmit { get; set; }

    /// <summary>Raised on Cancel / overlay click.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _original = string.Empty;
    private string _newName = string.Empty;
    private string _unitName = string.Empty;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (NeedsOriginalIdentifier && string.IsNullOrWhiteSpace(_original))
        {
            _error = "Enter the identifier to rename.";
            return;
        }
        if (NeedsNewName && string.IsNullOrWhiteSpace(_newName))
        {
            _error = "Enter the new name.";
            return;
        }
        if (NeedsUnitName && string.IsNullOrWhiteSpace(_unitName))
        {
            _error = "Enter the procedure name.";
            return;
        }
        await OnSubmit.InvokeAsync(new RefactorInputs(_original.Trim(), _newName.Trim(), _unitName.Trim()));
    }

    /// <summary>The values a heavyweight refactoring dialog collects.</summary>
    public sealed record RefactorInputs(string OriginalIdentifier, string NewName, string ExtractedUnitName);
}
