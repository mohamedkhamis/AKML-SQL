@code {
    private bool _open;

    // Spec 043 (T056): the query tab session this opening connects (the tab whose run asked, else the active tab's), and
    // whether it did — the run that opened the dialog goes on only after a successful connect.
    private SqlSessionState? _target;
    private bool _connected;

    private SqlSessionState? TargetSession => _target ?? SqlConn.ActiveSession;
    private bool _busy;
    private bool _focusOnNextRender;

    private ElementReference _panelRef;
    private IJSObjectReference? _module;

    // Saved-connection list + the currently-selected saved row (null = unsaved "new" form).
    private List<SavedSqlConnection> _saved = new();
    private string? _selectedId;

    // Spec 042: the kind the form is for. A saved row brings its own; "New" starts as SQL Server unless the opener asked.
    // Optional: a host (or test) with no bridge in its services still gets the notice, just without the engine's version.
    private IEngineBridge? PairedEngine => Services.GetService(typeof(IEngineBridge)) as IEngineBridge;

    private const string PostgresDisabledTooltip = "Requires an engine with PostgreSQL support (dialect.postgresql.v1)";
    private DatabaseKind _kind = DatabaseKind.SqlServer;
    private string _pgHost = string.Empty;
    private int? _pgPort = SavedSqlConnection.DefaultPostgresPort;
    private string _pgDatabase = "postgres";
    private string _pgUser = string.Empty;
    private string _pgPassword = string.Empty;   // transient, like the SQL password: never persisted
    private string _pgSslMode = "prefer";
    private string _pgRootCert = string.Empty;
    private bool _pgRemember;
    private bool _pgHasRemembered;                // the engine holds a password for this host, port and user (FR-105)

    // Form state. Password is transient — never persisted.
    private string _name = string.Empty;
    private string _server = "localhost";
    private string _database = "master";
    private bool _windowsAuth = true;
    private string _login = string.Empty;
    private string _password = string.Empty;
    private bool _trustServerCertificate;
    private bool _sqlRemember;                    // spec 043 follow-up: keep the SQL login's password on the engine machine
    private bool _sqlHasRememberedFlag;           // the engine holds a password for _sqlRememberedFor
    private string? _sqlRememberedFor;            // the server and login that answer was about

    // Review, round 3: the effective certificate choice is part of it — the engine answers for the password it would fill into a
    // connection with that choice (a server on the engine's machine is always trusted, so the checkbox changes nothing there).
    private string SqlIdentityKey => (_server ?? string.Empty).Trim().ToLowerInvariant() + "|" + (_login ?? string.Empty).Trim().ToLowerInvariant()
        + "|" + (ConnectionBinding.EffectiveTrust(_server, _trustServerCertificate) ? "trust" : "validate");

    // The engine's answer counts only for the server, login and certificate choice it was asked about: one edited since has none yet.
    private bool _sqlHasRemembered
    {
        get => _sqlHasRememberedFlag && _sqlRememberedFor == SqlIdentityKey;
        set { _sqlHasRememberedFlag = value; _sqlRememberedFor = value ? SqlIdentityKey : null; }
    }

    // Review, round 2: the user's change to the Remember checkbox stands against a later answer about a remembered password.
    // Review, round 4: any change since the form was loaded (SelectSaved, NewConnection, the kind switch; the prefill goes through
    // the first two), not only one made while the engine was being asked — an untick before the question (then the trust choice
    // or the login changed, and back) is the user's choice too, so the box is never ticked for them again. A load resets it.
    private bool _sqlRememberChosen;

    // SQL authentication can go without a typed password when the engine remembers one and Remember is on (review: unticked,
    // the password is typed — the engine's copy is not used, and a connect then forgets it), or when the tab was opened from a
    // connected tab whose password the engine can copy.
    private bool SqlPasswordMissing => !_windowsAuth && string.IsNullOrEmpty(_password) && !UsesRememberedSqlPassword && !CanCopySqlPassword;

    // The engine holds a password for this server and login, and the form uses it — unless the tab being connected is missing its
    // password for this sign-in (review, round 2; round 3: PasswordMissingForForm).
    private bool UsesRememberedSqlPassword => _sqlHasRemembered && _sqlRemember && !PasswordMissingForForm;

    // The connection the form names, without the password (compared with a tab's binding; never sent). Review, round 3: with its
    // certificate choices, which decide whether another tab's password may be copied into it.
    private ConnectionTarget SqlIdentity() => new(DatabaseKind.SqlServer, _server, _database, WindowsAuth: _windowsAuth, User: _login,
        TrustServerCertificate: _trustServerCertificate);

    private ConnectionTarget PgIdentity() => new(DatabaseKind.PostgreSql, _pgHost, _pgDatabase, User: _pgUser, Port: _pgPort,
        SslMode: _pgSslMode, RootCertificatePath: string.IsNullOrWhiteSpace(_pgRootCert) ? null : _pgRootCert);

    /// <summary>
    /// Spec 043 follow-up (review, round 3): the sign-in the tab being connected is missing its password for — the one its mark
    /// names (<see cref="SqlSessionState.PasswordMissingFor"/>), else its binding. A tab with no binding yet has only the mark: the
    /// Status bar's restore of a remembered login on a fresh page, refused by the server, leaves the tab with no connection.
    /// </summary>
    private ConnectionBinding? MissingPasswordSignIn =>
        TargetSession is { PasswordMissing: true } session ? session.PasswordMissingFor ?? session.Binding : null;

    /// <summary>
    /// Spec 043 follow-up (review, round 2): the tab being connected is missing its password — the server refused the one the
    /// engine supplied (remembered or copied), or the engine had none — and the form still names that sign-in (SQL Server:
    /// server and login; PostgreSQL: host, port and user). The engine's remembered password is then not used: no list, test or
    /// connect goes out without a typed password, so opening the dialog never costs one more refused login (each counts towards
    /// a lockout). Remember stays as it is, so the password typed now replaces the stored one. Another server or login follows
    /// the normal rules. Such a tab has no copy source (the mark drops it). Review, round 3: compared with the mark's own record of
    /// the sign-in (<see cref="MissingPasswordSignIn"/>), so a tab with no binding is covered too.
    /// </summary>
    private bool PasswordMissingForForm =>
        MissingPasswordSignIn is { } signIn
        && signIn.SameSignInAs(_kind == DatabaseKind.PostgreSql ? PgIdentity() : SqlIdentity());

    // Review, round 3: the server refused the password the engine supplied, rather than the engine having none (said differently).
    private bool MissingPasswordRefused => TargetSession?.PasswordRefused == true;

    // Remember is named only where the form offers it (PostgreSQL always; SQL Server with credentials.sqlserver.v1).
    private string MissingPasswordHint
    {
        get
        {
            bool remember = _kind == DatabaseKind.PostgreSql || SqlConn.EngineRemembersSqlServerPasswords;
            return MissingPasswordRefused
                ? "The password the engine had for this login was not accepted. Type the current one" + (remember ? "; with Remember on, it replaces the old one." : ".")
                : "The engine has no password it can use for this login. Type it" + (remember ? "; with Remember on, the engine keeps it." : ".");
        }
    }

    /// <summary>
    /// Spec 043 follow-up (review): a New query tab's dialog tests, lists and connects with the password of the tab it was opened
    /// from (nothing typed). Review, round 2: only on an engine with <c>session.copy.v2</c> (<see cref="ISqlConnectionService.EngineCopiesSessionPasswords"/>),
    /// only while the form names that tab's server and login (the engine would refuse the copy, and then use a password it
    /// remembers instead), and not while the engine remembers a password for the form's login with Remember unticked — the user
    /// has said not to use that one, and a refused copy would fall back to it. Otherwise the password is typed. Review, round 3:
    /// and only with that tab's certificate checking (<see cref="ConnectionBinding.CopiesPasswordTo"/>: the effective "Trust server
    /// certificate"), which the engine's copy requires too — and never for a sign-in whose password is missing.
    /// </summary>
    private bool CanCopySqlPassword =>
        !_windowsAuth && SqlConn.EngineCopiesSessionPasswords && !PasswordMissingForForm
        && CopySourceBinding is { } source && source.CopiesPasswordTo(SqlIdentity())
        && !(_sqlHasRemembered && !_sqlRemember);

    // PostgreSQL's form: the same source, for the same host, port and user (its case too), TLS mode and root certificate.
    private bool CanCopyPgPassword =>
        SqlConn.EngineCopiesSessionPasswords && !PasswordMissingForForm
        && CopySourceBinding is { } source && source.CopiesPasswordTo(PgIdentity());

    // The connection of the tab the one being connected was opened from (New query), while that tab is open. Review, round 4:
    // and connected — the engine copies only from a session that holds a connection, and a tab whose connection was lost keeps
    // its binding (MarkConnectionLost), so the binding alone would offer a password the engine then refuses to copy.
    private ConnectionBinding? CopySourceBinding =>
        TargetSession?.CopyPasswordFrom is { } sourceId && SqlConn.FindSession(sourceId) is { IsConnected: true } source ? source.Binding : null;

    private string? SqlPasswordPlaceholder =>
        UsesRememberedSqlPassword ? "Remembered on the engine machine"
        : CanCopySqlPassword ? "The same as the query tab this one was opened from"
        : null;

    private void OnSqlRememberChanged(ChangeEventArgs e)
    {
        _sqlRemember = e.Value is bool on ? on : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        _sqlRememberChosen = true;
    }

    // Review, round 3: the certificate choice changed. The engine is asked again about a SQL login (its answer follows the
    // certificate checking), and whether another tab's password can be copied follows it (CanCopySqlPassword).
    private async Task OnTrustChanged(ChangeEventArgs e)
    {
        _trustServerCertificate = e.Value is bool on ? on : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        if (_kind == DatabaseKind.SqlServer && !_windowsAuth) await RefreshRememberedAsync();
    }

    // ── PostgreSQL's remembered password (spec 042, FR-105), with the same round 2 rule as SQL Server's ──
    private bool UsesRememberedPgPassword => _pgHasRemembered && !PasswordMissingForForm;

    // Nothing typed for the sign-in whose password is missing: the engine would send the refused one again, or none at all.
    private bool PgPasswordNeeded => PasswordMissingForForm && string.IsNullOrEmpty(_pgPassword);

    private const string PgPasswordNeededText = "Enter the current password for this user (it is not stored in the browser).";

    // Notices that outlive the dialog (it closes on a successful connect). Optional: a host without the service shows none.
    private INotificationService? Notifications => Services.GetService(typeof(INotificationService)) as INotificationService;

    // Spec 043 (FR-028): a SQL Server on the engine's own computer is never validated (SqlConnectionService trusts loopback
    // whatever the flag says), so for such a server the checkbox is disabled and its help says why. The saved value is kept.
    private bool TrustIsMoot => SqlConnectionService.IsLoopbackServer(_server);

    // Database dropdown (spec 030). _databases is the list fetched from the server; the current
    // _database is always kept selectable even when absent from (or ahead of) the fetched list.
    private List<string> _databases = new();
    private bool _dbLoading;
    private string? _dbMessage;

    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        Controller.OpenRequested += OnOpenRequested;
        SqlConn.StateChanged += OnSqlStateChanged;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-connection-manager.js");
    }

    private void OnOpenRequested() => InvokeAsync(async () =>
    {
        // Re-entrant guard: opening while already open must not reset the form.
        if (_open) return;
        _target = Controller.TargetSession;
        _connected = false;
        var prefill = Controller.Prefill;
        _message = null;
        await ReloadAsync();
        // Pre-fill from the active (most-recently-used) saved row, if any.
        var activeId = await Store.GetActiveIdAsync();
        var active = string.IsNullOrEmpty(activeId) ? null : _saved.FirstOrDefault(c => c.Id == activeId);

        // Spec 042 (T064) / spec 043 (contracts/web-ui.md §5; review of US1, findings 28 and 34): a kind asked for decides the
        // form; otherwise the tab being connected does: its connection when it has one (filled in, the password still to type),
        // else SQL Server. The most recently used saved row is shown when it is of that kind.
        var requested = Controller.RequestedKind;
        // A restored tab whose connection needs a password (a run asked): the form reconnects it to exactly where it was.
        bool exact = prefill != null;
        if (prefill == null && requested == null && (_target ?? SqlConn.ActiveSession)?.Binding is { } current) prefill = current.Clone();
        // Spec 043 follow-up (review, round 3): a tab with no connection whose sign-in is missing its password (the Status bar's
        // restore of a remembered login, refused) opens on that sign-in — of either kind — so the form names it and asks for it.
        if (prefill == null && requested == null && TargetSession is { Binding: null, PasswordMissing: true, PasswordMissingFor: { } missing })
            prefill = missing.Clone();
        var kind = requested ?? DatabaseKind.SqlServer;
        if (active != null && active.Kind == kind) SelectSaved(active);
        else NewConnection(kind);
        if (prefill != null) ApplyPrefill(prefill, exact);
        _open = true;
        _focusOnNextRender = true;
        StateHasChanged();

        // Best-effort pre-populate the database dropdown. Windows auth needs no password, so the
        // common localhost/Windows default "just works"; SQL auth waits for the user to enter a
        // password and click refresh. Failures land in _dbMessage, never blocking the dialog.
        if (_kind == DatabaseKind.SqlServer && _windowsAuth)
            await LoadDatabasesAsync();
        else
            await RefreshRememberedAsync();
    });

    private void OnSqlStateChanged() => InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _saved = (await Store.ListAsync()).ToList();
    }

    private void NewConnection() => NewConnection(DatabaseKind.SqlServer);

    private void NewConnection(DatabaseKind kind)
    {
        _selectedId = null;
        _kind = kind == DatabaseKind.PostgreSql && !SqlConn.EngineSupportsPostgres ? DatabaseKind.SqlServer : kind;
        _name = string.Empty;
        _server = "localhost";
        _database = "master";
        _windowsAuth = true;
        _login = string.Empty;
        _password = string.Empty;
        _trustServerCertificate = false;
        _sqlRemember = false;
        _sqlRememberChosen = false;
        _sqlHasRemembered = false;
        ResetPostgresFields();
        _message = null;
        ClearDatabaseList();
    }

    private void ResetPostgresFields()
    {
        _rememberedAsk++;   // a remembered-password answer still on its way is about the form before this reset
        _pgHost = "localhost";
        _pgPort = SavedSqlConnection.DefaultPostgresPort;
        _pgDatabase = "postgres";
        _pgUser = string.Empty;
        _pgPassword = string.Empty;
        _pgSslMode = "prefer";
        _pgRootCert = string.Empty;
        _pgRemember = false;
        _pgHasRemembered = false;
    }

    // The kind switch: the other kind's fields start from their defaults, so nothing typed for one server leaks into the other.
    // A switch is a new connection of the other kind: the selected saved connection's name does not carry over to it.
    private async Task SetKind(DatabaseKind kind)
    {
        if (_kind == kind) return;
        if (kind == DatabaseKind.PostgreSql && !SqlConn.EngineSupportsPostgres) return;
        _rememberedAsk++;   // a remembered-password answer still on its way belongs to the other kind's form
        _kind = kind;
        _message = null;
        if (_selectedId != null) _name = string.Empty;
        _selectedId = null;
        ClearDatabaseList();
        if (kind == DatabaseKind.PostgreSql) ResetPostgresFields();
        else
        {
            _server = "localhost";
            _database = "master";
            _windowsAuth = true;
            _login = string.Empty;
            _password = string.Empty;
            _trustServerCertificate = false;
            _sqlRemember = false;
            _sqlRememberChosen = false;
            _sqlHasRemembered = false;
            await LoadDatabasesAsync();   // Windows authentication needs no password: the list fills as it did on open
        }
    }

    private async Task LoadPgDatabasesAsync()
    {
        // Review, round 2: the password the server refused for this tab is not sent again (see PasswordMissingForForm).
        if (PgPasswordNeeded)
        {
            _dbMessage = "Enter the password, then refresh the database list.";
            return;
        }
        _dbLoading = true;
        _dbMessage = null;
        StateHasChanged();
        try
        {
            var (ok, dbs, error) = await SqlConn.ListDatabasesAsync(PgTarget(), CancellationToken.None);
            if (ok)
            {
                _databases = dbs.ToList();
                _dbMessage = _databases.Count == 0 ? "No databases this role can connect to." : $"{_databases.Count} database(s): type or pick one.";
            }
            else
            {
                _dbMessage = error;
            }
        }
        finally
        {
            _dbLoading = false;
            StateHasChanged();
        }
    }

    // A click on a saved connection: its fields, then - for SQL Server with Windows authentication, which needs no password -
    // its server's database list, as opening the dialog on it does. Without this the list offered only the saved database.
    private async Task OnSavedRowClickAsync(SavedSqlConnection c)
    {
        SelectSaved(c);
        if (c.Kind == DatabaseKind.SqlServer && c.WindowsAuth) await LoadDatabasesAsync();
    }

    /// <summary>
    /// Spec 043: fill the form from a tab's connection. When it is still the saved connection it came from (the same server,
    /// sign-in and security; review of US1, findings 25 and 33), that row is selected: shown as saved when the dialog was simply
    /// opened, so Save never writes the tab's state into it; with the tab's database when a run needs the tab reconnected
    /// (<paramref name="exact"/>). Otherwise the form holds the tab's own values as a new connection — its server, sign-in and
    /// security choices may differ from the row's, and the form must reconnect the tab to the same place — and Save adds a row
    /// instead of changing another.
    /// </summary>
    private void ApplyPrefill(ConnectionBinding b, bool exact)
    {
        var saved = string.IsNullOrEmpty(b.SavedConnectionId) ? null : _saved.FirstOrDefault(c => c.Id == b.SavedConnectionId && c.Kind == b.Kind);
        // A run that reconnects the tab needs its database too: when that is not the row's, the row is not shown as the form's
        // (Save would write the tab's database into it), and the form is the tab's own connection.
        bool sameDatabase = saved != null && string.Equals(
            saved.Database, b.Database, saved.Kind == DatabaseKind.PostgreSql ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase);
        if (saved != null && b.SameConnectionAs(saved) && (!exact || sameDatabase))
        {
            SelectSaved(saved);
            if (!exact || _kind != b.Kind) return;
            if (b.Kind == DatabaseKind.PostgreSql)
            {
                _pgDatabase = b.Database;
                _pgRemember = b.RememberPassword;
                return;
            }
            _database = b.Database;
            _sqlRemember = b.RememberPassword && !b.WindowsAuth;
            if (!string.IsNullOrWhiteSpace(b.Database) && !_databases.Contains(b.Database)) _databases.Add(b.Database);
            return;
        }
        NewConnection(b.Kind);
        if (_kind != b.Kind) return;   // a PostgreSQL connection on an engine that no longer offers PostgreSQL: the empty form
        if (b.Kind == DatabaseKind.PostgreSql)
        {
            _pgHost = b.Server;
            _pgPort = b.Port ?? SavedSqlConnection.DefaultPostgresPort;
            _pgUser = b.Login ?? string.Empty;
            _pgSslMode = b.SslMode ?? "prefer";
            _pgRootCert = b.RootCertificatePath ?? string.Empty;
            _pgRemember = b.RememberPassword;
            _pgDatabase = b.Database;
            return;
        }
        if (_windowsAuth != b.WindowsAuth) ClearDatabaseList();   // the list belongs to the row's sign-in, not the tab's
        _server = b.Server;
        _windowsAuth = b.WindowsAuth;
        _login = b.Login ?? string.Empty;
        _trustServerCertificate = b.TrustServerCertificate;
        _sqlRemember = b.RememberPassword && !b.WindowsAuth;
        _database = b.Database;
        if (!string.IsNullOrWhiteSpace(b.Database) && !_databases.Contains(b.Database)) _databases.Add(b.Database);
    }

    private void SelectSaved(SavedSqlConnection c)
    {
        _selectedId = c.Id;
        _name = c.Name;
        _kind = c.Kind;
        if (c.Kind == DatabaseKind.PostgreSql)
        {
            _pgHost = c.Server;
            _pgPort = c.EffectivePort;
            _pgDatabase = c.Database;
            _pgUser = c.Login ?? string.Empty;
            _pgPassword = string.Empty;   // never stored in the browser
            _pgSslMode = c.SslMode ?? "prefer";
            _pgRootCert = c.RootCertificatePath ?? string.Empty;
            _pgRemember = c.RememberPassword;
            _pgHasRemembered = false;     // asked of the engine once the row is shown
            _message = null;
            ClearDatabaseList();
            _ = InvokeAsync(RefreshRememberedAsync);
            return;
        }

        _server = c.Server;
        _database = c.Database;
        _windowsAuth = c.WindowsAuth;
        _login = c.Login ?? string.Empty;
        _password = string.Empty;   // never stored in the browser — typed, or remembered on the engine machine
        _trustServerCertificate = c.TrustServerCertificate;
        _sqlRemember = c.RememberPassword && !c.WindowsAuth;
        _sqlRememberChosen = false; // a new form: the user has not chosen for it yet
        _sqlHasRemembered = false;  // asked of the engine once the row is shown
        _message = null;
        ClearDatabaseList();
        if (!c.WindowsAuth) _ = InvokeAsync(RefreshRememberedAsync);

        // Spec 032 FR-033 (campaign finding 6): SEED the option list with the saved
        // database so the dropdown deterministically DISPLAYS it. Relying only on the
        // synthetic fallback option raced Blazor's bind/render order and the select
        // showed the browser default ("master") while the BOUND value was correct —
        // display and target must never diverge.
        if (!string.IsNullOrWhiteSpace(c.Database))
            _databases.Add(c.Database);
    }

    // Drops any server-specific database list so a stale list from a different server/auth is never
    // shown. The current _database stays selected (rendered as a synthetic option in the dropdown).
    private void ClearDatabaseList()
    {
        _databases.Clear();
        _dbMessage = null;
    }

    private void SetAuth(bool windows)
    {
        if (_windowsAuth == windows) return;
        _windowsAuth = windows;
        ClearDatabaseList();   // accessible-database set depends on the identity/login
        if (!windows) _ = InvokeAsync(RefreshRememberedAsync);
    }

    // Server edited (on blur/change) — the previous list belongs to a different host, so drop it.
    private async Task OnServerChanged()
    {
        ClearDatabaseList();
        await RefreshRememberedAsync();
    }

    /// <summary>
    /// Fetches the server's databases into the dropdown. SQL auth needs the password first (same as
    /// Test/Connect). Best-effort: on failure the current value stays selectable and a hint explains.
    /// </summary>
    private async Task LoadDatabasesAsync()
    {
        if (SqlPasswordMissing)
        {
            _dbMessage = "Enter the SQL password, then refresh the database list.";
            return;
        }

        _dbLoading = true;
        _dbMessage = null;
        StateHasChanged();
        try
        {
            var (ok, dbs, error) = await SqlConn.ListDatabasesAsync(SqlServerTarget(), CancellationToken.None);

            if (ok)
            {
                _databases = dbs.ToList();
                _dbMessage = _databases.Count == 0 ? "No accessible databases on this server." : null;
            }
            else
            {
                _dbMessage = error;
            }
        }
        finally
        {
            _dbLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>The SQL Server form as a target; the certificate choice travels with it (review WEB-02).</summary>
    // Spec 043 (T056): the saved row the form came from goes with the target, so the tab's binding remembers it.
    private ConnectionTarget SqlServerTarget() => new(DatabaseKind.SqlServer, _server, _database, WindowsAuth: _windowsAuth,
        User: _windowsAuth ? null : _login, Password: _windowsAuth ? null : _password, TrustServerCertificate: _trustServerCertificate,
        RememberPassword: !_windowsAuth && _sqlRemember && SqlConn.EngineRemembersSqlServerPasswords, SavedConnectionId: _selectedId,
        CopyPasswordFrom: string.IsNullOrEmpty(_password) && CanCopySqlPassword ? TargetSession?.CopyPasswordFrom : null);

    // ── PostgreSQL (spec 042) ────────────────────────────────────────────────────────────────────────────

    private ConnectionTarget PgTarget() => new(DatabaseKind.PostgreSql, _pgHost, _pgDatabase, WindowsAuth: false,
        User: _pgUser, Password: _pgPassword, Port: _pgPort, SslMode: _pgSslMode,
        RootCertificatePath: string.IsNullOrWhiteSpace(_pgRootCert) ? null : _pgRootCert, RememberPassword: _pgRemember,
        SavedConnectionId: _selectedId,
        CopyPasswordFrom: string.IsNullOrEmpty(_pgPassword) && CanCopyPgPassword ? TargetSession?.CopyPasswordFrom : null);

    // Spec 043 (T056): the connect goes to the tab that opened the dialog.
    private Task<ConnectResult> ConnectTargetAsync(ConnectionTarget target) =>
        TargetSession is { } session
            ? SqlConn.ConnectAsync(target, session, CancellationToken.None)
            : SqlConn.ConnectAsync(target, CancellationToken.None);

    // Asks the engine whether it holds a password for this host, port and user. Never fetches the password itself.
    // Each question about a remembered password gets a number: a reply to an older one (the host or user changed meanwhile, or
    // a saved row was shown before the tab's own values replaced it) is not the form's answer any more.
    private int _rememberedAsk;

    private async Task RefreshRememberedAsync()
    {
        if (_kind == DatabaseKind.SqlServer) { await RefreshSqlRememberedAsync(); return; }
        int ask = ++_rememberedAsk;
        var (host, port, _) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
        var user = _pgUser;
        bool remembered = host != null && !string.IsNullOrWhiteSpace(user)
            && await SqlConn.HasRememberedPasswordAsync(host, port, user, CancellationToken.None);
        if (ask != _rememberedAsk || _kind != DatabaseKind.PostgreSql) return;
        _pgHasRemembered = remembered;
        // With a remembered password the list needs nothing more from the user, so it fills as SQL Server's does on open — not
        // with one the server refused for this tab (review, round 2).
        if (UsesRememberedPgPassword && _databases.Count == 0 && !_dbLoading) await LoadPgDatabasesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnPgIdentityChanged() => RefreshRememberedAsync();

    // Spec 043 follow-up: the same question for a SQL Server login. With a remembered password the database list fills on its
    // own, as it does for Windows authentication.
    private async Task RefreshSqlRememberedAsync()
    {
        int ask = ++_rememberedAsk;
        var server = _server;
        var login = _login;
        var trust = _trustServerCertificate;   // review, round 3: the answer is for this certificate choice (part of the key)
        var key = SqlIdentityKey;
        bool remembered = !_windowsAuth && SqlConn.EngineRemembersSqlServerPasswords
            && !string.IsNullOrWhiteSpace(server) && !string.IsNullOrWhiteSpace(login)
            && await SqlConn.HasRememberedSqlServerPasswordAsync(server, login, trust, CancellationToken.None);
        if (ask != _rememberedAsk || _kind != DatabaseKind.SqlServer || key != SqlIdentityKey) return;
        _sqlHasRemembered = remembered;
        // Review: the checkbox shows the engine's state — with a password remembered it is on, so unticking it is a choice (the
        // password is then typed, and a connect forgets the remembered one). Review, round 2: a choice made while the engine was
        // being asked stands. Round 4: so does one made before it was asked, for as long as the form is the one it was made on.
        if (remembered && !_sqlRememberChosen) _sqlRemember = true;
        // Review, round 2: not with a password the server refused for this tab (UsesRememberedSqlPassword says no then; round 3:
        // nor for a tab with no binding whose mark names this sign-in, nor when the engine had none).
        if ((UsesRememberedSqlPassword || CanCopySqlPassword) && _databases.Count <= 1 && !_dbLoading) await LoadDatabasesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSqlLoginChanged() => RefreshRememberedAsync();

    // Said when a Forget got no confirmed answer — no reply, none in time, or the engine said it could not (its store could not
    // be written; review, round 2): nothing is known to have changed on the engine, so nothing changes here either.
    private const string ForgetUnanswered =
        "The engine did not confirm that it forgot the password; it may still be remembered on the engine machine.";

    private async Task ForgetSqlPasswordAsync()
    {
        _busy = true;
        StateHasChanged();
        try
        {
            // Review: only the engine's answer counts. No answer (not paired, no reply in time) is not "forgotten".
            var forgotten = SqlIdentity();   // review, round 4: the login asked about, as it was when asked
            var answer = await SqlConn.ForgetRememberedSqlServerPasswordAsync(forgotten.Server, forgotten.User ?? string.Empty, CancellationToken.None);
            if (answer == null)
            {
                SetMessage(ForgetUnanswered, isError: true);
                return;
            }
            _sqlHasRemembered = false;
            _sqlRemember = false;
            // The saved row stops asking for it too, so it is not turned back on when the row is shown again — when it is the
            // row of the login just forgotten (review, round 4).
            await ClearSavedRememberAsync(forgotten);
            SetMessage("The remembered password was forgotten.", isError: false);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // The selected saved row no longer asks the engine to remember its password. Review, round 4: only when the row is for the
    // login whose password was forgotten (RowNamesLogin) — the form may have been edited to another login since the row was shown.
    private async Task ClearSavedRememberAsync(ConnectionTarget forgotten)
    {
        if (_selectedId != null && await Store.GetAsync(_selectedId) is { RememberPassword: true } row && RowNamesLogin(row, forgotten))
        {
            row.RememberPassword = false;
            await Store.UpdateAsync(row);
            await ReloadAsync();
        }
    }

    // Review, round 3: the saved row is for the login the form connected (its server and login, as Settings › Connections forgets
    // them), not one the form was edited away from.
    private static bool RowNamesLogin(SavedSqlConnection row, ConnectionTarget target) =>
        row.Kind == DatabaseKind.SqlServer && !row.WindowsAuth && !target.WindowsAuth
        && string.Equals((row.Server ?? string.Empty).Trim(), (target.Server ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase)
        && string.Equals((row.Login ?? string.Empty).Trim(), (target.User ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);

    // Review, round 4: the engine keeps a password under the key for the connect's certificate checking, and a trusting connection
    // to a remote server is given only a password kept on a trusting one (SqlServerCredentialResolver.FillKeys). So a row that
    // trusts is not marked remembered for a password kept on a validating connect: its own connect would be asked for it.
    private static bool RowIsGivenPasswordOf(SavedSqlConnection row, ConnectionTarget target) =>
        EffectiveTrust(target.Server, target.TrustServerCertificate) || !EffectiveTrust(row.Server, row.TrustServerCertificate);

    // A SQL Server on the engine's own computer is always trusted (SqlConnectionService.BuildConnectionString).
    private static bool EffectiveTrust(string? server, bool trustServerCertificate) =>
        trustServerCertificate || SqlConnectionService.IsLoopbackServer(server ?? string.Empty);

    // What a failed SQL Server test or connect says, from the engine's error code (not the server's words, which are localised):
    // a missing password is a prompt; a remembered password the server refused says how to replace it.
    // Review, round 4: whether the remembered password was used is taken before the call (UsedRememberedSqlPassword) — a refused
    // connect marks the tab (SqlSessionState.PasswordMissing) before this runs, and the mark turns UsesRememberedSqlPassword off.
    private string SqlFailureText(ConnectResult result, string fallback, bool usedRemembered)
    {
        if (result.PasswordRequired)
            return "Enter the password for this login" + (SqlConn.EngineRemembersSqlServerPasswords ? "; turn on Remember to keep it on the engine machine." : ".");
        if (usedRemembered && result.ErrorCode == AkmlSql.Core.Ipc.Messages.DialectErrors.LoginFailed)
            return "The remembered password was not accepted by the server. Enter the current password and keep Remember password on to replace it.";
        return result.Error ?? fallback;
    }

    // The test or connect about to go out uses the engine's remembered password: nothing typed, and the form uses it.
    private bool UsedRememberedSqlPassword => !_windowsAuth && string.IsNullOrEmpty(_password) && UsesRememberedSqlPassword;

    private bool UsedRememberedPgPassword => UsesRememberedPgPassword && string.IsNullOrEmpty(_pgPassword);

    private async Task ForgetPasswordAsync()
    {
        var (host, port, error) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
        if (host == null) { SetMessage(error ?? "Enter the host first.", isError: true); return; }
        _busy = true;
        StateHasChanged();
        try
        {
            // Review: as for SQL Server, no answer from the engine leaves everything as it was.
            var answer = await SqlConn.ForgetRememberedPasswordAsync(host, port, _pgUser, CancellationToken.None);
            if (answer == null)
            {
                SetMessage(ForgetUnanswered, isError: true);
                return;
            }
            _pgHasRemembered = false;
            _pgRemember = false;
            SetMessage("The remembered password was forgotten.", isError: false);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // What a failed PostgreSQL test or connect says. A missing password is a prompt, not a failure, and it offers to remember the
    // one typed. A password the engine remembered that the server no longer accepts says so and how to replace it (FR-105): the
    // Remember option stays on, so connecting with the new password overwrites the old one.
    private string PgFailureText(ConnectResult result, string fallback, bool usedRemembered)
    {
        if (result.PasswordRequired)
            return "The server asked for a password. Enter the password and try again; turn on Remember password to keep it on the engine machine.";

        // Review: the engine's code says the password was refused (SQLSTATE 28P01); the server's words are the fallback for an
        // engine from before the code. Round 2: it was the remembered one only when none was typed. Round 4: taken before the
        // call (UsedRememberedPgPassword), as for SQL Server — the refusal has marked the tab by now.
        var rejected = SqlConnectionService.IsPgPasswordRefused(result);
        if (usedRemembered && rejected)
            return "The remembered password was not accepted by the server. Enter the current password and keep Remember password on to replace it.";

        return result.Error ?? fallback;
    }

    // "PostgreSQL 18.1 on db1:5432" (FR-002), or the engine's own words; a missing password is a prompt, not a failure.
    private async Task TestPostgresAsync()
    {
        if (PgPasswordNeeded) { SetMessage(PgPasswordNeededText, isError: true); return; }
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            bool usedRemembered = UsedRememberedPgPassword;   // review, round 4: before the call (see PgFailureText)
            var result = await SqlConn.TestAsync(PgTarget(), CancellationToken.None);
            if (result.Ok)
            {
                var (host, port, _) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
                SetMessage($"{result.ServerVersion ?? "PostgreSQL"} on {host}:{port}", isError: false);
            }
            else
            {
                SetMessage(PgFailureText(result, "Connection test failed.", usedRemembered), isError: true);
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SavePostgresAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var (host, port, error) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
            if (host == null) throw new ArgumentException(error);

            var database = string.IsNullOrWhiteSpace(_pgDatabase) ? "postgres" : _pgDatabase.Trim();
            var name = string.IsNullOrWhiteSpace(_name) ? $"{host} / {database}" : _name.Trim();
            var record = new SavedSqlConnection
            {
                Id = _selectedId ?? Guid.NewGuid().ToString("N"),
                Name = name,
                Kind = DatabaseKind.PostgreSql,
                Server = host,
                Database = database,
                WindowsAuth = false,
                Login = string.IsNullOrWhiteSpace(_pgUser) ? null : _pgUser.Trim(),
                Port = port,
                SslMode = _pgSslMode,
                RootCertificatePath = string.IsNullOrWhiteSpace(_pgRootCert) ? null : _pgRootCert.Trim(),
                RememberPassword = _pgRemember,
            };
            if (_selectedId == null) await Store.AddAsync(record);
            else await Store.UpdateAsync(record);
            _selectedId = record.Id;
            await Store.SetActiveIdAsync(_selectedId);
            await ReloadAsync();
            _name = name;
            SetMessage("Saved.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        _busy = false;
        StateHasChanged();
    }

    // Spec 042 (FR-009): connecting somewhere else drops the session, and with it any open transaction. The engine rolls it
    // back; it never commits. Ask first, naming what is lost.
    private async Task<bool> ConfirmLeaveTransactionAsync()
    {
        // Spec 043: the transaction of the tab being connected, not of whichever tab is active.
        var session = TargetSession;
        bool connected = session?.IsConnected ?? SqlConn.IsConnected;
        var state = session?.TransactionState ?? SqlConn.TransactionState;
        if (!connected || state == TransactionState.None) return true;
        var aborted = state == TransactionState.Aborted;
        return await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = aborted ? "Aborted transaction" : "Open transaction",
            Message = (aborted
                ? "The current session has a transaction that an error aborted. "
                : "The current session has an open transaction. ")
                + "Connecting to another server rolls it back. Nothing is committed.",
            ConfirmLabel = "Roll back and connect",
            Destructive = true,
        });
    }

    // Spec 043 (T049): a tab's connection does not change under its own run.
    private bool RefuseWhileBusy()
    {
        if (TargetSession?.IsBusy != true) return false;
        SetMessage("Wait for the current run to finish.", isError: true);
        return true;
    }

    private async Task ConnectPostgresAsync()
    {
        if (PgPasswordNeeded) { SetMessage(PgPasswordNeededText, isError: true); return; }
        if (RefuseWhileBusy()) return;
        if (!await ConfirmLeaveTransactionAsync()) return;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            bool usedRemembered = UsedRememberedPgPassword;   // review, round 4: before the connect marks the tab (see PgFailureText)
            var result = await ConnectTargetAsync(PgTarget());
            if (result.Ok)
            {
                _connected = true;
                if (!string.IsNullOrEmpty(_selectedId))
                {
                    try
                    {
                        var existing = await Store.GetAsync(_selectedId!);
                        if (existing != null)
                        {
                            existing.LastConnectedAt = DateTimeOffset.UtcNow;
                            await Store.UpdateAsync(existing);
                            await Store.SetActiveIdAsync(existing.Id);
                        }
                    }
                    catch { /* best-effort metadata update — connect already succeeded */ }
                }
                Close();
                return;
            }
            SetMessage(PgFailureText(result, "Connect failed.", usedRemembered), isError: true);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task TestAsync()
    {
        if (_kind == DatabaseKind.PostgreSql) { await TestPostgresAsync(); return; }

        // Passwords are never stored in the browser, so a saved SQL-auth connection loads with an empty password. Require one
        // (unless the engine remembers it) rather than silently testing with "" (which always fails confusingly).
        if (SqlPasswordMissing)
        {
            SetMessage("Enter the SQL password to test this connection (it is not stored in the browser).", isError: true);
            return;
        }
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            bool usedRemembered = UsedRememberedSqlPassword;   // review, round 4: before the call (see SqlFailureText)
            var result = await SqlConn.TestAsync(SqlServerTarget(), CancellationToken.None);
            SetMessage(result.Ok ? "Connection test succeeded." : SqlFailureText(result, "Connection test failed.", usedRemembered), isError: !result.Ok);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_kind == DatabaseKind.PostgreSql) { await SavePostgresAsync(); return; }

        _busy = true;
        _message = null;
        try
        {
            // Default the display name to the server/db if the user left it blank.
            var name = string.IsNullOrWhiteSpace(_name) ? $"{_server} / {_database}" : _name.Trim();
            if (_selectedId == null)
            {
                var record = new SavedSqlConnection
                {
                    Name = name,
                    Server = _server.Trim(),
                    Database = _database.Trim(),
                    WindowsAuth = _windowsAuth,
                    Login = _windowsAuth ? null : (string.IsNullOrWhiteSpace(_login) ? null : _login.Trim()),
                    TrustServerCertificate = _trustServerCertificate,
                    RememberPassword = !_windowsAuth && _sqlRemember,
                };
                await Store.AddAsync(record);
                _selectedId = record.Id;
            }
            else
            {
                var record = new SavedSqlConnection
                {
                    Id = _selectedId,
                    Name = name,
                    Server = _server.Trim(),
                    Database = _database.Trim(),
                    WindowsAuth = _windowsAuth,
                    Login = _windowsAuth ? null : (string.IsNullOrWhiteSpace(_login) ? null : _login.Trim()),
                    TrustServerCertificate = _trustServerCertificate,
                    RememberPassword = !_windowsAuth && _sqlRemember,
                };
                await Store.UpdateAsync(record);
            }
            await Store.SetActiveIdAsync(_selectedId);
            await ReloadAsync();
            _name = name;
            SetMessage("Saved.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        _busy = false;
        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        if (string.IsNullOrEmpty(_selectedId)) return;
        // Spec 041 (FR-057, FR-102): deleting a saved connection confirms, naming it.
        var name = (await Store.GetAsync(_selectedId!))?.Name;
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Delete saved connection",
            Message = string.IsNullOrEmpty(name) ? "Delete this saved connection?" : $"Delete the saved connection “{name}”?",
            ConfirmLabel = "Delete",
            Destructive = true,
        });
        if (!ok) return;
        _busy = true;
        _message = null;
        try
        {
            await Store.RemoveAsync(_selectedId!);
            await ReloadAsync();
            NewConnection();
            SetMessage("Deleted.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        _busy = false;
        StateHasChanged();
    }

    private async Task ConnectAsync()
    {
        if (_kind == DatabaseKind.PostgreSql) { await ConnectPostgresAsync(); return; }

        if (SqlPasswordMissing)
        {
            SetMessage("Enter the SQL password to connect (it is not stored in the browser).", isError: true);
            return;
        }
        if (RefuseWhileBusy()) return;
        if (!await ConfirmLeaveTransactionAsync()) return;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            // Review WEB-19: the engine opens the connection before the session switches; a refusal keeps the dialog open
            // with what was typed, so it can be corrected.
            var target = SqlServerTarget();
            // Taken before the connect: what the form asked of the engine's password store.
            bool askedToRemember = target.RememberPassword && !string.IsNullOrEmpty(target.Password);
            bool hadRemembered = !_windowsAuth && _sqlHasRemembered;
            bool forgetRemembered = hadRemembered && !_sqlRemember && SqlConn.EngineRemembersSqlServerPasswords;
            bool usedRemembered = UsedRememberedSqlPassword;   // review, round 4: a refused connect marks the tab (see SqlFailureText)
            var result = await ConnectTargetAsync(target);
            if (result.Ok)
            {
                _connected = true;
                // Review: the engine could not keep the password Remember asked it to keep. The connect stands; the user is
                // told, and the saved row is not left saying the password is remembered. Review, round 2: when the engine held a
                // password for this login before, that one is still there and may still be used (another tab, another client):
                // said, with where to forget it, and the saved row keeps offering Forget in Settings › Connections.
                bool notRemembered = askedToRemember && !result.Remembered;
                bool olderStillKept = notRemembered && hadRemembered;
                // Review: Remember unticked while the engine held a password for this login is the choice to forget it — after the
                // connect, which used the password typed now.
                bool forgotten = false;
                if (forgetRemembered)
                {
                    var answer = await SqlConn.ForgetRememberedSqlServerPasswordAsync(target.Server, target.User ?? string.Empty, CancellationToken.None);
                    forgotten = answer != null;
                    if (answer == null)
                    {
                        Notifications?.Notify(
                            $"Connected. The engine did not confirm that it forgot the password for {target.User} on {target.Server}; it may still be remembered on the engine machine. Use Forget it in Connect to database to try again.",
                            NotificationKind.Warning);
                    }
                }
                // Persist LastConnectedAt + remember this as the active saved row when it maps to one.
                // Review, round 3: Settings › Connections offers Forget password only on a row that says its password is
                // remembered, so a row for this login that the warning below points to is made to say so.
                // Review, round 4: a password the engine kept (v2's Remembered; a v1 engine kept what it was asked to keep, which
                // ConnectResult.Remembered already says) makes the row say so too — the Status bar's restore of the row and its
                // Forget password in Settings › Connections read it. Every change to the flag is for the row's own login only: a
                // form edited to another login says nothing about the password of the row's.
                bool kept = askedToRemember && result.Remembered;
                bool rowOffersForget = false;
                if (!string.IsNullOrEmpty(_selectedId))
                {
                    try
                    {
                        var existing = await Store.GetAsync(_selectedId!);
                        if (existing != null)
                        {
                            existing.LastConnectedAt = DateTimeOffset.UtcNow;
                            bool namesLogin = RowNamesLogin(existing, target);
                            if (namesLogin && ((notRemembered && !hadRemembered) || forgotten)) existing.RememberPassword = false;
                            bool pointTo = olderStillKept && namesLogin;
                            if (pointTo || (namesLogin && kept && RowIsGivenPasswordOf(existing, target))) existing.RememberPassword = true;
                            await Store.UpdateAsync(existing);
                            rowOffersForget = pointTo;
                            await Store.SetActiveIdAsync(existing.Id);
                        }
                    }
                    catch { /* best-effort metadata update — connect already succeeded */ }
                }
                if (notRemembered)
                {
                    // Review, round 3: Settings › Connections is named only when its row offers Forget password; otherwise only
                    // Connect to database's Forget it (shown once the engine says it holds a password for the form's login).
                    Notifications?.Notify(!olderStillKept
                        ? $"Connected, but the engine could not keep the password for {target.User} on {target.Server}. It is asked for again next time."
                        : $"Connected, but the engine could not keep the new password for {target.User} on {target.Server}. The password it remembered before may still be used; forget it with Forget it in Connect to database"
                          + (rowOffersForget ? ", or Forget password in Settings › Connections." : "."),
                        NotificationKind.Warning);
                }
                Close();   // MainLayout's StateChanged owner starts SchemaSync on SqlConn.SessionId.
                return;
            }
            SetMessage(SqlFailureText(result, "Connect failed.", usedRemembered), isError: true);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }

    private void OnPanelKeyDown(KeyboardEventArgs e)
    {
        // Esc cancels (deliberate-click Connect; Esc/scrim-click are the only dismiss paths).
        if (e.Key == "Escape") Close();
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        bool connected = _connected;
        _target = null;
        _connected = false;
        Controller.NotifyClosed(connected);   // spec 043: a run waiting on this dialog goes on, or stops
        StateHasChanged();
        if (_module != null)
        {
            _ = _module.InvokeVoidAsync("restoreFocus");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOnNextRender && _open)
        {
            _focusOnNextRender = false;
            if (_module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("stashFocus");
                    // Prefer the first form field (#conn-name) over the header Close button so SR
                    // users don't enter the connect dialog on "Close".
                    await _module.InvokeVoidAsync("focusFirst", _panelRef, "#conn-name");
                    await _module.InvokeVoidAsync("trapTab", _panelRef);
                }
                catch (JSDisconnectedException) { /* tab closing — ignore */ }
                catch (Microsoft.JSInterop.JSException) { /* element not in DOM yet — harmless */ }
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        Controller.OpenRequested -= OnOpenRequested;
        SqlConn.StateChanged -= OnSqlStateChanged;
        try
        {
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* tab closing */ }
    }
}
