@*
    Phase 4 (web connection manager) — the app-global "Connect to SQL Server" modal. Hosted once
    in MainLayout; opened by IConnectionManagerController.Open() (command palette / Settings /
    StatusBar). Two panes: saved-connections list (left) + connect form (right). Actions:
    Test / Save / Delete / Connect.

    Conventions mirror CommandPalette.razor: scrim @onclick=Close + data-testid; panel role=dialog
    aria-modal=true aria-label + @onclick:stopPropagation; chrome from --akml-* tokens ONLY; classes
    prefixed akml-connmgr-*; scrim reuses the existing @keyframes akml-cmd-fade in app.css. Esc and
    focus management follow the gold-standard pattern, but because this is a multi-field form the Esc
    handler is on the PANEL div (@onkeydown), and focus/Tab-trap use a dedicated JS module
    (akml-connection-manager.js) rather than the palette module (which owns the global Ctrl+P).

    SECURITY: Connect/Test route through ISqlConnectionService, whose ValidateTarget enforces the
    confused-deputy guard before any IPC: a remote server is allowed with SQL Server authentication,
    Windows authentication only on the engine's own machine (the engine re-checks: BridgeSqlTargetGuard). No password is ever persisted — SQL-auth rows store
    only the login username; the password stays a transient field re-prompted at Connect/Test.
*@
@using System.Threading
@using AkmlSql.Core
@using AkmlSql.Web.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IConnectionManagerController Controller
@inject ISavedSqlConnectionStore Store
@inject ISqlConnectionService SqlConn
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject IServiceProvider Services

@if (_open)
{
    <div class="akml-scrim akml-connmgr-scrim" @onclick="Close" data-testid="connection-manager-scrim">
        <div class="akml-dialog akml-connmgr-panel" role="dialog" aria-modal="true" aria-label="Connection manager"
             tabindex="-1" @ref="_panelRef" @onkeydown="OnPanelKeyDown"
             @onclick:stopPropagation="true" data-testid="connection-manager">

            <div class="akml-connmgr-header">
                <span class="akml-connmgr-title" data-testid="conn-title">@(_kind == DatabaseKind.PostgreSql ? "Connect to PostgreSQL" : "Connect to SQL Server")</span>
                <button type="button" class="akml-connmgr-close" @onclick="Close"
                        aria-label="Close" data-testid="conn-close-btn"><Icon Name="x" /></button>
            </div>

            <div class="akml-connmgr-body">
                <!-- LEFT: saved-connections list -->
                <div class="akml-connmgr-list-pane">
                    <div class="akml-connmgr-list-head">
                        <span>Saved connections</span>
                        <button type="button" class="akml-connmgr-newbtn" @onclick="NewConnection"
                                data-testid="conn-new-btn">＋ New</button>
                    </div>
                    @if (_saved.Count == 0)
                    {
                        <p class="akml-connmgr-empty" data-testid="conn-list-empty">
                            No saved connections — fill the form and Save.
                        </p>
                    }
                    else
                    {
                        <ul class="akml-connmgr-list" data-testid="conn-list">
                            @foreach (var c in _saved)
                            {
                                <li class="akml-connmgr-row @(c.Id == _selectedId ? "selected" : "")"
                                    @onclick="@(() => SelectSaved(c))" data-testid="conn-row" data-conn-id="@c.Id">
                                    <span class="akml-connmgr-row-name">@c.Name</span>
                                    <span class="akml-connmgr-row-sub">@c.Server / @c.Database</span>
                                    <span class="akml-connmgr-row-badge" data-testid="conn-row-kind"
                                          title="@(c.Kind == DatabaseKind.PostgreSql ? "PostgreSQL" : "SQL Server")">@(c.Kind == DatabaseKind.PostgreSql ? "PG" : c.WindowsAuth ? "Win" : "SQL")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <!-- RIGHT: connect form -->
                <div class="akml-connmgr-form-pane">
                    @* Spec 042 (FR-001): every connection has a kind, chosen here. The choice is two buttons, not a colour. *@
                    <div class="akml-field akml-connmgr-field">
                        <span class="akml-field-label" id="conn-kind-label">Database kind</span>
                        <div class="akml-connmgr-kind" role="group" aria-labelledby="conn-kind-label">
                            <button type="button" class="akml-btn akml-connmgr-kindbtn @(_kind == DatabaseKind.SqlServer ? "selected" : "")"
                                    aria-pressed="@(_kind == DatabaseKind.SqlServer ? "true" : "false")"
                                    @onclick="@(() => SetKind(DatabaseKind.SqlServer))" data-testid="conn-kind-sqlserver">SQL Server</button>
                            <button type="button" class="akml-btn akml-connmgr-kindbtn @(_kind == DatabaseKind.PostgreSql ? "selected" : "")"
                                    aria-pressed="@(_kind == DatabaseKind.PostgreSql ? "true" : "false")"
                                    disabled="@(!SqlConn.EngineSupportsPostgres)"
                                    title="@(SqlConn.EngineSupportsPostgres ? null : PostgresDisabledTooltip)"
                                    @onclick="@(() => SetKind(DatabaseKind.PostgreSql))" data-testid="conn-kind-postgresql">PostgreSQL</button>
                        </div>
                        @* Spec 042 (T121): said once, in place, with the capability and the engine version found. *@
                        <CapabilityNotice Available="SqlConn.EngineSupportsPostgres" Feature="PostgreSQL"
                                          RequiredCapability="@SqlConnectionService.CapabilityPostgreSql" TestId="conn-kind-hint"
                                          EngineConnected="@(PairedEngine is null || PairedEngine.State == BridgeState.Open)"
                                          EngineVersion="@PairedEngine?.EngineVersion" />
                    </div>
                    <div class="akml-field akml-connmgr-field">
                        <label class="akml-field-label" for="conn-name">Display name</label>
                        <input id="conn-name" class="akml-input" @bind="_name" @bind:event="oninput"
                               placeholder="e.g. Local master" data-testid="conn-name-input" />
                    </div>
                    @if (_kind == DatabaseKind.PostgreSql)
                    {
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-pg-host">Host</label>
                            <input id="conn-pg-host" class="akml-input" @bind="_pgHost" @bind:event="oninput"
                                   @onchange="OnPgIdentityChanged"
                                   placeholder="db.example.com, 10.0.0.5 or [::1]" data-testid="conn-pg-host" />
                        </div>
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-pg-port">Port</label>
                            <input id="conn-pg-port" class="akml-input" type="number" min="1" max="65535"
                                   @bind="_pgPort" @bind:event="oninput" @onchange="OnPgIdentityChanged" data-testid="conn-pg-port" />
                        </div>
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-pg-database">Database</label>
                            @* Typed, or picked from the server's list (the refresh button, or automatically once a password
                               is remembered): the same choice SQL Server's form offers. *@
                            <div class="akml-connmgr-db-row">
                                <input id="conn-pg-database" class="akml-input akml-connmgr-select" @bind="_pgDatabase" @bind:event="oninput"
                                       list="conn-pg-database-list" autocomplete="off" placeholder="postgres" data-testid="conn-pg-database" />
                                <datalist id="conn-pg-database-list">
                                    @foreach (var db in _databases)
                                    {
                                        <option value="@db"></option>
                                    }
                                </datalist>
                                <button type="button" class="akml-btn akml-connmgr-db-refresh"
                                        @onclick="LoadPgDatabasesAsync" disabled="@(_busy || _dbLoading)"
                                        title="@(_busy || _dbLoading ? "Wait for the current connection operation" : "Load the database list from the server")"
                                        data-testid="conn-pg-database-refresh"><Icon Name="refresh-cw" /></button>
                            </div>
                            @if (!string.IsNullOrEmpty(_dbMessage))
                            {
                                <span class="akml-connmgr-hint" data-testid="conn-pg-database-hint">@_dbMessage</span>
                            }
                        </div>
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-pg-user">User name</label>
                            <input id="conn-pg-user" class="akml-input" @bind="_pgUser" @bind:event="oninput"
                                   @onchange="OnPgIdentityChanged" autocomplete="off" data-testid="conn-pg-user" />
                        </div>
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-pg-password">Password</label>
                            <input id="conn-pg-password" class="akml-input" type="password" autocomplete="new-password"
                                   @bind="_pgPassword" @bind:event="oninput"
                                   placeholder="@(_pgHasRemembered ? "Remembered on the engine machine" : null)" data-testid="conn-pg-password" />
                            <span class="akml-connmgr-hint">Not saved in the browser. @(_pgRemember ? "It will be kept on the engine machine." : "Re-entered each time you connect.")</span>
                        </div>
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-pg-sslmode">TLS mode</label>
                            <select id="conn-pg-sslmode" class="akml-select" @bind="_pgSslMode" data-testid="conn-pg-sslmode">
                                @foreach (var mode in SavedSqlConnection.SslModes)
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </select>
                        </div>
                        @if (_pgSslMode is "verify-ca" or "verify-full")
                        {
                            <div class="akml-field akml-connmgr-field">
                                <label class="akml-field-label" for="conn-pg-rootcert">CA certificate path</label>
                                <input id="conn-pg-rootcert" class="akml-input" @bind="_pgRootCert" @bind:event="oninput"
                                       placeholder="C:\certs\root.crt" data-testid="conn-pg-rootcert" />
                                <span class="akml-connmgr-hint">A path on the engine machine.</span>
                            </div>
                        }
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-connmgr-radio" for="conn-pg-remember">
                                <input id="conn-pg-remember" type="checkbox" @bind="_pgRemember" data-testid="conn-pg-remember" />
                                Remember the password on the engine machine
                            </label>
                            <span class="akml-connmgr-hint" data-testid="conn-pg-remember-help">
                                Stored on the engine machine for the account the engine runs as. On the web engine service this means any
                                administrator of the engine machine. Any client paired with this engine can use it.
                            </span>
                            @if (_pgHasRemembered)
                            {
                                <button type="button" class="akml-btn" @onclick="ForgetPasswordAsync" disabled="@_busy"
                                        data-testid="conn-pg-forget">Forget the remembered password</button>
                            }
                        </div>
                    }
                    else
                    {
                    <div class="akml-field akml-connmgr-field">
                        <label class="akml-field-label" for="conn-server">Server</label>
                        <input id="conn-server" class="akml-input" @bind="_server" @bind:event="oninput"
                               @onchange="OnServerChanged"
                               placeholder="localhost, server\instance, or a remote host,port" data-testid="conn-server-input" />
                    </div>
                    <div class="akml-field akml-connmgr-field">
                        <label class="akml-field-label" for="conn-database">Database</label>
                        <div class="akml-connmgr-db-row">
                            <select id="conn-database" class="akml-select akml-connmgr-select"
                                    @bind="_database" disabled="@_dbLoading" title="@(_dbLoading ? "Loading databases…" : null)" data-testid="conn-database-select">
                                @* Always keep the current value selectable — a saved/typed DB may not be
                                   in the freshly-loaded list (or the list may not be loaded yet). *@
                                @if (!string.IsNullOrEmpty(_database) &&
                                     !_databases.Contains(_database, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@_database" selected>@_database</option>
                                }
                                @foreach (var db in _databases)
                                {
                                    @* The list arrives after the value is bound: without `selected` the browser shows the first
                                       option while the connection uses _database, so the dialog connected to another database
                                       than the one it showed. *@
                                    <option value="@db" selected="@string.Equals(db, _database, StringComparison.OrdinalIgnoreCase)">@db</option>
                                }
                            </select>
                            <button type="button" class="akml-btn akml-connmgr-db-refresh"
                                    @onclick="LoadDatabasesAsync" disabled="@(_busy || _dbLoading)"
                                    title="@(_busy || _dbLoading ? "Wait for the current connection operation" : "Load the database list from the server")"
                                    data-testid="conn-database-refresh"><Icon Name="refresh-cw" /></button>
                        </div>
                        @if (!string.IsNullOrEmpty(_dbMessage))
                        {
                            <span class="akml-connmgr-hint" data-testid="conn-database-hint">@_dbMessage</span>
                        }
                        @* Spec 032 FR-033: the engine enumerates databases under ITS service
                           account — databases it lacks grants for are silently absent, which
                           surprised even the campaign (the sandbox needed a grant to appear). *@
                        <span class="akml-connmgr-hint" data-testid="conn-database-scope-hint">
                            @(_windowsAuth
                                ? "With Windows authentication only the databases the engine's account can open are listed. For another database, grant that account access or use SQL Server authentication."
                                : "Lists the databases this login can open.")
                        </span>
                    </div>
                    <div class="akml-field akml-connmgr-field">
                        <span class="akml-field-label">Authentication</span>
                        <label class="akml-connmgr-radio">
                            <input type="radio" name="connauth" checked="@_windowsAuth"
                                   @onchange="@(() => SetAuth(true))" data-testid="conn-auth-windows" />
                            Windows authentication
                        </label>
                        <label class="akml-connmgr-radio">
                            <input type="radio" name="connauth" checked="@(!_windowsAuth)"
                                   @onchange="@(() => SetAuth(false))" data-testid="conn-auth-sql" />
                            SQL Server authentication
                        </label>
                        @* The one rule that decides remote connections, stated where the choice is made. *@
                        <span class="akml-connmgr-hint" data-testid="conn-auth-hint">
                            Windows authentication works for a SQL Server on the engine's own computer.
                            For a remote server, use SQL Server authentication.
                        </span>
                    </div>
                    @if (!_windowsAuth)
                    {
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-login">Login</label>
                            <input id="conn-login" class="akml-input" @bind="_login" @bind:event="oninput"
                                   data-testid="conn-login-input" />
                        </div>
                        <div class="akml-field akml-connmgr-field">
                            <label class="akml-field-label" for="conn-password">Password</label>
                            <input id="conn-password" class="akml-input" type="password"
                                   @bind="_password" @bind:event="oninput" data-testid="conn-password-input" />
                            <span class="akml-connmgr-hint">Not saved — re-entered each time you connect.</span>
                        </div>
                    }
                    @* Review WEB-02: a remote server's certificate is validated unless the user says otherwise, for this connection only. *@
                    <div class="akml-field akml-connmgr-field">
                        <label class="akml-connmgr-radio" for="conn-trust-cert">
                            <input id="conn-trust-cert" type="checkbox" @bind="_trustServerCertificate" data-testid="conn-trust-cert" />
                            Trust the server certificate without validating it
                        </label>
                        <span class="akml-connmgr-hint" data-testid="conn-trust-cert-help">
                            The connection is always encrypted. Tick this only for a remote server with a self-signed certificate you
                            trust: without validation, anyone on the network path could pose as the server. A SQL Server on the
                            engine's own computer is never validated.
                        </span>
                    </div>
                    }

                </div>
            </div>

            @* Outside the scrolling form, so the result of Test or Connect is always in view. *@
            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="akml-connmgr-msg @(_messageIsError ? "error" : "ok")" role="status" data-testid="conn-message">@_message</p>
            }

            <div class="akml-connmgr-footer">
                <button type="button" class="akml-btn" @onclick="TestAsync"
                        disabled="@_busy" title="@(_busy ? "Wait for the current connection operation" : null)" data-testid="conn-test-btn">Test</button>
                <button type="button" class="akml-btn" @onclick="SaveAsync"
                        disabled="@_busy" title="@(_busy ? "Wait for the current connection operation" : null)" data-testid="conn-save-btn">Save</button>
                <button type="button" class="akml-btn" @onclick="DeleteAsync"
                        disabled="@(_busy || string.IsNullOrEmpty(_selectedId))" title="@(_busy ? "Wait for the current connection operation" : string.IsNullOrEmpty(_selectedId) ? "Select a saved connection to delete" : null)" data-testid="conn-delete-btn">Delete</button>
                <span class="akml-connmgr-footer-spacer"></span>
                <button type="button" class="akml-btn akml-btn--primary" @onclick="ConnectAsync"
                        disabled="@_busy" title="@(_busy ? "Wait for the current connection operation" : null)" data-testid="conn-connect-btn">Connect</button>
            </div>
        </div>
    </div>
}

<style>
    /* Phase 4 connection manager — chrome from --akml-* tokens only; akml-connmgr-* prefixed
       classes (no CSS isolation in this project). The scrim reuses the akml-cmd-fade keyframe
       defined in wwwroot/css/app.css (a Razor style block can't host @@keyframes — nested-brace
       mis-parse), so we never redefine it here. */
    /* The shell scrim (.akml-scrim in shell.css), one layer below the in-app dialog so a confirmation opened
       from here (Delete…) shows above it. */
    .akml-scrim.akml-connmgr-scrim { z-index: 1000; }

    /* A shell dialog (.akml-dialog in shell.css) sized for the list and the form side by side. */
    .akml-connmgr-panel {
        width: 720px;
        height: 500px;
        overflow: hidden;
    }

    .akml-connmgr-header {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-l);
        border-bottom: 1px solid var(--akml-border-default);
        background-color: var(--akml-surface-sidebar);
    }
    .akml-connmgr-title { font-weight: 600; }
    .akml-connmgr-close {
        background: none; border: none; color: var(--akml-text-secondary);
        font-size: 14px; cursor: pointer; padding: 2px 6px; border-radius: var(--akml-scalar-radius-xs);
    }
    .akml-connmgr-close:hover { background-color: var(--akml-surface-hover); color: var(--akml-text-primary); }

    .akml-connmgr-body {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 1px;
        flex: 1 1 auto;
        min-height: 0;
        background-color: var(--akml-border-default); /* shows through the 1px gap as a divider */
    }

    .akml-connmgr-list-pane {
        display: flex;
        flex-direction: column;
        min-height: 0;
        background-color: var(--akml-surface-sidebar);
    }
    .akml-connmgr-list-head {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-m);
        color: var(--akml-text-secondary);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 600;
    }
    .akml-connmgr-newbtn {
        background: none; border: none; color: var(--akml-text-link);
        cursor: pointer; font-size: 12px; padding: 0;
    }
    .akml-connmgr-newbtn:hover { text-decoration: underline; }
    .akml-connmgr-empty {
        padding: var(--akml-scalar-spacing-m);
        color: var(--akml-text-secondary);
        font-style: italic;
        font-size: 12px;
    }
    .akml-connmgr-list {
        list-style: none; padding: 0; margin: 0;
        overflow-y: auto; min-height: 0; flex: 1 1 auto;
    }
    .akml-connmgr-row {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas: "name badge" "sub badge";
        column-gap: var(--akml-scalar-spacing-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-m);
        cursor: pointer;
        border-bottom: 1px solid var(--akml-border-subtle);
    }
    .akml-connmgr-row:hover { background-color: var(--akml-surface-hover); }
    .akml-connmgr-row.selected {
        background-color: var(--akml-surface-selection);
        box-shadow: inset 2px 0 0 0 var(--akml-accent-primary);
    }
    .akml-connmgr-row-name { grid-area: name; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .akml-connmgr-row-sub {
        grid-area: sub; color: var(--akml-text-secondary); font-size: 11px;
        font-family: var(--akml-type-editor-family);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .akml-connmgr-row-badge {
        grid-area: badge; align-self: center;
        font-size: 10px; padding: 0 4px; border-radius: var(--akml-scalar-radius-xs);
        background-color: var(--akml-surface-hover); color: var(--akml-text-secondary);
    }

    .akml-connmgr-form-pane {
        display: flex;
        flex-direction: column;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-l);
        overflow-y: auto;
        min-height: 0;
        background-color: var(--akml-surface-panel);
    }
    .akml-connmgr-field { margin-bottom: 0; }
    /* Database dropdown + its inline refresh button share one row. */
    .akml-connmgr-db-row { display: flex; gap: var(--akml-scalar-spacing-xs); align-items: stretch; }
    .akml-connmgr-select { flex: 1 1 auto; min-width: 0; cursor: pointer; }
    .akml-connmgr-select:disabled { opacity: 0.6; cursor: default; }
    .akml-connmgr-db-refresh {
        flex: 0 0 auto; min-width: 32px; text-align: center;
        padding-left: var(--akml-scalar-spacing-s); padding-right: var(--akml-scalar-spacing-s);
    }
    .akml-connmgr-radio { display: block; color: var(--akml-text-primary); font-size: 13px; margin-top: 2px; }

    /* Spec 042: the two-way kind switch. The pressed one is announced through aria-pressed and drawn with a fill, a
       heavier outline and bold text, so the choice is never colour alone. */
    .akml-connmgr-kind { display: flex; gap: var(--akml-scalar-spacing-xs); }
    .akml-connmgr-kindbtn.selected {
        background-color: var(--akml-surface-selection);
        border-color: var(--akml-accent-primary);
        box-shadow: inset 0 0 0 1px var(--akml-accent-primary);
        font-weight: 600;
    }
    .akml-connmgr-hint { color: var(--akml-text-secondary); font-size: 11px; font-style: italic; }

    .akml-connmgr-msg {
        flex: 0 0 auto;
        font-size: 12px;
        margin: 0;
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-m);
        border-top: 1px solid var(--akml-border-default);
        overflow-wrap: anywhere;
    }
    .akml-connmgr-msg.error { color: var(--akml-status-danger); }
    .akml-connmgr-msg.ok { color: var(--akml-status-success); }

    .akml-connmgr-footer {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-l);
        border-top: 1px solid var(--akml-border-default);
        background-color: var(--akml-surface-sidebar);
    }
    .akml-connmgr-footer-spacer { flex: 1 1 auto; }
</style>

@code {
    private bool _open;
    private bool _busy;
    private bool _focusOnNextRender;

    private ElementReference _panelRef;
    private IJSObjectReference? _module;

    // Saved-connection list + the currently-selected saved row (null = unsaved "new" form).
    private List<SavedSqlConnection> _saved = new();
    private string? _selectedId;

    // Spec 042: the kind the form is for. A saved row brings its own; "New" starts as SQL Server unless the opener asked.
    // Optional: a host (or test) with no bridge in its services still gets the notice, just without the engine's version.
    private IEngineBridge? PairedEngine => Services.GetService(typeof(IEngineBridge)) as IEngineBridge;

    private const string PostgresDisabledTooltip = "Requires an engine with PostgreSQL support (dialect.postgresql.v1)";
    private DatabaseKind _kind = DatabaseKind.SqlServer;
    private string _pgHost = string.Empty;
    private int? _pgPort = SavedSqlConnection.DefaultPostgresPort;
    private string _pgDatabase = "postgres";
    private string _pgUser = string.Empty;
    private string _pgPassword = string.Empty;   // transient, like the SQL password: never persisted
    private string _pgSslMode = "prefer";
    private string _pgRootCert = string.Empty;
    private bool _pgRemember;
    private bool _pgHasRemembered;                // the engine holds a password for this host, port and user (FR-105)

    // Form state. Password is transient — never persisted.
    private string _name = string.Empty;
    private string _server = "localhost";
    private string _database = "master";
    private bool _windowsAuth = true;
    private string _login = string.Empty;
    private string _password = string.Empty;
    private bool _trustServerCertificate;

    // Database dropdown (spec 030). _databases is the list fetched from the server; the current
    // _database is always kept selectable even when absent from (or ahead of) the fetched list.
    private List<string> _databases = new();
    private bool _dbLoading;
    private string? _dbMessage;

    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        Controller.OpenRequested += OnOpenRequested;
        SqlConn.StateChanged += OnSqlStateChanged;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-connection-manager.js");
    }

    private void OnOpenRequested() => InvokeAsync(async () =>
    {
        // Re-entrant guard: opening while already open must not reset the form.
        if (_open) return;
        _message = null;
        await ReloadAsync();
        // Pre-fill from the active (most-recently-used) saved row, if any.
        var activeId = await Store.GetActiveIdAsync();
        var active = string.IsNullOrEmpty(activeId) ? null : _saved.FirstOrDefault(c => c.Id == activeId);

        // Spec 042 (T064): "Connect to PostgreSQL…" asks for the PostgreSQL form; otherwise the active row decides.
        var requested = Controller.RequestedKind;
        if (requested.HasValue && (active == null || active.Kind != requested.Value)) NewConnection(requested.Value);
        else if (active != null) SelectSaved(active);
        else NewConnection();
        _open = true;
        _focusOnNextRender = true;
        StateHasChanged();

        // Best-effort pre-populate the database dropdown. Windows auth needs no password, so the
        // common localhost/Windows default "just works"; SQL auth waits for the user to enter a
        // password and click refresh. Failures land in _dbMessage, never blocking the dialog.
        if (_kind == DatabaseKind.SqlServer && _windowsAuth)
            await LoadDatabasesAsync();
        else if (_kind == DatabaseKind.PostgreSql)
            await RefreshRememberedAsync();
    });

    private void OnSqlStateChanged() => InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _saved = (await Store.ListAsync()).ToList();
    }

    private void NewConnection() => NewConnection(DatabaseKind.SqlServer);

    private void NewConnection(DatabaseKind kind)
    {
        _selectedId = null;
        _kind = kind == DatabaseKind.PostgreSql && !SqlConn.EngineSupportsPostgres ? DatabaseKind.SqlServer : kind;
        _name = string.Empty;
        _server = "localhost";
        _database = "master";
        _windowsAuth = true;
        _login = string.Empty;
        _password = string.Empty;
        _trustServerCertificate = false;
        ResetPostgresFields();
        _message = null;
        ClearDatabaseList();
    }

    private void ResetPostgresFields()
    {
        _pgHost = "localhost";
        _pgPort = SavedSqlConnection.DefaultPostgresPort;
        _pgDatabase = "postgres";
        _pgUser = string.Empty;
        _pgPassword = string.Empty;
        _pgSslMode = "prefer";
        _pgRootCert = string.Empty;
        _pgRemember = false;
        _pgHasRemembered = false;
    }

    // The kind switch: the other kind's fields start from their defaults, so nothing typed for one server leaks into the other.
    // A switch is a new connection of the other kind: the selected saved connection's name does not carry over to it.
    private async Task SetKind(DatabaseKind kind)
    {
        if (_kind == kind) return;
        if (kind == DatabaseKind.PostgreSql && !SqlConn.EngineSupportsPostgres) return;
        _kind = kind;
        _message = null;
        if (_selectedId != null) _name = string.Empty;
        _selectedId = null;
        ClearDatabaseList();
        if (kind == DatabaseKind.PostgreSql) ResetPostgresFields();
        else
        {
            _server = "localhost";
            _database = "master";
            _windowsAuth = true;
            _login = string.Empty;
            _password = string.Empty;
            _trustServerCertificate = false;
            await LoadDatabasesAsync();   // Windows authentication needs no password: the list fills as it did on open
        }
    }

    private async Task LoadPgDatabasesAsync()
    {
        _dbLoading = true;
        _dbMessage = null;
        StateHasChanged();
        try
        {
            var (ok, dbs, error) = await SqlConn.ListDatabasesAsync(PgTarget(), CancellationToken.None);
            if (ok)
            {
                _databases = dbs.ToList();
                _dbMessage = _databases.Count == 0 ? "No databases this role can connect to." : $"{_databases.Count} database(s): type or pick one.";
            }
            else
            {
                _dbMessage = error;
            }
        }
        finally
        {
            _dbLoading = false;
            StateHasChanged();
        }
    }

    private void SelectSaved(SavedSqlConnection c)
    {
        _selectedId = c.Id;
        _name = c.Name;
        _kind = c.Kind;
        if (c.Kind == DatabaseKind.PostgreSql)
        {
            _pgHost = c.Server;
            _pgPort = c.EffectivePort;
            _pgDatabase = c.Database;
            _pgUser = c.Login ?? string.Empty;
            _pgPassword = string.Empty;   // never stored in the browser
            _pgSslMode = c.SslMode ?? "prefer";
            _pgRootCert = c.RootCertificatePath ?? string.Empty;
            _pgRemember = c.RememberPassword;
            _pgHasRemembered = false;     // asked of the engine once the row is shown
            _message = null;
            ClearDatabaseList();
            _ = InvokeAsync(RefreshRememberedAsync);
            return;
        }

        _server = c.Server;
        _database = c.Database;
        _windowsAuth = c.WindowsAuth;
        _login = c.Login ?? string.Empty;
        _password = string.Empty;   // never stored — re-prompt for SQL auth
        _trustServerCertificate = c.TrustServerCertificate;
        _message = null;
        ClearDatabaseList();

        // Spec 032 FR-033 (campaign finding 6): SEED the option list with the saved
        // database so the dropdown deterministically DISPLAYS it. Relying only on the
        // synthetic fallback option raced Blazor's bind/render order and the select
        // showed the browser default ("master") while the BOUND value was correct —
        // display and target must never diverge.
        if (!string.IsNullOrWhiteSpace(c.Database))
            _databases.Add(c.Database);
    }

    // Drops any server-specific database list so a stale list from a different server/auth is never
    // shown. The current _database stays selected (rendered as a synthetic option in the dropdown).
    private void ClearDatabaseList()
    {
        _databases.Clear();
        _dbMessage = null;
    }

    private void SetAuth(bool windows)
    {
        if (_windowsAuth == windows) return;
        _windowsAuth = windows;
        ClearDatabaseList();   // accessible-database set depends on the identity/login
    }

    // Server edited (on blur/change) — the previous list belongs to a different host, so drop it.
    private void OnServerChanged() => ClearDatabaseList();

    /// <summary>
    /// Fetches the server's databases into the dropdown. SQL auth needs the password first (same as
    /// Test/Connect). Best-effort: on failure the current value stays selectable and a hint explains.
    /// </summary>
    private async Task LoadDatabasesAsync()
    {
        if (!_windowsAuth && string.IsNullOrEmpty(_password))
        {
            _dbMessage = "Enter the SQL password, then refresh the database list.";
            return;
        }

        _dbLoading = true;
        _dbMessage = null;
        StateHasChanged();
        try
        {
            var (ok, dbs, error) = await SqlConn.ListDatabasesAsync(SqlServerTarget(), CancellationToken.None);

            if (ok)
            {
                _databases = dbs.ToList();
                _dbMessage = _databases.Count == 0 ? "No accessible databases on this server." : null;
            }
            else
            {
                _dbMessage = error;
            }
        }
        finally
        {
            _dbLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>The SQL Server form as a target; the certificate choice travels with it (review WEB-02).</summary>
    private ConnectionTarget SqlServerTarget() => new(DatabaseKind.SqlServer, _server, _database, WindowsAuth: _windowsAuth,
        User: _windowsAuth ? null : _login, Password: _windowsAuth ? null : _password, TrustServerCertificate: _trustServerCertificate);

    // ── PostgreSQL (spec 042) ────────────────────────────────────────────────────────────────────────────

    private ConnectionTarget PgTarget() => new(DatabaseKind.PostgreSql, _pgHost, _pgDatabase, WindowsAuth: false,
        User: _pgUser, Password: _pgPassword, Port: _pgPort, SslMode: _pgSslMode,
        RootCertificatePath: string.IsNullOrWhiteSpace(_pgRootCert) ? null : _pgRootCert, RememberPassword: _pgRemember);

    // Asks the engine whether it holds a password for this host, port and user. Never fetches the password itself.
    private async Task RefreshRememberedAsync()
    {
        if (_kind != DatabaseKind.PostgreSql) return;
        var (host, port, _) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
        _pgHasRemembered = host != null && !string.IsNullOrWhiteSpace(_pgUser)
            && await SqlConn.HasRememberedPasswordAsync(host, port, _pgUser, CancellationToken.None);
        // With a remembered password the list needs nothing more from the user, so it fills as SQL Server's does on open.
        if (_pgHasRemembered && _databases.Count == 0 && !_dbLoading) await LoadPgDatabasesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnPgIdentityChanged() => RefreshRememberedAsync();

    private async Task ForgetPasswordAsync()
    {
        var (host, port, error) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
        if (host == null) { SetMessage(error ?? "Enter the host first.", isError: true); return; }
        _busy = true;
        StateHasChanged();
        try
        {
            await SqlConn.ForgetRememberedPasswordAsync(host, port, _pgUser, CancellationToken.None);
            _pgHasRemembered = await SqlConn.HasRememberedPasswordAsync(host, port, _pgUser, CancellationToken.None);
            if (!_pgHasRemembered) _pgRemember = false;
            SetMessage(_pgHasRemembered ? "The engine could not forget the password." : "The remembered password was forgotten.", isError: _pgHasRemembered);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // What a failed PostgreSQL test or connect says. A missing password is a prompt, not a failure, and it offers to remember the
    // one typed. A password the engine remembered that the server no longer accepts says so and how to replace it (FR-105): the
    // Remember option stays on, so connecting with the new password overwrites the old one.
    private string PgFailureText(ConnectResult result, string fallback)
    {
        if (result.PasswordRequired)
            return "The server asked for a password. Enter the password and try again; turn on Remember password to keep it on the engine machine.";

        var rejected = result.Error != null
            && (result.Error.Contains("28P01", StringComparison.Ordinal)
                || result.Error.Contains("password authentication failed", StringComparison.OrdinalIgnoreCase));
        if (_pgHasRemembered && rejected)
            return "The remembered password was not accepted by the server. Enter the current password and keep Remember password on to replace it.";

        return result.Error ?? fallback;
    }

    // "PostgreSQL 18.1 on db1:5432" (FR-002), or the engine's own words; a missing password is a prompt, not a failure.
    private async Task TestPostgresAsync()
    {
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await SqlConn.TestAsync(PgTarget(), CancellationToken.None);
            if (result.Ok)
            {
                var (host, port, _) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
                SetMessage($"{result.ServerVersion ?? "PostgreSQL"} on {host}:{port}", isError: false);
            }
            else
            {
                SetMessage(PgFailureText(result, "Connection test failed."), isError: true);
            }
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SavePostgresAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var (host, port, error) = SqlConnectionService.ParseHostAndPort(_pgHost, _pgPort);
            if (host == null) throw new ArgumentException(error);

            var database = string.IsNullOrWhiteSpace(_pgDatabase) ? "postgres" : _pgDatabase.Trim();
            var name = string.IsNullOrWhiteSpace(_name) ? $"{host} / {database}" : _name.Trim();
            var record = new SavedSqlConnection
            {
                Id = _selectedId ?? Guid.NewGuid().ToString("N"),
                Name = name,
                Kind = DatabaseKind.PostgreSql,
                Server = host,
                Database = database,
                WindowsAuth = false,
                Login = string.IsNullOrWhiteSpace(_pgUser) ? null : _pgUser.Trim(),
                Port = port,
                SslMode = _pgSslMode,
                RootCertificatePath = string.IsNullOrWhiteSpace(_pgRootCert) ? null : _pgRootCert.Trim(),
                RememberPassword = _pgRemember,
            };
            if (_selectedId == null) await Store.AddAsync(record);
            else await Store.UpdateAsync(record);
            _selectedId = record.Id;
            await Store.SetActiveIdAsync(_selectedId);
            await ReloadAsync();
            _name = name;
            SetMessage("Saved.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        _busy = false;
        StateHasChanged();
    }

    // Spec 042 (FR-009): connecting somewhere else drops the session, and with it any open transaction. The engine rolls it
    // back; it never commits. Ask first, naming what is lost.
    private async Task<bool> ConfirmLeaveTransactionAsync()
    {
        if (!SqlConn.IsConnected || SqlConn.TransactionState == TransactionState.None) return true;
        var aborted = SqlConn.TransactionState == TransactionState.Aborted;
        return await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = aborted ? "Aborted transaction" : "Open transaction",
            Message = (aborted
                ? "The current session has a transaction that an error aborted. "
                : "The current session has an open transaction. ")
                + "Connecting to another server rolls it back. Nothing is committed.",
            ConfirmLabel = "Roll back and connect",
            Destructive = true,
        });
    }

    private async Task ConnectPostgresAsync()
    {
        if (!await ConfirmLeaveTransactionAsync()) return;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await SqlConn.ConnectAsync(PgTarget(), CancellationToken.None);
            if (result.Ok)
            {
                if (!string.IsNullOrEmpty(_selectedId))
                {
                    try
                    {
                        var existing = await Store.GetAsync(_selectedId!);
                        if (existing != null)
                        {
                            existing.LastConnectedAt = DateTimeOffset.UtcNow;
                            await Store.UpdateAsync(existing);
                            await Store.SetActiveIdAsync(existing.Id);
                        }
                    }
                    catch { /* best-effort metadata update — connect already succeeded */ }
                }
                Close();
                return;
            }
            SetMessage(PgFailureText(result, "Connect failed."), isError: true);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task TestAsync()
    {
        if (_kind == DatabaseKind.PostgreSql) { await TestPostgresAsync(); return; }

        // Passwords are never stored, so a saved SQL-auth connection loads with an empty password.
        // Require one rather than silently testing with "" (which always fails confusingly).
        if (!_windowsAuth && string.IsNullOrEmpty(_password))
        {
            SetMessage("Enter the SQL password to test this connection (passwords are never stored).", isError: true);
            return;
        }
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            var result = await SqlConn.TestAsync(SqlServerTarget(), CancellationToken.None);
            SetMessage(result.Ok ? "Connection test succeeded." : (result.Error ?? "Connection test failed."), isError: !result.Ok);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_kind == DatabaseKind.PostgreSql) { await SavePostgresAsync(); return; }

        _busy = true;
        _message = null;
        try
        {
            // Default the display name to the server/db if the user left it blank.
            var name = string.IsNullOrWhiteSpace(_name) ? $"{_server} / {_database}" : _name.Trim();
            if (_selectedId == null)
            {
                var record = new SavedSqlConnection
                {
                    Name = name,
                    Server = _server.Trim(),
                    Database = _database.Trim(),
                    WindowsAuth = _windowsAuth,
                    Login = _windowsAuth ? null : (string.IsNullOrWhiteSpace(_login) ? null : _login.Trim()),
                    TrustServerCertificate = _trustServerCertificate,
                };
                await Store.AddAsync(record);
                _selectedId = record.Id;
            }
            else
            {
                var record = new SavedSqlConnection
                {
                    Id = _selectedId,
                    Name = name,
                    Server = _server.Trim(),
                    Database = _database.Trim(),
                    WindowsAuth = _windowsAuth,
                    Login = _windowsAuth ? null : (string.IsNullOrWhiteSpace(_login) ? null : _login.Trim()),
                    TrustServerCertificate = _trustServerCertificate,
                };
                await Store.UpdateAsync(record);
            }
            await Store.SetActiveIdAsync(_selectedId);
            await ReloadAsync();
            _name = name;
            SetMessage("Saved.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        _busy = false;
        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        if (string.IsNullOrEmpty(_selectedId)) return;
        // Spec 041 (FR-057, FR-102): deleting a saved connection confirms, naming it.
        var name = (await Store.GetAsync(_selectedId!))?.Name;
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Delete saved connection",
            Message = string.IsNullOrEmpty(name) ? "Delete this saved connection?" : $"Delete the saved connection “{name}”?",
            ConfirmLabel = "Delete",
            Destructive = true,
        });
        if (!ok) return;
        _busy = true;
        _message = null;
        try
        {
            await Store.RemoveAsync(_selectedId!);
            await ReloadAsync();
            NewConnection();
            SetMessage("Deleted.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        _busy = false;
        StateHasChanged();
    }

    private async Task ConnectAsync()
    {
        if (_kind == DatabaseKind.PostgreSql) { await ConnectPostgresAsync(); return; }

        if (!_windowsAuth && string.IsNullOrEmpty(_password))
        {
            SetMessage("Enter the SQL password to connect (passwords are never stored).", isError: true);
            return;
        }
        if (!await ConfirmLeaveTransactionAsync()) return;
        _busy = true;
        _message = null;
        StateHasChanged();
        try
        {
            // Review WEB-19: the engine opens the connection before the session switches; a refusal keeps the dialog open
            // with what was typed, so it can be corrected.
            var result = await SqlConn.ConnectAsync(SqlServerTarget(), CancellationToken.None);
            if (result.Ok)
            {
                // Persist LastConnectedAt + remember this as the active saved row when it maps to one.
                if (!string.IsNullOrEmpty(_selectedId))
                {
                    try
                    {
                        var existing = await Store.GetAsync(_selectedId!);
                        if (existing != null)
                        {
                            existing.LastConnectedAt = DateTimeOffset.UtcNow;
                            await Store.UpdateAsync(existing);
                            await Store.SetActiveIdAsync(existing.Id);
                        }
                    }
                    catch { /* best-effort metadata update — connect already succeeded */ }
                }
                Close();   // MainLayout's StateChanged owner starts SchemaSync on SqlConn.SessionId.
                return;
            }
            SetMessage(result.Error ?? "Connect failed.", isError: true);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }

    private void OnPanelKeyDown(KeyboardEventArgs e)
    {
        // Esc cancels (deliberate-click Connect; Esc/scrim-click are the only dismiss paths).
        if (e.Key == "Escape") Close();
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
        if (_module != null)
        {
            _ = _module.InvokeVoidAsync("restoreFocus");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOnNextRender && _open)
        {
            _focusOnNextRender = false;
            if (_module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("stashFocus");
                    // Prefer the first form field (#conn-name) over the header Close button so SR
                    // users don't enter the connect dialog on "Close".
                    await _module.InvokeVoidAsync("focusFirst", _panelRef, "#conn-name");
                    await _module.InvokeVoidAsync("trapTab", _panelRef);
                }
                catch (JSDisconnectedException) { /* tab closing — ignore */ }
                catch (Microsoft.JSInterop.JSException) { /* element not in DOM yet — harmless */ }
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        Controller.OpenRequested -= OnOpenRequested;
        SqlConn.StateChanged -= OnSqlStateChanged;
        try
        {
            if (_module != null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* tab closing */ }
    }
}
