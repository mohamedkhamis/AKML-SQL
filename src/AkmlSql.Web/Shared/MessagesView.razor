@*
    Spec 041 (research R20, R24, FR-022, FR-023, FR-035) — the Messages tab: every message of an execute in
    stream order, worded as SSMS words them (Core SqlMessageText); an error that maps to a line of the
    document is a button that takes the editor there; the last line is the completion time in local time.
    An older engine sends only the legacy strings, which are shown as they came. Styles: .akml-messages* in
    components/results-grid.css.

    Spec 042 (FR-013, FR-014): a PostgreSQL error reads "SQLSTATE 42P01: message" with its DETAIL and HINT lines, and
    its button goes to the line AND the column; a notice or warning is not an error and is drawn quieter (its level is in
    its text, so colour is never the only sign).
*@
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Core.Text
@using AkmlSql.Web.Services

<div class="akml-messages" role="log" aria-label="Messages" data-testid="messages-list">
    @for (int i = 0; i < _lines.Count; i++)
    {
        var index = i;
        var line = _lines[index];
        <div class="akml-messages-line @(line.IsError ? "akml-messages-line--error" : null) @(line.IsSystem ? "akml-messages-line--system" : null) @(line.IsNotice ? "akml-messages-line--notice" : null) @(line.IsWarning ? "akml-messages-line--warning" : null)"
             data-testid="@($"messages-line-{index}")">
            @if (line.IsError && line.DocumentLine is int target)
            {
                <button type="button" class="akml-messages-error" data-testid="@($"messages-error-{index}")"
                        title="@(line.DocumentColumn is int col ? $"Go to line {target}, column {col}" : $"Go to line {target}")"
                        @onclick="() => NavigateAsync(target, line.DocumentColumn)">@line.Text</button>
            }
            else if (line.IsError)
            {
                <span class="akml-messages-error-text" data-testid="@($"messages-error-{index}")">@line.Text</span>
            }
            else
            {
                @line.Text
            }
        </div>
    }
    @if (_completion != null)
    {
        <div class="akml-messages-line akml-messages-line--completion" data-testid="messages-completion">@_completion</div>
    }
</div>

@code {
    /// <summary>The execute (or parse) the messages belong to.</summary>
    [Parameter, EditorRequired] public ExecuteQueryResult Result { get; set; } = default!;

    /// <summary>The document line the executed text started on (1 for the whole document).</summary>
    [Parameter] public int SelectionStartLine { get; set; } = 1;

    /// <summary>The document column the executed text started at on its first line (1 for the whole document).</summary>
    [Parameter] public int SelectionStartColumn { get; set; } = 1;

    /// <summary>When the reply arrived; the completion time when the engine sent none.</summary>
    [Parameter] public DateTimeOffset ReceivedAt { get; set; } = DateTimeOffset.Now;

    /// <summary>An error was clicked: the document line it points at.</summary>
    [Parameter] public EventCallback<int> OnNavigate { get; set; }

    /// <summary>Spec 042: a PostgreSQL error was clicked: its line and column. When nobody listens, <see cref="OnNavigate"/> gets the line.</summary>
    [Parameter] public EventCallback<DocumentPosition> OnNavigateToPosition { get; set; }

    private sealed record Line(string Text, bool IsError, bool IsSystem, int? DocumentLine, int? DocumentColumn = null,
        bool IsNotice = false, bool IsWarning = false);

    private List<Line> _lines = new();
    private string? _completion;

    private Task NavigateAsync(int line, int? column)
    {
        if (column is int c && OnNavigateToPosition.HasDelegate) return OnNavigateToPosition.InvokeAsync(new DocumentPosition(line, c));
        return OnNavigate.InvokeAsync(line);
    }

    protected override void OnParametersSet()
    {
        var result = Result;
        var lines = new List<Line>();
        var details = result.MessageDetails ?? Array.Empty<ExecuteMessageDto>();
        if (details.Length > 0)
        {
            foreach (var m in details)
            {
                // A notice or warning from PostgreSQL is information with a level in its text, never an error.
                var notice = m.Kind == ExecuteMessageKind.Info && !string.IsNullOrEmpty(m.SqlState);
                lines.Add(new Line(SqlMessageText.Format(m), m.Kind == ExecuteMessageKind.Error, m.Kind == ExecuteMessageKind.System,
                    ExecuteLineMapper.DocumentLine(SelectionStartLine, result, m),
                    ExecuteLineMapper.DocumentColumn(SelectionStartColumn, m),
                    IsNotice: notice,
                    IsWarning: notice && (m.Text ?? string.Empty).StartsWith("WARNING", StringComparison.Ordinal)));
            }
        }
        else
        {
            // An older engine: the legacy strings, as they came.
            foreach (var text in result.Messages ?? Array.Empty<string>()) lines.Add(new Line(text, false, false, null));
        }

        if (lines.Count == 0)
        {
            if (result.Status == ExecuteStatus.Ok) lines.Add(new Line(SqlMessageText.CommandsCompleted, false, false, null));
            else if (!string.IsNullOrEmpty(result.ErrorMessage)) lines.Add(new Line(result.ErrorMessage!, true, false, null));
        }
        else if (!string.IsNullOrEmpty(result.ErrorMessage) && result.Status != ExecuteStatus.Ok && result.Status != ExecuteStatus.Error
                 && !lines.Any(l => l.IsError))
        {
            // A timeout, cancellation or dropped reply with no server error to show: say why it stopped.
            lines.Add(new Line(result.ErrorMessage!, true, false, null));
        }
        _lines = lines;

        // Only a run the engine finished (or answered at all) has a completion time.
        bool answered = result.Status is not (ExecuteStatus.NoConnection or ExecuteStatus.NoReply or ExecuteStatus.Disconnected);
        _completion = answered
            ? SqlMessageText.CompletionLine(result.CompletedAtUnixMs > 0
                ? DateTimeOffset.FromUnixTimeMilliseconds(result.CompletedAtUnixMs).ToLocalTime()
                : ReceivedAt.ToLocalTime())
            : null;
    }
}
