    // ── NULL (FR-014) ──────────────────────────────────────────────────────────────────────────────

    /// <summary>Why Set to NULL is unavailable on a cell; null when it is available. The NOT NULL reason is
    /// given only for a column that comes from a table, so exotic sources show no false reason (R14).</summary>
    private string? SetNullBlockedReason(int row, int col)
    {
        if (!Set.IsEditable) return Set.ReadOnlyReason ?? "This result can't be edited.";
        if (LockReason != null) return LockReason;
        if (_deletes.Contains(row)) return "The row is marked for deletion.";
        if (IsUnconfirmed(row)) return UnconfirmedTitle;
        if (!IsColumnEditable(col)) return $"{ColumnLabel(col)} can't be edited.";
        if (AllowsNull(col) == false) return $"{ColumnLabel(col)} does not allow NULL.";
        return null;
    }

    private void SetFocusedToNull()
    {
        if (_area != FocusArea.Cell || _selection.IsEmpty) return;
        var f = _selection.Focus;
        int row = _rowIndexes[f.Row];
        var reason = SetNullBlockedReason(row, f.Col);
        if (reason != null)
        {
            // A read-only result stays quiet unless the engine said why (spec 042): then the key press gets its answer.
            if (Set.IsEditable || !string.IsNullOrEmpty(Set.ReadOnlyReason)) Notify(reason, NotificationKind.Info);
            return;
        }
        CommitEdit(row, f.Col, null);
    }

    // ── Editing (FR-013) ───────────────────────────────────────────────────────────────────────────

    private void OnCellDoubleClick(int displayRow, int col)
    {
        // The second click can already have opened an editor and replaced the cell DOM before
        // Blazor dispatches dblclick. Do not let that stale event move editing to another cell.
        if (!IsEditing) BeginEdit(displayRow, col);
    }

    private void BeginEdit(int displayRow, int col, string? replaceWith = null)
    {
        int row = _rowIndexes[displayRow];
        if (_editInsert < 0 && _editRow == row && _editCol == col) return;   // already editing it
        if (Set.IsEditable && RefuseWhileLocked()) return;
        if (!IsCellEditable(row, col)) return;
        _editSession++;
        _editRow = row;
        _editDisplay = displayRow;
        _editCol = col;
        _editInsert = -1;
        _editReplaced = replaceWith != null;
        _editInitial = replaceWith ?? EditText(CurrentWire(row, col), col) ?? string.Empty;
        _menu = null;
    }

    private void BeginInsertEdit(int insIdx, int col)
    {
        if (insIdx < 0 || insIdx >= _inserts.Count || !IsColumnInsertable(col)) return;
        if (_editInsert == insIdx && _editCol == col) return;
        if (RefuseWhileLocked()) return;
        _editSession++;
        _editRow = -1;
        _editDisplay = -1;
        _editCol = col;
        _editInsert = insIdx;
        _editReplaced = false;
        _editInitial = EditText(_inserts[insIdx].TryGetValue(col, out var v) ? v : null, col) ?? string.Empty;
    }

    private void EndEdit()
    {
        _editRow = _editDisplay = _editCol = _editInsert = -1;
        _editReplaced = false;
    }

    /// <param name="session">The edit the reporting editor belongs to: a replaced editor's late blur is ignored.</param>
    private Task OnEditorDoneAsync(int session, GridEditorResult result)
    {
        if (!IsEditing || session != _editSession) return Task.CompletedTask;
        int row = _editRow, display = _editDisplay, col = _editCol, ins = _editInsert;
        // An untouched editor changes nothing (F2 then Enter on a NULL int must not make it blank).
        bool changed = _editReplaced || !string.Equals(result.Value, _editInitial, StringComparison.Ordinal);
        if (result.Exit != GridEditorExit.Cancel && changed)
        {
            if (ins >= 0) CommitInsert(ins, col, result.Value);
            else CommitEdit(row, col, result.Value);
        }
        EndEdit();

        switch (result.Exit)
        {
            case GridEditorExit.Enter:
            case GridEditorExit.Cancel:
                _focusRootPending = true;
                break;
            case GridEditorExit.Tab:
            case GridEditorExit.TabBack:
                bool back = result.Exit == GridEditorExit.TabBack;
                if (ins >= 0)
                {
                    var next = NextInsertCell(ins, col, back);
                    if (next is { } n) BeginInsertEdit(n.Insert, n.Col);
                    else _focusRootPending = true;
                }
                else
                {
                    var next = NextEditableCell(display, col, back);
                    if (next is { } n)
                    {
                        _selection.Click(n.Display, n.Col, false, false);
                        _area = FocusArea.Cell;
                        BeginEdit(n.Display, n.Col);
                        _scrollPending = true;
                    }
                    else
                    {
                        _focusRootPending = true;
                    }
                }
                break;
        }
        return Task.CompletedTask;
    }

    /// <summary>The next (or previous) editable cell in display order, row by row.</summary>
    private (int Display, int Col)? NextEditableCell(int display, int col, bool back)
    {
        int cols = ColumnCount;
        long total = (long)RowCount * cols;
        long pos = (long)display * cols + col;
        for (long p = back ? pos - 1 : pos + 1; p >= 0 && p < total; p += back ? -1 : 1)
        {
            int d = (int)(p / cols), c = (int)(p % cols);
            if (IsCellEditable(_rowIndexes[d], c)) return (d, c);
        }
        return null;
    }

    private (int Insert, int Col)? NextInsertCell(int insIdx, int col, bool back)
    {
        int cols = ColumnCount;
        int total = _inserts.Count * cols;
        for (int p = insIdx * cols + col + (back ? -1 : 1); p >= 0 && p < total; p += back ? -1 : 1)
        {
            if (IsColumnInsertable(p % cols)) return (p / cols, p % cols);
        }
        return null;
    }

    private void CommitEdit(int row, int col, string? value)
    {
        if (row < 0 || row >= Set.Rows.Length || RefuseWhileLocked()) return;
        // The cell value is stored in wire form: a date, time or binary value typed the way the grid shows it is
        // converted (ToWire); anything else verbatim (a blank input is kept as an empty string — invalid on a
        // non-character type until a value or NULL is set). The write path binds it through
        // SqlScalarEncoder.Decode for the column's type. null = SQL NULL.
        value = ToWire(value, col);
        var original = Set.Rows[row].ElementAtOrDefault(col);
        if (!string.Equals(original, value, StringComparison.Ordinal))
        {
            if (!_edits.TryGetValue(row, out var rowEdits))
            {
                rowEdits = new Dictionary<int, string?>();
                _edits[row] = rowEdits;
            }
            rowEdits[col] = value;
            // A value longer than its column widens it, so the edit is not shown cut short ("beta ed…"). A width the user
            // set stays: WidthPx keeps returning it.
            if (value != null)
            {
                int px = GridColumnLayout.Fit(GridColumnLayout.EstimatePx(ColumnLabel(col)), GridColumnLayout.EstimatePx(Format(value, col, false).Text));
                if (px > _layout.WidthPx(col)) _layout.ApplyFit(col, px);
            }
        }
        else if (_edits.TryGetValue(row, out var rowEdits))
        {
            // Back to the fetched value: no longer a change.
            rowEdits.Remove(col);
            if (rowEdits.Count == 0) _edits.Remove(row);
        }
    }

    private void CommitInsert(int insIdx, int col, string? value)
    {
        if (RefuseWhileLocked()) return;
        if (insIdx >= 0 && insIdx < _inserts.Count) _inserts[insIdx][col] = ToWire(value, col);
    }

    private void ToggleDelete(int row)
    {
        if (RefuseWhileLocked() || IsUnconfirmed(row)) return;
        if (!_deletes.Remove(row)) _deletes.Add(row);
        // A deleted row's pending edits are moot.
        if (_deletes.Contains(row)) _edits.Remove(row);
    }

    private void AddNewRow()
    {
        if (RefuseWhileLocked()) return;
        _inserts.Add(new Dictionary<int, string?>());
    }

    private void RemoveInsert(int insIdx)
    {
        if (RefuseWhileLocked()) return;
        if (insIdx >= 0 && insIdx < _inserts.Count) _inserts.RemoveAt(insIdx);
        if (_editInsert >= 0) EndEdit();
    }

    /// <summary>The Discard button: ask first (FR-015), then drop this set's pending edits only.</summary>
    private async Task DiscardEditsAsync()
    {
        if (_applying) return;
        if (Dialogs is { } dialogs)
        {
            int n = PendingEditCount;
            bool discard = await dialogs.ConfirmAsync(new DialogRequest
            {
                Title = $"Discard {Plural(n, "pending edit")}?",
                Message = "The changes in this result have not been applied. Discard them?",
                ConfirmLabel = "Discard",
                CancelLabel = "Keep editing",
                Destructive = true,
            });
            if (!discard) return;
        }
        ResetEditState();
    }

    // ── Apply ──────────────────────────────────────────────────────────────────────────────────────

    /// <summary>
    /// After a successful Apply, reflect the committed edits / deletes / inserts in the in-memory
    /// result set so the grid stays consistent with the database WITHOUT re-running the query. The
    /// page only re-runs single read-only SELECTs (see Editor.OnAppliedReExecuteAsync /
    /// <see cref="QueryRefreshSafety"/>); for a multi-statement batch we must NOT re-run it (that
    /// would repeat its side effects), so without this the grid would revert to the stale pre-edit
    /// values when the overlay is cleared. When the page DOES re-run, the fresh result simply
    /// replaces these rows. An INSERT's server-filled values come back as the stored row (PostgreSQL RETURNING, SQL Server's
    /// key-based read-back); one that comes back without it is marked not read back (<see cref="_unconfirmed"/>).
    /// </summary>
    private void BakeCommittedChangesIntoSet(ExecuteResultSet set, IReadOnlyDictionary<int, string?[]>? storedUpdates = null,
        IReadOnlyDictionary<int, string?[]>? storedInserts = null, IReadOnlyDictionary<int, string>? identities = null)
    {
        int identityCol = Array.FindIndex(set.Provenance, p => p.IsAutoIncrement);
        int colCount = set.ColumnNames.Length;
        var rows = new List<string?[]>(set.Rows.Length + _inserts.Count);
        var unconfirmed = new Dictionary<int, HashSet<int>>();
        for (int r = 0; r < set.Rows.Length; r++)
        {
            if (_deletes.Contains(r)) continue;                  // committed delete → drop the row
            if (_unconfirmed.TryGetValue(r, out var stillUnknown)) unconfirmed[rows.Count] = stillUnknown;   // still not read back
            var row = set.Rows[r];
            if (_edits.TryGetValue(r, out var rowEdits))         // committed edits → overwrite cells
            {
                foreach (var (c, v) in rowEdits)
                    if (c >= 0 && c < row.Length) row[c] = v;
            }
            // Spec 042 (FR-133): a PostgreSQL write returns the row as the server stored it (defaults, a trigger's changes,
            // the form the type prints in); that replaces what was typed.
            if (storedUpdates != null && storedUpdates.TryGetValue(r, out var storedRow)) OverlayStored(row, storedRow);
            rows.Add(row);
        }
        for (int i = 0; i < _inserts.Count; i++)                 // committed inserts → append rows
        {
            var row = new string?[colCount];
            foreach (var (c, v) in _inserts[i])
                if (c >= 0 && c < colCount) row[c] = v;
            if (storedInserts != null && storedInserts.TryGetValue(i, out var storedRow)) OverlayStored(row, storedRow);
            else
            {
                // Review round 3 (REV-06): the server did not return the stored row. Show what is known — the typed cells and the
                // returned identity — and mark the rest as not read back instead of presenting them as committed values.
                var known = new HashSet<int>(_inserts[i].Keys);
                if (identityCol >= 0 && identityCol < colCount && identities != null && identities.TryGetValue(i, out var id))
                {
                    row[identityCol] = id;
                    known.Add(identityCol);
                }
                unconfirmed[rows.Count] = known;
            }
            rows.Add(row);
        }
        set.Rows = rows.ToArray();
        _unconfirmed.Clear();
        foreach (var (row, columns) in unconfirmed) _unconfirmed[row] = columns;
    }

    /// <summary>Writes a returned row's values over the cells of the columns that were asked for (<see cref="_returnOrdinals"/>).</summary>
    private void OverlayStored(string?[] row, string?[] stored)
    {
        for (int k = 0; k < stored.Length && k < _returnOrdinals.Length; k++)
        {
            int c = _returnOrdinals[k];
            if (c >= 0 && c < row.Length) row[c] = stored[k];
        }
    }

    /// <summary>What each edit of the request in flight stands for, in request order, so a result can be matched back to its row.</summary>
    private readonly List<(int Op, int Index)> _applyTargets = new();

    /// <summary>Result-column ordinals of the columns the request asked the server to return, in the same order.</summary>
    private int[] _returnOrdinals = System.Array.Empty<int>();

    private async Task ApplyEditsAsync()
    {
        var set = Set;
        if (set == null || !set.IsEditable || _applying || FrozenReason != null || InvalidCellCount > 0) return;

        _applying = true;
        _applyMessage = null;
        StateHasChanged();

        try
        {
            var req = BuildApplyRequest(set);
            var result = Session != null
                ? await QueryExec.ApplyAsync(Session, req, System.Threading.CancellationToken.None)
                : await QueryExec.ApplyAsync(req, System.Threading.CancellationToken.None);

            // A new run replaced the result while the reply was on its way: the pending state now belongs to that result, so
            // nothing here may be baked in or cleared. (The page refuses to run while an Apply is waiting; this is the backstop.)
            if (!ReferenceEquals(Set, set)) return;

            if (result.Status == ExecuteStatus.Ok)
            {
                // Reflect the committed changes in-memory BEFORE clearing the overlay so the grid shows
                // the new values even when the page declines to re-run the query (multi-statement batch).
                var storedUpdates = new Dictionary<int, string?[]>();
                var storedInserts = new Dictionary<int, string?[]>();
                var identities = new Dictionary<int, string>();
                foreach (var edit in result.Results ?? System.Array.Empty<CrudEditResult>())
                {
                    if (!edit.Ok || edit.Index < 0 || edit.Index >= _applyTargets.Count) continue;
                    var (op, index) = _applyTargets[edit.Index];
                    // Re-review REV-06: a SQL Server insert into a table with a trigger returns only its identity; keep it, so the
                    // new row has its key for the next edit or delete.
                    if (op == CrudOp.Insert && edit.Row == null && !string.IsNullOrEmpty(edit.NewIdentity)) identities[index] = edit.NewIdentity!;
                    if (edit.Row == null) continue;
                    if (op == CrudOp.Update) storedUpdates[index] = edit.Row;
                    else if (op == CrudOp.Insert) storedInserts[index] = edit.Row;
                }
                int notReadBack = _inserts.Count - storedInserts.Count;
                BakeCommittedChangesIntoSet(set, storedUpdates, storedInserts, identities);
                ResetEditState();
                RebuildRowIndexes();             // deletes/inserts changed the row set.
                _layout.SetRowCount(set.Rows.Length);
                if (_sortCol >= 0) ApplySort();  // the sort STATE survived; order the new rows by it.
                // Set the success message AFTER ResetEditState — which clears _applyMessage — so it
                // actually surfaces (previously it was set then immediately nulled by the reset).
                _applyOk = true;
                _applyMessage = $"Applied {req.Edits.Length} change(s).";
                if (notReadBack > 0)
                    _applyMessage += notReadBack == 1
                        ? " 1 new row could not be read back — use a SELECT query to check what was stored."
                        : $" {notReadBack} new rows could not be read back — use a SELECT query to check what was stored.";
                // Caller may re-run the query to refresh; we surface the success and clear tints.
                await OnApplied.InvokeAsync();
            }
            else
            {
                _applyOk = false;
                // Surface the SPECIFIC failed edit from the per-edit results (the engine rolled the whole
                // batch back, so nothing persisted). Every other edit carries the engine's "Rolled back —
                // edit N failed." note, which must not win just because it comes first. Keep the pending
                // edits — do NOT ResetEditState — so the user can correct the offending value and re-Apply.
                var failed = (result.Results ?? System.Array.Empty<CrudEditResult>())
                    .FirstOrDefault(r => !r.Ok && !string.IsNullOrEmpty(r.Error)
                                         && !r.Error.StartsWith("Rolled back — edit ", StringComparison.Ordinal));
                _applyMessage = failed?.Error ?? result.ErrorMessage ?? "Apply failed.";
                if (result.ConnectionWasReset)
                    _applyMessage += " (connection was reset — #temp/SET state lost.)";
            }
        }
        finally
        {
            _applying = false;
            StateHasChanged();
        }
    }

    private ApplyChangesRequest BuildApplyRequest(ExecuteResultSet set)
    {
        var edits = new List<CrudEditDto>();
        _applyTargets.Clear();

        // Key columns: prefer true PK; fall back to any IsKey column.
        var keyProv = set.Provenance.Where(p => p.IsTruePrimaryKey).ToList();
        if (keyProv.Count == 0) keyProv = set.Provenance.Where(p => p.IsKey).ToList();

        // UPDATE SET: writable NON-KEY columns (keys go to the WHERE, never the SET).
        bool IsUpdatable(ColumnProvenanceDto p) =>
            !p.IsReadOnly && !p.IsExpression && !p.IsAutoIncrement
            && !p.IsKey && !p.IsTruePrimaryKey
            && !string.IsNullOrEmpty(p.BaseColumnName);

        // INSERT VALUES: every supplyable column INCLUDING a non-identity (natural) key.
        bool IsInsertable(ColumnProvenanceDto p) =>
            !p.IsReadOnly && !p.IsExpression && !p.IsAutoIncrement && !string.IsNullOrEmpty(p.BaseColumnName);

        // Deletes.
        foreach (var rowIdx in _deletes)
        {
            edits.Add(new CrudEditDto
            {
                Op = CrudOp.Delete,
                KeyCells = keyProv.Select(p => KeyCell(set, rowIdx, p)).ToArray(),
            });
            _applyTargets.Add((CrudOp.Delete, rowIdx));
        }

        // Updates (skip rows also marked for delete).
        foreach (var kv in _edits)
        {
            if (_deletes.Contains(kv.Key)) continue;
            var setCells = kv.Value
                .Where(e => IsUpdatable(set.Provenance[e.Key]))
                .Select(e => new CrudCellDto
                {
                    BaseColumnName = set.Provenance[e.Key].BaseColumnName!,
                    TypeName = DeclaredTypeOrNull(set.Provenance[e.Key].Ordinal),
                    ProviderType = set.Provenance[e.Key].ProviderType,
                    Size = set.Provenance[e.Key].ColumnSize,
                    Precision = set.Provenance[e.Key].Precision,
                    Scale = set.Provenance[e.Key].Scale,
                    Value = e.Value,
                })
                .ToArray();
            if (setCells.Length == 0) continue;
            edits.Add(new CrudEditDto
            {
                Op = CrudOp.Update,
                SetCells = setCells,
                KeyCells = keyProv.Select(p => KeyCell(set, kv.Key, p)).ToArray(),
            });
            _applyTargets.Add((CrudOp.Update, kv.Key));
        }

        // Inserts. Review WEB-20: only the cells the user set — an explicit NULL included — go to the server. A cell left
        // unset is omitted so the column's default applies; sending NULL for it would suppress that default. A row with no
        // cell set is all defaults (the engine writes DEFAULT VALUES).
        for (int insIdx = 0; insIdx < _inserts.Count; insIdx++)
        {
            var ins = _inserts[insIdx];
            var setCells = new List<CrudCellDto>();
            for (int c = 0; c < set.Provenance.Length; c++)
            {
                var p = set.Provenance[c];
                if (!IsInsertable(p) || !ins.TryGetValue(c, out var v)) continue;
                setCells.Add(new CrudCellDto
                {
                    BaseColumnName = p.BaseColumnName!,
                    TypeName = DeclaredTypeOrNull(p.Ordinal),
                    ProviderType = p.ProviderType,
                    Size = p.ColumnSize,
                    Precision = p.Precision,
                    Scale = p.Scale,
                    Value = v,
                });
            }
            edits.Add(new CrudEditDto { Op = CrudOp.Insert, SetCells = setCells.ToArray() });
            _applyTargets.Add((CrudOp.Insert, insIdx));
        }

        // The columns a write reads back from the stored row: PostgreSQL's UPDATE and INSERT, SQL Server's INSERT.
        var returned = set.Provenance
            .Where(p => !p.IsExpression && !string.IsNullOrEmpty(p.BaseColumnName))
            .OrderBy(p => p.Ordinal)
            .ToArray();
        _returnOrdinals = returned.Select(p => p.Ordinal).ToArray();

        return new ApplyChangesRequest
        {
            // The engine stamps each set with the database it was read from (a script's USE moves between them);
            // only an older engine leaves it empty, and then the session's database is all there is to go on.
            BaseCatalog = string.IsNullOrEmpty(set.BaseCatalog) ? FallbackCatalog : set.BaseCatalog,
            BaseSchema = set.BaseSchema ?? string.Empty,
            BaseTable = set.BaseTable ?? string.Empty,
            ConnectionStamp = ConnectionStamp,
            Edits = edits.ToArray(),
            ReturnColumns = returned.Select(p => p.BaseColumnName!).ToArray(),
        };
    }

    /// <summary>The column's declared type as the engine printed it ("numeric(10,2)", "text[]"); the PostgreSQL write casts to it.</summary>
    private string? DeclaredTypeOrNull(int ordinal)
    {
        var type = Set.ColumnSqlTypes.ElementAtOrDefault(ordinal);
        return string.IsNullOrWhiteSpace(type) ? null : type;
    }

    private CrudCellDto KeyCell(ExecuteResultSet set, int rowIdx, ColumnProvenanceDto p) => new()
    {
        BaseColumnName = p.BaseColumnName!,
        TypeName = DeclaredTypeOrNull(p.Ordinal),
        ProviderType = p.ProviderType,
        Size = p.ColumnSize,
        Precision = p.Precision,
        Scale = p.Scale,
        // The WHERE always uses the ORIGINAL fetched value (not any pending edit).
        Value = set.Rows[rowIdx].ElementAtOrDefault(p.Ordinal),
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────────────────────────────

    private async Task<IJSObjectReference?> ModuleAsync()
    {
        if (_module != null || _disposed) return _module;
        try { _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-results-grid.js"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        return _module;
    }

    private async Task CallModuleAsync(string identifier, params object?[] args)
    {
        var module = await ModuleAsync();
        if (module == null) return;
        try { await module.InvokeVoidAsync(identifier, args); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (HasPendingEdits != _reportedPending)
        {
            _reportedPending = HasPendingEdits;
            await OnPendingEditsChanged.InvokeAsync(_reportedPending);
        }
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await CallModuleAsync("init", _root, _selfRef);
        }
        if (_fitPending)
        {
            _fitPending = false;
            var before = _layout.ToCssTracks();
            await FitColumnsAsync(AllColumns, replaceUser: false);
            if (_layout.ToCssTracks() != before) StateHasChanged();
        }
        if (_focusRootPending)
        {
            _focusRootPending = false;
            await CallModuleAsync("focusRoot", _root);
        }
        if (_scrollPending)
        {
            _scrollPending = false;
            await CallModuleAsync("scrollCellIntoView", _root, ActiveDescendantId, _selection.Focus.Row);
        }
    }

    private void Notify(string text, NotificationKind kind) => Notifications?.Notify(text, kind);

    private static string Plural(int n, string noun) =>
        n.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " " + noun + (n == 1 ? string.Empty : "s");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _root);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* tab closing */ }
            catch (JSException) { /* element gone */ }
        }
        foreach (var module in new[] { _ui, _download })
        {
            if (module == null) continue;
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* tab closing */ }
        }
        _selfRef?.Dispose();
    }
}
