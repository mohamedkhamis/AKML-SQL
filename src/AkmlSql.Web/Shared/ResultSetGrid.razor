    private void OpenViewValue(int row, int col)
    {
        if (IsUnconfirmed(row)) return;
        var wire = CurrentWire(row, col);
        if (wire == null) return;
        _viewValue = new CellValueView(ColumnLabel(col), DeclaredType(col), AllowsNull(col), DisplayText(row, col)!,
            EngineCutIndicator.IsIndicator(wire), IsBinaryColumn(col));
