    /// <summary>Runs a menu command and re-renders the grid (the menu itself is gone by then).</summary>
    private Func<Task> Command(Func<Task> action) => async () =>
    {
        await action();
        StateHasChanged();
    };

    private Func<Task> Command(Action action) => () =>
    {
        action();
        StateHasChanged();
        return Task.CompletedTask;
    };

    private IReadOnlyList<MenuItem> CellMenuItems()
    {
        var items = new List<MenuItem>
        {
            new() { Label = "Copy", Shortcut = "Ctrl+C", TestId = "results-menu-copy", OnSelect = Command(() => CopyAsync(CopyFormat.Tsv, false)) },
            new() { Label = "Copy with headers", Shortcut = "Ctrl+Shift+C", TestId = "results-menu-copy-headers", OnSelect = Command(() => CopyAsync(CopyFormat.Tsv, true)) },
            new()
            {
                Label = "Copy as", TestId = "results-menu-copy-as",
                Children = new[]
                {
                    new MenuItem { Label = "CSV", TestId = "results-menu-copy-csv", OnSelect = Command(() => CopyAsync(CopyFormat.Csv, true)) },
                    new MenuItem { Label = "JSON", TestId = "results-menu-copy-json", OnSelect = Command(() => CopyAsync(CopyFormat.Json, true)) },
                    new MenuItem { Label = "Markdown table", TestId = "results-menu-copy-markdown", OnSelect = Command(() => CopyAsync(CopyFormat.Markdown, true)) },
                    new MenuItem { Label = "INSERT statements", TestId = "results-menu-copy-insert", OnSelect = Command(() => CopyAsync(CopyFormat.Insert, true)) },
                },
            },
            new() { Label = "Select all", Shortcut = "Ctrl+A", TestId = "results-menu-select-all", OnSelect = Command(SelectAll) },
            ViewValueItem(),
        };
        if (Set.IsEditable) items.Add(SetNullItem());
        items.Add(new MenuItem { Label = "Save results as CSV…", TestId = "results-save-csv", OnSelect = Command(() => SaveResultsAsync(',')) });
        items.Add(new MenuItem { Label = "Save results as tab-delimited…", TestId = "results-save-tsv", OnSelect = Command(() => SaveResultsAsync('\t')) });
        if (Set.IsEditable)
        {
