@*
    Spec 041 (research R1–R9, R11, R14, R15, X6) — ONE result set's grid: header, virtualised body, row
    numbers, spreadsheet selection, copy, sort, column widths, menus, View value, Save results, and inline
    CRUD (edits / inserts / deletes, keyed by FETCHED row index) with that set's own Apply / Discard bar. A
    stacked results pane gives every set its own grid, so each keeps its own pending edits, Apply, widths
    and sort (FR-015, FR-021).

    Coordinates: a DISPLAY row is a position on screen and _rowIndexes maps it to the FETCHED row. A sort
    permutes _rowIndexes only, so pending edits, deletes, the Apply request and the results-cell-{r}-{c} /
    results-row-{r} test ids stay on the fetched row (FR-016); data-r on a cell is its display row.

    Focus: the grid root is the only tab stop (role=grid, aria-activedescendant), so focus never sits on an
    element Virtualize may remove. Interop (wwwroot/js/akml-results-grid.js) does only what JS must: column
    drag, drag-select, cell presses (no Blazor handler per cell), the context-menu event, canvas measurement
    and cancelling the browser default of the grid's keys. Everything else lives here. CRUD state is an edge
    bar PLUS a glyph, never colour alone. All chrome reads --akml-* tokens (components/results-grid.css).
*@
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Core.Text
@using AkmlSql.Web.Services
@using AkmlSql.Web.Shared.Grid
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable

@{
    var set = Set;
    int colCount = set.ColumnNames.Length;
    _selectedColumns = new HashSet<int>(_selection.SelectedColumns());
    var tooltip = TooltipText;
    if (!_pointerRender) _rowRenderVersion++;
    _pointerRender = false;
}
@* Why the result cannot be edited (spec 042, FR-130): shown when the engine gave a reason; SQL Server results carry none. *@
@if (!set.IsEditable && !string.IsNullOrEmpty(set.ReadOnlyReason))
{
    <div class="akml-results-readonly" role="note" data-testid="results-readonly-reason">
        <Icon Name="info" Size="12" /> <span>Read-only: @set.ReadOnlyReason</span>
    </div>
}
@* Why an editable result can't be changed right now (review WEB-01/WEB-08): a run in flight, or rows read through an
   earlier connection. Pending edits stay visible and can be discarded, never applied. *@
@if (set.IsEditable && FrozenReason != null)
{
    <div class="akml-results-readonly" role="note" data-testid="results-frozen-reason">
        <Icon Name="info" Size="12" /> <span>@FrozenReason</span>
    </div>
}
@* CRUD legend — only when the set is editable. Each chip pairs a glyph with the colour. *@
@if (set.IsEditable)
{
    <div class="akml-results-legend" data-testid="results-legend">
        <span class="akml-legend-chip akml-row-edited"><Icon Name="pencil" Size="12" /> edited</span>
        <span class="akml-legend-chip akml-row-new"><Icon Name="plus" Size="12" /> new</span>
        <span class="akml-legend-chip akml-row-deleted"><Icon Name="x" Size="12" /> deleted</span>
        <span class="akml-results-spacer"></span>
        <button type="button" class="akml-btn" data-testid="results-add-row"
                @onclick="AddNewRow" disabled="@(!CanMutate)" title="@(LockReason ?? "Add a new row")"><Icon Name="plus" Size="12" /> Row</button>
    </div>
}

<div class="akml-results-grid" role="grid" data-testid="results-grid" tabindex="0"
     aria-label="@($"Result {SetIndex + 1}")" aria-multiselectable="true"
     aria-readonly="@(set.IsEditable && CanMutate ? null : "true")"
     aria-rowcount="@(set.Rows.Length + 1 + _inserts.Count)" aria-colcount="@(colCount + 1)"
     aria-activedescendant="@ActiveDescendantId"
     style="@($"--akml-grid-cols:{_layout.ToCssTracks()}")"
     @ref="_root" @onkeydown="OnGridKeyDownAsync">
    @* Header row (aria-rowindex 1; data rows start at 2). *@
    <div class="akml-results-row akml-results-headerrow" role="row" aria-rowindex="1">
        <div class="akml-results-cell akml-results-rowmarker akml-results-corner @(_selection.IsAll ? "akml-cell-selected" : null)"
             role="columnheader" data-testid="results-corner" title="Select all"
             @onmousedown="OnCornerMouseDown"></div>
        @for (int c = 0; c < colCount; c++)
        {
            var col = c;
            bool headerFocus = _area == FocusArea.Header && _headerCol == col;
            <div id="@HeaderId(col)" class="@HeaderClass(col, headerFocus)" role="columnheader"
                 data-testid="@($"results-col-{col}")" data-header-c="@col"
                 title="@HeaderTitle(col)" aria-sort="@AriaSort(col)"
                 aria-describedby="@(headerFocus && tooltip != null ? TooltipId : null)"
                 @onmousedown="e => OnHeaderMouseDown(col, e)">
                <span class="akml-col-text">
                    <span class="akml-col-name">@ColumnLabel(col)</span>
                    @if (ShowColumnTypes)
                    {
                        <span class="akml-col-type" data-testid="@($"results-col-type-{col}")">@DeclaredType(col)</span>
                    }
                </span>
                <button type="button" class="akml-col-sort @(_sortCol == col ? "is-sorted" : null)" tabindex="-1"
                        aria-label="Sort" title="@SortTitle(col)" data-testid="@($"results-sort-{col}")"
                        @onmousedown:stopPropagation="true" @onclick="() => CycleSort(col)" @onclick:stopPropagation="true">
                    @if (_sortCol == col && !_sortDesc)
                    {
                        <Icon Name="arrow-up" Size="12" />
                    }
                    else if (_sortCol == col)
                    {
                        <Icon Name="arrow-down" Size="12" />
                    }
                    else
                    {
                        <Icon Name="arrow-up-down" Size="12" />
                    }
                </button>
                <span class="akml-col-resizer" data-col="@col" data-testid="@($"results-col-resizer-{col}")" aria-hidden="true"
                      @onmousedown:stopPropagation="true"
                      @ondblclick="() => AutoFitColumnAsync(col)" @ondblclick:stopPropagation="true"></span>
            </div>
        }
    </div>

    @* Body — virtualized only above the threshold (mirrors SchemaTreeComponent). Both branches iterate
       DISPLAY positions; RenderRow maps each to its fetched row through _rowIndexes. *@
    @if (set.Rows.Length > VirtualizeThreshold)
    {
        <div class="akml-results-virtualbody" data-testid="results-virtualized">
            <Virtualize Items="@_positions" Context="d" ItemSize="25">
                <GridRowBoundary @key="d" StateKey="@RowStateKey(d, tooltip)" ChildContent="@RenderRow(d, tooltip)" />
            </Virtualize>
        </div>
    }
    else
    {
        @for (int d = 0; d < _rowIndexes.Length; d++)
        {
            <GridRowBoundary @key="d" StateKey="@RowStateKey(d, tooltip)" ChildContent="@RenderRow(d, tooltip)" />
        }
    }

    @* New rows ALWAYS render after the body — OUTSIDE the virtualize branch, so they are visible and
       editable on large sets too (a <Virtualize> body only renders fetched rows). *@
    @for (int i = 0; i < _inserts.Count; i++)
    {
        @RenderInsertRow(i)
    }

    @* The focused cell's value when the column hides it, or the focused header's type (FR-103). Escape
       dismisses it; pointer users get the same text from the cell's title. *@
    @if (tooltip != null)
    {
        <div class="akml-cell-tooltip" role="tooltip" id="@TooltipId" data-testid="results-cell-tooltip">@tooltip</div>
    }
</div>

@* Footer: row count + truncation banner + apply result message. *@
<div class="akml-results-footer">
    <span class="akml-results-stat" data-testid="results-rowcount">
        showing @set.Rows.Length row@(set.Rows.Length == 1 ? "" : "s")
    </span>
    @if (set.Truncated)
    {
        <span class="akml-results-truncated" data-testid="results-truncated">
            result capped (~@(set.RowsOmitted)+ rows omitted) — raise Max rows to fetch more
        </span>
    }
    @* The apply result message lives HERE, not in the apply-bar: a SUCCESSFUL apply clears the pending
       edits, which removes the apply-bar entirely, so the confirmation must render in the always-present
       footer to be seen at all (PR #247 follow-up). A FAILED apply keeps the pending edits and shows the
       error here too, above the apply-bar. *@
    @if (!string.IsNullOrEmpty(_applyMessage))
    {
        <span class="@(_applyOk ? "akml-connmgr-msg-ok" : "akml-connmgr-msg-error")"
              data-testid="results-apply-message">@_applyMessage</span>
    }
</div>

@* Apply bar — only when there are pending edits. RUN-IMMEDIATELY (no confirm); blocked while a cell is
   invalid (FR-014), and the bar says why. *@
@if (set.IsEditable && HasPendingEdits)
{
    var invalid = InvalidCellCount;
    <div class="akml-results-applybar" data-testid="results-applybar">
        <span class="akml-results-stat">@PendingEditCount pending change@(PendingEditCount == 1 ? "" : "s")</span>
        @if (invalid > 0)
        {
            <span class="akml-results-blocked" role="status" data-testid="results-apply-blocked">
                <Icon Name="circle-alert" Size="12" /> @Plural(invalid, "cell") @(invalid == 1 ? "needs" : "need") a value: enter one or set NULL.
            </span>
        }
        <span class="akml-results-spacer"></span>
        <button type="button" class="akml-btn" data-testid="@($"results-discard{ApplyTestIdSuffix}")"
                @onclick="DiscardEditsAsync" disabled="@_applying" title="@(_applying ? "Wait for changes to finish applying" : null)">Discard</button>
        <button type="button" class="akml-btn akml-btn--primary" data-testid="@($"results-apply{ApplyTestIdSuffix}")"
                title="@(_applying ? "Wait for changes to finish applying" : FrozenReason ?? (invalid > 0 ? "Some cells need a value before the changes can be applied." : null))"
                @onclick="ApplyEditsAsync" disabled="@(_applying || FrozenReason != null || invalid > 0)">@(_applying ? "Applying…" : "Apply")</button>
    </div>
}

@if (_menu != null)
{
    <ContextMenu Items="_menu.Items" X="_menu.X" Y="_menu.Y" OnClose="CloseMenu"
                 TestId="@(_menu.Header ? "results-header-menu" : "results-context-menu")"
                 AriaLabel="@(_menu.Header ? "Column" : "Results")" />
}

@if (_viewValue != null)
{
    <CellValueDialog ColumnName="@_viewValue.Column" DeclaredType="@_viewValue.Type" AllowsNull="_viewValue.AllowsNull"
                     Value="@_viewValue.Value" IsEngineCut="_viewValue.IsEngineCut" IsBinary="_viewValue.IsBinary"
                     OnClose="CloseViewValue" />
}

@code {
    [Inject] private IQueryExecutionService QueryExec { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>The result set this grid shows. A different set (a new execution, another tab) starts
    /// afresh: pending edits, widths, sort and selection belong to the set they were made on.</summary>
    [Parameter, EditorRequired] public ExecuteResultSet Set { get; set; } = default!;

    /// <summary>The set's position in its batch (0-based).</summary>
    [Parameter] public int SetIndex { get; set; }

    /// <summary>Raised after a successful Apply so the page can re-run the query to refresh the grid.</summary>
    [Parameter] public EventCallback OnApplied { get; set; }

    /// <summary>The document the result came from; names the files Save results writes.</summary>
    [Parameter] public string? DocumentName { get; set; }

    /// <summary>Spec 041 (R27): the database the set's run was in (its reply's <c>CurrentDatabase</c>) — Apply writes
    /// there when the set carries no base catalog, so a later <c>USE</c> never redirects an older grid's edits.</summary>
    [Parameter] public string? FallbackCatalog { get; set; }

    /// <summary>Show each column's declared type as a second header line (FR-011; off by default).</summary>
    [Parameter] public bool ShowColumnTypes { get; set; }

    /// <summary>Keep line breaks inside values on copy and save (FR-009/FR-030; off, as in SSMS).</summary>
    [Parameter] public bool RetainLineBreaksOnCopy { get; set; }

    /// <summary>Appended to the Apply / Discard test ids when sets are stacked (<c>results-apply-1</c>).</summary>
    [Parameter] public string? ApplyTestIdSuffix { get; set; }

    /// <summary>
    /// Review findings WEB-01 / WEB-08: why the rows can't be changed right now — a query is running (its result replaces
    /// this one), or the rows were read through an earlier connection. Null when they can. Pending edits stay and can be
    /// discarded; nothing is added to them, and they are never applied.
    /// </summary>
    [Parameter] public string? FrozenReason { get; set; }

    /// <summary>The engine's stamp of the connection the rows were read through; sent with the edits so the engine
    /// refuses them on any other connection (WEB-01).</summary>
    [Parameter] public string? ConnectionStamp { get; set; }

    /// <summary>Review WEB-09: raised after a render in which <see cref="HasPendingEdits"/> changed, so the page can warn
    /// before a reload or a closed tab drops them.</summary>
    [Parameter] public EventCallback<bool> OnPendingEditsChanged { get; set; }

    /// <summary>Spec 043: prefix of the grid's element ids; the results pane passes <c>akml-grid-{tabId}-{set}</c> so two
    /// query tabs' grids never share an id. Null: <c>akml-grid-{SetIndex}</c>.</summary>
    [Parameter] public string? IdPrefix { get; set; }

    /// <summary>Spec 043: the query tab's connection the rows were read through; Apply is sent through it (null: the active tab's).</summary>
    [Parameter] public SqlSessionState? Session { get; set; }

    private bool _reportedPending;

    /// <summary>Shift+Alt+Left/Right resize step (FR-003).</summary>
    public const int ResizeStepPx = 16;

    /// <summary>The file name Save results uses when the document has none.</summary>
    public const string DefaultDocumentName = "SQLQuery1";

    private const int VirtualizeThreshold = 200;
    private const int PageRows = 20;
    private const string InvalidTitle = "Enter a value or set NULL";
    private const string NoColumnName = "(No column name)";

    private enum FocusArea { Cell, Header, RowNumber }

    private sealed record GridMenu(double X, double Y, bool Header, IReadOnlyList<MenuItem> Items);

    private sealed record CellValueView(string Column, string? Type, bool? AllowsNull, string Value, bool IsEngineCut, bool IsBinary);

    private INotificationService? Notifications => Services.GetService<INotificationService>();
    private IDialogService? Dialogs => Services.GetService<IDialogService>();

    // ── Per-set state ──────────────────────────────────────────────────────────────────────────────
    private ExecuteResultSet? _boundSet;
    private int[] _rowIndexes = Array.Empty<int>();               // display position → fetched row
    private int[] _positions = Array.Empty<int>();                // 0..n-1, the Virtualize items
    private SqlTypeName[] _types = Array.Empty<SqlTypeName>();
    private DisplayValue?[]?[] _displayCache = Array.Empty<DisplayValue?[]?>();   // fetched values only
    private GridColumnLayout _layout = new(0, 0);
    private GridSelection _selection = new(0, 0);
    private HashSet<int> _selectedColumns = new();
    private FocusArea _area = FocusArea.Cell;
    private int _headerCol;
    private bool _pressOnFocused;      // the press landed on the already-focused single cell: its click edits
    private bool _keyboardFocus;       // the focus last moved by keyboard (the focus tooltip shows)
    private bool _tooltipDismissed;
    private (int Display, int Col) _menuCell = (-1, -1);
    private int _sortCol = -1;
    private bool _sortDesc;

    // ── Edit tracking, keyed by FETCHED row index ─────────────────────────────────────────────────
    private readonly Dictionary<int, Dictionary<int, string?>> _edits = new();   // rowIndex -> (colIndex -> new value)
    private readonly HashSet<int> _deletes = new();                              // deleted fetched rows
    private readonly List<Dictionary<int, string?>> _inserts = new();            // new rows (colIndex -> value)

    // The inline editor: a fetched cell (_editInsert < 0) or a new row's cell (_editInsert = its index).
    private int _editRow = -1;
    private int _editDisplay = -1;
    private int _editCol = -1;
    private int _editInsert = -1;
    private int _editSession;
    private string _editInitial = string.Empty;
    private bool _editReplaced;        // started by a printable key, which replaced the value

    private bool _applying;
    private string? _applyMessage;
    private bool _applyOk;

    private GridMenu? _menu;
    private CellValueView? _viewValue;

    // ── Interop ────────────────────────────────────────────────────────────────────────────────────
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _ui;
    private IJSObjectReference? _download;
    private DotNetObjectReference<ResultSetGrid>? _selfRef;
    private bool _fitPending;
    private bool _focusRootPending;
    private bool _scrollPending;
    private bool _disposed;

    /// <summary>True while this set holds edits, deletes or new rows not yet applied.</summary>
    public bool HasPendingEdits => _edits.Count > 0 || _deletes.Count > 0 || _inserts.Count > 0;

    /// <summary>How many pending changes this set holds (edited rows + deletes + new rows).</summary>
    public int PendingEditCount => _edits.Count + _deletes.Count + _inserts.Count;

    /// <summary>An Apply is waiting for the engine's reply.</summary>
    public bool IsApplying => _applying;

    /// <summary>Why no change may be made now: an Apply in flight owns the pending edits (what was sent must be what is
    /// marked committed), or the page froze the grid. Null when changes are allowed.</summary>
    private string? LockReason => _applying ? "Wait for the changes to finish applying." : FrozenReason;

    private bool CanMutate => LockReason == null;

    /// <summary>Says why a change was refused; true when the grid is locked.</summary>
    private bool RefuseWhileLocked()
    {
        if (CanMutate) return false;
        Notify(LockReason!, NotificationKind.Info);
        return true;
    }

    /// <summary>Cells that need a value before Apply can run (FR-014).</summary>
    public int InvalidCellCount
    {
        get
        {
            int n = 0;
            foreach (var (row, cells) in _edits)
            {
                if (_deletes.Contains(row)) continue;
                foreach (var (c, v) in cells) if (IsInvalidValue(c, v)) n++;
            }
            for (int i = 0; i < _inserts.Count; i++)
                for (int c = 0; c < ColumnCount; c++)
                    if (IsInvalidInsert(i, c)) n++;
            return n;
        }
    }

    private int ColumnCount => Set.ColumnNames.Length;
    private int RowCount => _rowIndexes.Length;
    private bool IsEditing => _editCol >= 0;
    private IReadOnlyList<int> AllColumns => Enumerable.Range(0, ColumnCount).ToArray();

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Set, _boundSet)) return;
        _boundSet = Set;
        _unconfirmed = UnconfirmedRows.GetOrCreateValue(Set);

        int cols = Set.ColumnNames.Length;
        _types = new SqlTypeName[cols];
        for (int c = 0; c < cols; c++) _types[c] = SqlTypeName.Parse(Set.ColumnSqlTypes.ElementAtOrDefault(c));
        ResetEditState();
        _sortCol = -1;
        _sortDesc = false;
        _menu = null;
        _viewValue = null;
        _area = FocusArea.Cell;
        _headerCol = 0;
        _keyboardFocus = false;
        RebuildRowIndexes();
        _layout = new GridColumnLayout(cols, Set.Rows.Length);
        // Size by estimate now so the first frame is never unsized; the canvas measurement refines it.
        FitByEstimate(AllColumns, replaceUser: false);
        _fitPending = true;
    }

    /// <summary>
    /// Review round 3 (REV-06): committed inserts the server could not say how it stored (no key to read them back by, an INSTEAD OF
    /// trigger, an older engine) — set row → the columns whose value is known (typed, or the returned identity). The other cells
    /// show as not read back, and the row can be neither edited nor deleted: its key would be a guess. Running the query again
    /// replaces the set and clears this.
    /// </summary>
    // Keep the safety marker for the lifetime of the result, even if its grid is disposed and recreated.
    // Weak keys let discarded query results be collected; this browser-only state never changes the IPC contract.
    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<ExecuteResultSet, Dictionary<int, HashSet<int>>>
        UnconfirmedRows = new();

    private Dictionary<int, HashSet<int>> _unconfirmed = new();

    private const string UnconfirmedTitle = "Insert completed, but the row could not be read back — use a SELECT query to check what was stored.";
    private const string UnconfirmedExportMessage = "Some inserted rows could not be read back. Run a SELECT query before copying or saving those rows.";

    private bool IsUnconfirmed(int row) => _unconfirmed.ContainsKey(row);

    private void ResetEditState()
    {
        _edits.Clear();
        _deletes.Clear();
        _inserts.Clear();
        EndEdit();
        _applyMessage = null;
    }

    /// <summary>The row set changed (a new result, or an Apply baked its changes in): display order back
    /// to fetched order, a fresh selection and display cache. The sort STATE is kept — callers re-apply it.</summary>
    private void RebuildRowIndexes()
    {
        int n = Set?.Rows.Length ?? 0;
        _rowIndexes = Enumerable.Range(0, n).ToArray();
        _positions = Enumerable.Range(0, n).ToArray();
        _displayCache = new DisplayValue?[]?[n];
        _selection = new GridSelection(n, Set?.ColumnNames.Length ?? 0);
    }

    // ── Values ─────────────────────────────────────────────────────────────────────────────────────

    private string? CurrentWire(int row, int col)
    {
        if (_edits.TryGetValue(row, out var rowEdits) && rowEdits.TryGetValue(col, out var edited)) return edited;
        var cells = Set.Rows[row];
        return col < cells.Length ? cells[col] : null;
    }

    private DisplayValue Format(string? wire, int col, bool fullText) =>
        SqlValueDisplay.Format(wire, TypeOf(col), Set.ClrTypeHints.ElementAtOrDefault(col), fullText);

    private SqlTypeName TypeOf(int col) => col < _types.Length ? _types[col] : SqlTypeName.Parse(null);

    /// <summary>What the editor starts with: the cell's shown text where it converts back without loss (a date as
    /// 2025-10-01, binary as 0x…), else the wire text.</summary>
    private string? EditText(string? wire, int col) => SqlValueDisplay.EditText(wire, TypeOf(col), Set.ClrTypeHints.ElementAtOrDefault(col));

    /// <summary>A typed value in the wire form Apply binds (a date typed as the grid shows it becomes ISO-8601).</summary>
    private string? ToWire(string? typed, int col) => SqlValueDisplay.ToWire(typed, TypeOf(col), Set.ClrTypeHints.ElementAtOrDefault(col));

    /// <summary>What a cell shows (a large binary value as a preview). Fetched values are formatted once.</summary>
    private DisplayValue CellDisplay(int row, int col)
    {
        if (_edits.TryGetValue(row, out var rowEdits) && rowEdits.TryGetValue(col, out var edited)) return Format(edited, col, false);
        var cache = _displayCache[row] ??= new DisplayValue?[ColumnCount];
        return cache[col] ??= Format(Set.Rows[row].ElementAtOrDefault(col), col, false);
    }

    /// <summary>
    /// The text the grid shows for a cell, at full length: the single accessor copy, Save results and View
    /// value use (FR-009, FR-026, FR-030). Null for SQL NULL. The inline editor and Apply keep the engine's
    /// round-trip wire text instead, so editing never loses precision.
    /// </summary>
    public string? DisplayText(int row, int col)
    {
        var wire = CurrentWire(row, col);
        return wire == null ? null : Format(wire, col, true).Text;
    }

    private string ColumnLabel(int c)
    {
        var name = Set.ColumnNames[c];
        return string.IsNullOrEmpty(name) ? NoColumnName : name;
    }

    private string DeclaredType(int c) => Set.ColumnSqlTypes.ElementAtOrDefault(c) ?? string.Empty;

    private ColumnProvenanceDto? Provenance(int c) => c >= 0 && c < Set.Provenance.Length ? Set.Provenance[c] : null;

    /// <summary>NULL / NOT NULL from provenance, for a column that comes from a table; null otherwise.</summary>
    private bool? AllowsNull(int c)
    {
        var p = Provenance(c);
        return p != null && !string.IsNullOrEmpty(p.BaseColumnName) ? p.AllowDBNull : null;
    }

    private string HeaderTitle(int c)
    {
        var type = DeclaredType(c);
        if (string.IsNullOrEmpty(type)) type = TypeHintTitle(c);
        var nullability = AllowsNull(c) switch { true => ", NULL", false => ", NOT NULL", _ => string.Empty };
        return $"{ColumnLabel(c)} ({type}{nullability})";
    }

    private string TypeHintTitle(int col) => Set.ClrTypeHints.ElementAtOrDefault(col) switch
    {
        ClrTypeHint.Int64 => "integer",
        ClrTypeHint.Double => "floating point",
        ClrTypeHint.Decimal => "decimal",
        ClrTypeHint.Bool => "bit",
        ClrTypeHint.DateTime => "date/time",
        ClrTypeHint.DateTimeOffset => "datetimeoffset",
        ClrTypeHint.Guid => "uniqueidentifier",
        ClrTypeHint.Binary => "binary",
        ClrTypeHint.Variant => "sql_variant",
        _ => "text",
    };

    /// <summary>A blank value is an empty string for character types and invalid for every other (FR-014).
    /// Without a declared type (an older engine) the CLR hint decides.</summary>
    private bool IsCharacterColumn(int c)
    {
        var type = c < _types.Length ? _types[c] : null;
        if (type != null && type.BaseName.Length > 0) return type.IsCharacter;
        var hint = Set.ClrTypeHints.ElementAtOrDefault(c);
        return hint == ClrTypeHint.String || hint == ClrTypeHint.Variant;
    }

    private bool IsBinaryColumn(int c) =>
        Set.ClrTypeHints.ElementAtOrDefault(c) == ClrTypeHint.Binary
        || (c < _types.Length && _types[c].BaseName is "binary" or "varbinary" or "image" or "timestamp" or "rowversion");

    private bool IsInvalidValue(int c, string? value) => value != null && value.Length == 0 && !IsCharacterColumn(c);

    private bool IsInvalidEdit(int row, int c) =>
        !_deletes.Contains(row) && _edits.TryGetValue(row, out var cells) && cells.TryGetValue(c, out var v) && IsInvalidValue(c, v);

    /// <summary>A new row's cell is invalid when it is blank on a non-character type, or left unset on a NOT
    /// NULL, non-identity column the user must supply — one without a default the server fills in (review WEB-20).</summary>
    private bool IsInvalidInsert(int insIdx, int c)
    {
        if (!IsColumnInsertable(c)) return false;
        if (_inserts[insIdx].TryGetValue(c, out var v)) return IsInvalidValue(c, v);
        var p = Provenance(c);
        // Re-review REV-06: only a column known to have no default must be typed; with unknown defaults the server decides.
        return p != null && !p.AllowDBNull && !p.IsAutoIncrement && !p.HasDefault && Set.DefaultsKnown;
    }

    /// <summary>An unset NOT NULL cell whose default is not known: the server fills it in or refuses the row.</summary>
    private bool DefaultUnknown(int col) =>
        !Set.DefaultsKnown && Provenance(col) is { AllowDBNull: false, IsAutoIncrement: false, HasDefault: false };

    private bool HasDefault(int col) => Provenance(col)?.HasDefault == true;

    /// <summary>Editable in an EXISTING row: writable, non-identity, AND not a key column — the key is
    /// the WHERE identity, so editing it would retarget or orphan the row.</summary>
    private bool IsColumnEditable(int col)
    {
        var p = Provenance(col);
        return p != null && !p.IsReadOnly && !p.IsExpression && !p.IsAutoIncrement
            && !p.IsKey && !p.IsTruePrimaryKey
            && !string.IsNullOrEmpty(p.BaseColumnName);
    }

    /// <summary>Supplyable on a NEW row: writable + non-identity, INCLUDING a non-identity (natural) key
    /// the user must provide on insert. (Identity/computed/expression columns are still excluded.)</summary>
    private bool IsColumnInsertable(int col)
    {
        var p = Provenance(col);
        return p != null && !p.IsReadOnly && !p.IsExpression && !p.IsAutoIncrement && !string.IsNullOrEmpty(p.BaseColumnName);
    }

    private bool IsAutoIncrement(int col) => Provenance(col)?.IsAutoIncrement == true;

    private bool IsCellEditable(int row, int col) =>
        Set.IsEditable && CanMutate && IsColumnEditable(col) && !_deletes.Contains(row) && !IsUnconfirmed(row);

    // ── Rendering helpers ──────────────────────────────────────────────────────────────────────────

    private string GridPrefix => IdPrefix ?? $"akml-grid-{SetIndex}";
    private string CellId(int d, int c) => $"{GridPrefix}-{d}-{c}";
    private string RowNumberId(int d) => $"{GridPrefix}-{d}-rn";
    private string HeaderId(int c) => $"{GridPrefix}-h-{c}";
    private string TooltipId => $"{GridPrefix}-tip";

    private string? ActiveDescendantId => _area switch
    {
        FocusArea.Header => ColumnCount > 0 ? HeaderId(Math.Clamp(_headerCol, 0, ColumnCount - 1)) : null,
        FocusArea.RowNumber => _selection.IsEmpty ? null : RowNumberId(_selection.Focus.Row),
        _ => _selection.IsEmpty ? null : CellId(_selection.Focus.Row, _selection.Focus.Col),
    };

    private string HeaderClass(int c, bool focus) =>
        "akml-results-cell akml-results-colheader"
        + (_selectedColumns.Contains(c) ? " akml-cell-selected" : string.Empty)
        + (focus ? " akml-cell-focus" : string.Empty);

    private string? AriaSort(int c) => _sortCol == c ? (_sortDesc ? "descending" : "ascending") : null;

    private string SortTitle(int c) =>
        _sortCol != c ? "Sort ascending" : !_sortDesc ? "Sort descending" : "Clear sort";

    /// <summary>The value the column width hides (estimated from its length) — it gets a hover title.</summary>
    private bool IsCutByWidth(string text, int c) =>
        text.Length > 0 && GridColumnLayout.EstimatePx(text) + GridColumnLayout.CellPaddingPx + GridColumnLayout.CellBorderPx > _layout.WidthPx(c);

    private string? CellTitle(DisplayValue v, int c, bool invalid)
    {
        if (invalid) return InvalidTitle;
        if (v.IsEngineCut) return GridCellText.EngineCutTitle;
        if (v.IsEmptyString) return "(empty string)";
        return v.IsPreview || IsCutByWidth(v.Text, c) ? GridCellText.Tooltip(v.Text) : null;
    }

    private string? TooltipText
    {
        get
        {
            if (!_keyboardFocus || _tooltipDismissed || IsEditing || _menu != null || _viewValue != null) return null;
            if (_area == FocusArea.Header)
                return _headerCol >= 0 && _headerCol < ColumnCount ? HeaderTitle(_headerCol) : null;
            if (_area != FocusArea.Cell || _selection.IsEmpty) return null;
            var f = _selection.Focus;
            var v = CellDisplay(_rowIndexes[f.Row], f.Col);
            if (v.IsEngineCut) return GridCellText.EngineCutTitle;
            return v.IsPreview || IsCutByWidth(v.Text, f.Col) ? GridCellText.Tooltip(v.Text) : null;
        }
    }

    private bool RowHasSelection(int d)
    {
        for (int c = 0; c < ColumnCount; c++) if (_selection.IsSelected(d, c)) return true;
        return false;
    }

    // Pointer work changes selection/focus and width-dependent titles only. Keep unchanged rows out
    // of Blazor's render diff; normal renders (editing, sorting, parameters) invalidate every row.
    private bool _pointerRender;
    private long _rowRenderVersion;
    private string RowStateKey(int d, string? tooltip)
    {
        var cells = new char[ColumnCount];
        bool focusedRow = !_selection.IsEmpty && _selection.Focus.Row == d;
        for (int c = 0; c < cells.Length; c++)
            cells[c] = (char)('A' + (_selection.IsSelected(d, c) ? 1 : 0)
                + (IsCutByWidth(CellDisplay(_rowIndexes[d], c).Text, c) ? 2 : 0)
                + (focusedRow && _area == FocusArea.Cell && _selection.Focus.Col == c ? 4 : 0));
        return $"{_rowRenderVersion}:{d}:{focusedRow && _area == FocusArea.RowNumber}:{tooltip != null}:{new string(cells)}";
    }

    private RenderFragment RenderRow(int d, string? tooltip) => __builder =>
    {
        int r = _rowIndexes[d];
        bool deleted = _deletes.Contains(r);
        bool edited = !deleted && _edits.ContainsKey(r);
        _unconfirmed.TryGetValue(r, out var knownCols);
        bool rowFocus = _area == FocusArea.RowNumber && !_selection.IsEmpty && _selection.Focus.Row == d;
        string rowClass = "akml-results-row" + (deleted ? " akml-row-deleted" : edited ? " akml-row-edited" : string.Empty)
            + (knownCols != null ? " akml-row-unconfirmed" : string.Empty);
        string markerClass = "akml-results-cell akml-results-rowmarker"
            + (RowHasSelection(d) ? " akml-cell-selected" : string.Empty)
            + (rowFocus ? " akml-cell-focus" : string.Empty);

        <div @key="r" class="@rowClass" role="row" data-testid="@($"results-row-{r}")" aria-rowindex="@(d + 2)">
            <div id="@RowNumberId(d)" class="@markerClass" role="rowheader" data-testid="@($"results-rownum-{r}")"
                 data-r="@d" data-c="-1" @onmousedown="e => OnRowNumberMouseDown(d, e)">
                @if (deleted)
                {
                    <Icon Name="x" Size="12" Class="akml-row-glyph" Label="Deleted row" />
                }
                else if (edited)
                {
                    <Icon Name="pencil" Size="12" Class="akml-row-glyph" Label="Edited row" />
                }
                else if (knownCols != null)
                {
                    <span title="@UnconfirmedTitle" data-testid="@($"results-unconfirmed-{r}")"><Icon Name="circle-alert" Size="12" Class="akml-row-glyph" Label="@UnconfirmedTitle" /></span>
                }
                <span class="akml-rownum">@(d + 1)</span>
                @if (Set.IsEditable)
                {
                    <button type="button" class="akml-rowmarker-btn" tabindex="-1" disabled="@(!CanMutate || knownCols != null)"
                            title="@(LockReason ?? (knownCols != null ? UnconfirmedTitle : deleted ? "Restore row" : "Delete row"))" aria-label="@(deleted ? "Restore row" : "Delete row")"
                            data-testid="@($"results-delete-{r}")"
                            @onmousedown:stopPropagation="true" @onclick="() => ToggleDelete(r)" @onclick:stopPropagation="true">
                        @if (deleted)
                        {
                            <Icon Name="refresh-cw" Size="12" />
                        }
                        else
                        {
                            <Icon Name="x" Size="12" />
                        }
                    </button>
                }
            </div>
            @for (int c = 0; c < ColumnCount; c++)
            {
                var col = c;
                bool editable = IsCellEditable(r, col);
                bool selected = _selection.IsSelected(d, col);
                bool focus = _area == FocusArea.Cell && !_selection.IsEmpty && _selection.Focus.Row == d && _selection.Focus.Col == col;
                if (_editInsert < 0 && _editRow == r && _editCol == col)
                {
                    int session = _editSession;
                    <div id="@CellId(d, col)" class="akml-results-cell akml-cell-editing" role="gridcell" aria-selected="true"
                         data-testid="@($"results-cell-{r}-{col}")" data-r="@d" data-c="@col">
                        <GridCellEditor @key="session" InitialValue="@_editInitial"
                                        Label="@($"Edit {ColumnLabel(col)}, row {d + 1}")"
                                        OnDone="@(res => OnEditorDoneAsync(session, res))" />
                    </div>
                    continue;
                }
                if (knownCols != null && !knownCols.Contains(col))
                {
                    <div id="@CellId(d, col)" class="@("akml-results-cell akml-cell-unknown" + (selected ? " akml-cell-selected" : string.Empty) + (focus ? " akml-cell-focus" : string.Empty))"
                         role="gridcell" aria-selected="@(selected ? "true" : "false")" aria-describedby="@(focus && tooltip != null ? TooltipId : null)"
                         title="@UnconfirmedTitle" data-testid="@($"results-cell-{r}-{col}")" data-unknown="true" data-r="@d" data-c="@col">…</div>
                    continue;
                }
                var v = CellDisplay(r, col);
                bool invalid = IsInvalidEdit(r, col);
                string cellClass = "akml-results-cell"
                    + (editable ? " akml-cell-editable" : string.Empty)
                    + (v.IsNull ? " akml-cell-null" : string.Empty)
                    + (v.IsEmptyString ? " akml-cell-empty" : string.Empty)
                    + (v.IsEngineCut ? " akml-cell-cut" : string.Empty)
                    + (selected ? " akml-cell-selected" : string.Empty)
                    + (focus ? " akml-cell-focus" : string.Empty)
                    + (invalid ? " akml-cell-invalid" : string.Empty);
                if (editable)
                {
                    <div id="@CellId(d, col)" class="@cellClass" role="gridcell" aria-selected="@(selected ? "true" : "false")"
                         aria-invalid="@(invalid ? "true" : null)" aria-describedby="@(focus && tooltip != null ? TooltipId : null)"
                         title="@CellTitle(v, col, invalid)" data-testid="@($"results-cell-{r}-{col}")" data-r="@d" data-c="@col"
                         @ondblclick="() => OnCellDoubleClick(d, col)">
                        @if (invalid)
                        {
                            <span class="akml-cell-invalid-glyph" title="@InvalidTitle" data-testid="@($"results-cell-invalid-{r}-{col}")"><Icon Name="circle-alert" Size="12" /></span>
                        }
                        @v.Text
                    </div>
                }
                else
                {
                    <div id="@CellId(d, col)" class="@cellClass" role="gridcell" aria-selected="@(selected ? "true" : "false")"
                         aria-describedby="@(focus && tooltip != null ? TooltipId : null)"
                         title="@CellTitle(v, col, false)" data-testid="@($"results-cell-{r}-{col}")" data-r="@d" data-c="@col">@v.Text</div>
                }
            }
        </div>
    };

    private RenderFragment RenderInsertRow(int i) => __builder =>
    {
        var ins = _inserts[i];
        <div class="akml-results-row akml-row-new" role="row" data-testid="@($"results-insert-{i}")" aria-rowindex="@(Set.Rows.Length + 2 + i)">
            <div class="akml-results-cell akml-results-rowmarker" role="rowheader">
                <Icon Name="plus" Size="12" Class="akml-row-glyph" Label="New row" />
                <span class="akml-rownum">*</span>
                <button type="button" class="akml-rowmarker-btn" tabindex="-1" disabled="@(!CanMutate)" title="@(LockReason ?? "Remove new row")" aria-label="Remove new row"
                        data-testid="@($"results-remove-insert-{i}")" @onclick="() => RemoveInsert(i)">
                    <Icon Name="x" Size="12" />
                </button>
            </div>
            @for (int c = 0; c < ColumnCount; c++)
            {
                var col = c;
                bool insertable = IsColumnInsertable(col);
                if (_editInsert == i && _editCol == col)
                {
                    int session = _editSession;
                    <div class="akml-results-cell akml-cell-editing" role="gridcell" data-testid="@($"results-insert-cell-{i}-{col}")">
                        <GridCellEditor @key="session" InitialValue="@_editInitial"
                                        Label="@($"Edit {ColumnLabel(col)}, new row")"
                                        OnDone="@(res => OnEditorDoneAsync(session, res))" />
                    </div>
                    continue;
                }
                bool has = ins.TryGetValue(col, out var value);
                bool invalid = IsInvalidInsert(i, col);
                bool auto = IsAutoIncrement(col);
                // An unset cell is left out of the INSERT: the column's default applies (shown so), else NULL — unless the
                // column must be supplied (invalid, blank). Review WEB-20.
                string text = auto ? "(auto)" : has ? Format(value, col, false).Text : invalid ? string.Empty
                    : HasDefault(col) ? "(default)" : DefaultUnknown(col) ? "(not set)" : GridTextFormats.NullText;
                bool muted = auto || (has ? value == null : !invalid);
                string cellClass = "akml-results-cell"
                    + (insertable ? " akml-cell-editable" : string.Empty)
                    + (muted ? " akml-cell-null" : string.Empty)
                    + (invalid ? " akml-cell-invalid" : string.Empty);
                if (insertable)
                {
                    <div class="@cellClass" role="gridcell" aria-invalid="@(invalid ? "true" : null)" title="@(invalid ? InvalidTitle : null)"
                         data-testid="@($"results-insert-cell-{i}-{col}")"
                         @onclick="() => BeginInsertEdit(i, col)" @ondblclick="() => BeginInsertEdit(i, col)">
                        @if (invalid)
                        {
                            <span class="akml-cell-invalid-glyph" title="@InvalidTitle" data-testid="@($"results-insert-invalid-{i}-{col}")"><Icon Name="circle-alert" Size="12" /></span>
                        }
                        @text
                    </div>
                }
                else
                {
                    <div class="@cellClass" role="gridcell" data-testid="@($"results-insert-cell-{i}-{col}")">@text</div>
                }
            }
        </div>
    };

    // ── Pointer ────────────────────────────────────────────────────────────────────────────────────

    /// <summary>A press on a data cell (from akml-results-grid.js — no Blazor handler per cell).</summary>
    [JSInvokable]
    public Task OnCellPointerDownFromJs(int displayRow, int col, bool shift, bool ctrl) => InvokeAsync(() =>
    {
        if (displayRow < 0 || displayRow >= RowCount || col < 0 || col >= ColumnCount) return;
        _pressOnFocused = !shift && !ctrl && _area == FocusArea.Cell && _selection.IsSingleCell
                          && _selection.Focus == new GridCell(displayRow, col);
        _selection.Click(displayRow, col, shift, ctrl);
        _area = FocusArea.Cell;
        _keyboardFocus = false;
        _pointerRender = true;
        StateHasChanged();
    });

    /// <summary>A click on a data cell. A second click on the focused cell edits it (FR-013).</summary>
    [JSInvokable]
    public Task OnCellClickFromJs(int displayRow, int col) => InvokeAsync(() =>
    {
        bool second = _pressOnFocused;
        _pressOnFocused = false;
        if (!second || displayRow < 0 || displayRow >= RowCount || col < 0 || col >= ColumnCount) return;
        if (IsCellEditable(_rowIndexes[displayRow], col))
        {
            BeginEdit(displayRow, col);
            StateHasChanged();
        }
    });

    /// <summary>A drag reached another cell: select the rectangle from the press.</summary>
    [JSInvokable]
    public Task OnDragSelectFromJs(int displayRow, int col) => InvokeAsync(() =>
    {
        if (RowCount == 0 || ColumnCount == 0) return;
        _selection.DragTo(displayRow, col);
        _area = FocusArea.Cell;
        _pressOnFocused = false;
        _pointerRender = true;
        StateHasChanged();
    });

    /// <summary>A column edge drag ended (FR-003).</summary>
    [JSInvokable]
    public Task OnColumnResizedFromJs(int col, int px) => InvokeAsync(() =>
    {
        _layout.SetUserWidth(col, px);
        _pointerRender = true;
        StateHasChanged();
    });

    /// <summary>
    /// The context-menu event (a right-click, the Menu key or Shift+F10 — the keyboard ones are routed by
    /// the module to the focused cell). <paramref name="displayRow"/>/<paramref name="col"/> name the cell
    /// it was for (col -1 = a row number; -1/-1 = no cell); <paramref name="header"/> = a column header.
    /// </summary>
    [JSInvokable]
    public Task OnContextMenuFromJs(double x, double y, int displayRow, int col, bool header) => InvokeAsync(() =>
    {
        if (_disposed || IsEditing) return;
        if (header)
        {
            if (col < 0 || col >= ColumnCount) return;
            _area = FocusArea.Header;
            _headerCol = col;
            _menu = new GridMenu(x, y, true, HeaderMenuItems(col));
            StateHasChanged();
            return;
        }
        if (RowCount == 0 || ColumnCount == 0) return;
        if (displayRow >= 0 && displayRow < RowCount)
        {
            if (col < 0)
            {
                if (!RowHasSelection(displayRow)) _selection.ClickRowHeader(displayRow, false, false);
                _area = FocusArea.RowNumber;
            }
            else if (col < ColumnCount)
            {
                if (!_selection.IsSelected(displayRow, col)) _selection.Click(displayRow, col, false, false);
                _area = FocusArea.Cell;
            }
            _menuCell = (displayRow, Math.Max(0, col));
        }
        else
        {
            if (_selection.IsEmpty) _selection.Click(0, 0, false, false);
            _menuCell = (_selection.Focus.Row, _selection.Focus.Col);
        }
        _menu = new GridMenu(x, y, false, CellMenuItems());
        StateHasChanged();
    });

    private void OnCornerMouseDown(MouseEventArgs e)
    {
        if (e.Button != 0) return;
        _selection.SelectAll();
        _area = FocusArea.Cell;
        _keyboardFocus = false;
    }

    private void OnHeaderMouseDown(int col, MouseEventArgs e)
    {
        if (e.Button != 0) return;
        _selection.ClickColumnHeader(col, e.ShiftKey, e.CtrlKey || e.MetaKey);
        _area = FocusArea.Header;
        _headerCol = col;
        _keyboardFocus = false;
    }

    private void OnRowNumberMouseDown(int displayRow, MouseEventArgs e)
    {
        if (e.Button != 0) return;
        _selection.ClickRowHeader(displayRow, e.ShiftKey, e.CtrlKey || e.MetaKey);
        _area = FocusArea.RowNumber;
        _keyboardFocus = false;
    }

    // ── Keyboard (contracts/ui.md §2) ──────────────────────────────────────────────────────────────

    private async Task OnGridKeyDownAsync(KeyboardEventArgs e)
    {
        bool ctrl = e.CtrlKey || e.MetaKey;
        string key = e.Key ?? string.Empty;
        if (IsEditing)
        {
            // A fast typist's next keys can reach the grid before the new editor has focus: keep them.
            if (key.Length == 1 && !ctrl && !e.AltKey)
            {
                _editInitial += key;
                _editReplaced = true;
                _editSession++;
            }
            return;
        }
        if (_menu != null)
        {
            // The menu takes focus a moment after it opens; an Escape that beats it still closes it.
            if (key == "Escape") CloseMenu();
            return;
        }
        if (_viewValue != null) return;

        if (e.ShiftKey && e.AltKey && !ctrl && key is "ArrowLeft" or "ArrowRight")
        {
            ResizeFocusedColumn(key == "ArrowRight" ? ResizeStepPx : -ResizeStepPx);
            return;
        }
        if (ctrl && !e.AltKey)
        {
            switch (key)
            {
                case "a":
                case "A":
                    SelectAll();
                    return;
                case "c":
                case "C":
                    await CopyAsync(CopyFormat.Tsv, includeHeader: e.ShiftKey);
                    return;
                case "0":
                    SetFocusedToNull();
                    return;
            }
        }
        if (key == "Escape")
        {
            if (TooltipText != null) _tooltipDismissed = true;
            return;
        }
        if (e.AltKey) return;   // Alt+… belongs to the browser and the page

        switch (_area)
        {
            case FocusArea.Header: HeaderKey(key, e.ShiftKey); break;
            case FocusArea.RowNumber: RowNumberKey(key, e.ShiftKey); break;
            default: CellKey(key, e.ShiftKey, ctrl); break;
        }
    }

    private void CellKey(string key, bool shift, bool ctrl)
    {
        if (RowCount == 0 || ColumnCount == 0) return;
        GridMove? move = key switch
        {
            "ArrowUp" => GridMove.Up,
            "ArrowDown" => GridMove.Down,
            "ArrowLeft" => GridMove.Left,
            "ArrowRight" => GridMove.Right,
            "PageUp" => GridMove.PageUp,
            "PageDown" => GridMove.PageDown,
            "Home" => ctrl ? GridMove.CtrlHome : GridMove.Home,
            "End" => ctrl ? GridMove.CtrlEnd : GridMove.End,
            _ => null,
        };
        if (move is { } m)
        {
            // Past the top row the focus goes to the header (type tooltip, resize, header menu); left of the
            // first column, to the row number (Delete toggles the row's delete).
            if (!shift && !ctrl && !_selection.IsEmpty)
            {
                if (m == GridMove.Up && _selection.Focus.Row == 0) { FocusHeader(_selection.Focus.Col); return; }
                if (m == GridMove.Left && _selection.Focus.Col == 0) { _area = FocusArea.RowNumber; KeyboardMoved(); return; }
            }
            _selection.Move(m, shift, PageRows);
            KeyboardMoved();
            return;
        }
        if (ctrl || _selection.IsEmpty) return;

        var focus = _selection.Focus;
        if (!IsCellEditable(_rowIndexes[focus.Row], focus.Col)) return;
        if (key is "Enter" or "F2") BeginEdit(focus.Row, focus.Col);
        else if (key.Length == 1) BeginEdit(focus.Row, focus.Col, replaceWith: key);   // FR-013: typing replaces
    }

    private void HeaderKey(string key, bool shift)
    {
        if (ColumnCount == 0) return;
        switch (key)
        {
            case "ArrowLeft": _headerCol = Math.Max(0, _headerCol - 1); KeyboardMoved(); break;
            case "ArrowRight": _headerCol = Math.Min(ColumnCount - 1, _headerCol + 1); KeyboardMoved(); break;
            case "Home": _headerCol = 0; KeyboardMoved(); break;
            case "End": _headerCol = ColumnCount - 1; KeyboardMoved(); break;
            case "ArrowDown":
                if (RowCount == 0) return;
                _selection.Click(0, _headerCol, false, false);
                _area = FocusArea.Cell;
                KeyboardMoved();
                break;
            case " ":
            case "Enter":
                _selection.ClickColumnHeader(_headerCol, shift, false);
                break;
        }
    }

    private void RowNumberKey(string key, bool shift)
    {
        if (RowCount == 0 || _selection.IsEmpty) return;
        int row = _selection.Focus.Row;
        switch (key)
        {
            case "ArrowUp":
                if (row > 0) _selection.ClickRowHeader(row - 1, shift, false);
                KeyboardMoved();
                break;
            case "ArrowDown":
                if (row < RowCount - 1) _selection.ClickRowHeader(row + 1, shift, false);
                KeyboardMoved();
                break;
            case "ArrowRight":
                _selection.Click(row, 0, false, false);
                _area = FocusArea.Cell;
                KeyboardMoved();
                break;
            case " ":
                _selection.ClickRowHeader(row, shift, false);
                break;
            case "Delete":
                if (Set.IsEditable) ToggleDelete(_rowIndexes[row]);
                break;
        }
    }

    private void FocusHeader(int col)
    {
        _area = FocusArea.Header;
        _headerCol = Math.Clamp(col, 0, Math.Max(0, ColumnCount - 1));
        KeyboardMoved();
    }

    private void KeyboardMoved()
    {
        _keyboardFocus = true;
        _tooltipDismissed = false;
        _scrollPending = true;
    }

    private void SelectAll()
    {
        _selection.SelectAll();
        _area = FocusArea.Cell;
    }

    // ── Column widths (FR-001–FR-007) ──────────────────────────────────────────────────────────────

    private void ResizeFocusedColumn(int delta)
    {
        int c = _area == FocusArea.Header ? _headerCol : _selection.IsEmpty ? -1 : _selection.Focus.Col;
        if (c < 0 || c >= ColumnCount) return;
        _layout.SetUserWidth(c, _layout.WidthPx(c) + delta);
    }

    /// <summary>The header and the longest display texts of one column. Display length follows the wire
    /// length for every type except money (padded to four decimals), so only money is formatted per row.</summary>
    private FitCandidates Candidates(int c)
    {
        var header = ColumnLabel(c);
        int n = Set.Rows.Length;
        bool money = c < _types.Length && _types[c].BaseName is "money" or "smallmoney";
        if (money)
            return GridColumnLayout.SelectCandidates(header, Enumerable.Range(0, n).Select(r => Format(CurrentWire(r, c), c, false).Text));
        var picked = GridColumnLayout.SelectCandidates(header, Enumerable.Range(0, n).Select(r => CurrentWire(r, c) ?? GridTextFormats.NullText));
        return picked with
        {
            Values = picked.Values.Select(w => w == GridTextFormats.NullText ? w : Format(w, c, false).Text).ToList(),
        };
    }

    private void FitByEstimate(IReadOnlyList<int> cols, bool replaceUser)
    {
        foreach (var c in cols)
        {
            var cand = Candidates(c);
            double value = cand.Values.Count == 0 ? 0 : cand.Values.Max(GridColumnLayout.EstimatePx);
            Apply(c, GridColumnLayout.Fit(GridColumnLayout.EstimatePx(cand.Header), value), replaceUser);
        }
    }

    /// <summary>Fit columns to their content: the browser measures the candidates with a canvas; without it
    /// (tests, a disposal race) the 7 px-per-character estimate stands in.</summary>
    private async Task FitColumnsAsync(IReadOnlyList<int> cols, bool replaceUser)
    {
        if (cols.Count == 0) return;
        var cands = cols.Select(Candidates).ToArray();
        MeasuredWidth[]? measured = null;
        var module = await ModuleAsync();
        if (module != null)
        {
            try
            {
                measured = await module.InvokeAsync<MeasuredWidth[]?>("measureColumns", _root,
                    cands.Select(x => x.Header).ToArray(), cands.Select(x => x.Values.ToArray()).ToArray());
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            catch (TaskCanceledException) { }
        }
        for (int i = 0; i < cols.Count; i++)
        {
            double header, value;
            if (measured != null && i < measured.Length && measured[i] != null)
            {
                header = measured[i].Header;
                value = measured[i].Value;
            }
            else
            {
                header = GridColumnLayout.EstimatePx(cands[i].Header);
                value = cands[i].Values.Count == 0 ? 0 : cands[i].Values.Max(GridColumnLayout.EstimatePx);
            }
            Apply(cols[i], GridColumnLayout.Fit(header, value), replaceUser);
        }
    }

    private void Apply(int col, int px, bool replaceUser)
    {
        if (replaceUser) _layout.AutoFit(col, px);
        else _layout.ApplyFit(col, px);
    }

    /// <summary>"Auto-fit this column" and a double-click on the column's edge (FR-004).</summary>
    private Task AutoFitColumnAsync(int col) => FitColumnsAsync(new[] { col }, replaceUser: true);

    // ── Copy (FR-009, FR-031) ──────────────────────────────────────────────────────────────────────

    private string[] Headers() => Enumerable.Range(0, ColumnCount).Select(ColumnLabel).ToArray();

    private async Task CopyAsync(CopyFormat format, bool includeHeader)
    {
        if (_selection.IsEmpty) return;
        if (_unconfirmed.Count > 0 && _selection.SelectedRows().Any(d => IsUnconfirmed(_rowIndexes[d])))
        {
            Notify(UnconfirmedExportMessage, NotificationKind.Warning);
            return;
        }
        var kinds = Enumerable.Range(0, ColumnCount)
            .Select(c => GridTextFormats.KindOf(TypeOf(c), Set.ClrTypeHints.ElementAtOrDefault(c))).ToArray();
        var result = GridClipboard.Build(_selection, Headers(), _rowIndexes, DisplayText, format, includeHeader, RetainLineBreaksOnCopy,
            columnKinds: kinds);
        if (result.RowCount == 0) return;
        if (!await CopyTextAsync(result.Text))
        {
            Notify("Couldn't copy to the clipboard: the browser didn't allow it.", NotificationKind.Error);
            return;
        }
        if (result.Truncated)
        {
            Notify($"Copied the first {GridClipboard.MaxCopyChars.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} characters only: the selection is too large to copy whole.", NotificationKind.Warning);
            return;
        }
        var text = $"Copied {Plural(result.RowCount, "row")}.";
        if (result.EngineCutCount > 0)
        {
            text += result.EngineCutCount == 1
                ? " 1 value the engine cut was copied as its size."
                : $" {result.EngineCutCount} values the engine cut were copied as their size.";
        }
        Notify(text, result.EngineCutCount > 0 ? NotificationKind.Warning : NotificationKind.Success);
    }

    private async Task CopyColumnNameAsync(int col)
    {
        if (await CopyTextAsync(Set.ColumnNames[col])) Notify("Copied the column name.", NotificationKind.Success);
        else Notify("Couldn't copy to the clipboard: the browser didn't allow it.", NotificationKind.Error);
    }

    private async Task<bool> CopyTextAsync(string text)
    {
        try
        {
            _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
            return _ui != null && await _ui.InvokeAsync<bool>("copyText", text);
        }
        catch (JSException) { return false; }
        catch (JSDisconnectedException) { return false; }
        catch (InvalidOperationException) { return false; }
    }

    // ── Save results (FR-030) ──────────────────────────────────────────────────────────────────────

    private int CountEngineCut()
    {
        int n = 0;
        for (int r = 0; r < Set.Rows.Length; r++)
            for (int c = 0; c < ColumnCount; c++)
                if (EngineCutIndicator.IsIndicator(CurrentWire(r, c))) n++;
        return n;
    }

    /// <summary>"Save results as CSV…" (<paramref name="delimiter"/> ',') and "Save results as
    /// tab-delimited…" ('\t'): every row in display order, the text the grid shows, a header row.</summary>
    private async Task SaveResultsAsync(char delimiter)
    {
        if (_unconfirmed.Count > 0)
        {
            Notify(UnconfirmedExportMessage, NotificationKind.Warning);
            return;
        }
        bool csv = delimiter == ',';
        int cut = CountEngineCut();
        if ((Set.Truncated || cut > 0) && Dialogs is { } dialogs)
        {
            var details = new List<string>();
            if (Set.Truncated) details.Add($"The result was cut at the row limit: only the {Plural(Set.Rows.Length, "row")} shown will be saved.");
            if (cut > 0) details.Add(cut == 1
                ? "1 value the engine cut will be saved as its size, not its content."
                : $"{cut} values the engine cut will be saved as their size, not their content.");
            bool go = await dialogs.ConfirmAsync(new DialogRequest
            {
                Title = "Save an incomplete result?",
                Message = "The file will not hold the whole result.",
                Details = details,
                ConfirmLabel = "Save anyway",
            });
            if (!go) return;
        }

        var rows = new List<string[]>(_rowIndexes.Length);
        foreach (var r in _rowIndexes)
        {
            var line = new string[ColumnCount];
            for (int c = 0; c < ColumnCount; c++) line[c] = DisplayText(r, c) ?? GridTextFormats.NullText;
            rows.Add(line);
        }
        var text = GridTextFormats.Delimited(Headers(), rows, delimiter, RetainLineBreaksOnCopy);
        var fileName = SaveFileName(DocumentName, csv ? ".csv" : ".tsv");
        bool ok;
        try
        {
            _download ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-download.js");
            if (_download != null)
                await _download.InvokeVoidAsync("downloadText", fileName,
                    csv ? "text/csv;charset=utf-8" : "text/tab-separated-values;charset=utf-8", text, true);
            ok = _download != null;
        }
        catch (JSException) { ok = false; }
        catch (JSDisconnectedException) { ok = false; }
        catch (InvalidOperationException) { ok = false; }
        if (ok) Notify($"Saved {Plural(rows.Count, "row")} to {fileName}.", NotificationKind.Success);
        else Notify("Couldn't save the results file.", NotificationKind.Error);
    }

    /// <summary>The document's name without its extension and with characters a file name cannot hold
    /// replaced, plus <paramref name="extension"/>; <see cref="DefaultDocumentName"/> when it has none.</summary>
    public static string SaveFileName(string? documentName, string extension)
    {
        var name = (documentName ?? string.Empty).Trim();
        if (name.EndsWith(".sql", StringComparison.OrdinalIgnoreCase)) name = name.Substring(0, name.Length - 4);
        var invalid = System.IO.Path.GetInvalidFileNameChars().Concat(new[] { '<', '>', ':', '"', '/', '\\', '|', '?', '*' }).ToHashSet();
        name = new string(name.Select(ch => invalid.Contains(ch) || char.IsControl(ch) ? '_' : ch).ToArray()).Trim(' ', '.');
        return (name.Length == 0 ? DefaultDocumentName : name) + extension;
    }

    // ── Sort (FR-012) ──────────────────────────────────────────────────────────────────────────────

    private void CycleSort(int col)
    {
        if (_sortCol != col) SortBy(col, descending: false);
        else if (!_sortDesc) SortBy(col, descending: true);
        else ClearSort();
        _focusRootPending = true;
    }

    private void SortBy(int col, bool descending)
    {
        _sortCol = col;
        _sortDesc = descending;
        ApplySort();
    }

    private void ClearSort()
    {
        _sortCol = -1;
        _sortDesc = false;
        ApplySort();
    }

    /// <summary>Order the display by the sort column's CURRENT (edited) values. Only _rowIndexes moves;
    /// the selection follows the focused fetched row.</summary>
    private void ApplySort()
    {
        var before = _rowIndexes;
        var identity = Enumerable.Range(0, Set.Rows.Length).ToArray();
        _rowIndexes = _sortCol < 0 || _sortCol >= ColumnCount
            ? identity
            : GridSortComparer.Sort(identity, r => CurrentWire(r, _sortCol), Set.ClrTypeHints.ElementAtOrDefault(_sortCol), _sortDesc);
        _selection.RemapThroughPermutation(before, _rowIndexes);
    }

