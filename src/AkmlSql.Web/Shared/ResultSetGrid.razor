    private MenuItem ViewValueItem()
    {
        var (d, c) = _menuCell;
        bool unconfirmed = d >= 0 && d < RowCount && IsUnconfirmed(_rowIndexes[d]);
        string? wire = d >= 0 && d < RowCount && c >= 0 && c < ColumnCount ? CurrentWire(_rowIndexes[d], c) : null;
        return new MenuItem
        {
            Label = "View value", TestId = "results-menu-view-value",
            Disabled = unconfirmed || wire == null, DisabledReason = unconfirmed ? UnconfirmedTitle : "The value is NULL.",
            OnSelect = Command(() => OpenViewValue(_rowIndexes[d], c)),
        };
    }

    private MenuItem SetNullItem()
    {
        var (d, c) = _menuCell;
        string? reason = d >= 0 && d < RowCount && c >= 0 && c < ColumnCount ? SetNullBlockedReason(_rowIndexes[d], c) : "Select a cell first.";
        return new MenuItem
        {
            Label = "Set to NULL", Shortcut = "Ctrl+0", TestId = "results-menu-set-null",
            Disabled = reason != null, DisabledReason = reason,
            OnSelect = Command(() => CommitEdit(_rowIndexes[d], c, null)),
        };
    }

    private MenuItem DeleteRowsItem()
    {
        var rows = _selection.SelectedRows().Select(d => _rowIndexes[d]).ToList();
        bool restore = rows.Count > 0 && rows.All(_deletes.Contains);
        string noun = rows.Count == 1 ? "row" : "rows";
        return new MenuItem
        {
            Label = (restore ? "Restore " : "Delete ") + noun,
            TestId = "results-menu-delete-row",
            Disabled = rows.Count == 0 || !CanMutate, DisabledReason = LockReason ?? "Select a row first.",
            OnSelect = Command(() =>
            {
                if (RefuseWhileLocked()) return;
                foreach (var r in rows)
                {
                    if (IsUnconfirmed(r)) continue;   // its key is not known
                    if (restore) _deletes.Remove(r);
                    else if (_deletes.Add(r)) _edits.Remove(r);
                }
            }),
        };
    }

