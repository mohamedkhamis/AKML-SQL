@*
    Spec 021 (web edition) -- M2 task T045. Problems list:
      * Filter by severity (Off / Info / Warning / Error)
      * Sort by line number
      * Click-to-jump (calls back the parent with the line/col so the parent can
        invoke EditorComponent.GotoLineAsync)
      * Render inline suppression hint (-- akml-disable-line RuleId)
*@
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Web.Services

<div class="akml-problems">
    @* Spec 042 (FR-014): the errors the last PostgreSQL run reported, each at its line and column. They are not analysis
       findings, so they show whatever the analysis switch says. *@
    @if (_executionErrors.Count > 0)
    {
        <ul class="akml-problems-list akml-problems-exec" data-testid="problems-execution">
            @foreach (var error in _executionErrors)
            {
                <li class="akml-problems-row akml-severity-error" data-testid="problem-execution"
                    data-line="@error.Line" data-column="@error.Column" title="@error.Title"
                    @onclick="@(() => JumpToExecutionAsync(error))">
                    <span class="akml-problems-rule">@error.Code</span>
                    <span class="akml-problems-message">@error.Message</span>
                    <span class="akml-problems-location">L@(error.Line):@(error.Column)</span>
                </li>
            }
        </ul>
    }
    @if (!AnalysisEnabled)
    {
        @* Spec 041 (FR-034, FR-055): switched off in Settings › Code analysis — say so and offer to turn it on. *@
        <p class="akml-empty akml-problems-empty" data-testid="problems-analysis-off">
            Code analysis is off.
            <button type="button" class="akml-btn" data-testid="problems-enable-analysis" @onclick="OnEnableAnalysis">Turn on</button>
        </p>
    }
    else
    {
    <div class="akml-problems-header" data-testid="problems-header">
        @* Spec 041 (R34): inside the results pane the Problems tab carries the title and the count. *@
        @if (ShowHeader)
        {
            <span data-testid="problems-title">Problems</span>
            <span class="akml-problems-count">@(_filtered?.Count ?? 0)</span>
        }
        <span class="akml-problems-spacer"></span>
        <label class="akml-problems-filter-label">
            <input type="checkbox" checked="@_showInfo" @onchange="ToggleInfo" /> Info
        </label>
        <label class="akml-problems-filter-label">
            <input type="checkbox" checked="@_showWarn" @onchange="ToggleWarn" /> Warn
        </label>
        <label class="akml-problems-filter-label">
            <input type="checkbox" checked="@_showError" @onchange="ToggleError" /> Error
        </label>
    </div>

    @if ((_filtered == null || _filtered.Count == 0) && _executionErrors.Count > 0)
    {
        @* The list above is the problem; there is no analysis finding to add to it. *@
    }
    else if (_filtered == null || _filtered.Count == 0)
    {
        @* Spec 041 (T205, FR-034, FR-088): truthful about what was analysed, and what to do next. *@
        <div class="akml-empty akml-problems-empty" data-testid="problems-empty">
            @if (Findings == null)
            {
                <span>This document has not been analysed yet. Run Analyse (Ctrl+K, Ctrl+L).</span>
            }
            else if (Findings.Issues is { Length: > 0 })
            {
                <span>Every problem is hidden by the Info / Warn / Error filters.</span>
            }
            else
            {
                <span>No problems found. Run Analyse (Ctrl+K, Ctrl+L) again after a change.</span>
            }
        </div>
    }
    else
    {
        <ul class="akml-problems-list">
            @foreach (var issue in _filtered)
            {
                <li class="akml-problems-row akml-severity-@SeverityClass(issue.Severity)"
                    data-testid="problem-item"
                    data-line="@issue.Line"
                    data-column="@issue.Column"
                    title="@($"{issue.RuleId} — {issue.Message} (line {issue.Line})")"
                    @onclick="@(() => JumpAsync(issue))">
                    <span class="akml-problems-rule">@issue.RuleId</span>
                    <span class="akml-problems-message">@issue.Message</span>
                    <span class="akml-problems-location">L@(issue.Line)</span>
                    @* Spec 027 T025/T026 (US4) — suppression actions. stopPropagation keeps
                       the row's click-to-jump from firing when a suppress button is clicked. *@
                    @if (!string.IsNullOrEmpty(issue.RuleId))
                    {
                        <span class="akml-problems-actions">
                            @* Spec 042 (FR-150): a finding that carries a documentation page (every PostgreSQL rule does) links to it. *@
                            @if (DocumentationUrl(issue) is { } documentation)
                            {
                                <a class="akml-problems-suppress akml-problems-doc"
                                   data-testid="problem-doc"
                                   href="@documentation" target="_blank" rel="noopener noreferrer"
                                   title="@($"{issue.RuleId} in the documentation")"
                                   @onclick:stopPropagation="true">docs</a>
                            }
                            <button class="akml-problems-suppress"
                                    data-testid="suppress-line"
                                    title="@($"Suppress {issue.RuleId} for this line")"
                                    @onclick="@(() => SuppressLineAsync(issue))"
                                    @onclick:stopPropagation="true">⊘line</button>
                            <button class="akml-problems-suppress"
                                    data-testid="suppress-global"
                                    title="@($"Disable rule {issue.RuleId} globally")"
                                    @onclick="@(() => SuppressGlobalAsync(issue))"
                                    @onclick:stopPropagation="true">⊘all</button>
                        </span>
                    }
                </li>
            }
        </ul>
    }
    }
</div>

<style>
    .akml-problems {
        display: flex;
        flex-direction: column;
        height: 100%;
        background-color: var(--akml-surface-panel);
        border-left: 1px solid var(--akml-border-default);
        font-family: var(--akml-type-chrome-family);
        font-size: var(--akml-type-chrome-size);
        color: var(--akml-text-primary);
    }
    .akml-problems-header {
        display: flex;
        align-items: center;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        border-bottom: 1px solid var(--akml-border-default);
        background-color: var(--akml-surface-panel);
        font-weight: bold;
    }
    /* Spec 043 (FR-032): a badge token behind white text; the status colour read under 3:1 in the dark theme. */
    .akml-problems-count {
        background-color: var(--akml-accent-primary);
        color: var(--akml-text-onaccent);
        padding: 0 var(--akml-scalar-spacing-xs);
        border-radius: var(--akml-scalar-radius-s);
        font-size: 11px;
    }
    .akml-problems-spacer { flex: 1 1 auto; }
    .akml-problems-filter-label {
        font-weight: normal;
        font-size: 12px;
        color: var(--akml-text-secondary);
    }
    .akml-problems-empty {
        padding: var(--akml-scalar-spacing-m);
        color: var(--akml-text-secondary);
        font-style: italic;
    }
    .akml-problems-list {
        margin: 0;
        padding: 0;
        list-style: none;
        overflow: auto;
    }
    .akml-problems-row {
        display: grid;
        grid-template-columns: 80px 1fr 40px auto;
        align-items: center;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        cursor: pointer;
        border-bottom: 1px solid var(--akml-border-subtle);
    }
    .akml-problems-row:hover {
        background-color: var(--akml-surface-hover);
    }
    .akml-problems-rule { color: var(--akml-text-secondary); font-family: var(--akml-type-editor-family); }
    .akml-problems-message { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .akml-problems-location { color: var(--akml-text-secondary); text-align: right; }
    /* Spec 027 T025/T026 — per-finding suppress actions, revealed on row hover. */
    .akml-problems-actions { display: flex; gap: 2px; opacity: 0; }
    .akml-problems-row:hover .akml-problems-actions { opacity: 1; }
    .akml-problems-suppress {
        font-family: var(--akml-type-chrome-family); font-size: 11px;
        background-color: var(--akml-surface-panel); color: var(--akml-text-secondary);
        border: 1px solid var(--akml-border-default); border-radius: var(--akml-scalar-radius-xs);
        padding: 0 var(--akml-scalar-spacing-xs); cursor: pointer;
    }
    .akml-problems-suppress:hover { background-color: var(--akml-surface-hover); color: var(--akml-text-primary); }
    .akml-problems-doc { text-decoration: none; }
    .akml-problems-row:focus-within .akml-problems-actions { opacity: 1; }
    .akml-severity-error .akml-problems-rule { color: var(--akml-status-danger); font-weight: bold; }
    .akml-severity-warning .akml-problems-rule { color: var(--akml-status-warning); font-weight: bold; }
    .akml-severity-info .akml-problems-rule { color: var(--akml-status-info); }
    /* Severity glyph paired with color (not color alone) — rendered as an in-cell ::before
       so the row's 80px/1fr/40px/auto grid template is unaffected. */
    .akml-problems-rule::before { margin-right: var(--akml-scalar-spacing-xs); font-weight: bold; }
    .akml-severity-error .akml-problems-rule::before { content: "\26D4"; }   /* ⛔ no-entry */
    .akml-severity-warning .akml-problems-rule::before { content: "\26A0"; } /* ⚠ warning */
    .akml-severity-info .akml-problems-rule::before { content: "\2139"; }    /* ℹ info */
</style>

@code {
    /// <summary>Spec 041 (FR-055): false when Settings › Code analysis is off — the list says so instead.</summary>
    [Parameter] public bool AnalysisEnabled { get; set; } = true;

    /// <summary>"Turn on" in the analysis-off message.</summary>
    [Parameter] public EventCallback OnEnableAnalysis { get; set; }

    /// <summary>Spec 041 (R51): the severities shown when the list opens (Settings › Code analysis). Applied
    /// once — the first time it is given — so it never undoes what the user toggled here.</summary>
    [Parameter] public ProblemsFilter? DefaultFilter { get; set; }

    private bool _defaultFilterApplied;

    /// <summary>Spec 042 (FR-014): the last run. Its PostgreSQL errors (those with a SQLSTATE) are listed above the findings.</summary>
    [Parameter] public ExecuteQueryResult? ExecutionResult { get; set; }

    /// <summary>The document line / column the executed text started at (error positions map from them).</summary>
    [Parameter] public int SelectionStartLine { get; set; } = 1;
    [Parameter] public int SelectionStartColumn { get; set; } = 1;

    /// <summary>Spec 042: an execution error was clicked: its line and column.</summary>
    [Parameter] public EventCallback<DocumentPosition> OnJumpToPosition { get; set; }

    private sealed record ExecutionProblem(string Code, string Message, int Line, int Column, string Title);

    private List<ExecutionProblem> _executionErrors = new();

    [Parameter] public CodeAnalysisResponse? Findings { get; set; }
    [Parameter] public EventCallback<IssueLocation> OnJumpToIssue { get; set; }
    // Spec 027 T025/T026 (US4) — suppression actions surfaced up to the editor page.
    [Parameter] public EventCallback<IssueLocation> OnSuppressLine { get; set; }
    [Parameter] public EventCallback<IssueLocation> OnSuppressGlobal { get; set; }

    /// <summary>Spec 041 (R34) — show the "Problems" title and count; off inside the results pane, whose tab
    /// shows them. The severity filters stay either way.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Spec 041 (R34) — the number of findings the filters let through, raised only when it changes
    /// (the Problems tab badge).</summary>
    [Parameter] public EventCallback<int> OnVisibleCountChanged { get; set; }

    private int _lastVisibleCount = -1;

    // Only an http(s) address becomes a link: the engine supplies it, and a link is something a person will click.
    private static string? DocumentationUrl(CodeIssueInfo issue) =>
        Uri.TryCreate(issue.ReferenceUrl, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https" ? uri.AbsoluteUri : null;

    private bool _showInfo = true;
    private bool _showWarn = true;
    private bool _showError = true;
    private List<CodeIssueInfo>? _filtered;

    // CodeIssueInfo.Severity is an int: 0=Hint, 1=Info, 2=Warning, 3=Error.
    private const int SeverityHint = 0;
    private const int SeverityInfo = 1;
    private const int SeverityWarning = 2;
    private const int SeverityError = 3;

    protected override void OnParametersSet()
    {
        if (!_defaultFilterApplied && DefaultFilter != null)
        {
            _defaultFilterApplied = true;
            _showInfo = DefaultFilter.ShowInfo;
            _showWarn = DefaultFilter.ShowWarning;
            _showError = DefaultFilter.ShowError;
        }
        _executionErrors = ExecutionProblems();
        Recompute();
    }

    // Errors of a PostgreSQL run that map to a place in the document, in the order they happened.
    private List<ExecutionProblem> ExecutionProblems()
    {
        var found = new List<ExecutionProblem>();
        var details = ExecutionResult?.MessageDetails;
        if (details == null) return found;
        foreach (var message in details)
        {
            if (message.Kind != ExecuteMessageKind.Error || string.IsNullOrEmpty(message.SqlState)) continue;
            var line = ExecuteLineMapper.DocumentLine(SelectionStartLine, ExecutionResult!, message);
            if (line is not int documentLine) continue;
            var column = ExecuteLineMapper.DocumentColumn(SelectionStartColumn, message) ?? 1;
            found.Add(new ExecutionProblem(message.SqlState!, message.Text ?? string.Empty, documentLine, column,
                AkmlSql.Core.Text.SqlMessageText.ForPostgres(message) + " (line " + documentLine + ", column " + column + ")"));
        }
        return found;
    }

    private Task JumpToExecutionAsync(ExecutionProblem problem) =>
        OnJumpToPosition.InvokeAsync(new DocumentPosition(problem.Line, problem.Column));

    private void Recompute()
    {
        _filtered = !AnalysisEnabled || Findings?.Issues == null
            ? null
            : Findings.Issues
                .Where(i => MatchesFilter(i.Severity))
                .OrderBy(i => i.Line)
                .ThenBy(i => i.Column)
                .ToList();

        int count = (_filtered?.Count ?? 0) + _executionErrors.Count;
        if (count != _lastVisibleCount)
        {
            _lastVisibleCount = count;
            // Raised from OnParametersSet too, so only on a change — a parent that re-renders on it must
            // not loop.
            _ = OnVisibleCountChanged.InvokeAsync(count);
        }
    }

    private bool MatchesFilter(int severity) =>
        severity switch
        {
            SeverityHint => _showInfo,
            SeverityInfo => _showInfo,
            SeverityWarning => _showWarn,
            SeverityError => _showError,
            _ => true,
        };

    private static string SeverityClass(int severity) =>
        severity switch
        {
            SeverityError => "error",
            SeverityWarning => "warning",
            _ => "info",
        };

    private void ToggleInfo() { _showInfo = !_showInfo; Recompute(); }
    private void ToggleWarn() { _showWarn = !_showWarn; Recompute(); }
    private void ToggleError() { _showError = !_showError; Recompute(); }

    private Task JumpAsync(CodeIssueInfo issue) =>
        OnJumpToIssue.InvokeAsync(new IssueLocation(issue.Line, issue.Column, issue.RuleId));

    private Task SuppressLineAsync(CodeIssueInfo issue) =>
        OnSuppressLine.InvokeAsync(new IssueLocation(issue.Line, issue.Column, issue.RuleId));

    private Task SuppressGlobalAsync(CodeIssueInfo issue) =>
        OnSuppressGlobal.InvokeAsync(new IssueLocation(issue.Line, issue.Column, issue.RuleId));

    public sealed record IssueLocation(int Line, int Column, string RuleId);
}
