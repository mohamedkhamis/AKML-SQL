@*
    Spec 021 (web edition) -- M3 task T076 (FR-017a). Renders an inline "feature
    requires engine X" notice when a required capability is missing from the bridge's
    advertised list. Per clarification 5: missing capability -> inline notice, NOT a
    full-page blocker.

    Usage:
        <CapabilityNotice RequiredCapability="snippets.write">
            <p>Save / delete snippets via the engine.</p>
        </CapabilityNotice>

    If the capability is present, the @ChildContent renders. Otherwise the inline
    notice renders in its place.

    Spec 042 (task T121, FR-006). Two additions, both optional, so the usage above is unchanged:
      - Available: a caller that already knows (the connection dialog reads SqlConn.EngineSupportsPostgres)
        passes the answer and the component does not consult the bridge.
      - Feature / EngineConnected / EngineVersion / TestId: the notice then names the feature, the capability and the
        engine version found, or asks for an engine first, and carries the caller's test id.
        <CapabilityNotice Available="false" Feature="PostgreSQL" RequiredCapability="dialect.postgresql.v1" />
*@
@using AkmlSql.Web.Services
@implements IDisposable
@inject IServiceProvider Services

@if (IsAvailable)
{
    @ChildContent
}
else
{
    <div class="akml-capability-notice" role="note" data-testid="@TestId" data-capability="@RequiredCapability">
        <span class="akml-capability-notice-icon">i</span>
        <span class="akml-capability-notice-text">
            @if (string.IsNullOrEmpty(Feature))
            {
                <text>This feature requires engine capability <code>@RequiredCapability</code>,
                which the paired engine does not advertise. Update the engine to use it.</text>
            }
            else if (!EngineConnected)
            {
                <text>@Feature needs an engine that supports <code>@RequiredCapability</code>. Pair an engine first (Settings › Connections).</text>
            }
            else
            {
                <text>@Feature needs an engine that supports <code>@RequiredCapability</code>. @FoundText: update the engine, or check that postgreSql.enabled is not false in its config.json.</text>
            }
        </span>
    </div>
}

<style>
    .akml-capability-notice {
        display: flex;
        align-items: flex-start;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-s);
        background-color: var(--akml-surface-panel);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-s);
        color: var(--akml-text-secondary);
    }
    .akml-capability-notice-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px; height: 16px;
        /* Spec 043 (FR-032): a badge token behind white text; the status colour read under 3:1 in the dark theme. */
        background-color: var(--akml-accent-primary);
        color: var(--akml-text-onaccent);
        border-radius: var(--akml-scalar-radius-pill);
        font-size: 11px;
        font-weight: bold;
    }
    .akml-capability-notice code {
        font-family: var(--akml-type-editor-family);
        color: var(--akml-text-primary);
    }
</style>

@code {
    [Parameter] public string RequiredCapability { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Spec 042: the caller already knows whether the engine offers the capability; the bridge is not consulted.</summary>
    [Parameter] public bool? Available { get; set; }

    /// <summary>Spec 042: what needs the capability, as the person knows it ("PostgreSQL"). Empty keeps the original wording.</summary>
    [Parameter] public string? Feature { get; set; }

    /// <summary>Spec 042: false when no engine is paired at all; the notice then asks for one first.</summary>
    [Parameter] public bool EngineConnected { get; set; } = true;

    /// <summary>Spec 042: the paired engine's version, when known.</summary>
    [Parameter] public string? EngineVersion { get; set; }

    [Parameter] public string TestId { get; set; } = "capability-notice";

    private bool _isAvailable;
    private IEngineBridge? _bridge;

    private bool IsAvailable => Available ?? _isAvailable;

    private string FoundText
    {
        get
        {
            var version = AkmlSql.Core.AppVersion.StripBuildMetadata(EngineVersion);
            return string.IsNullOrWhiteSpace(version)
                ? "The paired engine does not advertise it"
                : $"The paired engine (version {version}) does not advertise it";
        }
    }

    protected override void OnInitialized()
    {
        // The bridge is optional: a caller that passes Available never needs it, and a host without one reads as "not offered".
        _bridge = Services.GetService(typeof(IEngineBridge)) as IEngineBridge;
        Refresh();
        if (_bridge != null) _bridge.StateChanged += OnBridgeStateChanged;
    }

    private void OnBridgeStateChanged(BridgeState _)
    {
        InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    protected override void OnParametersSet() => Refresh();

    private void Refresh()
    {
        _isAvailable = !string.IsNullOrEmpty(RequiredCapability)
            && _bridge != null
            && _bridge.Advertises(RequiredCapability);
    }

    public void Dispose()
    {
        if (_bridge != null) _bridge.StateChanged -= OnBridgeStateChanged;
    }
}
