@*
    Spec 025 (M3 bridge closure) US4 — schema object tree.
    Contract reference: specs/025-m3-bridge-closure/contracts/schema-tree-contract.md.

    Reads SchemaSnapshot bytes from ISchemaCacheStore (never sends IPC). Renders
    Database → Schema → Object-Kind → Object → Column. A click on a folder or its label opens it; a click on an Object
    selects it (and shows its columns), a double-click inserts its name into the editor, and right-click opens its context
    menu (Select Top 1000 Rows, Script as …, Insert / Copy name, Refresh) through OnObjectAction.
    Stale-indicator badge shows when bridge != Open. Virtualises children > 200.

    Spec 041 (research R40, N27, FR-093): the header names the server and database listed; Refresh asks the
    engine to reload (SchemaRefreshRequest, 6) and then fetches the schema again through ISchemaSync.RefreshAsync;
    a filter narrows the tree by object name (150 ms after typing, parents kept, matches opened, empty kinds hidden
    only while filtering); every node carries its icon; a loading row shows while the schema loads.
*@
@using System.Collections.Generic
@using System.Threading
@using AkmlSql.Core
@using AkmlSql.Core.Ipc
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Web.Services
@using MessagePack
@implements IDisposable
@inject ISchemaCacheStore Cache
@inject IEngineBridge Bridge
@inject ISchemaSync Sync
@inject IServiceProvider ServiceProvider

<div class="akml-schema-tree" data-testid="schema-tree">
    <div class="akml-schema-tree-header">
        @if (IsTargeted)
        {
            <span class="akml-schema-tree-target" data-testid="schema-header" title="@($"{_serverIdentity} · {_databaseName}")">@_serverIdentity · @_databaseName</span>
        }
        else
        {
            <span class="akml-schema-tree-target">Schema</span>
        }
        <span class="akml-schema-tree-spacer"></span>
        @if (IsTargeted)
        {
            <button type="button" class="akml-btn akml-btn--icon" data-testid="schema-refresh" aria-label="Refresh schema"
                    title="@RefreshTitle" disabled="@(!CanRefresh)" @onclick="RefreshAsync">
                <Icon Name="refresh-cw" Size="14" />
            </button>
        }
        @if (OnPinToggled.HasDelegate)
        {
            @* Pinned: the panel keeps its column. Unpinned: it hides to its edge strip and opens over the editor. *@
            <button type="button" class="akml-btn akml-btn--icon akml-btn--ghost" data-testid="schema-pin"
                    aria-pressed="@(Pinned ? "true" : "false")" aria-label="@(Pinned ? "Auto-hide the Schema panel" : "Pin the Schema panel")"
                    title="@(Pinned ? "Auto-hide: show the panel only while you use it" : "Pin: keep the panel open beside the editor")"
                    @onclick="() => OnPinToggled.InvokeAsync()">
                <Icon Name="@(Pinned ? "pin" : "pin-off")" Size="14" />
            </button>
        }
        @if (OnClose.HasDelegate)
        {
            <button type="button" class="akml-btn akml-btn--icon akml-btn--ghost" data-testid="schema-close"
                    aria-label="Close the Schema panel" title="Close (F8)" @onclick="() => OnClose.InvokeAsync()">
                <Icon Name="x" Size="14" />
            </button>
        }
    </div>

    @if (IsTargeted && _payload != null)
    {
        <div class="akml-schema-tree-filter">
            <Icon Name="filter" Size="14" />
            <input type="search" class="akml-input" data-testid="schema-filter" aria-label="Filter objects" placeholder="Filter objects"
                   value="@_filterInput" @oninput="OnFilterInput" />
            @* Spec 042 (FR-040): pg_catalog and information_schema are loaded so names resolve, and shown only on request. *@
            @if (HasSystemSchemas)
            {
                @* A toggle that reads as one in every theme: a check box that fills with the accent when on (the old
                   28 px icon button squeezed the word and showed "on" only as a faint inset line in dark mode). *@
                <button type="button" class="akml-btn akml-schema-system-toggle @(_showSystem ? "is-on" : null)"
                        data-testid="schema-system-toggle" aria-pressed="@(_showSystem ? "true" : "false")"
                        title="@(_showSystem ? "Hide system objects" : "Show system objects")" @onclick="ToggleSystem">
                    <span class="akml-schema-system-box" data-testid="schema-system-box" aria-hidden="true">
                        @if (_showSystem)
                        {
                            <Icon Name="check" Size="12" />
                        }
                    </span>
                    <span>System</span>
                </button>
            }
        </div>
    }

    @if (IsRefreshing || (IsTargeted && _payload == null && IsEngineLive))
    {
        <div class="akml-schema-tree-loading" data-testid="schema-loading" role="status">
            <Icon Name="loader-circle" Size="14" Class="akml-spin" />
            <span>@(IsRefreshing ? "Refreshing schema…" : "Loading schema…")</span>
        </div>
    }
    @if (_refreshError != null)
    {
        <div class="akml-schema-tree-error" data-testid="schema-refresh-error" role="alert">Refresh failed: @_refreshError</div>
    }

    @if (_showStaleBadge)
    {
        <div class="akml-schema-tree-stale" data-testid="schema-tree-stale">
            Stale — @FormatRelative(_fetchedAt)
        </div>
    }

    @if (!IsTargeted)
    {
        @* Spec 041 (FR-048): the panel stays, and says how to fill it. *@
        <div class="akml-schema-tree-empty">
            <p>Not connected to a database.</p>
            <button type="button" class="akml-btn" data-testid="schema-connect" @onclick="OnConnectRequested">Connect…</button>
        </div>
    }
    else if (_payload == null)
    {
        @if (!IsEngineLive)
        {
            <p class="akml-schema-tree-empty">Schema not yet loaded — waiting for engine.</p>
        }
    }
    else
    {
        var filtering = _filter.Length > 0;
        <ul class="akml-schema-tree-list" data-testid="schema-tree-root">
            <li class="akml-schema-tree-node akml-schema-tree-db akml-schema-tree-folder" @onclick="@(() => Toggle(DbPath))">
                <span class="akml-schema-tree-expand"><Icon Name="@Chevron(IsOpen(DbPath))" Size="12" Class="akml-schema-chevron" /></span>
                <Icon Name="database" Size="14" Class="akml-schema-icon akml-schema-icon--database" />
                <span class="akml-schema-tree-label">Database "@_databaseName"</span>
            </li>
            @if (IsOpen(DbPath))
            {
                @foreach (var schema in _payload.Schemas ?? Array.Empty<SchemaPhaseSchema>())
                {
                    if (IsHiddenSchema(schema.Name)) continue;
                    var inaccessible = IsInaccessibleSchema(schema.Name);
                    var schemaPath = DbPath + "/" + schema.Name;
                    var kinds = EnumerateKinds(schema, _filter, Kind).Where(k => !filtering || k.Objects.Count > 0).ToList();
                    if (filtering && (kinds.Count == 0 || inaccessible)) continue;
                    <li class="akml-schema-tree-node akml-schema-tree-schema akml-schema-tree-folder" @onclick="@(() => Toggle(schemaPath))">
                        <span class="akml-schema-tree-expand"><Icon Name="@Chevron(IsOpen(schemaPath))" Size="12" Class="akml-schema-chevron" /></span>
                        <Icon Name="folder-open" Size="14" Class="akml-schema-icon akml-schema-icon--schema" />
                        <span class="akml-schema-tree-label">Schema "@schema.Name"</span>
                        @if (inaccessible)
                        {
                            @* Spec 042 (FR-046): listed, marked, and left empty: the role has no USAGE on it. *@
                            <span class="akml-schema-tree-noaccess" data-testid="schema-inaccessible"
                                  title="Your role has no USAGE privilege on this schema, so its objects are not shown.">no access</span>
                        }
                    </li>
                    @if (IsOpen(schemaPath) && inaccessible)
                    {
                        <li class="akml-schema-tree-node akml-schema-tree-empty-kind" data-testid="schema-inaccessible-note">
                            <span class="akml-schema-tree-label">Not shown: no USAGE privilege.</span>
                        </li>
                    }
                    else if (IsOpen(schemaPath))
                    {
                        @foreach (var kind in kinds)
                        {
                            var kindPath = schemaPath + "/" + kind.Label;
                            var empty = kind.Objects.Count == 0;
                            <li class="@("akml-schema-tree-node akml-schema-tree-kind" + (empty ? null : " akml-schema-tree-folder"))"
                                @onclick="@(() => { if (!empty) Toggle(kindPath); })">
                                <span class="akml-schema-tree-expand">
                                    @if (!empty)
                                    {
                                        <Icon Name="@Chevron(IsOpen(kindPath))" Size="12" Class="akml-schema-chevron" />
                                    }
                                </span>
                                <Icon Name="@kind.Icon" Size="14" Class="@("akml-schema-icon akml-schema-icon--" + kind.Badge)" />
                                <span class="akml-schema-tree-label">@kind.Label (@kind.Objects.Count)</span>
                            </li>
                            @if (!empty && IsOpen(kindPath))
                            {
                                if (kind.Objects.Count > VirtualizeThreshold)
                                {
                                    <li class="akml-schema-tree-virtual" data-testid="schema-tree-virtualized">
                                        <Virtualize Items="@kind.Objects" Context="obj" ItemSize="24">
                                            @RenderObject(obj, kindPath + "/" + obj.ObjectName, schema.Name)
                                        </Virtualize>
                                    </li>
                                }
                                else
                                {
                                    @foreach (var obj in kind.Objects)
                                    {
                                        var objPath = kindPath + "/" + obj.ObjectName;
                                        @RenderObject(obj, objPath, schema.Name)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        </ul>
    }

    @if (_menu != null)
    {
        var menuObject = _menu.Object;
        var commands = SchemaObjectScripts.CommandsFor(menuObject.ObjectType);
        @* A transparent layer under the menu: any click or right-click outside it closes it. *@
        <div class="akml-schema-menu-backdrop" @onclick="CloseMenu" @oncontextmenu="CloseMenu" @oncontextmenu:preventDefault="true"></div>
        <div class="akml-schema-menu" role="menu" tabindex="-1" data-testid="schema-context-menu" @ref="_menuElement"
             aria-label="@($"Actions for {_menu.Qualifier}")"
             style="@($"left: min({_menu.X}px, calc(100vw - 240px)); top: min({_menu.Y}px, calc(100vh - 300px));")"
             @onkeydown="OnMenuKeyDown">
            @foreach (var command in commands)
            {
                var script = SchemaObjectScripts.Script(command, Kind, _menu.SchemaName, menuObject);
                <button type="button" role="menuitem" class="akml-schema-menu-item" data-testid="@($"schema-menu-{command}")"
                        disabled="@(script == null)" title="@(script == null ? "The columns have not loaded yet." : null)"
                        @onclick="@(() => RunMenuAsync(command))">@SchemaObjectScripts.Label(command, Kind, menuObject.ObjectType)</button>
            }
            @if (commands.Count > 0)
            {
                <div class="akml-schema-menu-separator" role="separator"></div>
            }
            <button type="button" role="menuitem" class="akml-schema-menu-item" data-testid="schema-menu-InsertName"
                    @onclick="@(() => RunMenuAsync(SchemaObjectCommand.InsertName))">Insert name</button>
            <button type="button" role="menuitem" class="akml-schema-menu-item" data-testid="schema-menu-CopyName"
                    @onclick="@(() => RunMenuAsync(SchemaObjectCommand.CopyName))">Copy name</button>
            <div class="akml-schema-menu-separator" role="separator"></div>
            <button type="button" role="menuitem" class="akml-schema-menu-item" data-testid="schema-menu-Refresh"
                    disabled="@(!CanRefresh)" title="@RefreshTitle" @onclick="RefreshFromMenuAsync">Refresh</button>
        </div>
    }
</div>

