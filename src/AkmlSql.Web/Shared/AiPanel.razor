@*
    Spec 021 (web edition) -- M6 task T131; extended by spec 028 (M6) US2/US3/US4.
    AI panel: five actions (Explain, Fix, Optimize, Text-to-SQL, Index Analysis) that
    stream their response (typewriter) into a result pane with Accept / Discard. Each
    action shows its active privacy mode. When the active provider can't be reached
    browser-direct (OpenAI / Azure -> CORS), a notice is shown instead of the actions.
*@
@using System.Collections.Generic
@using System.Threading
@using AkmlSql.Web.Services
@implements IDisposable
@inject IAiPromptService Prompts
@inject IAiPreference Preference
@inject IAiClientFactory Client
@inject IDiagnosticsRingBuffer Diagnostics

<div class="akml-ai-panel">
    <div class="akml-ai-header">
        <h3>AI assistance</h3>
    </div>

    @if (!_hasProvider)
    {
        @* Spec 041 (T205, FR-088): the shared empty state, with the way to fill it. *@
        <div class="akml-empty" data-testid="ai-empty">
            <p class="akml-empty-title">No AI provider configured</p>
            <p>Add a provider to explain, fix and optimise SQL. <a href="settings/ai-assistance">Add one in Settings</a>.</p>
        </div>
    }

    @if (_hasProvider && !_providerCapable)
    {
        <p class="akml-ai-notice">
            <strong>@_activeProvider</strong> can't be used directly from the browser (its API
            doesn't allow cross-origin calls). Use the desktop edition, choose a browser-capable
            provider (Claude, Gemini, Ollama, LM Studio), or point it at an OpenAI-compatible
            endpoint. <a href="settings/ai-assistance">Open Settings</a>.
        </p>
    }
    else if (_hasProvider)
    {
        <div class="akml-ai-buttons">
            <div class="akml-ai-action">
                <button class="akml-btn" @onclick="RunExplainAsync" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : null)">Explain</button>
                <AiPrivacyModeBadge FeatureId="explain" />
            </div>
            <div class="akml-ai-action">
                <button class="akml-btn" @onclick="RunFixAsync" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : null)">Fix</button>
                <AiPrivacyModeBadge FeatureId="fix" />
            </div>
            <div class="akml-ai-action">
                <button class="akml-btn" @onclick="RunOptimizeAsync" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : null)">Optimize</button>
                <AiPrivacyModeBadge FeatureId="optimize" />
            </div>
            <div class="akml-ai-action">
                <button class="akml-btn" @onclick="RunTextToSqlAsync" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : null)">Text to SQL</button>
                <AiPrivacyModeBadge FeatureId="texttosql" />
            </div>
            <div class="akml-ai-action">
                <button class="akml-btn" @onclick="RunIndexAnalysisAsync" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : null)">Index Analysis</button>
                <AiPrivacyModeBadge FeatureId="indexanalysis" />
            </div>
        </div>

        @if (_busy)
        {
            <p class="akml-ai-status">Calling AI provider…</p>
        }

        @if (!string.IsNullOrEmpty(_lastError))
        {
            <p class="akml-ai-error" role="alert" data-testid="ai-error">@_lastError</p>
            @if (_retry != null && !_busy)
            {
                <button type="button" class="akml-btn" data-testid="ai-retry" @onclick="_retry">Retry</button>
            }
        }

        @if (!string.IsNullOrEmpty(_lastResult))
        {
            <div class="akml-ai-result">
                <h4>Result</h4>
                <pre>@_lastResult</pre>
                <div class="akml-ai-result-buttons">
                    <button class="akml-btn" @onclick="AcceptResult" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : "Insert the result at the editor's caret")">Insert at caret</button>
                    <button class="akml-btn" @onclick="DiscardResult" disabled="@_busy" title="@(_busy ? "Waiting for the AI provider…" : null)">Discard</button>
                </div>
            </div>
        }
    }
</div>

<style>
    .akml-ai-panel { padding: var(--akml-scalar-spacing-m); }
    .akml-ai-header { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); margin-bottom: var(--akml-scalar-spacing-s); }
    .akml-ai-notice { color: var(--akml-status-warning); }
    .akml-ai-buttons { display: flex; gap: var(--akml-scalar-spacing-s); flex-wrap: wrap; align-items: flex-start; }
    .akml-ai-action { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; }
    .akml-ai-status { color: var(--akml-text-secondary); font-style: italic; }
    .akml-ai-error { color: var(--akml-status-danger); }
    .akml-ai-result {
        margin-top: var(--akml-scalar-spacing-m);
        padding: var(--akml-scalar-spacing-s);
        background-color: var(--akml-surface-panel);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
    }
    .akml-ai-result pre {
        font-family: var(--akml-editor-font-family, var(--akml-type-editor-family));
        font-size: var(--akml-editor-font-size, var(--akml-type-editor-size));
        line-height: var(--akml-type-editor-line-height);
        white-space: pre-wrap;
        margin: 0;
    }
    .akml-ai-result-buttons { display: flex; gap: var(--akml-scalar-spacing-s); margin-top: var(--akml-scalar-spacing-s); }
</style>

@code {
    /// <summary>Text the parent (Editor.razor) hands in -- usually the editor selection.</summary>
    [Parameter] public string SelectedSql { get; set; } = string.Empty;
    /// <summary>Optional lazy provider for the SQL to operate on, evaluated at action time so the
    /// live editor selection (or whole document) is always current. When null, <see cref="SelectedSql"/>
    /// is used -- which is how the bUnit tests drive the panel.</summary>
    [Parameter] public Func<Task<string>>? SelectedSqlProvider { get; set; }
    /// <summary>Raised when the user clicks Accept -- the parent inserts the text into the editor.</summary>
    [Parameter] public EventCallback<string> OnAcceptResult { get; set; }
    /// <summary>Spec 042 (FR-082): the error of the last run, read when Fix is clicked. A PostgreSQL error carries its SQLSTATE,
    /// detail and hint. Null (or no provider) sends what Fix always sent when no error was at hand.</summary>
    [Parameter] public Func<AiErrorInfo?>? LastErrorProvider { get; set; }

    private bool _hasProvider;
    private bool _providerCapable = true;
    private string _activeProvider = string.Empty;
    private bool _busy;
    private string? _lastResult;
    private string? _lastError;

    // Review WEB-18: runs the action whose answer failed or broke off again.
    private Func<Task>? _retry;

    // Per-surface streaming controller: one in-flight stream, cancelled when a new action
    // starts or the panel is disposed (FR-009/FR-010).
    private CancellationTokenSource? _cts;
    private bool _disposed;
    private const int RenderThrottleMs = 60;   // cap typewriter re-renders (avoid O(n^2) render churn)

    protected override async Task OnInitializedAsync()
    {
        _activeProvider = await Preference.GetActiveAsync();
        _hasProvider = !string.IsNullOrEmpty(_activeProvider);
        _providerCapable = !_hasProvider || Client.IsBrowserDirectCapable(_activeProvider);
    }

    private Task RunExplainAsync() => RunStreamAsync((sql, ct) => Prompts.ExplainStreamAsync(sql, ct), "Explain");
    private Task RunFixAsync() => RunStreamAsync((sql, ct) => Prompts.FixStreamAsync(sql, LastErrorProvider?.Invoke() ?? AiErrorInfo.None, ct), "Fix");
    private Task RunOptimizeAsync() => RunStreamAsync((sql, ct) => Prompts.OptimizeStreamAsync(sql, ct), "Optimize");
    private Task RunTextToSqlAsync() => RunStreamAsync((sql, ct) => Prompts.TextToSqlStreamAsync(sql, ct), "Text to SQL");
    private Task RunIndexAnalysisAsync() => RunStreamAsync((sql, ct) => Prompts.IndexAnalysisStreamAsync(sql, ct), "Index Analysis");

    private async Task RunStreamAsync(Func<string, CancellationToken, IAsyncEnumerable<string>> stream, string label)
    {
        // Cancel any previous stream so its tokens never bleed into this one.
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _busy = true;
        _lastError = null;
        _retry = null;
        _lastResult = string.Empty;
        StateHasChanged();
        // Resolve the SQL lazily so the live editor selection is current at click time; the
        // bUnit tests leave the provider null and rely on the SelectedSql parameter.
        var sql = SelectedSqlProvider != null ? await SelectedSqlProvider() : SelectedSql;
        var sb = new System.Text.StringBuilder();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            await foreach (var token in stream(sql, ct))
            {
                sb.Append(token);   // O(1) amortized — avoids O(n^2) string rebuild per token
                if (sw.ElapsedMilliseconds >= RenderThrottleMs) { sw.Restart(); _lastResult = sb.ToString(); StateHasChanged(); }   // throttled typewriter
            }
            Diagnostics.Log(DiagnosticLevel.Info, "ai", $"{label} completed ({sb.Length} chars).");
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer action -- keep whatever partial text rendered.
        }
        catch (AiNotSentException ex)
        {
            // Spec 042 (FR-081): the literals could not be removed and the user chose not to send the script as it is.
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Info, "ai", "Request not sent: literals could not be removed and the user declined.");
        }
        catch (ProviderNotBrowserDirectException ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai", ex.Message);
        }
        catch (UnauthorizedOriginException ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai", ex.Message);
        }
        catch (AiStreamException ex)
        {
            // Review WEB-18: the answer broke off. The partial text stays, marked incomplete, and the action can be run again.
            _lastError = ex.Message + (sb.Length > 0 ? " The result above is incomplete." : string.Empty);
            _retry = () => RunStreamAsync(stream, label);
            Diagnostics.Log(DiagnosticLevel.Warn, "ai", $"{label} stream failed: {ex.Failure} {ex.Code}");
        }
        catch (Exception ex)
        {
            // Preserve partial text (FR-011) and surface the mapped error.
            _lastError = MapErrorToMessage(ex);
            _retry = () => RunStreamAsync(stream, label);
            Diagnostics.Log(DiagnosticLevel.Error, "ai", _lastError, new { Exception = ex.GetType().Name });
        }
        finally
        {
            _lastResult = sb.ToString();   // flush the full / partial text (preserves FR-011 partial-on-error)
            _busy = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task AcceptResult()
    {
        if (!string.IsNullOrEmpty(_lastResult))
        {
            await OnAcceptResult.InvokeAsync(_lastResult);
        }
    }

    private void DiscardResult() { _lastResult = null; }

    /// <summary>
    /// FR-033 error mapping: surface user-readable messages for common provider failures.
    /// </summary>
    private static string MapErrorToMessage(Exception ex)
    {
        // Review WEB-21: the client's HTTP failures already say what happened in safe words (status + the provider's code);
        // a failure with no status never reached the provider.
        if (ex is System.Net.Http.HttpRequestException http)
            return http.StatusCode != null ? http.Message : "Provider unreachable. Check your network.";
        return $"AI call failed: {ex.Message}";
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
