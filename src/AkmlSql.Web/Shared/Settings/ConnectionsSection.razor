@*
    Spec 041 (R32, FR-057) — Settings › Connections, one vocabulary for both kinds: engine connections (add,
    connect, re-pair with a new PIN, remove — confirmed) and SQL Server connections (the connection now, the saved
    ones with Connect and Delete — confirmed — and the connection manager). A saved connection the web app cannot
    use says why, in place, and stays listed. No password is ever asked for or kept here. No Restore defaults.
    Spec 042: PostgreSQL connections are listed beside them, each with its kind; one whose password the engine remembers can
    have it forgotten, and is forgotten first when the connection is deleted. Spec 043 follow-up (review, round 2): a SQL Server
    login whose password the engine remembers is handled the same way.
*@
@using AkmlSql.Web.Services
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject ISqlConnectionService SqlConn
@inject ISavedSqlConnectionStore Saved
@inject IEngineBridge Bridge
@inject IConnectionManagerController ConnManager
@inject IDialogService Dialogs
@inject INotificationService Notifications
@inject IServiceProvider Services

<SettingRow Id="connections-engines" Kind="block">
    <ConnectionPickerComponent ShowTitle="false" />
</SettingRow>

<SettingRow Id="connections-sql" Kind="block">
    <p class="akml-hint">
        The paired engine opens the database connection, so the server can be on this computer or another one —
        the other server does not need AKML SQL installed. Windows authentication uses the engine computer's
        identity; for a remote server, use SQL Server authentication.
    </p>

    @if (SqlConn.IsConnected)
    {
        <p class="akml-settings-status" data-testid="settings-sql-connected">
            Connected to <strong>@SqlConn.Server</strong> / <strong>@SqlConn.Database</strong>@ActiveKindNote.
            <button type="button" class="akml-btn" disabled="@(RunInFlight || _disconnecting)"
                    title="@(RunInFlight ? RunInFlightText : _disconnecting ? "Checking for an open transaction…" : null)"
                    data-testid="settings-sql-disconnect" @onclick="DisconnectAsync">Disconnect</button>
        </p>
    }
    else if (Bridge.State != BridgeState.Open)
    {
        <p class="akml-settings-status">Pair an engine first (Engine connections › Add), then connect to a database.</p>
    }
    else
    {
        <p class="akml-settings-status">Not connected to a database.</p>
    }

    @if (_saved is { Count: > 0 })
    {
        <table class="akml-table">
            <thead><tr><th>Name</th>@if (ShowKinds) { <th>Kind</th> }<th>Server / database</th><th>Authentication</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _saved)
                {
                    var isPg = c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql;
                    var (ok, why) = isPg ? (true, (string?)null) : SqlConnectionService.ValidateTarget(c.Server, c.Database, c.WindowsAuth);
                    <tr data-testid="@($"saved-connection-{c.Id}")">
                        <td>@c.Name</td>
                        @if (ShowKinds)
                        {
                            <td><span class="akml-badge" data-testid="settings-conn-kind" data-kind="@(isPg ? "postgresql" : "sqlserver")">@(isPg ? "PostgreSQL" : "SQL Server")</span></td>
                        }
                        <td>@ServerText(c) / @c.Database</td>
                        <td>@AuthText(c)</td>
                        <td>
                            @if (isPg)
                            {
                                @* Spec 042: the password is asked for in the connection manager (or already held by the engine), never here. *@
                                <button type="button" class="akml-btn" data-testid="@($"settings-conn-connect-{c.Id}")"
                                        disabled="@(!SqlConn.EngineSupportsPostgres)"
                                        title="@(!SqlConn.EngineSupportsPostgres ? "Requires an engine with PostgreSQL support (dialect.postgresql.v1)" : null)"
                                        @onclick="@(() => ConnManager.Open(AkmlSql.Core.DatabaseKind.PostgreSql))">Connect…</button>
                                @if (c.RememberPassword)
                                {
                                    <button type="button" class="akml-btn" data-testid="@($"settings-conn-forget-{c.Id}")"
                                            title="Make the engine forget the password it remembers for this connection"
                                            @onclick="@(() => ForgetAsync(c))">Forget password</button>
                                }
                            }
                            else if (!ok)
                            {
                                <span class="akml-field-error" data-testid="@($"saved-connection-problem-{c.Id}")">@why</span>
                            }
                            else if (c.WindowsAuth)
                            {
                                <button type="button" class="akml-btn" disabled="@(Bridge.State != BridgeState.Open || RunInFlight)"
                                        title="@(Bridge.State != BridgeState.Open ? "Connect to an engine first" : RunInFlight ? RunInFlightText : null)"
                                        data-testid="@($"settings-conn-connect-{c.Id}")" @onclick="@(() => ConnectAsync(c))">Connect</button>
                            }
                            else
                            {
                                @* SQL Server authentication: the password is asked for in the connection manager, never kept here. *@
                                <button type="button" class="akml-btn" @onclick="@(() => ConnManager.Open())">Connect…</button>
                            }
                            @if (!isPg && HasRememberedPassword(c) && SqlConn.EngineRemembersSqlServerPasswords)
                            {
                                @* Spec 043 follow-up (review, round 2): a SQL login's password the engine remembers is forgotten as PostgreSQL's is. *@
                                <button type="button" class="akml-btn" data-testid="@($"settings-conn-forget-{c.Id}")"
                                        title="Make the engine forget the password it remembers for this connection"
                                        @onclick="@(() => ForgetAsync(c))">Forget password</button>
                            }
                            <button type="button" class="akml-btn akml-btn--danger" data-testid="@($"saved-connection-delete-{c.Id}")"
                                    @onclick="@(() => DeleteAsync(c))">Delete…</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <button type="button" class="akml-btn" @onclick="() => ConnManager.Open()" data-testid="settings-manage-connections">Manage connections…</button>
</SettingRow>

@code {
    private IReadOnlyList<SavedSqlConnection>? _saved;
    private IQueryTabs? _tabs;

    // Review of US1 (finding 36, data-model §3): the active tab's connection does not change under its run; the buttons
    // come back when the run ends (the tabs say so, wherever the run was started from).
    private bool RunInFlight => SqlConn.ActiveSession?.IsBusy == true;
    private const string RunInFlightText = "Wait for the current run to finish";

    protected override async Task OnInitializedAsync()
    {
        SqlConn.StateChanged += OnStateChanged;
        Bridge.StateChanged += OnBridgeStateChanged;
        _tabs = Services.GetService<IQueryTabs>();
        if (_tabs != null) _tabs.Changed += OnTabsChanged;
        await LoadAsync();
    }

    private void OnTabsChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync() => _saved = await Saved.ListAsync();

    /// <summary>
    /// Spec 042: the Kind column, the PostgreSQL rows' extras and the kind of the active connection appear once PostgreSQL can be
    /// involved - the engine offers it, or a PostgreSQL connection is saved. A list of SQL Server connections on an engine
    /// without PostgreSQL reads as it always did.
    /// </summary>
    private bool ShowKinds => SqlConn.EngineSupportsPostgres || (_saved?.Any(c => c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql) ?? false);

    private string ActiveKindNote =>
        SqlConn.Kind != AkmlSql.Core.DatabaseKind.PostgreSql ? string.Empty
        : string.IsNullOrWhiteSpace(SqlConn.ServerVersionText) ? " (PostgreSQL)" : $" (PostgreSQL {SqlConn.ServerVersionText})";

    /// <summary>A PostgreSQL server is written <c>host:port</c> as the status bar writes it; a SQL Server as it was typed.</summary>
    private static string ServerText(SavedSqlConnection c) =>
        c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql ? $"{c.Server}:{c.EffectivePort}" : c.Server;

    private static string AuthText(SavedSqlConnection c) =>
        c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql
            ? $"Login {c.Login}" + (c.RememberPassword ? RememberedNote : string.Empty)
            : c.WindowsAuth ? "Windows" : $"SQL Server login {c.Login}" + (c.RememberPassword ? RememberedNote : string.Empty);

    private const string RememberedNote = " · password remembered on the engine";

    /// <summary>
    /// The engine can be asked to forget this connection's password: it is paired and remembers passwords of the connection's
    /// kind (PostgreSQL; a SQL Server login since the spec 043 follow-up, <c>credentials.sqlserver.v1</c>).
    /// </summary>
    private bool CanReachEngine(SavedSqlConnection c) =>
        Bridge.State == BridgeState.Open
        && (c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql ? SqlConn.EngineSupportsPostgres : SqlConn.EngineRemembersSqlServerPasswords);

    private static bool HasRememberedPassword(SavedSqlConnection c) =>
        c.RememberPassword && !string.IsNullOrWhiteSpace(c.Login) && (c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql || !c.WindowsAuth);

    // True: the engine had one; false: it had none; null: no confirmed answer (see ISqlConnectionService).
    private Task<bool?> ForgetOnEngineAsync(SavedSqlConnection c) =>
        c.Kind == AkmlSql.Core.DatabaseKind.PostgreSql
            ? SqlConn.ForgetRememberedPasswordAsync(c.Server, c.Port, c.Login!, CancellationToken.None)
            : SqlConn.ForgetRememberedSqlServerPasswordAsync(c.Server, c.Login!, CancellationToken.None);

    // Spec 043 follow-up (review, round 2): null from a forget is no confirmed answer — no reply, none in time, or the engine said
    // it could not (its store could not be written) — not "the engine could not be reached".
    private static string ForgetUnconfirmedText(SavedSqlConnection c) =>
        $"The engine did not confirm that it forgot the password for {c.Login} on {ServerText(c)}; it may still be remembered on the engine machine.";

    private async Task ForgetAsync(SavedSqlConnection c)
    {
        if (!CanReachEngine(c))
        {
            Notifications.Notify(
                "The engine is not connected, so the saved password was not forgotten. Pair the engine and try again.",
                NotificationKind.Error);
            return;
        }

        // Spec 043 follow-up (review): only the engine's answer counts; no answer leaves the password, and the row, as they were.
        var answer = await ForgetOnEngineAsync(c);
        if (answer == null)
        {
            Notifications.Notify(ForgetUnconfirmedText(c), NotificationKind.Error);
            return;
        }
        c.RememberPassword = false;
        await Saved.UpdateAsync(c);
        Notifications.Notify($"Forgot the saved password for {c.Login} on {ServerText(c)}. The next connection asks for it.", NotificationKind.Success);
        await LoadAsync();
    }

    private void OnStateChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    private void OnBridgeStateChanged(BridgeState state) => _ = InvokeAsync(StateHasChanged);

    private async Task ConnectAsync(SavedSqlConnection c)
    {
        if (RunInFlight) { Notifications.Notify(RunInFlightText + ".", NotificationKind.Warning); return; }
        // Spec 043 (T057): the active query tab connects, remembering the saved row (and its certificate choice) in its binding.
        var result = await SqlConn.ConnectAsync(new ConnectionTarget(AkmlSql.Core.DatabaseKind.SqlServer, c.Server, c.Database, WindowsAuth: true,
            TrustServerCertificate: c.TrustServerCertificate, SavedConnectionId: c.Id), CancellationToken.None);
        bool ok = result.Ok;
        string? error = result.Error;
        if (ok)
        {
            await Saved.SetActiveIdAsync(c.Id);
            Notifications.Notify($"Connected to {c.Server} / {c.Database}.", NotificationKind.Success);
        }
        else
        {
            Notifications.Notify(error ?? $"Could not connect to {c.Server}.", NotificationKind.Error);
        }
    }

    private bool _disconnecting;

    private async Task DisconnectAsync()
    {
        if (RunInFlight) { Notifications.Notify(RunInFlightText + ".", NotificationKind.Warning); return; }
        if (_disconnecting) return;
        // Spec 043 (review of US1): the tab this Disconnect is for, taken before the first await — the facade speaks for whatever
        // tab is active, and another may be by the time the question below is answered.
        var session = SqlConn.ActiveSession;
        _disconnecting = true;
        try
        {
            await DisconnectCoreAsync(session);
        }
        finally
        {
            _disconnecting = false;
            StateHasChanged();
        }
    }

    private async Task DisconnectCoreAsync(SqlSessionState? session)
    {
        // Review WEB-06: Disconnect closes the engine's connection, which rolls back an open transaction (it never commits), so
        // it asks first. A PostgreSQL session knows it has one; a SQL Server session is asked of the server now (spec 043 gap G1),
        // for at most a few seconds, and when that cannot be told it is told afterwards.
        var state = session?.TransactionState ?? SqlConn.TransactionState;
        if (state == AkmlSql.Core.TransactionState.None && session != null
            && Services.GetService<IQueryExecutionService>() is { } exec)
        {
            using var limit = new CancellationTokenSource(TimeSpan.FromSeconds(3));
            state = await exec.ProbeTransactionStateAsync(session, limit.Token) ?? state;
        }
        if (session != null && (session.IsBusy || !session.IsConnected))
        {
            // A run started in that tab meanwhile, or it is no longer connected: nothing is changed under it.
            if (session.IsBusy) Notifications.Notify(RunInFlightText + ".", NotificationKind.Warning);
            return;
        }
        if (state != AkmlSql.Core.TransactionState.None)
        {
            var aborted = state == AkmlSql.Core.TransactionState.Aborted;
            var ok = await Dialogs.ConfirmAsync(new DialogRequest
            {
                Title = aborted ? "Aborted transaction" : "Open transaction",
                Message = (aborted ? "The session has a transaction that an error aborted. " : "The session has an open transaction. ")
                          + "Disconnecting rolls it back. Nothing is committed.",
                ConfirmLabel = "Roll back and disconnect",
                Destructive = true,
            });
            if (!ok) return;
        }

        if (session != null && session.IsBusy) { Notifications.Notify(RunInFlightText + ".", NotificationKind.Warning); return; }
        var result = session != null
            ? await SqlConn.DisconnectSessionAsync(session, release: false, CancellationToken.None)
            : await SqlConn.DisconnectSessionAsync(CancellationToken.None);
        if (result.Warning != null)
            Notifications.Notify("Disconnected in this browser. " + result.Warning, NotificationKind.Warning);
        else
            Notifications.Notify(result.RolledBack ? "Disconnected. The open transaction was rolled back." : "Disconnected.", NotificationKind.Success);
    }

    private async Task DeleteAsync(SavedSqlConnection c)
    {
        var remembered = HasRememberedPassword(c);
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Delete saved connection",
            Message = $"Delete the saved connection “{c.Name}” ({ServerText(c)} / {c.Database})?",
            Details = !remembered ? null : new[]
            {
                CanReachEngine(c)
                    ? $"The password the engine remembers for {c.Login} on {ServerText(c)} is forgotten too."
                    : Bridge.State == BridgeState.Open
                        ? $"The connected engine cannot forget passwords of this kind, so the password remembered for {c.Login} on {ServerText(c)} cannot be forgotten now."
                        : $"The engine is not connected, so the password it remembers for {c.Login} on {ServerText(c)} cannot be forgotten now.",
            },
            ConfirmLabel = "Delete",
            Destructive = true,
        });
        if (!ok) return;

        // Spec 042 (FR-106): the engine's copy of the password goes first, while the record that names it still exists.
        // Review, round 2: the engine is asked about again here — it may have gone while the question was open — and a remembered
        // password it cannot be asked to forget now is an unconfirmed forget, said as one, never a quiet success.
        bool? forgot = !remembered ? false
            : CanReachEngine(c) ? await ForgetOnEngineAsync(c)
            : null;
        await Saved.RemoveAsync(c.Id);
        // Spec 043 follow-up (review): the row goes as asked; a forget the engine did not confirm is said, not passed over.
        if (forgot == null)
            Notifications.Notify($"Deleted the saved connection “{c.Name}”. " + ForgetUnconfirmedText(c), NotificationKind.Warning);
        else
            Notifications.Notify($"Deleted the saved connection “{c.Name}”.", NotificationKind.Success);
        await LoadAsync();
    }

    public void Dispose()
    {
        SqlConn.StateChanged -= OnStateChanged;
        Bridge.StateChanged -= OnBridgeStateChanged;
        if (_tabs != null) _tabs.Changed -= OnTabsChanged;
    }
}
