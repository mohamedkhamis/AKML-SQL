@*
    Spec 041 (R44, R49, FR-056) — Settings › AI assistance, extracted from the old /settings/ai page (spec 021
    T135, spec 028 T011/T012), reshaped by the 2026-11 master–detail redesign (web layout A): the AI agents as a
    list on the left (+ Add agent, a status pill per agent) and the selected agent on the right — its details with
    Edit, Duplicate, Test connection, Set as active and Delete; Edit and Add turn the right side into a form with
    Save / Cancel. One provider can carry several agents. The stored key is never shown: an empty key box keeps it.
    Then the privacy modes and ghost text. Status lines are notifications; Delete confirms. The form keeps the labels
    the E2E suites select ("Provider", "Model", "Endpoint", "API key", "Save", "Enable ghost text").
*@
@using AkmlSql.Web.Services
@inject IAiKeyVault Vault
@inject IAiPreference Preference
@inject IAiFeatureSettings FeatureSettings
@inject IAiClientFactory Client
@inject IDialogService Dialogs
@inject INotificationService Notifications
@inject IServiceProvider ServiceProvider

<p class="akml-hint">
    AKML SQL never sees your API keys. They live encrypted in your browser via Web Crypto (AES-GCM 256). When you
    invoke an AI action the key is unwrapped for the duration of one fetch to the provider's own endpoint, then
    dropped.
</p>

<SettingRow Id="ai-providers" Kind="block">
    @if (_configs == null)
    {
        <p class="akml-settings-status">Loading…</p>
    }
    else
    {
        <div class="akml-agents" data-testid="ai-agents">
            <section class="akml-agents__master" aria-label="AI agents">
                <div class="akml-agents__toolbar">
                    <button type="button" class="akml-btn akml-btn--primary" data-testid="ai-agent-add"
                            disabled="@(_configs.Count >= MaxAgents || _mode == EditMode.Edit)" title="@(_configs.Count >= MaxAgents ? $"The list holds the maximum of {MaxAgents} agents" : "Add an AI agent")"
                            @onclick="StartAdd">+ Add agent</button>
                    <span class="akml-agents__count" data-testid="ai-agent-count">@_configs.Count of @MaxAgents</span>
                </div>
                @if (_configs.Count == 0)
                {
                    <p class="akml-agents__empty">No AI agents yet. Add one to use Explain, Fix, Optimize, chat and ghost text.</p>
                }
                else
                {
                    <ul class="akml-agents__list" aria-label="AI agents">
                        @foreach (var c in _configs)
                        {
                            var agent = c;
                            var selected = agent.Id == _selectedId;
                            <li>
                                <button type="button" class="@($"akml-agents__item{(agent.Enabled ? "" : " is-off")}")"
                                        aria-current="@(selected ? "true" : null)" data-testid="@($"ai-agent-item-{agent.Id}")"
                                        @onclick="@(() => Select(agent.Id))" @ondblclick="@(() => StartEdit(agent.Id))"
                                        @onkeydown="@(e => OnItemKeyDownAsync(e, agent.Id))">
                                    <span class="akml-agents__name">@agent.DisplayName</span>
                                    <span class="akml-agents__meta">@ProviderLabel(agent.ProviderId) · <span class="akml-mono">@agent.Model</span></span>
                                    <span class="akml-agents__pills">
                                        @if (agent.Id == _activeId)
                                        {
                                            <span class="akml-pill akml-pill--active" data-testid="@($"ai-agent-active-{agent.Id}")">Active</span>
                                        }
                                        @StatusPill(agent)
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="akml-agents__detail" data-testid="ai-agent-detail">
                @if (_mode != EditMode.None)
                {
                    @RenderForm()
                }
                else if (Selected is { } a)
                {
                    @RenderDetails(a)
                }
                else
                {
                    <p class="akml-hint">Add an agent to connect an AI provider: Anthropic, Gemini, Ollama and LM Studio work straight from the browser.</p>
                }
            </section>
        </div>
    }
</SettingRow>

<SettingRow Id="ai-privacy" Kind="block">
    @if (_aiSettings != null)
    {
        @if (_aiSettings.GlobalDefaultMode == AiPrivacyMode.FullyLocal)
        {
            <p class="akml-hint">Fully local is on — only Ollama or LM Studio can be the active provider.</p>
        }
        <label class="akml-field">Global default
            <select class="akml-select" @onchange="OnGlobalModeChanged">
                @foreach (var m in AllModes)
                {
                    <option value="@m" selected="@(_aiSettings.GlobalDefaultMode == m)">@ModeLabel(m)</option>
                }
            </select>
        </label>
        <table class="akml-table">
            <thead><tr><th>Feature</th><th>Mode</th></tr></thead>
            <tbody>
                @foreach (var (id, label) in Features)
                {
                    <tr>
                        <td>@label</td>
                        <td>
                            <select class="akml-select" aria-label="@($"{label} privacy mode")" @onchange="@(e => OnFeatureModeChanged(id, e))">
                                <option value="" selected="@(!_aiSettings.FeatureModeOverrides.ContainsKey(id))">Use the default</option>
                                @foreach (var m in AllModes)
                                {
                                    <option value="@m" selected="@(_aiSettings.FeatureModeOverrides.TryGetValue(id, out var fm) && fm == m)">@ModeLabel(m)</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</SettingRow>

<SettingRow Id="ai-ghost-text" Kind="block">
    @if (_aiSettings != null)
    {
        <label class="akml-field-inline">
            <input type="checkbox" checked="@_aiSettings.GhostTextEnabled" @onchange="OnGhostEnabledChanged" />
            Enable ghost text
        </label>
        <label class="akml-field">Wait after typing (ms)
            <input class="akml-input" type="number" min="100" step="50" value="@_aiSettings.GhostTextDelayMs" @onchange="OnGhostDelayChanged" />
        </label>
        <label class="akml-field">Most requests per 3 seconds
            <input class="akml-input" type="number" min="1" value="@_aiSettings.GhostTextMaxRequestsPer3s" @onchange="OnGhostRateChanged" />
        </label>
    }
</SettingRow>

@code {
    /// <summary>The most agents one browser keeps (the desktop edition's limit).</summary>
    internal const int MaxAgents = 20;

    private IReadOnlyList<AiProviderConfig>? _configs;
    private string _activeId = string.Empty;
    private string _selectedId = string.Empty;

    private enum EditMode { None, Add, Edit }
    private EditMode _mode = EditMode.None;
    private AgentForm _form = new();
    private List<string> _errors = new();

    // Test connection: the tester is optional (a host without it shows no Test button).
    private IAiConnectionTester? _tester;
    private bool _testing;
    private AiConnectionTestResult? _detailTest;   // the selected agent's, in the details view
    private AiConnectionTestResult? _formTest;     // the values in the form

    private static readonly (string Id, string Label)[] ProviderLabels =
    {
        ("openai",    "OpenAI"),
        ("anthropic", "Anthropic"),
        ("gemini",    "Google Gemini"),
        ("azure",     "Azure OpenAI"),
        ("ollama",    "Ollama (local)"),
        ("lmstudio",  "LM Studio (local)"),
    };

    private static string DefaultDisplayName(string id) =>
        ProviderLabels.FirstOrDefault(p => p.Id == id).Label ?? id;

    /// <summary>The provider's name without the "(local)" note, for agent names and sentences.</summary>
    private static string ProviderLabel(string id) => DefaultDisplayName(id).Replace(" (local)", string.Empty);

    private static string ModelPlaceholder(string id) => id switch
    {
        "openai"    => "gpt-4.1",
        "anthropic" => "claude-sonnet-4-6",
        "gemini"    => "gemini-flash-latest",   // as the desktop default: the pinned 2.5-flash is refused for new keys
        "azure"     => "gpt-4.1 (your deployment name)",
        "ollama"    => "llama3.1:8b",
        "lmstudio"  => "lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF",
        _ => string.Empty,
    };

    /// <summary>The model an empty Model box stands for: its placeholder, except Azure's, which names no real model.</summary>
    internal static string? DefaultModel(string id) => id == "azure" ? null : NullIfEmpty(ModelPlaceholder(id));

    private static string? NullIfEmpty(string text) => string.IsNullOrEmpty(text) ? null : text;

    private static bool RequiresEndpoint(string id) => id is "azure" or "ollama" or "lmstudio";

    // Local providers (Ollama, LM Studio) authenticate by network reachability, not a key.
    private static bool RequiresApiKey(string id) => id is not ("ollama" or "lmstudio");

    /// <summary>R49: a cloud agent with no key stored (one imported from a settings file).</summary>
    private static bool NeedsKey(AiProviderConfig c) => !c.HasKey && !AiProviders.IsLocal(c.ProviderId);

    private static string EndpointPlaceholder(string id) => id switch
    {
        "azure"    => "https://your-resource.openai.azure.com/",
        "ollama"   => "http://localhost:11434",
        "lmstudio" => "http://localhost:1234/v1",
        _ => string.Empty,
    };

    private static string StandardEndpoint(string id) => id switch
    {
        "openai"    => "Standard (api.openai.com)",
        "anthropic" => "Standard (api.anthropic.com)",
        "gemini"    => "Standard (generativelanguage.googleapis.com)",
        _ => "Not set",
    };

    // Review WEB-03: whether an API key can be stored here (a secure context). Assumed until the browser says otherwise.
    private bool _secureStorage = true;

    private AiProviderConfig? Selected => _configs?.FirstOrDefault(c => c.Id == _selectedId);

    protected override async Task OnInitializedAsync()
    {
        _tester = ServiceProvider.GetService(typeof(IAiConnectionTester)) as IAiConnectionTester;
        try { _secureStorage = ServiceProvider.GetService(typeof(IWebCryptoWrapper)) is not IWebCryptoWrapper crypto || await crypto.IsSecureStorageAvailableAsync(); }
        catch (JSException) { _secureStorage = false; }
        catch (JSDisconnectedException) { }
        await FeatureSettings.ReloadAsync();
        await ReloadAsync();
        // No agent yet: the form is the way in.
        if (_configs is { Count: 0 }) StartAdd();
    }

    private async Task ReloadAsync()
    {
        _configs = await Vault.ListAsync();
        _activeId = await Preference.GetActiveAsync();
        _aiSettings = await FeatureSettings.GetAsync();
        if (_configs.All(c => c.Id != _selectedId))
            _selectedId = _configs.FirstOrDefault(c => c.Id == _activeId)?.Id ?? _configs.FirstOrDefault()?.Id ?? string.Empty;
        StateHasChanged();
    }

    // ── The list ───────────────────────────────────────────────────────────────────

    private void Select(string id)
    {
        if (_mode != EditMode.None) return;   // the form keeps the panel until Save or Cancel
        if (_selectedId != id) _detailTest = null;
        _selectedId = id;
    }

    private async Task OnItemKeyDownAsync(KeyboardEventArgs e, string id)
    {
        if (_mode != EditMode.None) return;
        if (e.Key == "Delete") { _selectedId = id; await DeleteAsync(); }
        else if (e.Key == "F2") StartEdit(id);
    }

    /// <param name="inList">The list's pill carries the test id; the details repeat it without one.</param>
    private RenderFragment StatusPill(AiProviderConfig c, bool inList = true) => __builder =>
    {
        if (!c.Enabled)
        {
            <span class="akml-pill akml-pill--neutral">Off</span>
        }
        else if (NeedsKey(c))
        {
            <span class="akml-pill akml-pill--warn" data-testid="@(inList ? $"ai-agent-needs-key-{c.Id}" : null)"
                  title="Imported without its key — Edit and enter the key">Needs key</span>
        }
        else if (!Client.IsBrowserDirectCapable(c.ProviderId))
        {
            <span class="akml-pill akml-pill--warn" title="This provider's API does not allow calls from a browser">Desktop only</span>
        }
        else if (c.LastCheck?.Status == AiAgentCheck.Ready)
        {
            <span class="akml-pill akml-pill--ready" title="@CheckTitle(c.LastCheck)">Ready</span>
        }
        else if (c.LastCheck?.Status == AiAgentCheck.Failed)
        {
            <span class="akml-pill akml-pill--failed" title="@CheckTitle(c.LastCheck)">Failed</span>
        }
        else
        {
            <span class="akml-pill akml-pill--neutral">Not tested</span>
        }
    };

    private static string CheckTitle(AiAgentCheck check)
    {
        var when = DateTimeOffset.TryParse(check.CheckedUtc, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal, out var t)
            ? t.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
            : string.Empty;
        return string.IsNullOrEmpty(when) ? check.Message : $"{when}: {check.Message}";
    }

    // ── The details view ───────────────────────────────────────────────────────────

    private RenderFragment RenderDetails(AiProviderConfig a) => __builder =>
    {
        var isActive = a.Id == _activeId;
        <div class="akml-agents__head">
            <div>
                <h4 class="akml-agents__title" data-testid="ai-agent-title">@a.DisplayName</h4>
                <p class="akml-agents__subtitle">@ProviderLabel(a.ProviderId) · @(AiProviders.IsLocal(a.ProviderId) ? "runs on your machine" : "cloud provider")@(isActive ? " · the active agent" : string.Empty)</p>
            </div>
            <div class="akml-btn-group">
                <button type="button" class="akml-btn akml-btn--primary" data-testid="ai-agent-edit" @onclick="@(() => StartEdit(a.Id))">Edit</button>
                <button type="button" class="akml-btn" data-testid="ai-agent-duplicate" disabled="@(_configs!.Count >= MaxAgents)" @onclick="DuplicateAsync">Duplicate</button>
                @if (_tester != null)
                {
                    <button type="button" class="akml-btn" data-testid="ai-agent-test" disabled="@_testing" @onclick="TestSelectedAsync">@(_testing ? "Testing…" : "Test connection")</button>
                }
                <button type="button" class="akml-btn" data-testid="ai-agent-set-active" disabled="@isActive" @onclick="@(() => SetActiveAsync(a.Id))">Set as active</button>
                <button type="button" class="akml-btn akml-btn--danger" data-testid="ai-agent-delete" @onclick="DeleteAsync">Delete</button>
            </div>
        </div>
        <dl class="akml-agents__fields">
            <dt>Provider</dt><dd>@DefaultDisplayName(a.ProviderId)</dd>
            <dt>Model</dt><dd class="akml-mono">@a.Model</dd>
            <dt>Endpoint</dt><dd>@(string.IsNullOrEmpty(a.Endpoint) ? StandardEndpoint(a.ProviderId) : a.Endpoint)</dd>
            <dt>API key</dt>
            <dd>
                @if (AiProviders.IsLocal(a.ProviderId)) { <span>Not needed</span> }
                else if (a.HasKey) { <span>Stored, encrypted in this browser</span> }
                else { <span class="akml-agents__warn" data-testid="@($"provider-needs-key-{a.Id}")">Needs a key — click Edit and enter it</span> }
            </dd>
            <dt>Enabled</dt><dd>@(a.Enabled ? "Yes" : "No — it cannot be the active agent")</dd>
            <dt>Status</dt>
            <dd>
                @StatusPill(a, inList: false)
                @if (a.LastCheck != null)
                {
                    <span class="akml-agents__check">@CheckTitle(a.LastCheck)</span>
                }
            </dd>
        </dl>
        @if (!Client.IsBrowserDirectCapable(a.ProviderId))
        {
            <p class="akml-hint">
                @ProviderLabel(a.ProviderId) can't be used directly from the browser — its API doesn't send CORS headers. It runs
                only in the desktop edition or through an OpenAI-compatible endpoint.
            </p>
        }
        @if (_detailTest != null)
        {
            <p class="@(_detailTest.Success ? "akml-agents__result akml-agents__result--ok" : "akml-agents__result akml-agents__result--fail")"
               role="status" data-testid="ai-agent-test-result">@_detailTest.Message</p>
        }
    };

    // ── The form ───────────────────────────────────────────────────────────────────

    private RenderFragment RenderForm() => __builder =>
    {
        var editing = _mode == EditMode.Edit ? Selected : null;
        var keepsKey = editing != null && editing.HasKey && editing.ProviderId == _form.ProviderId;
        <form class="akml-ai-form" data-testid="ai-agent-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true" @onkeydown="OnFormKeyDown">
            <h4 class="akml-agents__title">@(_mode == EditMode.Add ? (_configs!.Count == 0 ? "Add your first AI agent" : "New agent") : $"Edit agent: {editing?.DisplayName}")</h4>
            <div class="akml-agents__row">
                <label class="akml-field">Name
                    <input class="akml-input" @bind="_form.Name" maxlength="40" placeholder="@SuggestName(_form.ProviderId, editing?.Id)" />
                </label>
                <label class="akml-field">Provider
                    <select class="akml-select" @bind="_form.ProviderId" @bind:after="OnProviderChanged">
                        @foreach (var (id, label) in ProviderLabels)
                        {
                            <option value="@id">@label</option>
                        }
                    </select>
                </label>
            </div>
            <div class="akml-agents__row">
                <label class="akml-field">Model <input class="akml-input" @bind="_form.Model" placeholder="@ModelPlaceholder(_form.ProviderId)" /></label>
                @if (RequiresEndpoint(_form.ProviderId))
                {
                    <label class="akml-field">Endpoint
                        <input class="akml-input" @bind="_form.Endpoint" placeholder="@EndpointPlaceholder(_form.ProviderId)" />
                    </label>
                }
                else
                {
                    @* Only the providers that need one take an endpoint (FR-056: the hints match what the form allows). *@
                    <label class="akml-field">Endpoint
                        <input class="akml-input" @bind="_form.Endpoint" disabled title="This provider uses its standard endpoint" placeholder="Not used by this provider" />
                    </label>
                }
            </div>
            @if (RequiresApiKey(_form.ProviderId) && !_secureStorage)
            {
                <SecureContextNotice What="API keys" />
            }
            @if (RequiresApiKey(_form.ProviderId))
            {
                <label class="akml-field">API key
                    <input class="akml-input" type="password" @bind="_form.ApiKey" autocomplete="new-password"
                           placeholder="@(keepsKey ? "Stored. Leave empty to keep it." : "Enter or paste your key (stored wrapped)")" />
                </label>
                @if (editing != null && editing.HasKey && !keepsKey)
                {
                    <p class="akml-hint">The stored key belongs to @ProviderLabel(editing.ProviderId) and is removed. Enter a key for @ProviderLabel(_form.ProviderId).</p>
                }
            }
            else
            {
                <p class="akml-hint">@ProviderLabel(_form.ProviderId) runs locally and does not use an API key.</p>
            }
            <label class="akml-field-inline">
                <input type="checkbox" @bind="_form.Enabled" />
                Enabled
            </label>

            @if (!Client.IsBrowserDirectCapable(_form.ProviderId))
            {
                <p class="akml-hint">
                    @ProviderLabel(_form.ProviderId) can't be used directly from the browser — its API doesn't send
                    CORS headers. You can configure it here, but it runs only in the desktop edition or via an
                    OpenAI-compatible endpoint. Claude, Gemini, Ollama and LM Studio work browser-direct.
                </p>
            }

            @if (_tester != null)
            {
                <div class="akml-agents__test">
                    <button type="button" class="akml-btn" data-testid="ai-agent-form-test" disabled="@_testing" @onclick="TestFormAsync">@(_testing ? "Testing…" : "Test connection")</button>
                    @if (_formTest != null)
                    {
                        <span class="@(_formTest.Success ? "akml-agents__result--ok" : "akml-agents__result--fail")" role="status" data-testid="ai-agent-form-test-result">@_formTest.Message</span>
                    }
                    else
                    {
                        <span class="akml-agents__check">Sends one short prompt with the values above. Nothing is saved.</span>
                    }
                </div>
            }

            <div class="akml-btn-group">
                <button type="submit" class="akml-btn akml-btn--primary">Save</button>
                <button type="button" class="akml-btn" data-testid="ai-agent-cancel" @onclick="CancelForm">Cancel</button>
            </div>

            @if (_errors.Count > 0)
            {
                <ul class="akml-field-error" role="alert">
                    @foreach (var err in _errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
        </form>
    };

    private void StartAdd()
    {
        if (_configs != null && _configs.Count >= MaxAgents) return;
        _form = new AgentForm();
        _errors.Clear();
        _formTest = null;
        _mode = EditMode.Add;
    }

    private void StartEdit(string id)
    {
        var c = _configs?.FirstOrDefault(x => x.Id == id);
        if (c == null) return;
        _selectedId = id;
        _form = new AgentForm
        {
            Name = c.DisplayName,
            ProviderId = c.ProviderId,
            Model = c.Model,
            Endpoint = c.Endpoint ?? string.Empty,
            ApiKey = string.Empty,   // never read back: empty keeps the stored key
            Enabled = c.Enabled,
        };
        _errors.Clear();
        _formTest = null;
        _mode = EditMode.Edit;
    }

    private void CancelForm()
    {
        _form = new AgentForm();
        _errors.Clear();
        _formTest = null;
        _mode = EditMode.None;
    }

    private void OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && (_configs?.Count ?? 0) > 0) CancelForm();
    }

    private void OnProviderChanged()
    {
        // A model typed for another provider is not this one's: an empty box shows the default instead.
        if (ProviderLabels.Any(p => ModelPlaceholder(p.Id) == _form.Model.Trim())) _form.Model = string.Empty;
        if (!RequiresEndpoint(_form.ProviderId)) _form.Endpoint = string.Empty;
        _formTest = null;
    }

    /// <summary>The provider's name, numbered when it is taken: "OpenAI", "OpenAI 2"…</summary>
    private string SuggestName(string providerId, string? exceptId)
    {
        var taken = new HashSet<string>((_configs ?? Array.Empty<AiProviderConfig>())
            .Where(c => c.Id != exceptId).Select(c => c.DisplayName.Trim()), StringComparer.OrdinalIgnoreCase);
        var name = ProviderLabel(providerId);
        if (!taken.Contains(name)) return name;
        for (var n = 2; ; n++)
        {
            var candidate = $"{name} {n}";
            if (!taken.Contains(candidate)) return candidate;
        }
    }

    private string SuggestCopyName(string name)
    {
        var taken = new HashSet<string>((_configs ?? Array.Empty<AiProviderConfig>()).Select(c => c.DisplayName.Trim()), StringComparer.OrdinalIgnoreCase);
        var candidate = $"{name} (copy)";
        for (var n = 2; taken.Contains(candidate); n++) candidate = $"{name} (copy {n})";
        return candidate.Length <= 40 ? candidate : candidate.Substring(0, 40);
    }

    private async Task SubmitAsync()
    {
        _errors = new List<string>();
        var editing = _mode == EditMode.Edit ? Selected : null;
        // The model shown in the empty box is the one used: "Model is required" under a box that reads gemini-flash-latest told
        // the user to type what the form already showed. Azure has no default (it is the user's deployment name).
        var model = string.IsNullOrWhiteSpace(_form.Model) ? DefaultModel(_form.ProviderId) : _form.Model.Trim();
        var name = string.IsNullOrWhiteSpace(_form.Name) ? SuggestName(_form.ProviderId, editing?.Id) : _form.Name.Trim();
        var keepsKey = editing != null && editing.HasKey && editing.ProviderId == _form.ProviderId;
        var newKey = !string.IsNullOrEmpty(_form.ApiKey) && RequiresApiKey(_form.ProviderId);

        if (string.IsNullOrEmpty(_form.ProviderId)) _errors.Add("Provider is required.");
        if (string.IsNullOrEmpty(model)) _errors.Add("Model is required.");
        if (name.Length > 40) _errors.Add("Name must be 40 characters or fewer.");
        if (_configs!.Any(c => c.Id != editing?.Id && string.Equals(c.DisplayName.Trim(), name, StringComparison.OrdinalIgnoreCase)))
            _errors.Add($"Another agent is already named \"{name}\".");
        if (RequiresApiKey(_form.ProviderId) && !newKey && !keepsKey) _errors.Add("API key is required.");
        if (newKey && !_secureStorage)
            _errors.Add("This page was opened over plain HTTP from another computer, so the key cannot be stored. Open the site's HTTPS address.");
        if (RequiresEndpoint(_form.ProviderId) && string.IsNullOrWhiteSpace(_form.Endpoint))
            _errors.Add($"Endpoint is required for {ProviderLabel(_form.ProviderId)}.");
        if (_mode == EditMode.Add && _configs.Count >= MaxAgents)
            _errors.Add($"The list already holds the maximum of {MaxAgents} agents. Delete an agent before adding another.");
        if (_errors.Count > 0) return;

        var endpoint = RequiresEndpoint(_form.ProviderId) ? _form.Endpoint.Trim() : null;
        // The last check still describes the agent when nothing it connects with changed — or a test of these very values ran.
        var connectionChanged = editing == null || newKey || editing.ProviderId != _form.ProviderId
                                || editing.Model != model || (editing.Endpoint ?? string.Empty) != (endpoint ?? string.Empty);
        var lastCheck = _formTest != null ? ToCheck(_formTest) : connectionChanged ? null : editing?.LastCheck;

        var config = new AiProviderConfig
        {
            Id = editing?.Id ?? Guid.NewGuid().ToString("N"),
            ProviderId = _form.ProviderId,
            DisplayName = name,
            Model = model!,
            Endpoint = endpoint,
            Enabled = _form.Enabled,
            CreatedUtc = editing?.CreatedUtc is { Length: > 0 } created ? created : DateTime.UtcNow.ToString("O", System.Globalization.CultureInfo.InvariantCulture),
            LastCheck = lastCheck,
        };
        await Vault.SaveAgentAsync(config, newKey ? _form.ApiKey : null);
        _form.ApiKey = string.Empty;   // tighten the residual exposure window
        var added = _mode == EditMode.Add;
        _mode = EditMode.None;
        _formTest = null;
        _detailTest = null;
        _selectedId = config.Id;
        Notifications.Notify(added ? $"Added {name}." : $"Saved {name}.", NotificationKind.Success);
        await ReloadAsync();

        // With no usable active agent the AI panel says none is configured, even right after one was saved: the one saved
        // becomes the active one (still refused for a cloud provider in Fully local mode). A turned-off active agent hands over.
        var active = _configs!.FirstOrDefault(c => c.Id == _activeId);
        if (config.Enabled && (active == null || !active.Enabled)) await SetActiveAsync(config.Id, quiet: active != null);
        else if (!config.Enabled && config.Id == _activeId) await HandOverActiveAsync(config.Id);
    }

    private async Task DuplicateAsync()
    {
        var source = Selected;
        if (source == null || _configs!.Count >= MaxAgents) return;
        var copy = new AiProviderConfig
        {
            Id = Guid.NewGuid().ToString("N"),
            ProviderId = source.ProviderId,
            DisplayName = SuggestCopyName(source.DisplayName),
            Model = source.Model,
            Endpoint = source.Endpoint,
            Enabled = source.Enabled,
            CreatedUtc = DateTime.UtcNow.ToString("O", System.Globalization.CultureInfo.InvariantCulture),
        };
        await Vault.DuplicateAsync(source.Id, copy);
        _selectedId = copy.Id;
        _detailTest = null;
        Notifications.Notify($"Duplicated {source.DisplayName} as {copy.DisplayName}.", NotificationKind.Success);
        await ReloadAsync();
    }

    private async Task DeleteAsync()
    {
        var c = Selected;
        if (c == null) return;
        var isActive = _activeId == c.Id;
        var next = isActive ? NextActiveCandidate(c.Id) : null;
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Delete agent",
            Message = $"Delete {c.DisplayName} and its stored key?",
            Details = isActive
                ? new[] { next != null ? $"It is the active agent: AI features use {next.DisplayName} instead." : "It is the active agent: AI features stop until you add another." }
                : null,
            ConfirmLabel = "Delete",
            Destructive = true,
        });
        if (!ok) return;
        await Vault.RemoveAsync(c.Id);
        if (isActive) await Preference.SetActiveAsync(next?.Id ?? string.Empty);
        _detailTest = null;
        Notifications.Notify($"Deleted {c.DisplayName}.", NotificationKind.Success);
        await ReloadAsync();
    }

    /// <summary>The first other agent that can be active: on, with its key, and local when Fully local is on.</summary>
    private AiProviderConfig? NextActiveCandidate(string exceptId) =>
        _configs?.FirstOrDefault(x => x.Id != exceptId && x.Enabled && !NeedsKey(x)
            && (_aiSettings?.GlobalDefaultMode != AiPrivacyMode.FullyLocal || AiProviders.IsLocal(x.ProviderId)));

    private async Task HandOverActiveAsync(string fromId)
    {
        var next = NextActiveCandidate(fromId);
        await Preference.SetActiveAsync(next?.Id ?? string.Empty);
        _activeId = next?.Id ?? string.Empty;
        Notifications.Notify(next != null
            ? $"The agent is off, so {next.DisplayName} is now the active agent."
            : "The agent is off and no other agent can take over: AI features stop until you turn one on.", NotificationKind.Info);
        StateHasChanged();
    }

    private async Task SetActiveAsync(string agentId, bool quiet = false)
    {
        var c = _configs?.FirstOrDefault(x => x.Id == agentId);
        if (c == null) return;
        if (!c.Enabled)
        {
            Notifications.Notify($"{c.DisplayName} is turned off. Edit it and tick Enabled first.", NotificationKind.Warning);
            return;
        }
        if (NeedsKey(c))
        {
            Notifications.Notify($"{c.DisplayName} has no API key. Edit it and enter the key first.", NotificationKind.Warning);
            return;
        }
        // Spec 028 T012: fully-local mode forbids a cloud provider as the active one.
        if (_aiSettings != null && _aiSettings.GlobalDefaultMode == AiPrivacyMode.FullyLocal && !AiProviders.IsLocal(c.ProviderId))
        {
            Notifications.Notify($"Fully local is on — {c.DisplayName} uses a cloud provider and can't be active. " +
                                 "Choose an Ollama or LM Studio agent, or change the global privacy mode.", NotificationKind.Warning);
            StateHasChanged();
            return;
        }
        _activeId = agentId;
        await Preference.SetActiveAsync(agentId);
        if (!quiet) Notifications.Notify($"Active agent: {c.DisplayName}.", NotificationKind.Success);
        StateHasChanged();
    }

    // ── Test connection ────────────────────────────────────────────────────────────

    private async Task TestSelectedAsync()
    {
        var c = Selected;
        if (c == null || _tester == null || _testing) return;
        _testing = true;
        _detailTest = null;
        StateHasChanged();
        try
        {
            _detailTest = await _tester.TestAsync(c, null, CancellationToken.None);
            c.LastCheck = ToCheck(_detailTest);
            await Vault.UpsertConfigAsync(c);   // the check is recorded; the key is untouched
        }
        finally
        {
            _testing = false;
        }
        await ReloadAsync();
    }

    private async Task TestFormAsync()
    {
        if (_tester == null || _testing) return;
        var editing = _mode == EditMode.Edit ? Selected : null;
        var probe = new AiProviderConfig
        {
            Id = editing?.Id ?? string.Empty,   // lets an empty key box use the stored key
            ProviderId = _form.ProviderId,
            Model = string.IsNullOrWhiteSpace(_form.Model) ? DefaultModel(_form.ProviderId) ?? string.Empty : _form.Model.Trim(),
            Endpoint = RequiresEndpoint(_form.ProviderId) ? _form.Endpoint.Trim() : null,
        };
        _testing = true;
        _formTest = null;
        StateHasChanged();
        try
        {
            _formTest = await _tester.TestAsync(probe, RequiresApiKey(_form.ProviderId) ? _form.ApiKey : null, CancellationToken.None);
        }
        finally
        {
            _testing = false;
        }
        StateHasChanged();
    }

    private static AiAgentCheck ToCheck(AiConnectionTestResult result) => new()
    {
        Status = result.Success ? AiAgentCheck.Ready : AiAgentCheck.Failed,
        CheckedUtc = DateTime.UtcNow.ToString("O", System.Globalization.CultureInfo.InvariantCulture),
        LatencyMs = result.Success ? result.LatencyMs : 0,
        Message = result.Message.Length <= 300 ? result.Message : result.Message.Substring(0, 300),
    };

    // Spec 028 (M6) T011/T012 -- privacy disclosure modes (global + per-feature) + fully-local gating.
    private AiFeatureSettings? _aiSettings;

    private static readonly AiPrivacyMode[] AllModes =
        { AiPrivacyMode.FullSchema, AiPrivacyMode.SchemaNamesOnly, AiPrivacyMode.NoSchema, AiPrivacyMode.FullyLocal };

    private static readonly (string Id, string Label)[] Features =
    {
        ("explain", "Explain"),
        ("fix", "Fix"),
        ("optimize", "Optimize"),
        ("texttosql", "Text-to-SQL"),
        ("indexanalysis", "Index Analysis"),
        ("chat", "Chat"),
        ("ghosttext", "Ghost Text"),
    };

    private static string ModeLabel(AiPrivacyMode m) => m switch
    {
        AiPrivacyMode.FullSchema => "Full schema",
        AiPrivacyMode.SchemaNamesOnly => "Schema names only",
        AiPrivacyMode.NoSchema => "No schema",
        AiPrivacyMode.FullyLocal => "Fully local",
        _ => m.ToString(),
    };

    private async Task OnGlobalModeChanged(ChangeEventArgs e)
    {
        if (_aiSettings == null || !Enum.TryParse<AiPrivacyMode>(e.Value?.ToString(), out var mode)) return;
        _aiSettings.GlobalDefaultMode = mode;
        await FeatureSettings.SetAsync(_aiSettings);
        var message = $"Global privacy mode: {ModeLabel(mode)}.";

        // T012: switching to Fully local must not leave a cloud agent active.
        var active = _configs?.FirstOrDefault(c => c.Id == _activeId);
        if (mode == AiPrivacyMode.FullyLocal && active != null && !AiProviders.IsLocal(active.ProviderId))
        {
            await Preference.SetActiveAsync(string.Empty);
            _activeId = string.Empty;
            message = "Fully local is on — the cloud agent is no longer active. Choose an Ollama or LM Studio agent.";
        }
        Notifications.Notify(message, NotificationKind.Success);
        StateHasChanged();
    }

    private async Task OnFeatureModeChanged(string featureId, ChangeEventArgs e)
    {
        if (_aiSettings == null) return;
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw)) _aiSettings.FeatureModeOverrides.Remove(featureId);
        else if (Enum.TryParse<AiPrivacyMode>(raw, out var mode)) _aiSettings.FeatureModeOverrides[featureId] = mode;
        await FeatureSettings.SetAsync(_aiSettings);
        Notifications.Notify("Privacy mode saved.", NotificationKind.Success);
        StateHasChanged();
    }

    private async Task OnGhostEnabledChanged(ChangeEventArgs e)
    {
        if (_aiSettings == null) return;
        _aiSettings.GhostTextEnabled = e.Value is bool b && b;
        await FeatureSettings.SetAsync(_aiSettings);
        Notifications.Notify(_aiSettings.GhostTextEnabled ? "Ghost text is on." : "Ghost text is off.", NotificationKind.Success);
        StateHasChanged();
    }

    private async Task OnGhostDelayChanged(ChangeEventArgs e)
    {
        if (_aiSettings == null || !int.TryParse(e.Value?.ToString(), out var v) || v < 100) return;
        _aiSettings.GhostTextDelayMs = v;
        await FeatureSettings.SetAsync(_aiSettings);
        Notifications.Notify($"Ghost text waits {v} ms.", NotificationKind.Success);
    }

    private async Task OnGhostRateChanged(ChangeEventArgs e)
    {
        if (_aiSettings == null || !int.TryParse(e.Value?.ToString(), out var v) || v < 1) return;
        _aiSettings.GhostTextMaxRequestsPer3s = v;
        await FeatureSettings.SetAsync(_aiSettings);
        Notifications.Notify($"Ghost text: at most {v} requests per 3 seconds.", NotificationKind.Success);
    }

    private sealed class AgentForm
    {
        public string Name { get; set; } = string.Empty;
        public string ProviderId { get; set; } = "openai";
        public string Model { get; set; } = string.Empty;
        public string Endpoint { get; set; } = string.Empty;
        public string ApiKey { get; set; } = string.Empty;
        public bool Enabled { get; set; } = true;
    }
}
