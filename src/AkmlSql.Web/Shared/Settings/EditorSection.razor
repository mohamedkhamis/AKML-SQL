@*
    Spec 041 (R53, R64, FR-053) — Settings › Editor: font size, word wrap, tab size (applied to the open editor at
    once), and Reset editor session, which says exactly what it clears and confirms naming the document.
*@
@using AkmlSql.Web.Services
@implements IDisposable
@inject IEditorSettingsStore Store
@inject IEditorSessionStore Session
@inject IDialogService Dialogs
@inject INotificationService Notifications

<SettingRow Id="editor-font-size" Kind="number">
    <input id="setting-editor-font-size-control" type="number" class="akml-input" min="@EditorSettings.MinFontSize" max="@EditorSettings.MaxFontSize"
           value="@_settings.FontSize" aria-describedby="setting-editor-font-size-help" @onchange="OnFontSizeAsync" />
    <span class="akml-settings-status">px</span>
</SettingRow>
<SettingRow Id="editor-word-wrap" Kind="switch">
    <input id="setting-editor-word-wrap-control" type="checkbox" checked="@_settings.WordWrap"
           aria-describedby="setting-editor-word-wrap-help" @onchange="OnWordWrapAsync" />
</SettingRow>
<SettingRow Id="editor-tab-size" Kind="number">
    <input id="setting-editor-tab-size-control" type="number" class="akml-input" min="@EditorSettings.MinTabSize" max="@EditorSettings.MaxTabSize"
           value="@_settings.TabSize" aria-describedby="setting-editor-tab-size-help" @onchange="OnTabSizeAsync" />
</SettingRow>
<SettingRow Id="editor-reset-session" Kind="action"
            Help="Clears the document kept between visits, its caret position and its history grouping. Your styles, snippets and history are kept.">
    <button id="setting-editor-reset-session-control" type="button" class="akml-btn akml-btn--danger"
            aria-describedby="setting-editor-reset-session-help" @onclick="ResetSessionAsync">Reset editor session…</button>
</SettingRow>

@code {
    private EditorSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        await Store.ReloadAsync();   // what another tab saved shows here (R56)
        _settings = await Store.GetAsync();
        Store.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(async () => { _settings = await Store.GetAsync(); StateHasChanged(); });

    private async Task SaveAsync(EditorSettings next, string message)
    {
        await Store.SetAsync(next);
        _settings = await Store.GetAsync();
        Notifications.Notify(message, NotificationKind.Success);
    }

    private Task OnFontSizeAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return Task.CompletedTask;
        var next = Copy(); next.FontSize = v;
        return SaveAsync(next, $"Editor font size: {next.Clamped().FontSize} px.");
    }

    private Task OnWordWrapAsync(ChangeEventArgs e)
    {
        var next = Copy(); next.WordWrap = e.Value is bool b && b;
        return SaveAsync(next, next.WordWrap ? "Word wrap is on." : "Word wrap is off.");
    }

    private Task OnTabSizeAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return Task.CompletedTask;
        var next = Copy(); next.TabSize = v;
        return SaveAsync(next, $"Tab size: {next.Clamped().TabSize}.");
    }

    private EditorSettings Copy() => new() { FontSize = _settings.FontSize, WordWrap = _settings.WordWrap, TabSize = _settings.TabSize };

    private async Task ResetSessionAsync()
    {
        var record = await Session.RestoreAsync();
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Reset editor session",
            Message = $"Clear {DocumentDescription(record?.DocumentText)}? This cannot be undone.",
            Details = new[]
            {
                "The document kept between visits, and its caret position.",
                "Its history grouping: the next run starts a new history session.",
                "Styles, snippets, history and connections are kept.",
            },
            ConfirmLabel = "Reset session",
            Destructive = true,
        });
        if (!ok) return;
        await Session.ClearAsync();
        // T9: reset the key explicitly so the intent never depends on ClearAsync's scope.
        await EditorSessionKeys.ResetAsync(Session);
        Notifications.Notify("Editor session cleared. The editor starts empty next time it opens.", NotificationKind.Success);
    }

    /// <summary>The document, by its first line (documents get names with spec 041 US5).</summary>
    internal static string DocumentDescription(string? text)
    {
        var first = (text ?? string.Empty).Split('\n').Select(l => l.Trim()).FirstOrDefault(l => l.Length > 0);
        if (first == null) return "the editor's empty document";
        if (first.Length > 40) first = first.Substring(0, 40) + "…";
        return $"the editor's document “{first}”";
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
