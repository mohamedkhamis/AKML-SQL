@*
    Spec 021 (web edition) -- M6 task T132; extended by spec 028 (M6) US2/US6.
    Free-form conversational AI panel. Streams the assistant response (typewriter), persists
    the conversation locally (IndexedDB) so it survives a reload, and can export it to a
    Markdown download. Honours the fully-local privacy guard before sending.
*@
@using System.Collections.Generic
@using System.Threading
@using AkmlSql.Web.Services
@using Microsoft.JSInterop
@implements IDisposable
@inject IAiClientFactory Client
@inject IAiPreference Preference
@inject IAiFeatureSettings Settings
@inject IChatHistoryStore History
@inject IDiagnosticsRingBuffer Diagnostics
@inject IJSRuntime JS

<div class="akml-chat">
    <div class="akml-chat-header">
        <h3>AI chat</h3>
        @if (!_hasProvider)
        {
            <span class="akml-chat-no-provider">
                No AI provider configured. <a href="/settings/ai">Add one in Settings</a>.
            </span>
        }
        else if (_conversation.Turns.Count > 0)
        {
            <button class="akml-tool-button" @onclick="ExportAsync" disabled="@_busy">Export</button>
            <button class="akml-tool-button" @onclick="ClearAsync" disabled="@_busy">Clear</button>
        }
    </div>

    @if (_hasProvider)
    {
        <div class="akml-chat-log">
            @if (_conversation.Turns.Count == 0)
            {
                <p class="akml-chat-empty">
                    Multi-turn chat. Type a question below. The conversation is stored only in
                    this browser and sent only to your chosen provider.
                </p>
            }
            else
            {
                @foreach (var turn in _conversation.Turns)
                {
                    <div class="akml-chat-turn akml-chat-role-@turn.Role">
                        <div class="akml-chat-role-label">@(turn.Role == "user" ? "You" : "Assistant")</div>
                        <pre class="akml-chat-turn-text">@turn.Content</pre>
                    </div>
                }
            }
            @if (_busy)
            {
                <p class="akml-chat-thinking">Thinking…</p>
            }
            @if (!string.IsNullOrEmpty(_lastError))
            {
                <p class="akml-chat-error">@_lastError</p>
            }
        </div>

        <div class="akml-chat-composer">
            <textarea class="akml-chat-input" @bind="_pending" placeholder="Ask anything about your SQL..." rows="3"
                      @onkeydown="OnKeyDown" disabled="@_busy"></textarea>
            <button class="akml-tool-button" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_pending))">
                Send
            </button>
        </div>
    }
</div>

<style>
    .akml-chat { display: flex; flex-direction: column; height: 100%; padding: var(--akml-scalar-spacing-m); }
    .akml-chat-header { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); margin-bottom: var(--akml-scalar-spacing-s); }
    .akml-chat-no-provider { color: var(--akml-status-warning); }
    .akml-chat-log {
        flex: 1 1 auto;
        overflow-y: auto;
        background-color: var(--akml-surface-canvas);
        border: 1px solid var(--akml-border-default);
        border-radius: 4px;
        padding: var(--akml-scalar-spacing-s);
        min-height: 240px;
    }
    .akml-chat-empty { color: var(--akml-text-secondary); font-style: italic; }
    .akml-chat-turn { margin-bottom: var(--akml-scalar-spacing-m); }
    .akml-chat-role-label {
        font-weight: bold;
        font-size: 12px;
        color: var(--akml-text-secondary);
        margin-bottom: var(--akml-scalar-spacing-xs);
    }
    .akml-chat-role-user .akml-chat-role-label { color: var(--akml-accent-primary); }
    .akml-chat-turn-text {
        font-family: var(--akml-type-editor-family);
        font-size: var(--akml-type-editor-size);
        white-space: pre-wrap;
        margin: 0;
        color: var(--akml-text-primary);
    }
    .akml-chat-thinking { color: var(--akml-text-secondary); font-style: italic; }
    .akml-chat-error { color: var(--akml-status-danger); }
    .akml-chat-composer {
        display: flex;
        gap: var(--akml-scalar-spacing-s);
        margin-top: var(--akml-scalar-spacing-s);
    }
    .akml-chat-input {
        flex: 1 1 auto;
        font-family: var(--akml-type-editor-family);
        font-size: var(--akml-type-editor-size);
        background-color: var(--akml-surface-canvas);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default);
        padding: var(--akml-scalar-spacing-xs);
        resize: vertical;
    }
    .akml-tool-button {
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel); color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default); border-radius: 3px;
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer;
    }
    .akml-tool-button:disabled { opacity: 0.5; cursor: not-allowed; }
    .akml-tool-button:hover:not(:disabled) { background-color: var(--akml-surface-hover); }
</style>

@code {
    private const string SystemPrompt =
        "You are a SQL Server expert assisting an experienced developer through " +
        "AKML SQL. Be concise. When you give SQL, use canonical T-SQL formatting. " +
        "When you're unsure of the schema, ask before guessing.";

    private bool _hasProvider;
    private bool _busy;
    private string _pending = string.Empty;
    private string? _lastError;
    private ChatConversation _conversation = NewConversation();
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _downloadModule;

    private static ChatConversation NewConversation() => new()
    {
        Id = Guid.NewGuid().ToString("N"),
        Title = "conversation",
        CreatedAt = DateTimeOffset.UtcNow,
        UpdatedAt = DateTimeOffset.UtcNow,
    };

    protected override async Task OnInitializedAsync()
    {
        var active = await Preference.GetActiveAsync();
        _hasProvider = !string.IsNullOrEmpty(active);
        _conversation = await History.GetAsync() ?? NewConversation();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Ctrl+Enter sends. Plain Enter inserts a newline (default textarea behaviour).
        if (e.CtrlKey && e.Key == "Enter")
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_pending)) return;

        var userMessage = _pending.Trim();
        _lastError = null;

        // FR-004 / FR-012: chat honours the fully-local guard too -- refuse a cloud provider
        // under Fully local before anything is sent.
        var providerId = await Preference.GetActiveAsync();
        var mode = await Settings.ResolveModeAsync("chat");
        if (mode == AiPrivacyMode.FullyLocal && !AiProviders.IsLocal(providerId))
        {
            _lastError = "Chat is set to Fully local, but the active provider is not local. " +
                         "Switch to Ollama or LM Studio in Settings -> AI.";
            StateHasChanged();
            return;
        }

        _pending = string.Empty;
        _busy = true;

        // Build the history BEFORE adding the new turns (every prior turn, oldest-first).
        var snapshot = BuildHistorySnapshot();
        _conversation.Turns.Add(new ChatTurn { Role = "user", Content = userMessage, Timestamp = DateTimeOffset.UtcNow });
        var assistant = new ChatTurn { Role = "assistant", Content = string.Empty, ProviderId = providerId, Timestamp = DateTimeOffset.UtcNow };
        _conversation.Turns.Add(assistant);
        StateHasChanged();

        // One in-flight stream per panel; a new message cancels the previous (FR-010).
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        var request = new AiChatRequest
        {
            SystemPrompt = SystemPrompt,
            UserPrompt = userMessage,
            History = snapshot,
        };

        try
        {
            await foreach (var token in Client.StreamAsync(providerId, request, ct))
            {
                assistant.Content += token;   // typewriter
                StateHasChanged();
            }
            await History.SaveAsync(_conversation);   // persist (FR-030); local-only
            Diagnostics.Log(DiagnosticLevel.Info, "ai-chat", $"Turn {_conversation.Turns.Count / 2} ({assistant.Content.Length} chars).");
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer message -- keep whatever partial text rendered.
        }
        catch (ProviderNotBrowserDirectException ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai-chat", ex.Message);
        }
        catch (UnauthorizedOriginException ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai-chat", ex.Message);
        }
        catch (Exception ex)
        {
            _lastError = "Chat call failed: " + ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai-chat", _lastError);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>Every existing turn (oldest-first) to send as conversation context.</summary>
    private AiChatMessage[] BuildHistorySnapshot()
    {
        var turns = _conversation.Turns;
        if (turns.Count == 0) return Array.Empty<AiChatMessage>();
        var prior = new AiChatMessage[turns.Count];
        for (int i = 0; i < turns.Count; i++)
        {
            prior[i] = new AiChatMessage { Role = turns[i].Role, Content = turns[i].Content };
        }
        return prior;
    }

    private async Task ExportAsync()
    {
        var md = _conversation.ToMarkdown();
        _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-download.js");
        var fileName = $"chat-{DateTimeOffset.UtcNow:yyyy-MM-dd-HHmm}.md";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(md));
        await _downloadModule.InvokeVoidAsync("downloadBase64", fileName, "text/markdown", base64);
    }

    private async Task ClearAsync()
    {
        _conversation = NewConversation();
        _lastError = null;
        await History.ClearAsync();   // FR-032: removed from storage; independent of schema/keys
        StateHasChanged();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
