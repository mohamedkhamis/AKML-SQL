@*
    Spec 021 (web edition) -- M6 task T132; extended by spec 028 (M6) US2/US6.
    Free-form conversational AI panel. Streams the assistant response (typewriter), persists
    the conversation locally (IndexedDB) so it survives a reload, and can export it to a
    Markdown download. Honours the fully-local privacy guard before sending.
*@
@using System.Collections.Generic
@using System.Threading
@using AkmlSql.Engine.Ai
@using AkmlSql.Web.Services
@using Microsoft.JSInterop
@implements IDisposable
@inject IAiClientFactory Client
@inject IAiPreference Preference
@inject IAiFeatureSettings Settings
@inject IChatHistoryStore History
@inject IDiagnosticsRingBuffer Diagnostics
@inject IJSRuntime JS
@inject INotificationService Notifications
@inject IServiceProvider Services

<div class="akml-chat">
    <div class="akml-chat-header">
        <h3>AI chat</h3>
        @if (!_hasProvider)
        {
            <span class="akml-chat-no-provider">
                No AI provider configured. <a href="settings/ai-assistance">Add one in Settings</a>.
            </span>
        }
        else
        {
            @if (_conversation.Turns.Count > 0)
            {
                <button class="akml-btn" @onclick="ExportAsync" disabled="@_busy" title="@(_busy ? "Wait for the answer to finish" : "Download the conversation as Markdown")">Export</button>
            }
            @* Spec 046 (US5, FR-040/FR-042): New chat replaces Clear and, as Clear did, stays usable
               while an answer streams — it stops that answer. *@
            <button class="akml-btn" data-testid="chat-new" @onclick="NewChatAsync" disabled="@(_conversation.Turns.Count == 0)"
                    title="@(_conversation.Turns.Count == 0 ? "The conversation is already empty" : "Start a new conversation — clears this one")">New chat</button>
        }
    </div>

    @if (_hasProvider)
    {
        <div class="akml-chat-log" @ref="_log">
            @if (_conversation.Turns.Count == 0)
            {
                <div class="akml-empty akml-chat-empty" data-testid="chat-empty">
                    <p class="akml-empty-title">Type a question below to start</p>
                    <p>The conversation is stored only in this browser and sent only to your chosen provider.</p>
                    @* Spec 046 (FR-023): three starters that send on a click, as Copilot Chat opens. *@
                    <div class="akml-chat-starters">
                        @foreach (var question in StarterQuestions)
                        {
                            <button type="button" class="akml-chat-starter" data-testid="chat-starter" title="Send this question"
                                    disabled="@_busy" @onclick="() => SendStarterAsync(question)">@question</button>
                        }
                    </div>
                </div>
            }
            else
            {
                @for (var i = 0; i < _conversation.Turns.Count; i++)
                {
                    var turn = _conversation.Turns[i];
                    @foreach (var notice in NoticesBefore(i))
                    {
                        <p class="akml-chat-notice" data-testid="chat-notice">@notice</p>
                    }
                    <div class="akml-chat-turn akml-chat-role-@turn.Role">
                        <div class="akml-chat-role-label">
                            <span>@SpeakerOf(turn)</span>
                            @if (!string.IsNullOrEmpty(turn.Content))
                            {
                                <button type="button" class="akml-chat-copy" title="Copy message"
                                        aria-label="Copy message" @onclick="() => CopyTurnAsync(turn)">
                                    <Icon Name="@(_copiedTurn == turn ? "check" : "copy")" Size="12" />@if (_copiedTurn == turn) { <span>Copied</span> }
                                </button>
                            }
                        </div>
                        @if (turn.Role == "user")
                        {
                            <pre class="akml-chat-turn-text">@turn.Content</pre>
                        }
                        else
                        {
                            @* Spec 046 (FR-020/FR-021): rendered like the SSMS panel — prose and code panels. *@
                            <ChatMessageView Text="@turn.Content" OnInsert="OnInsertSql" />
                        }
                        @if (turn.IncompleteReason != null)
                        {
                            <p class="akml-chat-incomplete" role="note" data-testid="ai-chat-incomplete">This answer is incomplete: @turn.IncompleteReason</p>
                        }
                    </div>
                }
            }
            @foreach (var notice in NoticesBefore(_conversation.Turns.Count))
            {
                <p class="akml-chat-notice" data-testid="chat-notice">@notice</p>
            }
            @if (_busy)
            {
                <p class="akml-chat-thinking">@WorkingText</p>
            }
            @if (!string.IsNullOrEmpty(_lastError))
            {
                <p class="akml-chat-error" role="alert" data-testid="ai-chat-error">@_lastError</p>
                @if (_retryMessage != null && !_busy)
                {
                    <button type="button" class="akml-btn" data-testid="ai-chat-retry" @onclick="RetryAsync">Retry</button>
                }
            }
        </div>

        <div class="akml-chat-composer">
            @* oninput (not the default onchange): the browser only fires change on blur, so a
               default bind would keep Send disabled while typing and make an Enter send read an
               empty prompt (silent no-op). *@
            @* Enter sends / Shift+Enter inserts a newline, matching the desktop panel. The newline
               is the DEFAULT ACTION of Enter's keypress, so it is suppressed there and armed one
               event earlier — see OnKeyDown / _suppressEnterNewline for why it cannot ride on
               keydown. *@
            <textarea class="akml-chat-input" @ref="_composer" @bind="_pending" @bind:event="oninput"
                      placeholder="@PlaceholderText" rows="3"
                      @onkeydown="OnKeyDown" @onkeypress="OnKeyPress"
                      @onkeypress:preventDefault="_suppressEnterNewline" disabled="@_busy" aria-label="Question"
                      title="@(_busy ? "Wait for the answer to finish" : null)"></textarea>
            <button class="akml-chat-send" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_pending))"
                    title="@SendTitle">
                Send
            </button>
        </div>
        @* Spec 046 (FR-030/FR-033): the answering agent, in view where the user types. *@
        <div class="akml-chat-composer-footer">
            <AiAgentSelector Changed="OnAgentChangedAsync" />
        </div>
    }
</div>

<style>
    .akml-chat { display: flex; flex-direction: column; height: 100%; padding: var(--akml-scalar-spacing-m); }
    .akml-chat-header { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); margin-bottom: var(--akml-scalar-spacing-s); }
    .akml-chat-no-provider { color: var(--akml-status-warning); }
    .akml-chat-log {
        flex: 1 1 auto;
        overflow-y: auto;
        background-color: var(--akml-surface-canvas);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-s);
        min-height: 240px;
    }
    .akml-chat-turn {
        margin-bottom: var(--akml-scalar-spacing-m);
        width: fit-content;
        max-width: 80%;
        padding: var(--akml-scalar-spacing-s);
        border-radius: var(--akml-scalar-radius-m);
        /* Visible edge: on the white light-theme panel a borderless slate bubble is
           indistinguishable from the background (user feedback). */
        border: 1px solid var(--akml-border-strong);
    }
    .akml-chat-role-user {
        margin-left: auto;
        background-color: var(--akml-chat-userbubble);
    }
    .akml-chat-role-assistant {
        margin-right: auto;
        background-color: var(--akml-chat-assistantbubble);
        /* Spec 046: answers carry SQL in code panels — they take the log's full width. */
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .akml-chat-starters { display: flex; flex-direction: column; align-items: flex-start; gap: var(--akml-scalar-spacing-xs); margin-top: var(--akml-scalar-spacing-s); }
    .akml-chat-starter {
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel); color: var(--akml-text-link);
        border: 1px solid var(--akml-border-default); border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer; text-align: left;
    }
    .akml-chat-starter:hover:not(:disabled) { background-color: var(--akml-surface-hover); }
    .akml-chat-starter:disabled { opacity: 0.6; cursor: not-allowed; }
    .akml-chat-role-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--akml-scalar-spacing-s);
        font-weight: bold;
        font-size: 12px;
        color: var(--akml-text-secondary);
        margin-bottom: var(--akml-scalar-spacing-xs);
    }
    .akml-chat-role-user .akml-chat-role-label > span { color: var(--akml-text-link); }
    .akml-chat-copy {
        background: transparent;
        border: none;
        border-radius: var(--akml-scalar-radius-xs);
        color: var(--akml-text-secondary);
        cursor: pointer;
        font-size: 12px;
        line-height: 1;
        padding: 2px 4px;
        opacity: 0.8;
    }
    .akml-chat-turn:hover .akml-chat-copy,
    .akml-chat-copy:focus-visible { opacity: 1; }
    .akml-chat-copy:hover {
        color: var(--akml-text-primary);
        background-color: var(--akml-surface-hover);
    }
    .akml-chat-turn-text {
        /* Spec 043 (FR-020): answers carry SQL, so they use the editor font and size from Settings › Editor. */
        font-family: var(--akml-editor-font-family, var(--akml-type-editor-family));
        font-size: var(--akml-editor-font-size, var(--akml-type-editor-size));
        line-height: var(--akml-type-editor-line-height);
        white-space: pre-wrap;
        margin: 0;
        color: var(--akml-text-primary);
    }
    .akml-chat-thinking { color: var(--akml-text-secondary); font-style: italic; }
    /* Spec 046 (FR-034): a plainly stated line between turns; not a turn, never saved. */
    .akml-chat-notice { color: var(--akml-text-secondary); font-style: italic; font-size: 11px; margin: 0 0 var(--akml-scalar-spacing-s); }
    .akml-chat-composer-footer { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); margin-top: var(--akml-scalar-spacing-xs); }
    .akml-chat-error { color: var(--akml-status-danger); }
    .akml-chat-incomplete { margin: var(--akml-scalar-spacing-xs) 0 0; color: var(--akml-status-warning); font-style: italic; }
    .akml-chat-composer {
        display: flex;
        gap: var(--akml-scalar-spacing-s);
        margin-top: var(--akml-scalar-spacing-s);
        /* Divider between the conversation and the composer (visibility pass). */
        border-top: 1px solid var(--akml-border-splitter);
        padding-top: var(--akml-scalar-spacing-s);
    }
    .akml-chat-input {
        flex: 1 1 auto;
        font-family: var(--akml-type-editor-family);
        font-size: var(--akml-type-editor-size);
        background-color: var(--akml-surface-canvas);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-strong);
        border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs);
        resize: vertical;
    }
    .akml-chat-input:focus-visible { outline: 2px solid var(--akml-border-focus); outline-offset: -1px; }
    /* The composer's primary action reads as an accent button, not a ghost tool button. */
    .akml-chat-send {
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        font-weight: 600;
        background-color: var(--akml-accent-primary); color: var(--akml-text-onaccent);
        border: 1px solid var(--akml-accent-primarypressed);
        border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-m);
        cursor: pointer;
        /* Stretch to the composer's height so button and textarea read as one bar. */
        align-self: stretch;
    }
    .akml-chat-send:hover:not(:disabled) { background-color: var(--akml-accent-primaryhover); }
    .akml-chat-send:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    /// <summary>Spec 042 (FR-080): written for the dialect of the connection at the moment of sending. SQL Server keeps the text
    /// it always had. Optional lookup, so a host without the dialect context behaves as before PostgreSQL support.</summary>
    private string SystemPrompt =>
        Services.GetService(typeof(IAiDialectContext)) is IAiDialectContext dialect
            ? AiChatSystemText.For(dialect.Dialect, dialect.ServerVersion)
            : AiChatSystemText.SqlServer;

    /// <summary>Spec 046 (FR-012): the composer's hint names both send keys and the new-line key.</summary>
    internal const string PlaceholderText = "Ask anything about your SQL…   (Enter or Ctrl+Enter sends · Shift+Enter for a new line)";

    /// <summary>Spec 046 (FR-011): Send names its shortcut when it can send, and says why when it cannot.</summary>
    private string SendTitle =>
        !_hasProvider ? "No AI agent can answer yet — add one in Settings"
        : _busy ? "Wait for the answer to finish"
        : string.IsNullOrWhiteSpace(_pending) ? "Type a question first"
        : "Send (Ctrl+Enter)";

    /// <summary>Spec 046 (US6, FR-021): Insert at caret for a SQL block of an answer — the editor page
    /// passes its insert; without it the code panels offer Copy only.</summary>
    [Parameter] public EventCallback<string> OnInsertSql { get; set; }

    /// <summary>Spec 046 (FR-023): the same three starters as the SSMS welcome card.</summary>
    internal static readonly string[] StarterQuestions =
    {
        "What are the largest tables in this database?",
        "Which tables have no primary key?",
        "Which stored procedures were modified most recently?",
    };

    private ElementReference _log;
    private bool _scrollAfterRender;

    private bool _hasProvider;

    /// <summary>Spec 046 (FR-022): "Name · Provider · model" of the active agent, or null when no key
    /// vault is available to name it (the turn then reads "Assistant").</summary>
    private string? _agentLabel;

    /// <summary>The label of the agent the answer in flight was requested from (FR-014).</summary>
    private string? _inFlightLabel;

    /// <summary>Spec 046 (FR-034): notices, each shown before the turn at its index — never saved.</summary>
    private readonly List<(int BeforeTurn, string Text)> _notices = new();

    private IEnumerable<string> NoticesBefore(int turnIndex)
        => _notices.Where(n => n.BeforeTurn == turnIndex).Select(n => n.Text);

    private static string SpeakerOf(ChatTurn turn)
        => turn.Role == "user" ? "You" : string.IsNullOrWhiteSpace(turn.AgentLabel) ? "Assistant" : turn.AgentLabel!;

    private string WorkingText
        => string.IsNullOrWhiteSpace(_inFlightLabel) ? "Thinking…" : $"Asking {_inFlightLabel}…";
    private bool _busy;
    private string _pending = string.Empty;
    private string? _lastError;

    // Review WEB-18: the message of a turn whose answer failed or broke off; Retry sends it again in place of that turn.
    private string? _retryMessage;
    private ChatConversation _conversation = NewConversation();
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _downloadModule;
    private bool _disposed;
    private const int RenderThrottleMs = 60;   // cap typewriter re-renders (avoid O(n^2) render churn)

    private static ChatConversation NewConversation() => new()
    {
        Id = Guid.NewGuid().ToString("N"),
        Title = "conversation",
        CreatedAt = DateTimeOffset.UtcNow,
        UpdatedAt = DateTimeOffset.UtcNow,
    };

    protected override async Task OnInitializedAsync()
    {
        var active = await Preference.GetActiveAsync();
        _hasProvider = !string.IsNullOrEmpty(active);
        _agentLabel = await LabelOfAsync(active);
        _conversation = await History.GetAsync() ?? NewConversation();
    }

    /// <summary>Armed by <see cref="OnKeyDown"/> when the key just pressed is an Enter that sends;
    /// read by the textarea's <c>@onkeypress:preventDefault</c> on the very next event.</summary>
    /// <remarks>The newline Enter would add is the default action of the KEYPRESS that follows the
    /// keydown, so suppressing it has to happen on keypress. It cannot ride on keydown: Blazor reads
    /// a dynamic <c>:preventDefault</c> off the DOM at dispatch time, so a keydown flag is always one
    /// keystroke stale (it would eat the character typed AFTER Enter), and a static one suppresses
    /// keydown→beforeinput and kills all typing — the same trap documented in
    /// wwwroot/js/akml-command-palette.js (trapKeys), which solves it with a targeted native listener
    /// this panel has no module of its own to host. Re-evaluated on every keydown, so ordinary typing
    /// is never suppressed.</remarks>
    private bool _suppressEnterNewline;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Key contract now matches the desktop panel (AkmlSql.Shell.Shared/Ai/AiChatPanel.cs,
        // OnInputKeyDown): Enter with no Shift sends, Shift+Enter falls through to the textarea
        // default and inserts a newline. Ctrl+Enter keeps working because it is simply an Enter
        // without Shift, so the web edition's original chord is not broken.
        var sends = e.Key == "Enter" && !e.ShiftKey;

        // Arm BEFORE awaiting: ComponentBase re-renders as soon as the handler reaches its first
        // await, so the flag is in the DOM before the matching keypress is dispatched.
        _suppressEnterNewline = sends;

        if (sends)
        {
            // SendAsync owns the _busy / empty-prompt guards — this path must not bypass them.
            await SendAsync();
        }
    }

    /// <summary>No behaviour of its own: registered so Blazor installs the global keypress listener
    /// that the paired <c>@onkeypress:preventDefault="_suppressEnterNewline"</c> rides on.</summary>
    private void OnKeyPress(KeyboardEventArgs e)
    {
    }

    private async Task SendAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_pending)) return;

        var userMessage = _pending.Trim();
        _lastError = null;
        _retryMessage = null;

        // FR-004 / FR-012: chat honours the fully-local guard too -- refuse a cloud provider
        // under Fully local before anything is sent.
        var agentId = await Preference.GetActiveAsync();
        var providerId = await Preference.GetActiveProviderAsync();
        var mode = await Settings.ResolveModeAsync("chat");
        if (mode == AiPrivacyMode.FullyLocal && !AiProviders.IsLocal(providerId))
        {
            _lastError = "Chat is set to Fully local, but the active provider is not local. " +
                         "Switch to Ollama or LM Studio in Settings -> AI.";
            StateHasChanged();
            return;
        }

        _pending = string.Empty;
        _busy = true;

        // Build the history BEFORE adding the new turns (every prior NON-EMPTY turn, oldest-first).
        var snapshot = BuildHistorySnapshot();
        var conversation = _conversation;   // spec 046: New chat may replace _conversation mid-answer
        var preTurns = conversation.Turns.Count;
        conversation.Turns.Add(new ChatTurn { Role = "user", Content = userMessage, Timestamp = DateTimeOffset.UtcNow });
        _inFlightLabel = await LabelOfAsync(agentId);
        var assistant = new ChatTurn
        {
            Role = "assistant", Content = string.Empty, ProviderId = providerId, Timestamp = DateTimeOffset.UtcNow,
            AgentLabel = _inFlightLabel,   // spec 046 (FR-022): who this answer was requested from
        };
        conversation.Turns.Add(assistant);
        await FollowAsync(force: true);   // the user's own message always comes into view (FR-024)
        StateHasChanged();

        // One in-flight stream per panel; a new message cancels the previous (FR-010).
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        var request = new AiChatRequest
        {
            SystemPrompt = SystemPrompt,
            UserPrompt = userMessage,
            History = snapshot,
        };

        var sb = new System.Text.StringBuilder();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            await foreach (var token in Client.StreamAsync(agentId, request, ct))
            {
                sb.Append(token);   // O(1) amortized — avoids O(n^2) string rebuild per token
                if (sw.ElapsedMilliseconds >= RenderThrottleMs) { sw.Restart(); await FollowAsync(force: false); assistant.Content = sb.ToString(); StateHasChanged(); }
            }
            Diagnostics.Log(DiagnosticLevel.Info, "ai-chat", $"Turn {_conversation.Turns.Count / 2} ({sb.Length} chars).");
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer message -- keep whatever partial text rendered, marked as stopped.
            assistant.IncompleteReason = StoppedReason;
        }
        catch (ProviderNotBrowserDirectException ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai-chat", ex.Message);
        }
        catch (UnauthorizedOriginException ex)
        {
            _lastError = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "ai-chat", ex.Message);
        }
        catch (AiStreamException ex)
        {
            // Review WEB-18: the provider accepted the request, then the answer broke off. What arrived stays, marked incomplete.
            _lastError = ex.Message + (sb.Length > 0 ? " The answer above is incomplete." : string.Empty);
            _retryMessage = userMessage;
            assistant.IncompleteReason = ex.Message;   // re-review REV-07: stays with the turn, not only on screen
            Diagnostics.Log(DiagnosticLevel.Warn, "ai-chat", $"Stream failed: {ex.Failure} {ex.Code}");
        }
        catch (Exception ex)
        {
            _lastError = "Chat call failed: " + ex.Message;
            _retryMessage = userMessage;
            assistant.IncompleteReason = FailedReason;
            Diagnostics.Log(DiagnosticLevel.Error, "ai-chat", $"Chat call failed: {ex.GetType().Name}");
        }
        finally
        {
            assistant.Content = sb.ToString();   // flush full / partial text before the empty check
            if (!ReferenceEquals(conversation, _conversation))
            {
                // Spec 046 (FR-042): New chat replaced the conversation while this answer streamed —
                // the stopped answer belonged to the old one; nothing to roll back, save or restore.
                _lastError = null;
                _retryMessage = null;
            }
            else if (string.IsNullOrEmpty(assistant.Content))
            {
                // Nothing came back (error / cancel before the first token): roll back the
                // user + assistant turns so an empty turn can't poison history or get persisted,
                // and restore the typed text so the user can retry.
                conversation.Turns.RemoveRange(preTurns, conversation.Turns.Count - preTurns);
                _pending = userMessage;
            }
            else if (!_disposed)
            {
                await History.SaveAsync(_conversation);   // persist successful/partial turn (FR-030); local-only
            }
            _busy = false;
            if (!_disposed)
            {
                await FollowAsync(force: false);
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Spec 046 (FR-034): the selector made another agent the active one — say so once in the
    /// conversation. The line is not a turn: it is never sent, saved or exported.
    /// </summary>
    private async Task OnAgentChangedAsync(string agentId)
    {
        _hasProvider = !string.IsNullOrEmpty(agentId);
        _agentLabel = await LabelOfAsync(agentId);
        _notices.Add((_conversation.Turns.Count, $"Now answering with {_agentLabel ?? agentId}."));
        StateHasChanged();
    }

    /// <summary>"Name · Provider · model" of <paramref name="agentId"/>, read from the key vault when the
    /// host has one (optional, like the dialect context); null otherwise.</summary>
    private async Task<string?> LabelOfAsync(string? agentId)
    {
        if (string.IsNullOrEmpty(agentId) || Services.GetService(typeof(IAiKeyVault)) is not IAiKeyVault vault)
            return null;
        try
        {
            var config = (await vault.ListAsync()).FirstOrDefault(c => c.Id == agentId);
            return config == null ? null : AiAgentSelector.Label(config);
        }
        catch (Exception ex)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "ai-chat", $"Agent label unavailable: {ex.GetType().Name}");
            return null;
        }
    }

    internal const string StoppedReason = "it was stopped before it finished.";
    internal const string FailedReason = "the call failed before the answer finished.";

    private async Task SendStarterAsync(string question)
    {
        if (_busy) return;
        _pending = question;
        await SendAsync();
    }

    /// <summary>
    /// Spec 046 (FR-024): a new turn or token follows the log only when the reader is already at the
    /// bottom (read BEFORE the render that grows the log); <paramref name="force"/> — the user's own
    /// message — always follows.
    /// </summary>
    private async Task FollowAsync(bool force)
    {
        if (_disposed || _followUnavailable) return;
        try
        {
            _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
            if (force || await _ui.InvokeAsync<bool>("isAtBottom", _log, 8))
                _scrollAfterRender = true;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Following the log is a convenience: it must never break a send. Say it once and stop
            // trying (a stream would otherwise retry every 60 ms).
            _followUnavailable = true;
            Diagnostics.Log(DiagnosticLevel.Warn, "ai-chat", $"Chat log follow unavailable: {ex.GetType().Name}");
        }
    }

    private bool _followUnavailable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollAfterRender || _ui == null) return;
        _scrollAfterRender = false;
        try { await _ui.InvokeVoidAsync("scrollToBottom", _log); }
        catch (Exception ex) when (ex is not OperationCanceledException) { _followUnavailable = true; }
    }

    /// <summary>Review WEB-18: send the failed turn's message again, in place of the failed (or partial) turn.</summary>
    private async Task RetryAsync()
    {
        if (_busy || _retryMessage == null) return;
        var message = _retryMessage;
        _retryMessage = null;
        // The failed pair is the last two turns (the user message and its partial answer), when the answer kept any text.
        int n = _conversation.Turns.Count;
        if (n >= 2 && _conversation.Turns[n - 1].Role == "assistant" && _conversation.Turns[n - 2].Content == message)
            _conversation.Turns.RemoveRange(n - 2, 2);
        _pending = message;
        await SendAsync();
    }

    /// <summary>Every existing NON-EMPTY turn (oldest-first) to send as conversation context.
    /// Skipping empty turns is defence-in-depth: a stray empty assistant turn must never reach
    /// the provider wire (Anthropic 400s on empty content). Re-review REV-07: an incomplete answer is sent
    /// with a note that it was cut off, so the model never builds on it as if it were finished.</summary>
    private AiChatMessage[] BuildHistorySnapshot()
    {
        var list = new List<AiChatMessage>(_conversation.Turns.Count);
        foreach (var t in _conversation.Turns)
        {
            if (!string.IsNullOrEmpty(t.Content))
            {
                var content = t.IncompleteReason == null ? t.Content : t.Content + "\n\n[This answer was cut off before it finished.]";
                list.Add(new AiChatMessage { Role = t.Role, Content = content });
            }
        }
        return list.ToArray();
    }

    private const int CopiedIndicatorMs = 1500;
    private ChatTurn? _copiedTurn;
    private int _copyStamp;   // a newer copy must not have its indicator cleared by an older timer

    private IJSObjectReference? _ui;

    private async Task CopyTurnAsync(ChatTurn turn)
    {
        // Spec 041 (T201, R5, N14): copyText also works on the http LAN deployment, where navigator.clipboard is absent.
        bool copied;
        try
        {
            _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
            copied = await _ui.InvokeAsync<bool>("copyText", turn.Content);
        }
        catch (Exception ex)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "ai-chat", $"Copy failed: {ex.Message}");
            copied = false;
        }
        if (!copied)
        {
            Notifications.Notify("Copy failed — select the text and press Ctrl+C.", NotificationKind.Error);
            return;
        }

        _copiedTurn = turn;
        var stamp = ++_copyStamp;
        StateHasChanged();
        await Task.Delay(CopiedIndicatorMs);
        if (stamp == _copyStamp && !_disposed)
        {
            _copiedTurn = null;
            StateHasChanged();
        }
    }

    private async Task ExportAsync()
    {
        var md = _conversation.ToMarkdown();
        _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-download.js");
        var fileName = $"chat-{DateTimeOffset.UtcNow:yyyy-MM-dd-HHmm}.md";
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(md));
        await _downloadModule.InvokeVoidAsync("downloadBase64", fileName, "text/markdown", base64);
    }

    private ElementReference _composer;

    /// <summary>
    /// Spec 046 (US5, FR-040 – FR-043): starts a new conversation — stops an answer in flight,
    /// removes the stored conversation (one conversation at a time; Export is the way to keep it),
    /// keeps the active agent, and puts the focus back in the empty composer.
    /// </summary>
    private async Task NewChatAsync()
    {
        _cts?.Cancel();
        _pending = string.Empty;
        _retryMessage = null;
        await ClearAsync();
        try
        {
            _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
            await _ui.InvokeVoidAsync("focusElement", _composer);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "ai-chat", $"Composer focus failed: {ex.GetType().Name}");
        }
    }

    private async Task ClearAsync()
    {
        _conversation = NewConversation();
        _notices.Clear();
        _lastError = null;
        await History.ClearAsync();   // FR-032: removed from storage; independent of schema/keys
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _cts?.Cancel();
        _cts?.Dispose();
        if (_ui != null) _ = ReleaseUiAsync(_ui);
    }

    private static async Task ReleaseUiAsync(IJSObjectReference ui)
    {
        try { await ui.DisposeAsync(); }
        catch (JSDisconnectedException) { /* the page is gone */ }
    }
}
