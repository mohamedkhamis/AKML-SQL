@*
    Spec 021 (web edition) -- M2 task T032 + M5 task T109 follow-up. CodeMirror 6
    editor wrapper. Hosts the editor inside a stable DOM div; lifecycle managed by
    akml-editor.js. The Blazor side exposes SetText/GetText/SetSelection/GotoLine +
    OnTextChanged event, AND a JS-invokable completion bridge so the editor's
    autocomplete popup is fed by our ICompletionService (which routes to the engine
    when online and falls back to the cached IndexedDB snapshot when offline).
*@
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Web.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ICompletionService Completion
@inject IAiGhostTextService GhostText
@inject IAiFeatureSettings AiFeatures
@inject IEditorSettingsStore EditorSettings
@inject IServiceProvider Services
@using Microsoft.Extensions.DependencyInjection
@inject ISqlConnectionService SqlConn
@inject IQuickInfoService QuickInfo
@inject ISignatureHelpService SignatureHelp
@inject IGotoDefinitionService GotoDefinition
@inject IWildcardExpansionService Wildcard

<div @ref="_host" id="@HostId" class="akml-editor" data-testid="sql-editor" data-tab-id="@_appliedTabId"></div>

<style>
    .akml-editor {
        height: 100%;
        min-height: 320px;
        position: relative; /* anchors the go-to-definition peek panel */
        background-color: var(--akml-surface-editor);
        font-family: var(--akml-editor-font-family, var(--akml-type-editor-family));   /* Settings › Editor › Font (spec 043) */
        font-size: var(--akml-editor-font-size, var(--akml-type-editor-size));   /* Settings › Editor (spec 041 R53) */
    }
    .akml-editor .cm-editor { height: 100%; }
    /* Spec 043 (R12, FR-016): an explicit line spacing instead of CodeMirror's 1.4. The gutter sits inside the scroller,
       so its numbers share each line's height and baseline. */
    .akml-editor .cm-scroller { font-family: inherit; font-size: inherit; line-height: var(--akml-type-editor-line-height); }

    /* Spec 043 (R13, FR-019): the caret, the selection, the active line, the matching bracket and find matches, from the
       theme tokens. CodeMirror's own defaults are light-theme colours that stayed light in the dark theme. The selection
       is the browser's (no drawSelection layer), so it is styled with ::selection. */
    .akml-editor .cm-content { caret-color: var(--akml-text-primary); }
    .akml-editor .cm-cursor, .akml-editor .cm-dropCursor { border-left-color: var(--akml-text-primary); }
    .akml-editor .cm-content ::selection { background-color: var(--akml-editor-selection); color: var(--akml-text-primary); }
    .akml-editor .cm-editor .cm-activeLine { background-color: var(--akml-editor-activeline); }
    .akml-editor .cm-editor .cm-matchingBracket,
    .akml-editor .cm-editor.cm-focused .cm-matchingBracket {
        background-color: transparent;
        outline: 1px solid var(--akml-editor-matchingbracket);
        border-radius: 2px;
    }
    .akml-editor .cm-editor .cm-nonmatchingBracket,
    .akml-editor .cm-editor.cm-focused .cm-nonmatchingBracket {
        background-color: transparent;
        outline: 1px dashed var(--akml-status-danger);
    }
    .akml-editor .cm-editor .cm-searchMatch { background-color: var(--akml-editor-searchmatch); color: var(--akml-text-primary); }
    .akml-editor .cm-editor .cm-searchMatch-selected { outline: 1px solid var(--akml-editor-matchingbracket); }
    /* Theme the line-number gutter — CodeMirror's default is a hardcoded light #f5f5f5 that stayed
       light in dark mode (a jarring strip down the editor's left edge). Token-drive it so it follows
       the editor surface in every theme; the active line gets a subtle hover tint. */
    .akml-editor .cm-gutters {
        background-color: var(--akml-surface-editor);
        color: var(--akml-text-secondary);
        border-right: 1px solid var(--akml-border-subtle);
    }
    .akml-editor .cm-activeLineGutter {
        background-color: var(--akml-surface-hover);
        color: var(--akml-text-primary);
    }

    /* Spec 041 (R39) — findings in the editor (analyser issues, the line of an execution error). The
       lint extension injects hard-coded colours under a generated class at runtime, so these overrides
       are scoped under .akml-editor .cm-editor (higher specificity) and drawn from the theme tokens.
       Severity is told by shape as well as colour: error ●, warning ◆, info/hint ○. */
    .akml-editor .cm-editor .cm-lintRange {
        background-image: none;
        text-decoration-line: underline;
        text-decoration-style: wavy;
        text-decoration-skip-ink: none;
        text-underline-offset: 3px;
        padding-bottom: 0;
    }
    .akml-editor .cm-editor .cm-lintRange-error { text-decoration-color: var(--akml-status-danger); }
    .akml-editor .cm-editor .cm-lintRange-warning { text-decoration-color: var(--akml-status-warning); }
    .akml-editor .cm-editor .cm-lintRange-info { text-decoration-color: var(--akml-status-info); }
    .akml-editor .cm-editor .cm-lintRange-hint { text-decoration-color: var(--akml-text-secondary); }
    .akml-editor .cm-editor .cm-gutter-lint { width: 1.1em; }
    .akml-editor .cm-editor .cm-lint-marker {
        content: none;
        width: 0.55em;
        height: 0.55em;
        margin: 0.35em auto 0;
        box-sizing: border-box;
    }
    .akml-editor .cm-editor .cm-lint-marker-error { border-radius: 50%; background-color: var(--akml-status-danger); }
    .akml-editor .cm-editor .cm-lint-marker-warning { transform: rotate(45deg); background-color: var(--akml-status-warning); }
    .akml-editor .cm-editor .cm-lint-marker-info { border-radius: 50%; border: 2px solid var(--akml-status-info); }
    /* CodeMirror's base theme paints every tooltip and panel light (#f5f5f5 / #bbb, white fields,
       gradient buttons) and no CodeMirror theme is registered, so the hover hint, signature help and
       Find panel stayed light in dark mode. Its rules are `.ͼ2 .cm-x` in a style tag inserted first in the
       document head, so these equal-specificity overrides win. The autocomplete popup is themed in Pages/Editor.razor. */
    .akml-editor .cm-tooltip {
        background-color: var(--akml-surface-panel);
        border: 1px solid var(--akml-border-strong);
        color: var(--akml-text-primary);
    }
    .akml-editor .cm-tooltip-section:not(:first-child) { border-top-color: var(--akml-border-strong); }
    .akml-editor .cm-panels {
        background-color: var(--akml-surface-panel);
        color: var(--akml-text-primary);
    }
    .akml-editor .cm-panels-top { border-bottom-color: var(--akml-border-default); }
    .akml-editor .cm-panels-bottom { border-top-color: var(--akml-border-default); }
    .akml-editor .cm-textfield {
        background-color: var(--akml-surface-input);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs);
    }
    .akml-editor .cm-textfield::placeholder { color: var(--akml-text-placeholder); }
    .akml-editor .cm-button,
    .akml-editor .cm-button:active {
        background-image: none;
        background-color: var(--akml-surface-panel);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-strong);
        border-radius: var(--akml-scalar-radius-xs);
    }
    .akml-editor .cm-button:hover { background-color: var(--akml-surface-hover); }
    [data-akml-theme="high-contrast"] .akml-editor .cm-button:hover { color: var(--akml-text-onaccent); }
    .cm-tooltip.cm-tooltip-lint {
        font-family: var(--akml-type-chrome-family);
        font-size: 12px;
    }
    .cm-tooltip-lint .cm-diagnostic { padding: 4px 8px; }
    .cm-tooltip-lint .cm-diagnostic-error { border-left: 4px solid var(--akml-status-danger); }
    .cm-tooltip-lint .cm-diagnostic-warning { border-left: 4px solid var(--akml-status-warning); }
    .cm-tooltip-lint .cm-diagnostic-info { border-left: 4px solid var(--akml-status-info); }
    .cm-tooltip-lint .cm-diagnostic-hint { border-left: 4px solid var(--akml-text-secondary); }
    .cm-tooltip-lint .cm-diagnosticSource { color: var(--akml-text-secondary); font-size: 11px; }

    /* Spec 030 (web Phase 1) — quick-info hover + signature tooltip content. */
    .akml-qi-tooltip, .akml-sig-tooltip {
        max-width: 460px;
        padding: 6px 8px;
        color: var(--akml-text-primary);
        font-family: var(--akml-type-chrome-family);
        font-size: 12px;
        line-height: 1.5;
    }
    .akml-qi-header, .akml-sig-label { font-weight: 600; }
    .akml-qi-desc, .akml-sig-doc { color: var(--akml-text-secondary); margin-top: 2px; }
    .akml-qi-details { margin-top: 4px; color: var(--akml-text-secondary); font-family: var(--akml-editor-font-family, var(--akml-type-editor-family)); }
    .akml-sig-active { margin-top: 3px; color: var(--akml-text-link); font-weight: 600; }

    /* Go-to-definition peek panel — anchored to the bottom of the editor. */
    .akml-peek-panel {
        position: absolute; left: 0; right: 0; bottom: 0; z-index: 20;
        max-height: 45%; display: flex; flex-direction: column;
        background-color: var(--akml-surface-panel);
        border-top: 1px solid var(--akml-border-default);
        box-shadow: 0 -2px 8px rgba(0,0,0,0.25);
    }
    .akml-peek-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 4px 8px; font-family: var(--akml-type-chrome-family); font-size: 12px;
        color: var(--akml-text-primary); background-color: var(--akml-surface-hover, var(--akml-surface-panel));
        border-bottom: 1px solid var(--akml-border-default);
    }
    .akml-peek-close {
        background: transparent; border: none; cursor: pointer; font-size: 13px;
        color: var(--akml-text-secondary); padding: 0 4px;
    }
    .akml-peek-close:hover { color: var(--akml-text-primary); }
    .akml-peek-body {
        margin: 0; padding: 8px; overflow: auto; white-space: pre;
        font-family: var(--akml-editor-font-family, var(--akml-type-editor-family));
        font-size: var(--akml-editor-font-size, var(--akml-type-editor-size));
        line-height: var(--akml-type-editor-line-height);
        color: var(--akml-text-primary);
    }
</style>

@code {
    [Parameter] public string InitialText { get; set; } = string.Empty;

    /// <summary>Raised whenever the editor's text changes. Debounced by CodeMirror.</summary>
    [Parameter] public EventCallback<string> OnTextChanged { get; set; }

    /// <summary>Spec 030 — Phase 5. Raised when the user presses Ctrl/Cmd+Enter in the editor
    /// (CM6 keymap → <see cref="ExecuteFromJs"/>). The page handles it by reading the live text and
    /// running the query. Same shape as <see cref="OnTextChanged"/>.</summary>
    [Parameter] public EventCallback OnExecute { get; set; }

    /// <summary>
    /// Spec 042 (FR-060, FR-065): the database kind of the active connection. PostgreSQL highlights as PostgreSQL; SQL
    /// Server, and no connection, keep the language the editor always had. A change reconfigures the open editor in
    /// place, so switching connections keeps the text, caret and diagnostics.
    /// </summary>
    [Parameter] public AkmlSql.Core.DatabaseKind Kind { get; set; } = AkmlSql.Core.DatabaseKind.SqlServer;

    /// <summary>
    /// Spec 043 (research R6): a text change with the query tab it was made in (the tab shown when CodeMirror reported it).
    /// When set it is raised instead of <see cref="OnTextChanged"/>.
    /// </summary>
    [Parameter] public EventCallback<EditorTabText> OnTabTextChanged { get; set; }

    private string HostId { get; } = $"akml-editor-{Guid.NewGuid():N}";

    // Spec 043 (R6): the query tab the one CodeMirror view shows; other tabs' states wait in akml-editor.js.
    private string? _currentTabId;
    // Published only after JS applied the tab's state; the view can exist before its first tab is attached.
    private string? _appliedTabId;
    // A switch asked for before CodeMirror existed: the view is created showing this tab and text.
    private (string Text, AkmlSql.Core.DatabaseKind Kind)? _pendingSeed;

    // The tabs whose state akml-editor.js holds. Showing one of them again sends no text: a 10 MB document crosses the interop
    // boundary only the first time it is shown (plan › Performance Goals: a swap under 200 ms).
    private readonly HashSet<string> _jsTabs = new();

    /// <summary>Spec 043: the query tab the editor shows (null before the page names one).</summary>
    public string? CurrentTabId => _currentTabId;
    private AkmlSql.Core.DatabaseKind _appliedKind = AkmlSql.Core.DatabaseKind.SqlServer;
    private ElementReference _host;
    private IJSObjectReference? _module;
    // Set when the page is left. Start-up awaits JS several times; leaving mid-way (e.g. the style
    // picker's "Edit…" link) must not call into a module DisposeAsync already released.
    private bool _disposed;
    private DotNetObjectReference<EditorComponent>? _selfRef;
    private bool _initialised;
    // The InitialText value the parent last passed. Only a change of the PARAMETER is pushed into CodeMirror: comparing it
    // with what the editor holds instead (as before) made any re-render after an edit made from inside the editor (Format,
    // a fix, an insert) push the parent's older value back over the document - a connection switch replaced the query
    // with the text the page had restored at start-up.
    private string? _lastInitialTextParameter;

    // The InitialText value last pushed into CodeMirror. CM is created once (below); if the parent
    // later changes InitialText (async session restore, or History "Open in editor"), OnParametersSetAsync
    // pushes it via setText so the new document actually appears. User edits flow OUT via OnTextChanged
    // and never mutate InitialText, so this can't clobber typing.
    private string? _appliedInitialText;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialised) return;
        _initialised = true;

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-editor.js");
        if (_disposed) { await module.DisposeAsync(); return; }
        _selfRef = DotNetObjectReference.Create(this);
        // Spec 041 (R53): the editor options from Settings › Editor, applied at create and on every change.
        var options = await EditorSettings.GetAsync();
        if (_disposed) { await module.DisposeAsync(); return; }
        // Spec 043: a tab switch that came before CodeMirror existed decides what it is created showing. _module stays null
        // until create has run, and the seed stays in force meanwhile: reads see its text, writes change it, a switch replaces
        // it — and whatever it holds when create returns is shown just below, never sent to an editor that does not exist yet.
        var pending = _pendingSeed;
        var seed = pending?.Text ?? InitialText;
        var kindAtCreate = pending?.Kind ?? Kind;
        var tabAtCreate = _currentTabId;
        var appliedTab = tabAtCreate;
        await module.InvokeVoidAsync("create", HostId, seed, _selfRef, ToJs(options, kindAtCreate, tabAtCreate));
        _module = module;
        _appliedKind = kindAtCreate;
        if (tabAtCreate != null) _jsTabs.Add(tabAtCreate);
        if (_disposed)
        {
            // Left while CodeMirror was being created: DisposeAsync found no module, so the editor is released here.
            try { await module.InvokeVoidAsync("dispose", HostId); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            return;
        }
        var later = _pendingSeed;
        _pendingSeed = null;
        if (later is { } shown && _currentTabId != null && _currentTabId != tabAtCreate)
        {
            // Another tab was shown while CodeMirror was being created.
            var shownTabId = _currentTabId;
            _appliedKind = shown.Kind;
            _jsTabs.Add(shownTabId);
            await _module.InvokeVoidAsync("switchTab", HostId, shownTabId, shown.Text, AkmlSql.Core.DatabaseKindNames.ToName(shown.Kind));
            appliedTab = shownTabId;
        }
        else if (later is { } same && pending != null && !string.Equals(same.Text, seed, StringComparison.Ordinal))
        {
            // The same tab's text was set while CodeMirror was being created.
            await _module.InvokeVoidAsync("setText", HostId, same.Text);
        }
        // Findings asked for while CodeMirror did not exist (the page shows a tab's findings on its first show).
        if (_pendingDiagnostics is { } diagnostics)
        {
            _pendingDiagnostics = null;
            if (_pendingDiagnosticsTab == _currentTabId)
                await _module.InvokeVoidAsync("setDiagnostics", HostId, diagnostics);
        }
        _appliedInitialText = pending == null ? seed : InitialText;
        _lastInitialTextParameter = InitialText;
        EditorSettings.Changed += OnEditorSettingsChanged;

        // Spec 028 (M6) US5: tell the editor whether ghost text is enabled + the debounce.
        // The JS only requests a completion when enabled, so disabling it costs no interop.
        var ai = await AiFeatures.GetAsync();
        if (_disposed) return;
        await _module.InvokeVoidAsync("setGhostTextConfig", HostId, ai.GhostTextEnabled, ai.GhostTextDelayMs);

        // A parameter change (async session restore, or History "Open in editor"/"Re-execute") may have
        // landed while _module was still null above — OnParametersSetAsync would have skipped it. Apply
        // the latest InitialText now that the editor exists, so the restored document actually appears.
        if (!_disposed && InitialText != _lastInitialTextParameter)
        {
            _lastInitialTextParameter = InitialText;
            if (InitialText != _appliedInitialText)
            {
                _appliedInitialText = InitialText;
                await _module.InvokeVoidAsync("setText", HostId, InitialText);
            }
        }

        // Same race for the connection kind: it may have changed while the module was loading.
        if (!_disposed && Kind != _appliedKind)
        {
            _appliedKind = Kind;
            await _module.InvokeVoidAsync("setDialect", HostId, AkmlSql.Core.DatabaseKindNames.ToName(Kind));
        }
        if (!_disposed)
        {
            _appliedTabId ??= appliedTab;
            StateHasChanged();
        }
    }

    /// <summary>If the parent updates <see cref="InitialText"/> after CodeMirror is already created
    /// (async session restore, or History "Open in editor"/"Re-execute"), push the new document into
    /// the editor. Guarded so it only fires on an actual change post-init.</summary>
    protected override async Task OnParametersSetAsync()
    {
        // Only when the parent passed a new value: a re-render that passes the same (possibly older) value again must not
        // overwrite what the user has done in the editor since.
        if (_initialised && _module != null && InitialText != _lastInitialTextParameter)
        {
            _lastInitialTextParameter = InitialText;
            if (InitialText != _appliedInitialText)
            {
                _appliedInitialText = InitialText;
                await _module.InvokeVoidAsync("setText", HostId, InitialText);
            }
        }

        // Spec 042: the active connection changed kind; reconfigure the open editor's language in place.
        if (_initialised && _module != null && Kind != _appliedKind)
        {
            _appliedKind = Kind;
            await _module.InvokeVoidAsync("setDialect", HostId, AkmlSql.Core.DatabaseKindNames.ToName(Kind));
        }
    }

    /// <summary>
    /// JS-invokable callback wired from akml-editor.js update listener. Marshalled as a
    /// non-blocking invoke so the editor doesn't block on the C# debounce path.
    /// </summary>
    [JSInvokable]
    public Task OnTextChangedFromJs(string text, string? tabId)
    {
        // Spec 043: the tab CodeMirror showed when it reported the change; a page with query tabs files it under that tab.
        if (OnTabTextChanged.HasDelegate) return OnTabTextChanged.InvokeAsync(new EditorTabText(tabId ?? _currentTabId, text));
        return OnTextChanged.InvokeAsync(text);
    }

    /// <summary>
    /// Spec 043 (R6, plan › Design notes › Tab switch): show query tab <paramref name="tabId"/>. The shown tab's text, caret,
    /// selection, undo history, scroll and diagnostics are kept for it; <paramref name="tabId"/>'s come back, or are made from
    /// <paramref name="seedText"/> the first time it is shown, with <paramref name="kind"/>'s SQL language. Raises no text change.
    /// </summary>
    public async Task SwitchTabAsync(string tabId, string seedText, AkmlSql.Core.DatabaseKind kind)
    {
        if (string.IsNullOrEmpty(tabId) || _disposed) return;
        if (_module == null)
        {
            _currentTabId = tabId;
            _pendingSeed = (seedText ?? string.Empty, kind);
            return;
        }
        if (tabId == _currentTabId) return;
        _currentTabId = tabId;
        _appliedKind = kind;
        // A tab the editor already holds comes back from its kept state: its text is not sent again.
        string? seed = _jsTabs.Add(tabId) ? seedText ?? string.Empty : null;
        await _module.InvokeVoidAsync("switchTab", HostId, tabId, seed, AkmlSql.Core.DatabaseKindNames.ToName(kind));
        if (!_disposed && tabId == _currentTabId)
        {
            _appliedTabId = tabId;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Spec 043: forget a closed query tab's kept state. The page shows another tab first.</summary>
    public async Task CloseTabAsync(string tabId)
    {
        if (string.IsNullOrEmpty(tabId)) return;
        if (tabId == _currentTabId) { _currentTabId = null; _appliedTabId = null; }
        _jsTabs.Remove(tabId);
        if (_module == null || _disposed) return;
        await _module.InvokeVoidAsync("closeTab", HostId, tabId);
    }

    // A call that names no tab, or the shown one, acts on the view; any other acts on that tab's kept state.
    private bool IsShown(string? tabId) => tabId == null || tabId == _currentTabId;

    // A tab never shown in this editor has no kept state: the page holds its text and puts its findings back on the first show.
    private bool IsKept(string tabId) => _jsTabs.Contains(tabId);

    /// <summary>Spec 041 (R65, FR-083): the caret moved (throttled in akml-editor.js) — the status bar shows it.</summary>
    [JSInvokable]
    public void OnSelectionChangedFromJs(int line, int column) =>
        Services.GetService<IWorkspaceStatus>()?.SetCaret(Math.Max(1, line), Math.Max(1, column));

    /// <summary>Spec 030 — Phase 5. JS-invokable Execute bridge (CM6 Mod-Enter keymap). Surfaces the
    /// <see cref="OnExecute"/> EventCallback up to the page, which reads the LIVE editor text.</summary>
    [JSInvokable]
    public Task ExecuteFromJs() => OnExecute.InvokeAsync();

    /// <summary>
    /// JS-invokable completion source called by CodeMirror's autocompletion. Returns
    /// an array of plain objects shaped for the JS side: { label, insertText, type,
    /// detail }. The .NET side dispatches to <see cref="ICompletionService"/> which
    /// routes to the engine when online or to the cached SchemaSnapshot when offline.
    /// </summary>
    [JSInvokable]
    public async Task<CompletionItemDto[]> RequestCompletionsFromJs(int cursorOffset, string? documentText = null)
    {
        try
        {
            // Spec 043: the shown tab's connection, captured before the first await, so a tab switch while the request
            // is on its way never sends this tab's text to another tab's session.
            var session = TabSession();
            // Spec 030: when connected to a SQL Server (via the engine bridge), use the tab's session id so the engine
            // resolves the live schema; otherwise empty → offline/keyword path.
            var request = new CompletionRequest
            {
                SessionId = session.Connected ? session.Id : string.Empty,
                CursorOffset = cursorOffset,
                TriggerKind = 0,
            };
            // Spec 030: push the live document to the engine session FIRST (DocumentChanged), then ask
            // for completion. Frames are delivered in order over the one socket, so the engine has the
            // current text (clause context) before it completes. No-op offline.
            if (session.Connected && documentText != null)
            {
                await SendDocumentAsync(session, documentText);
            }
            // documentText is the LIVE editor text, passed straight from JS so the offline
            // smart GROUP BY action parses what the user actually sees (the online path ignores
            // it — the engine has its own copy). Kept off CompletionRequest so it never hits the wire.
            var response = await Completion.CompleteAsync(request, CancellationToken.None, documentText);
            if (response.Items == null || response.Items.Length == 0) return System.Array.Empty<CompletionItemDto>();

            return response.Items.Select(i => new CompletionItemDto
            {
                Label = string.IsNullOrEmpty(i.DisplayText) ? i.InsertText : i.DisplayText,
                InsertText = string.IsNullOrEmpty(i.InsertText) ? i.DisplayText : i.InsertText,
                Type = ToCmType(i.ObjectType),
                Detail = i.SecondaryText,
                SortPriority = i.SortPriority,
            }).ToArray();
        }
        catch
        {
            // Never bubble through the JS interop boundary -- the popup just stays empty.
            return System.Array.Empty<CompletionItemDto>();
        }
    }

    /// <summary>
    /// Spec 028 (M6) task T030 (US5). JS-invokable inline ghost-text source. The CodeMirror
    /// debounced change hook calls this with the cursor offset + live document text; we derive
    /// the preceding text and ask <see cref="IAiGhostTextService"/> for a suggestion. Returns
    /// null (no suggestion) on anything — ghost text must never throw into the typing path.
    /// </summary>
    [JSInvokable]
    public async Task<string?> RequestGhostTextFromJs(int cursorOffset, string? documentText)
    {
        try
        {
            var doc = documentText ?? string.Empty;
            var pos = System.Math.Clamp(cursorOffset, 0, doc.Length);
            var start = System.Math.Max(0, pos - 500);
            var preceding = doc.Substring(start, pos - start);
            return await GhostText.CompleteAsync(preceding, CancellationToken.None);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Spec 030 (web Phase 1) — JS-invokable hover quick-info. Returns null when there is
    /// nothing to show (the JS hoverTooltip then shows no tooltip). Online routes through the engine;
    /// offline synthesises from the cached schema (handled inside IQuickInfoService).</summary>
    [JSInvokable]
    public async Task<QuickInfoDto?> RequestQuickInfoFromJs(int cursorOffset, string? documentText)
    {
        try
        {
            var session = TabSession();
            if (session.Connected && documentText != null)
                await SendDocumentAsync(session, documentText);

            var r = await QuickInfo.GetAsync(new QuickInfoRequest
            {
                SessionId = session.Connected ? session.Id : string.Empty,
                CursorOffset = cursorOffset,
            }, CancellationToken.None);

            bool empty = r == null
                || (string.IsNullOrEmpty(r.Header) && string.IsNullOrEmpty(r.Description)
                    && (r.Details == null || r.Details.Length == 0));
            if (empty) return null;

            return new QuickInfoDto
            {
                Header = r!.Header ?? string.Empty,
                ObjectType = r.ObjectType ?? string.Empty,
                Description = r.Description ?? string.Empty,
                Details = (r.Details ?? System.Array.Empty<QuickInfoDetail>())
                    .Select(d => new DetailDto { Label = d.Label ?? string.Empty, Value = d.Value ?? string.Empty })
                    .ToArray(),
            };
        }
        catch { return null; }
    }

    /// <summary>Spec 030 (web Phase 1) — JS-invokable signature help (triggered on '(' / ','). Returns
    /// the active overload's label + parameters + the active parameter index, or null.</summary>
    [JSInvokable]
    public async Task<SignatureDto?> RequestSignatureHelpFromJs(int cursorOffset, string? documentText)
    {
        try
        {
            var session = TabSession();
            if (session.Connected && documentText != null)
                await SendDocumentAsync(session, documentText);

            var r = await SignatureHelp.GetAsync(new SignatureRequest
            {
                SessionId = session.Connected ? session.Id : string.Empty,
                CursorOffset = cursorOffset,
            }, CancellationToken.None);

            if (r == null || r.Overloads == null || r.Overloads.Length == 0) return null;
            var ov = r.Overloads[System.Math.Clamp(r.ActiveOverload, 0, r.Overloads.Length - 1)];

            return new SignatureDto
            {
                Label = ov.Label ?? string.Empty,
                Documentation = ov.Documentation ?? string.Empty,
                ActiveParameter = r.ActiveParameter,
                Parameters = (ov.Parameters ?? System.Array.Empty<ParameterInfo>())
                    .Select(p => new ParamDto { Name = p.Name ?? string.Empty, Type = p.Type ?? string.Empty })
                    .ToArray(),
            };
        }
        catch { return null; }
    }

    /// <summary>Spec 030 (web Phase 1) — JS-invokable go-to-definition (F12). Resolves the identifier
    /// at the caret and asks the engine for the object's CREATE definition (online-only). Returns a
    /// flat result the JS peek panel renders; Found=false carries a short reason.</summary>
    [JSInvokable]
    public async Task<DefinitionDto> RequestGoToDefinitionFromJs(int cursorOffset, string? documentText)
    {
        try
        {
            var session = TabSession();
            var doc = documentText ?? string.Empty;
            var token = OfflineSqlScanner.FindIdentifierAt(doc, cursorOffset);
            if (!token.IsValid)
                return new DefinitionDto { Found = false, Message = "No object under the cursor." };
            if (!session.Connected)
                return new DefinitionDto { Found = false, Message = "Connect to a database to view object definitions." };

            var r = await GotoDefinition.GetAsync(new GetObjectDefinitionRequest
            {
                SessionId = session.Id,
                ObjectName = token.Identifier,
                SchemaName = string.IsNullOrEmpty(token.Prefix) ? null : token.Prefix,
                PeekOnly = true,
            }, CancellationToken.None);

            if (r == null || !r.Success || string.IsNullOrEmpty(r.Definition))
                return new DefinitionDto { Found = false, Message = r?.Error ?? $"No definition found for '{token.Identifier}'." };

            return new DefinitionDto
            {
                Found = true,
                FullName = r.FullName ?? token.Identifier,
                ObjectType = r.ObjectType ?? string.Empty,
                Definition = r.Definition!,
            };
        }
        catch { return new DefinitionDto { Found = false, Message = "Could not retrieve the definition." }; }
    }

    /// <summary>Spec 030 — JS-invokable "expand SELECT *" (Tab after a <c>*</c>). Locates the wildcard
    /// at the caret (bare <c>*</c> or <c>alias.*</c>), asks the engine to enumerate the FROM tables'
    /// columns, and returns the replacement text + the span to overwrite. Returns null when not
    /// connected, not a wildcard, or the engine can't expand it — the JS side then leaves Tab alone.
    /// The column layout mirrors the desktop: first column on the <c>*</c>'s line, the rest wrapped
    /// and aligned to the <c>*</c>'s indent; columns are qualified only when more than one source
    /// table is expanded (or the user wrote <c>alias.*</c>). Names are written as the dialect needs
    /// (<see cref="WrittenName"/>).</summary>
    [JSInvokable]
    public async Task<WildcardExpandDto?> ExpandWildcardFromJs(int caretOffset, string? documentText)
    {
        try
        {
            var session = TabSession();
            var doc = documentText ?? string.Empty;
            if (!session.Connected) return null;

            // Locate the '*' at or adjacent to the caret (mirrors desktop DetectWildcardAtCursor).
            int starPos = -1;
            if (caretOffset > 0 && caretOffset <= doc.Length && doc[caretOffset - 1] == '*') starPos = caretOffset - 1;
            else if (caretOffset >= 0 && caretOffset < doc.Length && doc[caretOffset] == '*') starPos = caretOffset;
            if (starPos < 0) return null;

            // Qualified wildcard "identifier.*" — the replacement span also covers "identifier.".
            // Spec 043 follow-up (review): a bracketed or double-quoted qualifier ('[o].*', '"o".*') is sent as the name it
            // quotes and replaced from its opening bracket or quote (TryReadQualifier). The walk back used to stop inside it,
            // so the engine was asked for 'o]' and nothing expanded — and a found one would have left the '[' behind. A '.'
            // with no name before it is not a wildcard the engine can expand.
            string? qualifier = null;
            string? writtenQualifier = null;
            int spanStart = starPos;
            if (starPos >= 1 && doc[starPos - 1] == '.')
            {
                if (!TryReadQualifier(doc, starPos - 1, out var name, out var nameStart)) return null;
                qualifier = name;
                writtenQualifier = doc.Substring(nameStart, starPos - 1 - nameStart);
                spanStart = nameStart;
            }
            int spanLength = starPos - spanStart + 1;   // include the '*' itself

            var resp = await Wildcard.GetAsync(new WildcardExpansionRequest
            {
                SessionId = session.Id,
                CursorOffset = caretOffset,
                DocumentText = doc,
                Qualifier = qualifier,
            }, CancellationToken.None);

            if (resp == null || !resp.Success || resp.Tables == null || resp.Tables.Length == 0) return null;

            var columns = resp.Tables
                .SelectMany(t => (t.Columns ?? System.Array.Empty<WildcardColumn>())
                    .Select(c => (t.Qualifier, c.ColumnName)))
                .ToList();
            if (columns.Count == 0) return null;

            // Qualify the columns when the user wrote "alias.*", or when > 1 source table is expanded
            // (a bare * over a join) so the emitted list is unambiguous.
            bool useQualifier = qualifier != null
                || columns.Select(c => c.Qualifier).Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1;

            // Indent wrapped columns to the '*'s column (spaces from the line start).
            int lineStart = doc.LastIndexOf('\n', System.Math.Min(System.Math.Max(0, spanStart - 1), System.Math.Max(0, doc.Length - 1)));
            int indentChars = lineStart < 0 ? spanStart : spanStart - (lineStart + 1);
            string indent = new string(' ', System.Math.Max(0, indentChars));

            // Spec 043 follow-up (review): the columns of a qualified wildcard carry the qualifier as the user wrote it
            // ('[o].OrderID', '"o".OrderID'), so a name that needs its brackets or quotes ('[Order Lines].*') keeps them.
            // The engine's names are written as the dialect needs (WrittenName): 'Order Details'.'Order Date' came out as
            // 'Order Details.Order Date', which does not parse.
            var kind = session.State?.Kind ?? SqlConn.Kind;
            var parts = columns.Select(c => useQualifier
                ? (writtenQualifier ?? WrittenName(c.Qualifier, kind)) + "." + WrittenName(c.ColumnName, kind)
                : WrittenName(c.ColumnName, kind)).ToList();
            string text = parts.Count == 1 ? parts[0] : string.Join(",\n" + indent, parts);

            return new WildcardExpandDto { Ok = true, SpanStart = spanStart, SpanLength = spanLength, Text = text };
        }
        catch { return null; }
    }

    private static bool IsIdentifierChar(char c)
        => char.IsLetterOrDigit(c) || c == '_' || c == '$' || c == '#' || c == '@';

    /// <summary>Spec 043 follow-up (review) — a column or qualifier name from a wildcard expansion as it is written in the
    /// query. SQL Server's engine sends the names as they are (<c>Order Details</c>, <c>Order Date</c>, <c>a]b</c>): they
    /// are bracketed when they are not a regular identifier or are a reserved word (<c>[Order Details]</c>, <c>[Order]</c>,
    /// <c>[a]]b]</c>) — the rule completions use (SqlIdentifier). PostgreSQL's expander (PgWildcardExpander) already sends
    /// them written, double-quoted only where the name needs it (<c>"Order Date"</c>), so they are left as they are:
    /// quoting them again would double every quote.</summary>
    internal static string WrittenName(string? name, AkmlSql.Core.DatabaseKind kind) =>
        kind == AkmlSql.Core.DatabaseKind.PostgreSql
            ? name ?? string.Empty
            : AkmlSql.Engine.Completion.SqlIdentifier.QuoteIfNeeded(name);

    /// <summary>Spec 043 follow-up (review) — the qualifier written just before the '.' at <paramref name="dot"/> of a
    /// 'qualifier.*': a plain name (<c>o</c>), a bracketed one (<c>[o]</c>, <c>]]</c> inside it for a <c>]</c>) or a
    /// double-quoted one (<c>"o"</c>, <c>""</c> inside it for a <c>"</c>). Gives the name it stands for (unquoted and
    /// unescaped: the engine matches it against the FROM aliases and tables, and PostgreSQL reads a quoted one's case from
    /// the text) and the offset it is written from; false when no name is written there (<c>.*</c>, <c>[].*</c>, a
    /// <c>]</c> no <c>[</c> opens). A bracketed name is taken from the nearest <c>[</c>, so <c>[a[b].*</c> reads as
    /// <c>b</c>.</summary>
    internal static bool TryReadQualifier(string doc, int dot, out string name, out int start)
    {
        name = string.Empty;
        start = dot;
        if (dot < 1 || dot > doc.Length) return false;
        int close = dot - 1;
        char quote = doc[close];
        if (quote == ']' || quote == '"')
        {
            char open = quote == ']' ? '[' : '"';
            for (int i = close - 1; i >= 0; i--)
            {
                char c = doc[i];
                if (c == quote)
                {
                    if (i > 0 && doc[i - 1] == quote) { i--; continue; }   // ']]' / '""': the quote character inside the name
                    if (quote != open) return false;                      // a lone ']': no '[' opens this name
                }
                if (c != open) continue;
                if (i == close - 1) return false;                         // '[]' / '""': no name
                start = i;
                name = doc.Substring(i + 1, close - i - 1).Replace(new string(quote, 2), quote.ToString());
                return true;
            }
            return false;
        }

        int s = dot;
        while (s > 0 && IsIdentifierChar(doc[s - 1])) s--;
        if (s == dot) return false;
        start = s;
        name = doc.Substring(s, dot - s);
        return true;
    }

    // CodeMirror uses the type only for the badge's class (cm-completionIcon-{type}, styled in Pages/Editor.razor); the JS
    // editor branches on "snippet" alone.
    private static string ToCmType(int objectType) => objectType switch
    {
        (int)CompletionObjectType.Table     => "class",
        // Spec 043 follow-up (review): views and procedures get their own badges ('V', 'P') instead of sharing the table's
        // and the function's.
        (int)CompletionObjectType.View      => "view",
        (int)CompletionObjectType.Column    => "property",
        (int)CompletionObjectType.Keyword   => "keyword",
        // Spec 027 T011: a distinct CM type so akml-editor.js routes snippet items to the
        // expanding `apply` (tab-stops) rather than inserting the body literally.
        (int)CompletionObjectType.Snippet   => "snippet",
        (int)CompletionObjectType.Function  => "function",
        (int)CompletionObjectType.Procedure => "procedure",
        (int)CompletionObjectType.Schema    => "namespace",
        (int)CompletionObjectType.Database  => "namespace",
        (int)CompletionObjectType.Variable  => "variable",
        (int)CompletionObjectType.Parameter => "variable",
        _ => "text",
    };

