    private static object ToJs(EditorSettings o, AkmlSql.Core.DatabaseKind kind = AkmlSql.Core.DatabaseKind.SqlServer, string? tabId = null) =>
        new { fontSize = o.FontSize, wordWrap = o.WordWrap, tabSize = o.TabSize, fontFamily = AkmlSql.Web.Services.EditorSettings.FontName(o.FontFamily),
              dialect = AkmlSql.Core.DatabaseKindNames.ToName(kind), tabId };

    // Spec 043 (T042): the shown tab's session, read once when a request starts. The shown tab is the active one, whose
    // session is the connection service's active session.
    private (SqlSessionState? State, string Id, bool Connected) TabSession()
    {
        var state = SqlConn.ActiveSession;
        return state != null ? (state, state.SessionId, state.IsConnected) : (null, SqlConn.SessionId, SqlConn.IsConnected);
    }

    private Task SendDocumentAsync((SqlSessionState? State, string Id, bool Connected) session, string text) =>
        session.State != null
            ? SqlConn.SendDocumentAsync(session.State, text, CancellationToken.None)
            : SqlConn.SendDocumentAsync(text, CancellationToken.None);

    private void OnEditorSettingsChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed || _module == null) return;
        try { await _module.InvokeVoidAsync("setEditorOptions", HostId, ToJs(await EditorSettings.GetAsync())); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        EditorSettings.Changed -= OnEditorSettingsChanged;
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("dispose", HostId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* browser tab closing -- ignore */ }
        finally
        {
            _selfRef?.Dispose();
        }
    }
