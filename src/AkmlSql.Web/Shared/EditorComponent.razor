    public async Task<string> GetTextAsync()
    {
        if (_module == null) return InitialText;
        return await _module.InvokeAsync<string>("getText", HostId);
    }

    /// <summary>Spec 028 (M6) — the current editor selection (empty when nothing is selected).
    /// The editor's AI dock feeds this to the action panel so Explain / Fix / Optimize operate
    /// on the selection, falling back to the whole document when empty.</summary>
    public async Task<string> GetSelectedTextAsync()
    {
        if (_module == null) return string.Empty;
        return await _module.InvokeAsync<string>("getSelectedText", HostId);
    }

    /// <summary>Spec 041 (R24) — the selected text and the document line it starts on (1 when the selection
    /// is empty or only whitespace, which runs the whole document).</summary>
    public async Task<EditorSelectionInfo> GetSelectionInfoAsync()
    {
        if (_module == null) return new EditorSelectionInfo(string.Empty, 1);
        var info = await _module.InvokeAsync<EditorSelectionInfo?>("getSelectionInfo", HostId);
        return info ?? new EditorSelectionInfo(string.Empty, 1);
    }

    public async Task SetTextAsync(string text)
    {
        if (_module == null) { InitialText = text; return; }
        // Spec 041: what was applied, so a page that keeps InitialText in step does not push it twice.
        _appliedInitialText = text;
        await _module.InvokeVoidAsync("setText", HostId, text);
    }

    /// <summary>
    /// Review WEB-10: replace the document with <paramref name="text"/> only if it still reads <paramref name="expected"/>, as one
    /// undoable change; false (nothing changed) when it was edited or replaced in the meantime.
    /// </summary>
    public async Task<bool> ReplaceTextIfUnchangedAsync(string expected, string text)
    {
        if (_module == null)
        {
            if (!string.Equals(InitialText, expected, StringComparison.Ordinal)) return false;
            InitialText = text;
            return true;
        }
        if (!await _module.InvokeAsync<bool>("replaceTextIfUnchanged", HostId, expected, text)) return false;
        _appliedInitialText = text;
        return true;
    }

    public async Task SetSelectionAsync(int anchor, int head)
