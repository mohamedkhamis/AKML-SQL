    /// <summary>Spec 043: replace query tab <paramref name="tabId"/>'s text; a tab that is not shown changes without a text
    /// report (the page keeps that tab's text itself).</summary>
    public async Task SetTextAsync(string text, string? tabId)
    {
        if (IsShown(tabId)) { await SetTextAsync(text); return; }
        // Never shown yet: the page seeds it with its own text on the first switch, so nothing is sent now.
        if (_module == null || !IsKept(tabId!)) return;
        await _module.InvokeVoidAsync("setText", HostId, text, tabId);
    }

    public async Task SetTextAsync(string text)
    {
        if (_module == null)
        {
            if (_pendingSeed is { } seed) _pendingSeed = (text, seed.Kind);
            else InitialText = text;
            return;
        }
        // Spec 041: what was applied, so a page that keeps InitialText in step does not push it twice.
        _appliedInitialText = text;
        await _module.InvokeVoidAsync("setText", HostId, text);
    }

    /// <summary>
    /// Review WEB-10: replace the document with <paramref name="text"/> only if it still reads <paramref name="expected"/>, as one
    /// undoable change; false (nothing changed) when it was edited or replaced in the meantime.
    /// </summary>
    /// <summary>Spec 043: <see cref="ReplaceTextIfUnchangedAsync(string, string)"/> on query tab <paramref name="tabId"/> — a
    /// Format reply for a tab the user left meanwhile lands in that tab, never in the one now shown.</summary>
    public async Task<bool> ReplaceTextIfUnchangedAsync(string expected, string text, string? tabId)
    {
        if (IsShown(tabId)) return await ReplaceTextIfUnchangedAsync(expected, text);
        if (_module == null || !IsKept(tabId!)) return false;
        return await _module.InvokeAsync<bool>("replaceTextIfUnchanged", HostId, expected, text, tabId);
    }

    public async Task<bool> ReplaceTextIfUnchangedAsync(string expected, string text)
    {
        if (_module == null)
        {
            if (_pendingSeed is { } seed)
            {
                if (!string.Equals(seed.Text, expected, StringComparison.Ordinal)) return false;
                _pendingSeed = (text, seed.Kind);
                return true;
            }
            if (!string.Equals(InitialText, expected, StringComparison.Ordinal)) return false;
            InitialText = text;
            return true;
        }
        if (!await _module.InvokeAsync<bool>("replaceTextIfUnchanged", HostId, expected, text)) return false;
        _appliedInitialText = text;
        return true;
    }

