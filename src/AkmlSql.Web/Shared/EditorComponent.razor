    /// <summary>Spec 027 (M5 offline closure) T025 — append <paramref name="text"/> at the end
    /// of <paramref name="lineNumber"/> (1-based). Used by the suppression "this line" action
    /// to insert <c>-- akml-disable-line RuleId</c> at the finding's line. Returns the updated full text.</summary>
    public async Task<string> InsertAtLineEndAsync(int lineNumber, string text)
    {
        if (_module == null) return InitialText;
        await _module.InvokeVoidAsync("insertAtLineEnd", HostId, lineNumber, text);
        return await _module.InvokeAsync<string>("getText", HostId);
    }

    private static object ToJs(EditorSettings o, AkmlSql.Core.DatabaseKind kind = AkmlSql.Core.DatabaseKind.SqlServer) =>
        new { fontSize = o.FontSize, wordWrap = o.WordWrap, tabSize = o.TabSize, dialect = AkmlSql.Core.DatabaseKindNames.ToName(kind) };

    private void OnEditorSettingsChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed || _module == null) return;
        try { await _module.InvokeVoidAsync("setEditorOptions", HostId, ToJs(await EditorSettings.GetAsync())); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        EditorSettings.Changed -= OnEditorSettingsChanged;
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("dispose", HostId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* browser tab closing -- ignore */ }
        finally
        {
            _selfRef?.Dispose();
        }
    }
}
