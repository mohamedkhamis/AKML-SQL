@page "/history"
@*
    Spec 030 — web SQL HistorySvc. Ports the desktop SQL History tool window to the web edition,
    reusing the engine's history IPC (HistoryRecord=40 / HistorySearch=41 / HistoryAction=42) over
    the bridge against the shared per-user store. Online-only (history needs the engine paired).
*@
@using System.Globalization
@using System.Linq
@using System.Text
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Core.Models.History
@using AkmlSql.Web.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IHistoryService HistorySvc
@inject IEngineBridge Bridge
@inject ISqlConnectionService SqlConn
@inject IThemeService Theme
@inject IDiagnosticsRingBuffer Diagnostics
@inject IEditorSessionStore SessionStore
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject EditorDocumentFlow Document
@inject INotificationService Notifications
@inject IServiceProvider Services

<PageTitle>SQL History — AKML SQL</PageTitle>

<div class="akml-page akml-hist">
    @* Spec 041 (T203, FR-085): the one page header. *@
    <div class="akml-page-header akml-hist-header" data-testid="page-header">
        <h1 class="akml-page-title" data-testid="page-title">SQL History</h1>
        <span class="akml-page-spacer"></span>
        <div class="akml-page-actions" data-testid="page-actions">
            <button type="button" class="akml-btn" @onclick="@(() => LoadAsync(true))" title="Refresh"><Icon Name="refresh-cw" /><span>Refresh</span></button>
            <select class="akml-select" value="" @onchange="OnExportChanged" title="Export visible entries" aria-label="Export visible entries">
                <option value="">Export…</option>
                <option value="csv">CSV</option>
                <option value="json">JSON</option>
                <option value="sql">SQL</option>
            </select>
        </div>
    </div>
    <!-- Top bar: search + filters -->
    <div class="akml-hist-top">
        <input class="akml-hist-search" placeholder="@(ShowKinds ? "Search SQL history…  (server: db: name: kind: starred:)" : "Search SQL history…  (server: db: name: starred:)")"
               value="@_search" @oninput="OnSearchInput"
               @onkeydown="OnSearchKey" data-testid="history-search" />
        <button class="akml-btn akml-hist-fav @(_favoritesOnly ? "is-active" : null)" title="Favorites only"
                aria-pressed="@(_favoritesOnly ? "true" : "false")"
                @onclick="ToggleFavoritesFilter" data-testid="history-fav-filter" aria-label="Favorites only"><Icon Name="star" /></button>
        <select class="akml-hist-select" value="@(_server ?? "")" @onchange="OnServerChanged" title="Server">
            <option value="">All servers</option>
            @foreach (var s in _servers) { <option value="@s">@s</option> }
        </select>
        <select class="akml-hist-select" value="@(_database ?? "")" @onchange="OnDatabaseChanged" title="Database">
            <option value="">All databases</option>
            @foreach (var d in _databases) { <option value="@d">@d</option> }
        </select>
        @if (ShowKinds)
        {
            @* Spec 042 (FR-070): only entries of one kind; the search box takes kind:pg / kind:mssql for the same. *@
            <select class="akml-hist-select" value="@(_kind?.ToString() ?? "")" @onchange="OnKindChanged" title="Kind of server"
                    aria-label="Kind of server" data-testid="history-kind-filter">
                <option value="">All kinds</option>
                <option value="0">SQL Server</option>
                <option value="1">PostgreSQL</option>
            </select>
        }
        @if (_compare.Count == 2)
        {
            <button class="akml-btn" @onclick="OpenCompareAsync" data-testid="history-compare">Compare (2)</button>
        }
    </div>

    @if (!HistorySvc.IsAvailable)
    {
        @* Spec 041 (T205, FR-088): what is missing and the two ways forward. *@
        <div class="akml-empty akml-hist-empty" data-testid="history-unavailable">
            <p class="akml-empty-title">SQL History needs a connected engine</p>
            <p>The engine keeps the history SSMS and the web edition share. Pair one, or retry if it is starting.</p>
            <div class="akml-page-actions">
                <button type="button" class="akml-btn" data-testid="history-retry" @onclick="@(() => LoadAsync(true))">Retry</button>
                <a class="akml-btn" href="settings/connections" data-testid="history-setup">Set up engine</a>
            </div>
        </div>
    }
    else
    {
        <div class="akml-hist-body">
            <!-- LEFT: master list (top) + version sub-panel (bottom) -->
            <div class="akml-hist-left">
                @* Review WEB-13: every action is a native control. Arrow keys, Home and End move between the group headers and
                   the entries (one tab stop: the current one, then its favorite and compare controls); Enter or Space selects
                   an entry or folds a group. A click anywhere on a row still selects it. *@
                <div class="akml-hist-list" data-testid="history-list" role="group" aria-label="History entries" @onkeydown="OnListKeyDownAsync" @ref="_listRef">
                    @{ string? lastBucket = null; var stopKey = CurrentStop; }
                    @foreach (var e in _entries)
                    {
                        var rv = RowFor(e);
                        var bucket = rv.Bucket;
                        if (bucket != lastBucket)
                        {
                            lastBucket = bucket;
                            var b = bucket;
                            var groupKey = GroupStop(b);
                            <button type="button" class="akml-hist-group" id="@StopId(groupKey)" data-testid="history-group"
                                    aria-expanded="@(_collapsed.Contains(b) ? "false" : "true")" tabindex="@(stopKey == groupKey ? 0 : -1)"
                                    @onfocus="@(() => _focusStop = groupKey)" @onclick="@(() => ToggleBucket(b))">
                                <span class="akml-hist-chevron"><Icon Name="@(_collapsed.Contains(b) ? "chevron-right" : "chevron-down")" Size="12" /></span>
                                <span>@b</span>
                            </button>
                        }
                        if (!_collapsed.Contains(bucket))
                        {
                            var entry = e;
                            var rowKey = RowStop(e.Id);
                            var current = stopKey == rowKey;
                            <div class="akml-list-row akml-hist-row @(_selected?.Id == e.Id ? "is-selected" : null)" data-testid="history-row"
                                 @onclick="@(() => SelectAsync(entry))">
                                <button type="button" class="akml-hist-star @(e.IsFavorite ? "on" : "")" title="Toggle favorite" data-testid="history-row-favorite"
                                        aria-pressed="@(e.IsFavorite ? "true" : "false")" aria-label="Favorite" tabindex="@(current ? 0 : -1)"
                                        @onclick="@(() => ToggleFavoriteAsync(entry))" @onclick:stopPropagation="true">
                                    <Icon Name="star" Size="14" />
                                </button>
                                <button type="button" class="akml-hist-rowmain" id="@StopId(rowKey)" data-testid="history-row-select"
                                        aria-current="@(_selected?.Id == e.Id ? "true" : null)" tabindex="@(current ? 0 : -1)"
                                        @onfocus="@(() => _focusStop = rowKey)">
                                    <span class="akml-hist-name">@rv.DisplayName</span>
                                    <span class="akml-hist-meta">
                                        @if (ShowKinds)
                                        {
                                            <span class="akml-hist-kind" data-testid="history-kind"
                                                  data-kind="@AkmlSql.Core.DatabaseKindNames.ToName(AkmlSql.Core.DatabaseKindNames.FromInt(e.Kind))">@WebHistoryLogic.KindLabel(e.Kind)</span>
                                        }
                                        <span>@rv.RelativeTime</span>
                                        @if (!string.IsNullOrEmpty(rv.Meta)) { <span class="akml-hist-count"> · @rv.Meta</span> }
                                        <span class="akml-hist-conn">
                                            <span class="akml-hist-dot @(e.IsOpen ? "is-open" : "is-closed")" title="@(e.IsOpen ? "Open" : "Closed")"></span>
                                            @rv.ServerDb
                                        </span>
                                    </span>
                                </button>
                                <input type="checkbox" class="akml-hist-cmp" title="Select for compare" aria-label="Select for compare"
                                       checked="@_compare.Contains(e.Id)" tabindex="@(current ? 0 : -1)"
                                       @onclick:stopPropagation="true"
                                       @onchange="@(args => ToggleCompare(entry, args))" />
                            </div>
                        }
                    }
                    @if (_entries.Count == 0 && _loading)
                    {
                        <div class="akml-empty" data-testid="history-loading" role="status">
                            <Icon Name="loader-circle" Class="akml-spin" /><span>Loading history…</span>
                        </div>
                    }
                    else if (_entries.Count == 0)
                    {
                        <div class="akml-empty" data-testid="history-empty">
                            @if (IsFiltered)
                            {
                                <span>No history entries match the search or filters.</span>
                            }
                            else
                            {
                                <span>No history yet. Run a query in the editor (F5) and it appears here.</span>
                            }
                        </div>
                    }
                    @if (_entries.Count < _total)
                    {
                        <button class="akml-btn akml-hist-more" @onclick="@(() => LoadAsync(false))">
                            Load more (@(_total - _entries.Count) more)
                        </button>
                    }
                </div>

                <div class="akml-hist-versions">
                    <div class="akml-hist-vhdr">@(_selected == null ? "HISTORY" : $"History for {RowFor(_selected).DisplayName}")</div>
                    <div class="akml-hist-vlist">
                        @for (int i = 0; i < _versions.Length; i++)
                        {
                            var idx = i;
                            var vnum = _versions.Length - i;
                            <button type="button" class="akml-hist-vrow @(_selectedVersion == idx ? "selected" : "")" data-testid="history-version"
                                    aria-pressed="@(_selectedVersion == idx || (_selectedVersion < 0 && idx == 0) ? "true" : "false")"
                                    @onclick="@(() => SelectVersion(idx))">
                                <span class="akml-hist-vlabel">v@(vnum)@(i == 0 ? " (current)" : "")</span>
                                <span class="akml-hist-vtime">@VersionTime(_versions[idx].SavedAt)</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT: preview + metadata + actions -->
            <div class="akml-hist-right">
                <div class="akml-hist-phdr">
                    <span class="akml-hist-pname">@(_selected == null ? "Preview" : RowFor(_selected).DisplayName)</span>
                    <span class="akml-hist-ptime">@(_selected == null ? "" : AbsTime(_selected.ExecutedAt))</span>
                </div>
                <pre class="akml-hist-preview" data-testid="history-preview" aria-busy="@(_detailLoading ? "true" : null)">@if (_selected != null && !_detailLoading)
{
    foreach (var seg in _previewSegments)
    {<span class="@SegClass(seg)">@seg.Text</span>}
}</pre>
                <div class="akml-hist-meta-bar">
                    @if (_selected != null)
                    {
                        <span class="akml-hist-dot is-open"></span>
                        <span class="akml-hist-mtext">@(_selected.Server)@(string.IsNullOrEmpty(_selected.Database) ? "" : " · " + _selected.Database)</span>
                        @if (_versions.Length > 0)
                        {
                            <span class="akml-hist-mtext"> · v@(_versions.Length - (_selectedVersion < 0 ? 0 : _selectedVersion)) of @_versions.Length</span>
                        }
                    }
                    <span class="akml-hist-spacer"></span>
                    @if (_selected != null)
                    {
                        <button class="akml-btn" @onclick="CopySqlAsync" disabled="@_detailLoading" title="@DetailWait" data-testid="history-copy">Copy</button>
                        <button class="akml-btn" @onclick="@(() => RenameAsync(_selected))" data-testid="history-rename">Rename</button>
                        <button class="akml-btn" @onclick="@(() => DeleteAsync(_selected))" data-testid="history-delete">Delete</button>
                        <button class="akml-btn" @onclick="@(() => RemoveOlderAsync(_selected))" data-testid="history-remove-older">Remove older</button>
                        <button class="akml-btn" @onclick="ReExecuteAsync" disabled="@_detailLoading" title="@DetailWait" data-testid="history-reexecute">Re-execute</button>
                        <button class="akml-btn akml-btn--primary" @onclick="OpenInEditorAsync" disabled="@_detailLoading" title="@DetailWait" data-testid="history-open">Open</button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Status strip -->
    <div class="akml-hist-status">
        <span>@_total entries</span>
        <span class="akml-hist-spacer"></span>
        @if (_loading) { <span class="akml-hist-loading">Loading…</span> }
    </div>
</div>

@if (_compareOpen)
{
    @* Spec 041 (R59): the shared scrim and dialog, as every other modal; Escape and the scrim close it. *@
    <div class="akml-scrim" @onclick="CloseCompare">
        <div class="akml-dialog akml-dialog--wide akml-hist-compare" role="dialog" aria-modal="true" aria-labelledby="akml-hist-compare-title"
             data-testid="history-compare-dialog" tabindex="-1" @onclick:stopPropagation="true" @onkeydown="OnCompareKeyDown">
            <div class="akml-dialog-header">
                <h2 class="akml-dialog-title" id="akml-hist-compare-title">Compare</h2>
            </div>
            <div class="akml-dialog-body akml-hist-compare-body">
                <pre class="akml-hist-preview">@_diffLeft</pre>
                <pre class="akml-hist-preview">@_diffRight</pre>
            </div>
            <div class="akml-dialog-footer">
                <button type="button" class="akml-btn" @onclick="CloseCompare" data-testid="history-compare-close">Close</button>
            </div>
        </div>
    </div>
}

<style>
    .akml-hist { display: flex; flex-direction: column; height: 100%;
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        color: var(--akml-text-primary); background-color: var(--akml-surface-canvas); }
    .akml-hist-top { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-m);
        background-color: var(--akml-surface-panel); border-bottom: 1px solid var(--akml-border-default); }
    .akml-hist-search { flex: 1 1 auto; min-width: 120px; background-color: var(--akml-surface-input);
        color: var(--akml-text-primary); border: 1px solid var(--akml-border-default);
        border-radius: var(--akml-scalar-radius-xs); padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); }
    .akml-hist-select { background-color: var(--akml-surface-input); color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default); border-radius: var(--akml-scalar-radius-xs);
        padding: 2px var(--akml-scalar-spacing-xs); }
    .akml-hist-spacer { flex: 1 1 auto; }
    .akml-hist-header { padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-m) var(--akml-scalar-spacing-xs); }
    .akml-hist-body { flex: 1 1 auto; display: grid; grid-template-columns: 42% 1fr; min-height: 0; }
    .akml-hist-left { display: grid; grid-template-rows: 1fr auto; min-height: 0;
        border-right: 1px solid var(--akml-border-default); }
    .akml-hist-list { overflow: auto; background-color: var(--akml-surface-panel); }
    .akml-hist-group, .akml-hist-star, .akml-hist-rowmain, .akml-hist-vrow {
        font: inherit; color: inherit; background: none; border: 0; margin: 0; text-align: left; }
    .akml-hist-group:focus-visible, .akml-hist-star:focus-visible, .akml-hist-rowmain:focus-visible, .akml-hist-vrow:focus-visible {
        outline: 2px solid var(--akml-border-focus); outline-offset: -2px; }
    .akml-hist-group { width: 100%; display: flex; align-items: center; gap: var(--akml-scalar-spacing-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer;
        color: var(--akml-text-secondary); font-size: 11px; font-weight: var(--akml-type-chrome-weight);
        text-transform: uppercase; border-bottom: 1px solid var(--akml-border-subtle); }
    .akml-hist-chevron { width: 12px; display: inline-block; }
    .akml-hist-row { display: flex; align-items: center; gap: var(--akml-scalar-spacing-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer;
        border-left: 3px solid transparent; border-bottom: 1px solid var(--akml-border-subtle); }
    .akml-hist-star { cursor: pointer; color: var(--akml-text-disabled); font-size: 14px; width: 16px; padding: 0; text-align: center; }
    .akml-hist-star.on { color: var(--akml-history-star-active, var(--akml-status-warning)); }
    .akml-hist-star.on .akml-icon, .akml-hist-fav.is-active .akml-icon { fill: currentColor; }
    .akml-hist-rowmain { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; padding: 0; cursor: pointer; }
    .akml-hist-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        color: var(--akml-text-primary); font-weight: var(--akml-type-chrome-weight); }
    .akml-hist-meta { display: flex; gap: 4px; align-items: center; color: var(--akml-text-secondary);
        font-size: 11px; overflow: hidden; }
    .akml-hist-kind {
        flex: none; padding: 0 var(--akml-scalar-spacing-xs); border: 1px solid var(--akml-border-subtle);
        border-radius: var(--akml-scalar-radius-xs); font-size: 10px; line-height: 1.4; color: var(--akml-text-secondary);
        white-space: nowrap;
    }
    .akml-hist-kind[data-kind="postgresql"] { color: var(--akml-text-primary); border-color: var(--akml-border-strong); }
    .akml-hist-conn { margin-left: auto; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .akml-hist-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
    .akml-hist-dot.is-open { background-color: var(--akml-status-success); }
    .akml-hist-dot.is-closed { background-color: var(--akml-status-danger); }
    .akml-hist-count { font-style: italic; }
    .akml-hist-cmp { flex: 0 0 auto; }
    .akml-hist-more { margin: var(--akml-scalar-spacing-s); }
    .akml-hist-versions { border-top: 1px solid var(--akml-border-default); display: flex; flex-direction: column;
        max-height: 38%; background-color: var(--akml-surface-panel); }
    .akml-hist-vhdr { padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        color: var(--akml-text-secondary); font-size: 11px; font-weight: var(--akml-type-chrome-weight);
        text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .akml-hist-vlist { overflow: auto; }
    .akml-hist-vrow { width: 100%; display: flex; justify-content: space-between; cursor: pointer;
        padding: 2px var(--akml-scalar-spacing-s); }
    .akml-hist-vrow:hover { background-color: var(--akml-surface-hover); }
    .akml-hist-vrow.selected { background-color: var(--akml-surface-selection); }
    .akml-hist-vlabel { color: var(--akml-text-link); }
    .akml-hist-vtime { color: var(--akml-text-secondary); font-size: 11px; }
    .akml-hist-right { display: flex; flex-direction: column; min-height: 0;
        background-color: var(--akml-editor-popupbackground); }
    .akml-hist-phdr { display: flex; justify-content: space-between; align-items: center;
        padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-m);
        background-color: var(--akml-surface-elevated); border-bottom: 1px solid var(--akml-border-default); }
    .akml-hist-pname { font-weight: var(--akml-type-chrome-weight); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .akml-hist-ptime { color: var(--akml-text-secondary); font-size: 11px; }
    .akml-hist-preview { flex: 1 1 auto; margin: 0; overflow: auto; white-space: pre-wrap;
        padding: var(--akml-scalar-spacing-m); font-family: var(--akml-type-editor-family);
        font-size: var(--akml-type-editor-size); color: var(--akml-text-primary);
        background-color: var(--akml-editor-popupbackground); }
    .akml-hist-preview .tok-keyword { color: var(--akml-accent-primary); }
    .akml-hist-preview .tok-string { color: var(--akml-status-success); }
    .akml-hist-preview .tok-comment { color: var(--akml-text-secondary); font-style: italic; }
    .akml-hist-preview .hit { background-color: var(--akml-history-matchhighlight); }
    .akml-hist-meta-bar { display: flex; align-items: center; gap: var(--akml-scalar-spacing-xs);
        padding: var(--akml-scalar-spacing-s) var(--akml-scalar-spacing-m);
        border-top: 1px solid var(--akml-border-default); background-color: var(--akml-surface-elevated); }
    .akml-hist-mtext { color: var(--akml-text-secondary); font-size: 11px; }
    .akml-hist-status { display: flex; align-items: center; padding: 2px var(--akml-scalar-spacing-m);
        color: var(--akml-text-secondary); font-size: 11px; border-top: 1px solid var(--akml-border-default); }
    .akml-hist-loading { font-style: italic; }
    .akml-hist-empty { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center;
        justify-content: center; gap: var(--akml-scalar-spacing-s); color: var(--akml-text-secondary); }
    .akml-hist-compare { height: 70vh; display: flex; flex-direction: column; }
    .akml-hist-compare-body { flex: 1 1 auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--akml-scalar-spacing-s); min-height: 0; }
    .akml-hist-compare-body .akml-hist-preview { margin: 0; overflow: auto; }
    .akml-hist-fav.is-active { color: var(--akml-status-warning); }
</style>

@code {
    private const int PageSize = 100;

    private readonly List<HistoryEntryDto> _entries = new();
    private HistoryEntryDto? _selected;
    private string _previewSql = string.Empty;
    private HistoryVersionDto[] _versions = Array.Empty<HistoryVersionDto>();
    private int _selectedVersion = -1;   // -1 == current (the entry itself / newest version)

    // Per-entry derived display values computed once per load (keyed by entry id) so the render tree
    // never re-runs the regex/date/relative-time work per row per render. See RebuildRowViews.
    private readonly Dictionary<long, RowView> _rowViews = new();
    private sealed record RowView(string DisplayName, string Meta, string Bucket, string RelativeTime, string ServerDb);

    // Cached preview segments — recomputed only when _previewSql or _search changes (SelectAsync,
    // SelectVersion, ClearDetail, OnSearchInput), never inside the render tree.
    private IReadOnlyList<HistoryPreviewHighlighter.Segment> _previewSegments =
        Array.Empty<HistoryPreviewHighlighter.Segment>();

    private string _search = string.Empty;
    private bool _favoritesOnly;
    private string? _server;
    private string? _database;
    private int? _kind;   // spec 042 (FR-070): the kind filter control; a kind: term in the search box overrides it
    private IReadOnlyList<string> _servers = Array.Empty<string>();
    private IReadOnlyList<string> _databases = Array.Empty<string>();

    private int _total;
    private bool _loading;

    private readonly HashSet<string> _collapsed = new();
    private readonly List<long> _compare = new();   // up to 2 ids selected for compare
    private bool _compareOpen;
    private string _diffLeft = string.Empty;
    private string _diffRight = string.Empty;

    private IJSObjectReference? _downloadModule;
    private IJSObjectReference? _ui;

    // Review WEB-17: every search gets a number; only the latest one's rows are shown, and a Load more page belongs to the
    // search it was asked for.
    private int _loadGeneration;

    // Review WEB-16: every selection gets a number; its SQL and versions are shown together, and only while it is still the
    // selection. Until they arrive the preview is empty and the actions that use it wait.
    private int _detailRequest;
    private bool _detailLoading;

    private string? DetailWait => _detailLoading ? "Wait for the entry to load" : null;

    // Review WEB-13: the list's one tab stop — a group header ("g:<bucket>") or an entry ("r:<id>") — moved by the arrow keys.
    private ElementReference _listRef;
    private string? _focusStop;
    private string? _focusAfterRender;
    private string? _trappedListId;

    private static string GroupStop(string bucket) => "g:" + bucket;
    private static string RowStop(long id) => "r:" + id.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private static string StopId(string key) => "akml-hist-stop-" + Convert.ToHexString(System.Text.Encoding.UTF8.GetBytes(key));

    /// <summary>The group headers and visible entries in list order.</summary>
    private List<string> Stops()
    {
        var stops = new List<string>();
        string? last = null;
        foreach (var e in _entries)
        {
            var bucket = RowFor(e).Bucket;
            if (bucket != last) { last = bucket; stops.Add(GroupStop(bucket)); }
            if (!_collapsed.Contains(bucket)) stops.Add(RowStop(e.Id));
        }
        return stops;
    }

    /// <summary>The stop that takes Tab: the focused one, else the selected entry, else the first.</summary>
    private string? CurrentStop
    {
        get
        {
            var stops = Stops();
            if (_focusStop != null && stops.Contains(_focusStop)) return _focusStop;
            if (_selected != null && stops.Contains(RowStop(_selected.Id))) return RowStop(_selected.Id);
            return stops.Count > 0 ? stops[0] : null;
        }
    }

    private async Task OnListKeyDownAsync(KeyboardEventArgs e)
    {
        var stops = Stops();
        if (stops.Count == 0) return;
        int at = Math.Max(0, CurrentStop is { } c ? stops.IndexOf(c) : 0);
        int next = e.Key switch
        {
            "ArrowDown" => Math.Min(stops.Count - 1, at + 1),
            "ArrowUp" => Math.Max(0, at - 1),
            "Home" => 0,
            "End" => stops.Count - 1,
            _ => -1,
        };
        if (next < 0) return;
        _focusStop = stops[next];
        _focusAfterRender = StopId(stops[next]);
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The list exists only once the engine answers; trap its keys (Arrow scrolling, Home/End jumping) once per element.
        if (!string.IsNullOrEmpty(_listRef.Id) && _listRef.Id != _trappedListId)
        {
            _trappedListId = _listRef.Id;
            try
            {
                _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
                await _ui.InvokeVoidAsync("trapListKeys", _listRef);
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        if (_focusAfterRender is { } id && _ui != null)
        {
            _focusAfterRender = null;
            try { await _ui.InvokeVoidAsync("focusById", id); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Theme.InitializeAsync();
        SqlConn.StateChanged += OnConnChanged;
        Bridge.StateChanged += OnBridgeStateChanged;
        await LoadAsync(true);
    }

    private void OnConnChanged() => InvokeAsync(StateHasChanged);

    // The bridge handshake usually completes AFTER this page's initial load, so the first
    // LoadAsync runs while not-yet-available. Reload once the bridge reaches Open so history
    // appears without a manual Retry; on disconnect, re-render to show the not-connected state.
    private void OnBridgeStateChanged(BridgeState state) =>
        InvokeAsync(async () =>
        {
            if (state == BridgeState.Open) await LoadAsync(true);
            else StateHasChanged();
        });

    private async Task LoadAsync(bool reset)
    {
        // Review WEB-17: a new search (or filter) replaces one still loading — it used to be dropped, leaving the old
        // search's rows under the new controls. Load more waits for the current load instead of mixing pages.
        if (_loading && !reset) return;
        int generation = ++_loadGeneration;
        _loading = true;
        StateHasChanged();
        try
        {
            // Spec 042 (FR-070): a kind: term is a filter, not words for the full-text index.
            var parsed = WebHistoryLogic.ParseSearch(_search);
            var request = new HistorySearchRequest
            {
                SearchText = parsed.Text,
                Kind = parsed.Kind ?? _kind,
                Server = _server,
                Database = _database,
                FavoritesOnly = _favoritesOnly,
                Deduplicate = true,
                Offset = reset ? 0 : _entries.Count,
                Limit = PageSize,
            };
            var resp = await HistorySvc.SearchAsync(request, CancellationToken.None);
            if (generation != _loadGeneration) return;   // superseded: a later search owns the list
            if (reset)
            {
                // A reset/filter reload REPLACES the result set; drop the cached row views too so a
                // renamed/changed entry can't keep a stale view (RebuildRowViews only builds ids it
                // hasn't seen). Load-more (reset:false) keeps the cache so prior pages aren't rebuilt.
                _entries.Clear();
                _rowViews.Clear();
            }
            if (resp.Entries != null) _entries.AddRange(resp.Entries);
            _total = resp.TotalCount;
            (_servers, _databases) = WebHistoryLogic.DeriveSources(_entries);
            RebuildRowViews();

            // Keep the selection if it is still present; otherwise clear the detail panes.
            if (_selected != null && _entries.All(e => e.Id != _selected.Id)) ClearDetail();
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task SelectAsync(HistoryEntryDto entry)
    {
        // Review WEB-16: the heading changes at once, so the preview and the versions must too — never the previous entry's
        // SQL under this entry's name, where Open or Re-execute would use it.
        int request = ++_detailRequest;
        _selected = entry;
        _focusStop = RowStop(entry.Id);
        _selectedVersion = -1;
        _previewSql = string.Empty;
        _versions = Array.Empty<HistoryVersionDto>();
        _detailLoading = true;
        RecomputePreviewSegments();
        StateHasChanged();

        string sql;
        HistoryVersionDto[] versions;
        try
        {
            sql = await HistorySvc.GetFullSqlAsync(entry.Id, CancellationToken.None) ?? entry.SqlText ?? string.Empty;
            versions = await HistorySvc.GetVersionsAsync(entry.Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            if (request != _detailRequest) return;
            Diagnostics.Log(DiagnosticLevel.Warn, "history", $"Entry details failed: {ex.GetType().Name}");
            sql = entry.SqlText ?? string.Empty;
            versions = Array.Empty<HistoryVersionDto>();
        }
        if (request != _detailRequest) return;   // another entry was selected (or the selection went) meanwhile

        _previewSql = sql;
        _versions = versions;
        _detailLoading = false;
        RecomputePreviewSegments();
        StateHasChanged();
    }

    private void SelectVersion(int idx)
    {
        if (idx < 0 || idx >= _versions.Length) return;
        _selectedVersion = idx;
        _previewSql = _versions[idx].SqlText ?? string.Empty;
        RecomputePreviewSegments();
    }

    private void ClearDetail()
    {
        _detailRequest++;           // a details load still on its way belongs to nothing now
        _detailLoading = false;
        _selected = null;
        _previewSql = string.Empty;
        _versions = Array.Empty<HistoryVersionDto>();
        _selectedVersion = -1;
        RecomputePreviewSegments();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        RecomputePreviewSegments();   // highlight terms changed → refresh the cached preview segments
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync(true);
    }

    private async Task ToggleFavoritesFilter()
    {
        _favoritesOnly = !_favoritesOnly;
        await LoadAsync(true);
    }

    private async Task OnServerChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _server = string.IsNullOrEmpty(v) ? null : v;
        await LoadAsync(true);
    }

    private async Task OnDatabaseChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _database = string.IsNullOrEmpty(v) ? null : v;
        await LoadAsync(true);
    }

    private async Task OnKindChanged(ChangeEventArgs e)
    {
        _kind = int.TryParse(e.Value?.ToString(), out var kind) ? kind : null;
        await LoadAsync(true);
    }

    /// <summary>
    /// Spec 042 (FR-070): the kind badge, the kind filter and the kind: hint appear once PostgreSQL can be involved - the engine
    /// supports it, an entry already is one, or a kind filter is on. Otherwise the page is the page it was.
    /// </summary>
    private bool ShowKinds => SqlConn.EngineSupportsPostgres || _kind != null || _entries.Any(e => e.Kind != 0);

    private void ToggleBucket(string bucket)
    {
        if (!_collapsed.Remove(bucket)) _collapsed.Add(bucket);
    }

    private async Task ToggleFavoriteAsync(HistoryEntryDto entry)
    {
        await HistorySvc.ToggleFavoriteAsync(entry.Id, CancellationToken.None);
        await LoadAsync(true);
    }

    private void ToggleCompare(HistoryEntryDto entry, ChangeEventArgs args)
    {
        var on = args.Value is bool b && b;
        if (on)
        {
            if (!_compare.Contains(entry.Id))
            {
                if (_compare.Count == 2) _compare.RemoveAt(0);   // keep the two most recent picks
                _compare.Add(entry.Id);
            }
        }
        else
        {
            _compare.Remove(entry.Id);
        }
    }

    private async Task OpenCompareAsync()
    {
        if (_compare.Count != 2) return;
        var diff = await HistorySvc.GetDiffAsync(_compare[0], _compare[1], CancellationToken.None);
        if (diff == null) { Notifications.Notify("Compare failed.", NotificationKind.Error); return; }
        _diffLeft = diff.Value.left;
        _diffRight = diff.Value.right;
        _compareOpen = true;
    }

    private void CloseCompare() => _compareOpen = false;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search) || _favoritesOnly || _server != null || _database != null || _kind != null;

    private void OnCompareKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseCompare();
    }

    private async Task RenameAsync(HistoryEntryDto entry)
    {
        var current = entry.TabTitle ?? string.Empty;
        var name = await Dialogs.PromptAsync(new PromptRequest
        {
            Title = "Rename history entry",
            Label = "Name",
            InitialValue = current,
            ConfirmLabel = "Rename",
            Validate = value => string.IsNullOrWhiteSpace(value) ? "Enter a name." : null,
        });
        if (string.IsNullOrWhiteSpace(name) || name == current) return;
        if (await HistorySvc.RenameAsync(entry.Id, name.Trim(), CancellationToken.None))
        {
            // Mirror the desktop (HistoryToolWindowControl: entry.TabTitle = newName) so the right-pane
            // header (DisplayNameFor(_selected)) updates immediately — _selected is this same reference.
            entry.TabTitle = name.Trim();
            await LoadAsync(true);
        }
    }

    private async Task DeleteAsync(HistoryEntryDto entry)
    {
        if (!await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Delete history entry",
            Message = $"Delete “{RowFor(entry).DisplayName}” from SQL History? This cannot be undone.",
            ConfirmLabel = "Delete",
            Destructive = true,
        })) return;
        await HistorySvc.DeleteAsync(new[] { entry.Id }, CancellationToken.None);
        ClearDetail();
        await LoadAsync(true);
    }

    private async Task RemoveOlderAsync(HistoryEntryDto entry)
    {
        if (!await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Remove older entries",
            Message = "Remove every entry older than this one? Favorites are kept.",
            ConfirmLabel = "Remove",
            Destructive = true,
        })) return;
        var n = await HistorySvc.RemoveOlderThanAsync(entry.Id, keepFavorites: true, CancellationToken.None);
        Notifications.Notify($"Removed {n} older entr{(n == 1 ? "y" : "ies")}.", NotificationKind.Success);
        await LoadAsync(true);
    }

    private async Task CopySqlAsync()
    {
        if (_detailLoading) return;
        // Spec 041 (T201, R5, N14): copyText also works on the http LAN deployment, where navigator.clipboard is absent.
        bool copied;
        try
        {
            _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
            copied = await _ui.InvokeAsync<bool>("copyText", _previewSql);
        }
        catch (Exception ex)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "history", $"Copy failed: {ex.Message}");
            copied = false;
        }
        if (copied) Notifications.Notify("Copied SQL.", NotificationKind.Success);
        else Notifications.Notify("Copy failed — select the text and press Ctrl+C.", NotificationKind.Error);
    }

    private async Task OpenInEditorAsync()
    {
        if (_selected == null || _detailLoading) return;
        // Spec 041 (R64): a past query opens as a new document, as Open does, and never overwrites a modified
        // document without asking.
        var entry = _selected;
        if (!await Document.OpenQueryAsync(_previewSql, "Open in editor")) return;
        await SessionStore.FlushAsync();
        await SuggestConnectionAsync(entry);
        Nav.NavigateTo("/");
    }

    private async Task ReExecuteAsync()
    {
        if (_selected == null || _detailLoading) return;
        var entry = _selected;
        if (!await Document.OpenQueryAsync(_previewSql, "Re-execute")) return;
        await SessionStore.FlushAsync();

        // Spec 042 (FR-070): a script written for one kind of server is never run on the other. It is opened, and the user is told
        // which connection it belongs to; running it is theirs to choose after connecting.
        if (RanOnOtherKind(entry))
        {
            await SuggestConnectionAsync(entry, notRun: true);
            Nav.NavigateTo("/");
            return;
        }

        Nav.NavigateTo("/?autorun=1");
    }

    /// <summary>The entry ran on the other kind of server than the connection that is active now.</summary>
    private bool RanOnOtherKind(HistoryEntryDto entry) =>
        SqlConn.IsConnected && (int)SqlConn.Kind != entry.Kind;

    /// <summary>
    /// Spec 042 (FR-070): on restore, name the saved connection the entry ran on when it still exists. Said only when it helps - the
    /// active connection is of the other kind, or on another server or database. Nothing is connected or run on the user's behalf.
    /// </summary>
    private async Task SuggestConnectionAsync(HistoryEntryDto entry, bool notRun = false)
    {
        var kind = AkmlSql.Core.DatabaseKindNames.FromInt(entry.Kind);
        var ranWhere = $"{WebHistoryLogic.KindLabel(entry.Kind)} {entry.Server}/{entry.Database}";
        var active = SqlConn.IsConnected && SqlConn.Kind == kind
            && string.Equals(SqlConn.Server, entry.Server, StringComparison.OrdinalIgnoreCase)
            && string.Equals(SqlConn.Database, entry.Database, StringComparison.OrdinalIgnoreCase);
        var sameKind = SqlConn.IsConnected && SqlConn.Kind == kind;
        if (active) return;
        if (!notRun && sameKind && string.IsNullOrWhiteSpace(entry.Server)) return;

        SavedSqlConnection? match = null;
        if (Services.GetService(typeof(ISavedSqlConnectionStore)) is ISavedSqlConnectionStore store)
        {
            try { match = WebHistoryLogic.FindConnection(await store.ListAsync(), kind, entry.Server, entry.Database); }
            catch (Exception ex) { Diagnostics.Log(DiagnosticLevel.Warn, "history", $"Saved connections could not be read: {ex.Message}"); }
        }

        // Same kind and nothing saved to point to: the query simply opens on whatever is connected, as it always did.
        if (match == null && sameKind && !notRun) return;

        var text = match != null
            ? $"This query ran on {ranWhere}. Saved connection: “{match.Name}”. Connect to it to run the query where it ran."
            : $"This query ran on {ranWhere}. No saved connection matches it.";
        if (notRun) text += " It was opened but not run.";
        Notifications.Notify(text, NotificationKind.Info);
    }

    private async Task OnExportChanged(ChangeEventArgs e)
    {
        var fmt = e.Value?.ToString();
        if (string.IsNullOrEmpty(fmt)) return;
        try
        {
            var (name, mime, content) = BuildExport(fmt);
            _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-download.js");
            await _downloadModule.InvokeVoidAsync("downloadBase64", name, mime,
                Convert.ToBase64String(Encoding.UTF8.GetBytes(content)));
            Notifications.Notify($"Exported {_entries.Count} entries ({fmt}).", NotificationKind.Success);
        }
        catch (Exception ex) { Diagnostics.Log(DiagnosticLevel.Warn, "history", $"Export failed: {ex.Message}"); }
    }

    private (string name, string mime, string content) BuildExport(string fmt)
    {
        switch (fmt)
        {
            case "json":
                var json = System.Text.Json.JsonSerializer.Serialize(_entries,
                    new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                return ("history.json", "application/json", json);
            case "sql":
                var sb = new StringBuilder();
                foreach (var e in _entries)
                {
                    sb.AppendLine($"-- {e.ExecutedAt}  {e.Server}/{e.Database}");
                    sb.AppendLine(e.SqlText);
                    sb.AppendLine("GO");
                    sb.AppendLine();
                }
                return ("history.sql", "text/plain", sb.ToString());
            default: // csv
                var csv = new StringBuilder("ExecutedAt,Server,Database,Status,DurationMs,RowCount,Sql\n");
                foreach (var e in _entries)
                    csv.AppendLine(string.Join(",", Csv(e.ExecutedAt), Csv(e.Server), Csv(e.Database),
                        e.Status.ToString(), e.DurationMs.ToString(), e.RowCount.ToString(), Csv(e.SqlText)));
                return ("history.csv", "text/csv", csv.ToString());
        }
    }

    private static string Csv(string? v) => "\"" + (v ?? string.Empty).Replace("\"", "\"\"") + "\"";

    private static string SegClass(HistoryPreviewHighlighter.Segment seg) =>
        seg.Hit ? $"tok-{seg.Kind} hit" : $"tok-{seg.Kind}";

    // Build derived display values for entries we haven't cached yet, against a single "now" snapshot.
    // LoadAsync(reset:false) APPENDs each paginated 'load more' page, so rebuilding EVERY row here would
    // be O(n^2) across pages (page k recomputing all prior rows). Building only the new ids keeps each
    // load O(page). The reset/filter path clears _rowViews in LoadAsync so changed entries refresh; we
    // also prune any cached id no longer in _entries here as a safety net against stale rows.
    private void RebuildRowViews()
    {
        var now = DateTime.Now;
        var live = new HashSet<long>(_entries.Count);
        foreach (var e in _entries)
        {
            live.Add(e.Id);
            if (!_rowViews.ContainsKey(e.Id)) _rowViews[e.Id] = BuildRowView(e, now);
        }
        if (_rowViews.Count != live.Count)
        {
            var stale = _rowViews.Keys.Where(k => !live.Contains(k)).ToList();
            foreach (var k in stale) _rowViews.Remove(k);
        }
    }

    private RowView RowFor(HistoryEntryDto e) =>
        _rowViews.TryGetValue(e.Id, out var v) ? v : BuildRowView(e, DateTime.Now);

    private static RowView BuildRowView(HistoryEntryDto e, DateTime now) =>
        new(DisplayNameFor(e), MetaFor(e.ExecutionCount, e.VersionCount),
            WebHistoryLogic.DateBucket(e.ExecutedAt, now), RelativeTime(e.ExecutedAt), ServerDb(e));

    private void RecomputePreviewSegments() =>
        _previewSegments = _selected == null
            ? Array.Empty<HistoryPreviewHighlighter.Segment>()
            : HistoryPreviewHighlighter.BuildSegments(_previewSql, WebHistoryLogic.ParseSearch(_search).Text ?? string.Empty);

    /// <summary>
    /// The session name (query-NN, a saved file name, or the user's rename). The raw-SQL fallback
    /// only fires for a row that somehow has no session at all, and is formatted via the shared
    /// <see cref="HistoryDisplayName.Of"/> — whitespace collapsed, truncated to ~60 characters — so
    /// a sessionless row never dumps raw multi-line SQL into the list. Mirrored by
    /// <c>AkmlSql.Shell.Shared.History.HistoryRowDisplay.DisplayNameFor</c> — see that file's remarks.
    /// </summary>
    internal static string DisplayNameFor(HistoryEntryDto e) =>
        HistoryDisplayName.Of(e.TabTitle, e.SqlText);

    /// <summary>
    /// "×276 · 12 versions". Both halves are omitted when they carry no information. Finding 10
    /// (PR #249 review): delegates to the shared <see cref="HistoryDisplayName.MetaFor"/> instead
    /// of hand-duplicating the same List/Join logic that used to live here AND in
    /// <c>AkmlSql.Shell.Shared.History.HistoryRowDisplay.MetaFor</c>.
    /// </summary>
    internal static string MetaFor(int executionCount, int versionCount) =>
        HistoryDisplayName.MetaFor(executionCount, versionCount);

    private static string ServerDb(HistoryEntryDto e)
    {
        if (!string.IsNullOrEmpty(e.Server) && !string.IsNullOrEmpty(e.Database)) return $"{e.Server} · {e.Database}";
        return e.Server ?? e.Database ?? "";
    }

    private static string RelativeTime(string? iso)
    {
        if (!DateTime.TryParse(iso, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dt)) return "";
        var local = dt.ToLocalTime();
        var elapsed = DateTime.Now - local;
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return local.ToString("HH:mm", CultureInfo.CurrentCulture);
        if (local.Date == DateTime.Today.AddDays(-1)) return "Yesterday " + local.ToString("HH:mm", CultureInfo.CurrentCulture);
        return local.ToString("yyyy-MM-dd HH:mm", CultureInfo.CurrentCulture);
    }

    private static string AbsTime(string? iso)
    {
        if (!DateTime.TryParse(iso, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dt)) return "";
        return dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.CurrentCulture);
    }

    private static string VersionTime(string? saved)
    {
        if (!DateTime.TryParse(saved, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var dt))
            return saved ?? "";
        return dt.ToLocalTime().ToString("MMM dd, HH:mm", CultureInfo.CurrentCulture);
    }

    public async ValueTask DisposeAsync()
    {
        SqlConn.StateChanged -= OnConnChanged;
        Bridge.StateChanged -= OnBridgeStateChanged;
        if (_downloadModule != null)
        {
            try { await _downloadModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_ui != null)
        {
            try { await _ui.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
