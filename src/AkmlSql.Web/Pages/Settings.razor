@page "/settings"
@page "/settings/{Section}"
@page "/diagnostics"
@*
    Spec 041 (research R43–R57, FR-050–FR-064, contracts/ui.md §6) — one Settings page, its sections named and
    ordered as in SSMS's Options window: General, Editor, Format, Queries, Code analysis, AI assistance,
    Connections, Schema cache, Diagnostics. A filter searches every section; each section has Restore defaults
    (Connections none); Restore all, Export and Import cover the preferences only (never a key, a password, a
    connection, the cache, snippets, history, chat or the document).
*@
@using AkmlSql.Web.Services
@using AkmlSql.Web.Services.Settings
@using AkmlSql.Web.Shared.Settings
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject ISettingsPortability Portability
@inject IDialogService Dialogs
@inject INotificationService Notifications
@inject IJSRuntime JS

<PageTitle>Settings — AKML SQL</PageTitle>

<div class="akml-page akml-settings-page" data-testid="settings-page">
    @* Spec 041 (T203, FR-085): the one page header. *@
    <div class="akml-page-header akml-settings-header" data-testid="page-header">
        <h1 class="akml-page-title" data-testid="page-title">Settings</h1>
        <input type="search" class="akml-input akml-settings-filter" data-testid="settings-filter" aria-label="Search settings"
               placeholder="Search settings" value="@_filter.Text" @oninput="OnFilterInput" />
        <span class="akml-page-spacer"></span>
        <div class="akml-page-actions" data-testid="page-actions">
            <button type="button" class="akml-btn" data-testid="settings-restore-all" @onclick="RestoreAllAsync">Restore all defaults…</button>
            <button type="button" class="akml-btn" data-testid="settings-export" @onclick="ExportAsync">Export…</button>
            <label class="akml-btn" data-testid="settings-import">
                Import…
                <InputFile class="akml-visually-hidden" accept=".json" data-testid="settings-import-input" OnChange="ImportAsync" />
            </label>
        </div>
    </div>

    <nav aria-label="Settings sections">
        <ul class="akml-settings-nav">
            @foreach (var s in SettingsCatalog.Sections)
            {
                var id = s.Id;
                bool current = !_filter.IsActive && id == _current.Id;
                int matches = _filter.IsActive ? _filter.MatchCount(id) : 0;
                <li>
                    <a class="akml-settings-nav-link" href="@($"settings/{id}")" data-testid="@($"settings-nav-{id}")"
                       aria-current="@(current ? "page" : null)" aria-disabled="@(_filter.IsActive && matches == 0 ? "true" : null)"
                       @onclick="@(() => Go(id))" @onclick:preventDefault="true">
                        @s.Title
                        @if (_filter.IsActive && matches > 0)
                        {
                            <span class="akml-settings-nav-count">@matches</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div class="akml-settings-main">
        <CascadingValue Value="_filter">
            @foreach (var s in Shown)
            {
                <section @key="@($"{s.Id}#{_mount}")" class="akml-settings-section" data-testid="@($"settings-section-{s.Id}")" aria-labelledby="@($"settings-title-{s.Id}")">
                    <div class="akml-settings-section-header">
                        <h2 class="akml-settings-section-title" id="@($"settings-title-{s.Id}")">@s.Title</h2>
                        <span class="akml-settings-section-spacer"></span>
                        @if (s.Id != SettingsCatalog.Connections)
                        {
                            <button type="button" class="akml-btn akml-btn--ghost" data-testid="@($"settings-restore-{s.Id}")"
                                    @onclick="@(() => RestoreAsync(s.Id))">Restore defaults…</button>
                        }
                    </div>
                    @switch (s.Id)
                    {
                        case SettingsCatalog.General: <GeneralSection /> break;
                        case SettingsCatalog.Editor: <EditorSection /> break;
                        case SettingsCatalog.Format: <FormatSection /> break;
                        case SettingsCatalog.Queries: <QueriesSection /> break;
                        case SettingsCatalog.CodeAnalysis: <CodeAnalysisSection /> break;
                        case SettingsCatalog.AiAssistance: <AiAssistanceSection /> break;
                        case SettingsCatalog.Connections: <ConnectionsSection /> break;
                        case SettingsCatalog.SchemaCache: <SchemaCacheSection @ref="_schemaCache" /> break;
                        case SettingsCatalog.Diagnostics: <DiagnosticsSection @ref="_diagnostics" /> break;
                    }
                </section>
            }
            @if (_filter.IsActive && !Shown.Any())
            {
                <p class="akml-settings-status" data-testid="settings-no-match">No setting matches “@_filter.Text”.</p>
            }
        </CascadingValue>
    </div>
</div>

@code {
    /// <summary>The section in the route (<c>/settings/{Section}</c>); <c>/diagnostics</c> has none.</summary>
    [Parameter] public string? Section { get; set; }

    private SettingsSectionInfo _current = SettingsCatalog.Sections[0];
    private SettingsFilter _filter = SettingsFilter.None;
    private SchemaCacheSection? _schemaCache;
    private DiagnosticsSection? _diagnostics;
    private IJSObjectReference? _download;
    private int _mount;

    /// <summary>The open section; while filtering, every section with a match (R55).</summary>
    private IEnumerable<SettingsSectionInfo> Shown => _filter.IsActive
        ? SettingsCatalog.Sections.Where(s => _filter.MatchCount(s.Id) > 0)
        : new[] { _current };

    protected override void OnParametersSet()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        int cut = path.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) path = path.Substring(0, cut);
        _current = string.Equals(path.Trim('/'), "diagnostics", StringComparison.OrdinalIgnoreCase)
            ? SettingsCatalog.Resolve(SettingsCatalog.Diagnostics)
            : SettingsCatalog.Resolve(Section);
    }

    private void Go(string id)
    {
        _filter = SettingsFilter.None;
        Nav.NavigateTo($"settings/{id}");
    }

    private void OnFilterInput(ChangeEventArgs e) => _filter = new SettingsFilter(e.Value?.ToString() ?? string.Empty);

    private async Task RestoreAsync(string id)
    {
        if (id == SettingsCatalog.SchemaCache)
        {
            if (_schemaCache != null) await _schemaCache.ClearAllAsync();   // Restore defaults = Clear all (R57)
            return;
        }
        if (id == SettingsCatalog.Diagnostics)
        {
            _diagnostics?.ResetFilters();
            return;
        }
        var section = Portability.Find(id);
        if (section == null) return;
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = $"Restore {section.Title} defaults",
            Message = $"Restore the {section.Title} settings to their defaults?",
            Details = await section.DescribeResetAsync(),
            ConfirmLabel = "Restore defaults",
            Destructive = true,
        });
        if (!ok) return;
        await section.ResetAsync();
        Notifications.Notify($"{section.Title} settings restored to their defaults.", NotificationKind.Success);
        await RemountAsync();
    }

    private async Task RestoreAllAsync()
    {
        var ok = await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = "Restore all defaults",
            Message = "Restore every setting to its default?",
            Details = await Portability.DescribeRestoreAllAsync(),
            ConfirmLabel = "Restore all",
            Destructive = true,
        });
        if (!ok) return;
        await Portability.RestoreAllAsync();
        Notifications.Notify("All settings restored to their defaults.", NotificationKind.Success);
        await RemountAsync();
    }

    /// <summary>Re-create the shown sections (a new @key) so they read the stores again.</summary>
    private Task RemountAsync()
    {
        _mount++;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ExportAsync()
    {
        var now = DateTimeOffset.Now;
        var json = await Portability.ExportAsync(now);
        try
        {
            _download ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-download.js");
            await _download.InvokeVoidAsync("downloadText", Portability.ExportFileName(now), "application/json", json, false);
            Notifications.Notify($"Settings exported to {Portability.ExportFileName(now)}. The file holds no keys, passwords or connections.", NotificationKind.Success);
        }
        catch (JSException ex)
        {
            Notifications.Notify($"The export could not be saved: {ex.Message}", NotificationKind.Error);
        }
    }

    private const long MaxImportBytes = 1024 * 1024;

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > MaxImportBytes)
        {
            Notifications.Notify("That file is larger than 1 MB — a settings export is much smaller.", NotificationKind.Error);
            return;
        }
        string json;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream);
            json = await reader.ReadToEndAsync();
        }
        catch (IOException ex)
        {
            Notifications.Notify($"The file could not be read: {ex.Message}", NotificationKind.Error);
            return;
        }
        var result = await Portability.ImportAsync(json);
        Notifications.Notify(result.Summary, result.Ok ? NotificationKind.Success : NotificationKind.Error);
        if (result.Ok) await RemountAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_download != null)
        {
            try { await _download.DisposeAsync(); }
            catch (JSDisconnectedException) { /* tab closing */ }
        }
    }
}
