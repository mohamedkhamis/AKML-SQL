@page "/settings"
@*
    Spec 021 (web edition) -- M2 stub. The full Settings page surface (theme override,
    analyser settings, profile management, schema-cache management) lands across the M5
    Settings pages (T111 schema cache, T135 AI) and T046 (analyser auto-run toggle).
    M2 ships theme + analyser + reset session in a single page.
*@
@using AkmlSql.Web.Services
@using AkmlSql.Web.Shared
@implements IDisposable
@inject IThemeService Theme
@inject IAnalysisSettingsStore AnalysisSettings
@inject IEditorSessionStore SessionStore
@inject ISqlConnectionService SqlConn
@inject IEngineBridge Bridge
@inject IConnectionManagerController ConnManager

<PageTitle>Settings — AKML SQL</PageTitle>

<div class="akml-settings">
    <h2>Settings</h2>

    <section class="akml-settings-section">
        <h3>Theme</h3>
        <p class="akml-settings-help">
            Follow the operating system, or pin a specific mode. Choosing "System" reacts
            to OS theme changes in real time.
        </p>
        <label class="akml-radio"><input type="radio" name="theme" checked="@(Theme.Current == ThemeMode.System)" @onchange="() => SetTheme(ThemeMode.System)" /> System</label>
        <label class="akml-radio"><input type="radio" name="theme" checked="@(Theme.Current == ThemeMode.Light)" @onchange="() => SetTheme(ThemeMode.Light)" /> Light</label>
        <label class="akml-radio"><input type="radio" name="theme" checked="@(Theme.Current == ThemeMode.Dark)" @onchange="() => SetTheme(ThemeMode.Dark)" /> Dark</label>
        <label class="akml-radio"><input type="radio" name="theme" checked="@(Theme.Current == ThemeMode.HighContrast)" @onchange="() => SetTheme(ThemeMode.HighContrast)" /> High contrast</label>
    </section>

    <section class="akml-settings-section">
        <h3>Analyser</h3>
        <label class="akml-checkbox">
            <input type="checkbox" checked="@_settings.Enabled" @onchange="ToggleEnabled" /> Enable analyser
        </label>
        <label class="akml-checkbox">
            <input type="checkbox" checked="@_settings.AutoAnalyseOnFormat" @onchange="ToggleAutoAnalyse" /> Re-analyse after every format
        </label>
    </section>

    <section class="akml-settings-section">
        <h3>Editor</h3>
        <button class="akml-tool-button" @onclick="ResetSessionAsync">Reset editor session</button>
        <p class="akml-settings-help">
            Clears the persisted document text + caret + active profile. Built-in and
            user profiles are not touched.
        </p>
    </section>

    <section class="akml-settings-section">
        <ConnectionPickerComponent />
    </section>

    <section class="akml-settings-section">
        <h3>Connect to SQL Server</h3>
        <p class="akml-settings-help">
            Tell the paired engine which SQL Server + database to open, so IntelliSense gets the live
            schema. Windows authentication uses the <em>engine host's</em> identity (no password).
            Requires a paired engine (above) and currently targets a local engine.
        </p>

        @if (SqlConn.IsConnected)
        {
            <p class="akml-settings-status">Connected: <strong>@SqlConn.Server</strong> / <strong>@SqlConn.Database</strong> — live schema IntelliSense is on.</p>
            <button class="akml-tool-button" @onclick="DisconnectSqlAsync">Disconnect</button>
        }
        else if (Bridge.State != BridgeState.Open)
        {
            <p class="akml-settings-help">Pair an engine first (Engine connections → Add), then connect to SQL Server.</p>
        }
        <button class="akml-tool-button" @onclick="() => ConnManager.Open()" data-testid="settings-manage-connections">Manage connections…</button>
    </section>

    <section class="akml-settings-section">
        <h3>Schema cache</h3>
        <p class="akml-settings-help">
            The browser caches schema metadata per (server, database) so IntelliSense
            keeps working when the engine is unreachable. Manage cached entries on the
            <a href="/settings/schema-cache">schema-cache settings page</a>.
        </p>
    </section>

    <section class="akml-settings-section">
        <h3>AI providers</h3>
        <p class="akml-settings-help">
            Manage AI providers (OpenAI, Anthropic, Gemini, Azure, Ollama, LM Studio)
            on the <a href="/settings/ai">AI providers page</a>. Keys are wrapped at
            rest with Web Crypto; AKML SQL never sees them.
        </p>
    </section>

    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="akml-settings-status">@_status</p>
    }
</div>

<style>
    .akml-settings { padding: var(--akml-scalar-spacing-m); max-width: 720px; }
    .akml-settings-section { margin-bottom: var(--akml-scalar-spacing-l); }
    .akml-settings-help { color: var(--akml-text-secondary); font-size: 13px; }
    .akml-radio, .akml-checkbox {
        display: block;
        margin-bottom: var(--akml-scalar-spacing-xs);
        color: var(--akml-text-primary);
    }
    .akml-tool-button {
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel); color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default); border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer;
    }
    .akml-tool-button:hover { background-color: var(--akml-surface-hover); }
    .akml-settings-status { color: var(--akml-status-info); font-style: italic; }
    .akml-field { display: flex; align-items: center; gap: var(--akml-scalar-spacing-s); margin-bottom: var(--akml-scalar-spacing-xs); }
    .akml-field > label:first-child { width: 90px; color: var(--akml-text-secondary); font-size: 13px; }
    .akml-input {
        flex: 1; max-width: 320px;
        background-color: var(--akml-surface-input, var(--akml-surface-panel)); color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default); border-radius: var(--akml-scalar-radius-xs);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
    }
</style>

@code {
    private WebAnalysisSettings _settings = new();
    private string? _status;

    // Phase 4 — the inline connect form moved to the global ConnectionManagerModal (opened via
    // ConnManager.Open()). Settings keeps only the connected-status line + Disconnect below.

    private async Task DisconnectSqlAsync()
    {
        await SqlConn.DisconnectAsync();
        StateHasChanged();
    }

    private void OnConnStateChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        // Await theme init before the radios bind to Theme.Current; otherwise a
        // hard-refresh on /settings would render the radios with the default
        // "System" value and never re-render when the persisted Dark/Light/HC
        // override loads from IndexedDB. ThemeService.InitializeAsync is
        // idempotent (Task is cached), so MainLayout's parallel call is fine.
        await Theme.InitializeAsync();
        Theme.Changed += OnThemeChanged;
        Bridge.StateChanged += OnBridgeStateChanged;
        SqlConn.StateChanged += OnConnStateChanged;
        _settings = await AnalysisSettings.GetAsync();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);
    private void OnBridgeStateChanged(BridgeState _) => InvokeAsync(StateHasChanged);

    private async Task SetTheme(ThemeMode mode)
    {
        await Theme.SetAsync(mode);
        _status = $"Theme set to {mode}.";
        StateHasChanged();
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Bridge.StateChanged -= OnBridgeStateChanged;
        SqlConn.StateChanged -= OnConnStateChanged;
    }

    private async Task ToggleEnabled(ChangeEventArgs e)
    {
        _settings.Enabled = (bool)(e.Value ?? false);
        await AnalysisSettings.SetAsync(_settings);
        _status = "Analyser settings saved.";
    }

    private async Task ToggleAutoAnalyse(ChangeEventArgs e)
    {
        _settings.AutoAnalyseOnFormat = (bool)(e.Value ?? false);
        await AnalysisSettings.SetAsync(_settings);
        _status = "Analyser settings saved.";
    }

    private async Task ResetSessionAsync()
    {
        await SessionStore.ClearAsync();
        // T9: explicit deliberate boundary -- even though ClearAsync already drops the whole
        // persisted record (SessionKey included), reset the key explicitly so the intent doesn't
        // silently depend on ClearAsync's scope never narrowing.
        await EditorSessionKeys.ResetAsync(SessionStore);
        _status = "Editor session cleared. Reload the page to start fresh.";
    }
}
