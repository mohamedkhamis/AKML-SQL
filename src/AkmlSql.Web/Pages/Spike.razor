    .bad, .sev-error { color: #e74c3c; }
    .sev-info { color: var(--akml-text-secondary, #888); }
</style>

@code {
    // --- constants ---
    private const int FormatTimingIterations = 10;
    private const int RuleBaseline = 130;   // desktop-discovered rule count (research.md Decision 10)
    private const string DefaultSampleSql =
        "select   a, b, c   from dbo.Foo   where a > 1";

    // --- input state ---
    private string _sqlInput = DefaultSampleSql;
    private SpikeCorpusItem[]? _corpus;
    private string? _corpusLoadError;
    private string? _selectedCorpusId;
    private string? _statusMessage;

    // --- runtime probe state (T015, T020) ---
    private int _rulesDiscovered;
    private string? _rulesDiscoveredError;
    private long _timerFreq;
    private long _timerSmallestTicks;
    private double _timerResolutionUs;
    private double? _firstRenderMs;
    private string? _timerNote;

    // --- single-run state ---
    private OperationOutcome? _formatOutcome;
    private FormatResult? _formatResult;
    private OperationOutcome? _analyseOutcome;
    private CodeAnalysisResponse? _analyseResponse;
    private string? _lastRunLabel;

    // --- corpus-run state ---
    private readonly List<SpikeRunResult> _corpusResults = new();

    // --- busy state ---
    private bool _running;
    private string? _busyLabel;

    protected override async Task OnInitializedAsync()
    {
        // Rule-discovery count: construct RuleRegistry directly (research.md Decision 10).
        // Wrapped so a trimming-induced reflection failure is a recorded finding, not a page crash.
        try
        {
            _rulesDiscovered = new RuleRegistry().AllRules.Count;
        }
        catch (Exception ex)
        {
            _rulesDiscoveredError = ex.ToString();
        }

        // Corpus manifest. GetFromJsonAsync uses the System.Text.Json Web defaults
        // (camelCase, case-insensitive) which match spike-corpus/corpus.json.
        try
        {
            _corpus = await Http.GetFromJsonAsync<SpikeCorpusItem[]>("spike-corpus/corpus.json");
        }
        catch (Exception ex)
        {
            _corpusLoadError = ex.ToString();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Timer microbench (research.md Decision 5; measurement-protocol.md M5).
        RunTimerProbe();

        // Cold-load capture (measurement-protocol.md M2). The mark lets an external
        // driver read time-to-interactive via performance.measure; performance.now()
        // gives the same figure in-page.
        try
        {
            await JS.InvokeVoidAsync("performance.mark", "akml-spike-ready");
            _firstRenderMs = await JS.InvokeAsync<double>("performance.now");
        }
        catch (Exception ex)
        {
            _timerNote = $"performance API unavailable: {ex.Message}";
        }

        StateHasChanged();
    }

    private void RunTimerProbe()
    {
        _timerFreq = Stopwatch.Frequency;
        var smallest = long.MaxValue;
        for (var i = 0; i < 2000; i++)
        {
            var a = Stopwatch.GetTimestamp();
            var b = Stopwatch.GetTimestamp();
            var delta = b - a;
            if (delta > 0 && delta < smallest) smallest = delta;
        }
        _timerSmallestTicks = smallest == long.MaxValue ? 0 : smallest;
        _timerResolutionUs = _timerFreq > 0 ? _timerSmallestTicks * 1_000_000.0 / _timerFreq : 0;
    }

    private async Task OnCorpusSelected(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        _selectedCorpusId = string.IsNullOrEmpty(id) ? null : id;
        _statusMessage = null;
        if (_selectedCorpusId is null || _corpus is null) return;

        var item = _corpus.FirstOrDefault(c => c.Id == _selectedCorpusId);
        if (item is null) return;
        try
        {
            _sqlInput = await Http.GetStringAsync(item.SqlPath);
            _statusMessage = $"Loaded corpus item '{item.DisplayName}'.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Could not fetch {item.SqlPath}: {ex.GetType().Name} — {ex.Message}";
        }
    }

    // Oversized-file edge case (spec Edge Case "Oversized .sql file"): guard the 10 MB
    // document limit BEFORE reading, so the limit message renders instead of the tab freezing.
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _statusMessage = null;
        _selectedCorpusId = null;

        if (file.Size > DocumentSizeLimit.MaxDocumentSizeChars)
        {
            _statusMessage =
                $"File '{file.Name}' is {file.Size:N0} bytes — over the "
                + $"{DocumentSizeLimit.MaxDocumentSizeChars:N0}-char (10 MB) document limit. Not loaded.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(DocumentSizeLimit.MaxDocumentSizeChars);
            using var reader = new StreamReader(stream);
            _sqlInput = await reader.ReadToEndAsync();
            _statusMessage = $"Loaded '{file.Name}' ({file.Size:N0} bytes).";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Could not load '{file.Name}': {ex.GetType().Name} — {ex.Message}";
        }
    }

    private async Task ParseAndFormatAsync()
    {
        _running = true;
        _busyLabel = "Parsing & formatting…";
        _corpusResults.Clear();
        _lastRunLabel = _selectedCorpusId ?? "pasted input";
        StateHasChanged();
        await Task.Yield();   // let the busy state paint before the synchronous work

        try
        {
            (_formatOutcome, _formatResult) = TimedFormat(_sqlInput);
        }
        finally
        {
            _running = false;
            _busyLabel = null;
            StateHasChanged();
        }
    }

    private async Task AnalyseAsync()
    {
        _running = true;
        _busyLabel = "Analysing…";
        _corpusResults.Clear();
        _lastRunLabel = _selectedCorpusId ?? "pasted input";
        StateHasChanged();
        await Task.Yield();

        try
        {
            (_analyseOutcome, _analyseResponse) = await TimedAnalyseAsync(_sqlInput);
        }
        finally
        {
            _running = false;
            _busyLabel = null;
            StateHasChanged();
        }
    }

    private async Task RunAllCorpusAsync()
    {
        if (_corpus is null) return;
        _running = true;
        _corpusResults.Clear();
        _formatOutcome = null;
        _analyseOutcome = null;
        StateHasChanged();

        try
        {
            foreach (var item in _corpus)
            {
                _busyLabel = $"Running corpus — {item.DisplayName}…";
                StateHasChanged();
                await Task.Yield();   // keep the UI responsive between items

                _corpusResults.Add(await RunCorpusItemAsync(item));
                StateHasChanged();
            }
        }
        finally
        {
            _running = false;
            _busyLabel = null;
            StateHasChanged();
        }
    }

    private async Task<SpikeRunResult> RunCorpusItemAsync(SpikeCorpusItem item)
    {
        string sql;
        try
        {
            sql = await Http.GetStringAsync(item.SqlPath);
        }
        catch (Exception ex)
        {
            return new SpikeRunResult
            {
                InputId = item.Id,
                DisplayName = item.DisplayName,
                ParseAndFormat = OperationOutcome.Fail("FetchSql", ex),
            };
        }

        var (formatOutcome, formatResult) = TimedFormat(sql);
        var (analyseOutcome, analyseResponse) = await TimedAnalyseAsync(sql);

        bool? formatMatch = null;
        bool? analysisMatch = null;

        if (formatOutcome.Success && formatResult is not null)
        {
            var golden = await TryFetchTextAsync(item.ExpectedFormattedPath);
            if (golden is not null)
            {
                formatMatch = SpikeGolden.Normalize(golden)
                    == SpikeGolden.Normalize(formatResult.FormattedText);
            }
        }

        if (analyseOutcome.Success && analyseResponse is not null)
        {
            var golden = await TryFetchTextAsync(item.ExpectedAnalysisPath);
            if (golden is not null)
            {
                analysisMatch = SpikeGolden.Normalize(golden)
                    == SpikeGolden.Normalize(SpikeGolden.FindingsToJson(analyseResponse.Issues));
            }
        }

        return new SpikeRunResult
        {
            InputId = item.Id,
            DisplayName = item.DisplayName,
            ParseAndFormat = formatOutcome,
            Analyse = analyseOutcome,
            FormattedOutput = formatResult?.FormattedText,
            Findings = analyseResponse?.Issues ?? Array.Empty<CodeIssueInfo>(),
            RulesDiscovered = _rulesDiscovered,
            FormattedMatchesGolden = formatMatch,
            AnalysisMatchesGolden = analysisMatch,
        };
    }

    // Parse & Format timing: one warm-up pass, then average over N runs (research.md Decision 5).
    private (OperationOutcome, FormatResult?) TimedFormat(string sql)
    {
        try
        {
            var result = Formatter.Format(sql);   // warm-up
            var sw = Stopwatch.StartNew();
            for (var i = 0; i < FormatTimingIterations; i++)
            {
                result = Formatter.Format(sql);
            }
            sw.Stop();
            var avgMs = sw.Elapsed.TotalMilliseconds / FormatTimingIterations;
            return (OperationOutcome.Ok("ParseAndFormat", avgMs), result);
        }
        catch (Exception ex)
        {
            return (OperationOutcome.Fail("ParseAndFormat", ex), null);
        }
    }

    // Analyse timing: single-shot. The analysis engine caches results per batch hash,
    // so averaging would measure cache hits, not real work.
    private async Task<(OperationOutcome, CodeAnalysisResponse?)> TimedAnalyseAsync(string sql)
    {
        try
        {
            var sw = Stopwatch.StartNew();
            var response = await Analyser.AnalyseAsync(sql);
            sw.Stop();
            return (OperationOutcome.Ok("Analyse", sw.Elapsed.TotalMilliseconds), response);
        }
        catch (Exception ex)
        {
            return (OperationOutcome.Fail("Analyse", ex), null);
        }
    }

    private async Task<string?> TryFetchTextAsync(string path)
    {
        try
        {
            using var response = await Http.GetAsync(path);
            return response.IsSuccessStatusCode
                ? await response.Content.ReadAsStringAsync()
                : null;
        }
        catch
        {
            return null;
        }
    }

    private static string SeverityLabel(int severity) => severity switch
    {
        0 => "Hint",
        1 => "Info",
        2 => "Warning",
        3 => "Error",
        _ => $"({severity})",
    };

    private static string DiagClass(DiagnosticSeverity severity) => severity switch
    {
        DiagnosticSeverity.Error => "sev-error",
        DiagnosticSeverity.Warning => "sev-warning",
        _ => "sev-info",
    };

    private RenderFragment RenderException(OperationOutcome o) => @<div class="spike-exc">
        <div class="spike-exc-head">✗ @o.Operation threw @o.ErrorType</div>
        <div class="spike-exc-msg">@o.ErrorMessage</div>
        <pre class="spike-exc-trace">@o.ErrorDetail</pre>
    </div>;

    private RenderFragment RenderOutcomeCell(OperationOutcome? o) => @<text>
        @if (o is null)
        {
            <span class="spike-muted">—</span>
        }
        else if (o.Success)
        {
            <span class="ok">✓ @o.ElapsedMs.ToString("F2") ms</span>
        }
        else
        {
            <span class="bad">✗ @o.ErrorType</span>
        }
    </text>;

    private RenderFragment RenderGoldenCell(bool? match) => @<text>
        @if (match is null)
        {
            <span class="spike-muted">— (no golden file)</span>
        }
        else if (match.Value)
        {
            <span class="ok">✓ match</span>
        }
        else
        {
            <span class="bad">✗ differs</span>
        }
    </text>;
}
