@page "/settings/ai"
@*
    Spec 021 (web edition) -- M6 task T135. Settings -> AI page.
    Per-provider Add / Edit / Remove form. Masked display of stored key (the
    plaintext is NEVER read back from storage -- "Edit" replaces the key).
    Model selection, endpoint URL for Azure / Ollama / LM Studio. "No key"
    path opens provider docs (FR-032).
*@
@using AkmlSql.Web.Services
@inject IAiKeyVault Vault
@inject IAiPreference Preference

<PageTitle>AI providers — AKML SQL</PageTitle>

<div class="akml-ai-settings">
    <h2>AI providers</h2>
    <p class="akml-help">
        AKML SQL never sees your API keys. They live encrypted in your browser via
        Web Crypto (AES-GCM 256). When you invoke an AI action the key is unwrapped
        for the duration of one fetch to the provider's own endpoint, then dropped.
    </p>

    <h3>Configured providers</h3>
    @if (_configs == null)
    {
        <p>Loading…</p>
    }
    else if (_configs.Count == 0)
    {
        <p class="akml-help">No providers configured yet.</p>
    }
    else
    {
        <table class="akml-ai-table">
            <thead><tr><th>Active</th><th>Provider</th><th>Model</th><th>Has key</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _configs)
                {
                    <tr>
                        <td>
                            <input type="radio" name="active" checked="@(_activeId == c.ProviderId)"
                                   @onchange="@(() => SetActiveAsync(c.ProviderId))" />
                        </td>
                        <td>@c.DisplayName (@c.ProviderId)</td>
                        <td>@c.Model</td>
                        <td>@(c.HasKey ? "Yes (wrapped)" : "No")</td>
                        <td>
                            <button class="akml-tool-button" @onclick="@(() => EditAsync(c))">Edit</button>
                            <button class="akml-tool-button" @onclick="@(() => RemoveAsync(c.ProviderId))">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>Add / edit provider</h3>
    <form class="akml-ai-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <label>Provider
            <select @bind="_form.ProviderId">
                @foreach (var (id, label) in ProviderLabels)
                {
                    <option value="@id">@label</option>
                }
            </select>
        </label>
        <label>Display name <input @bind="_form.DisplayName" placeholder="@DefaultDisplayName(_form.ProviderId)" /></label>
        <label>Model <input @bind="_form.Model" placeholder="@ModelPlaceholder(_form.ProviderId)" /></label>
        <label>Endpoint
            <input @bind="_form.Endpoint"
                   disabled="@(!RequiresEndpoint(_form.ProviderId))"
                   placeholder="@EndpointPlaceholder(_form.ProviderId)" />
            @if (!RequiresEndpoint(_form.ProviderId))
            {
                <span class="akml-ai-form-hint">Endpoint is only required for Azure / Ollama / LM Studio.</span>
            }
        </label>
        @if (RequiresApiKey(_form.ProviderId))
        {
            <label>API key
                <input type="password" @bind="_form.ApiKey" autocomplete="new-password"
                       placeholder="Enter or paste your key (stored wrapped)" />
            </label>
        }
        else
        {
            <p class="akml-ai-form-hint">@DefaultDisplayName(_form.ProviderId) runs locally and doesn't use an API key.</p>
        }

        <div class="akml-ai-form-buttons">
            <button type="submit" class="akml-tool-button">Save</button>
            <button type="button" class="akml-tool-button" @onclick="ClearForm">Clear</button>
        </div>

        @if (_errors.Count > 0)
        {
            <ul class="akml-ai-errors">
                @foreach (var err in _errors)
                {
                    <li>@err</li>
                }
            </ul>
        }
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="akml-ai-status">@_status</p>
        }
    </form>
</div>

<style>
    .akml-ai-settings { padding: var(--akml-scalar-spacing-m); max-width: 800px; }
    .akml-help { color: var(--akml-text-secondary); }
    .akml-ai-table { width: 100%; border-collapse: collapse; margin-bottom: var(--akml-scalar-spacing-l); }
    .akml-ai-table th, .akml-ai-table td {
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
        border-bottom: 1px solid var(--akml-border-subtle);
        text-align: left;
    }
    .akml-ai-form { display: flex; flex-direction: column; gap: var(--akml-scalar-spacing-s); max-width: 480px; }
    .akml-ai-form label { display: flex; flex-direction: column; gap: var(--akml-scalar-spacing-xs); }
    .akml-ai-form input, .akml-ai-form select {
        background-color: var(--akml-surface-canvas);
        color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default);
        padding: var(--akml-scalar-spacing-xs);
    }
    .akml-ai-form-buttons { display: flex; gap: var(--akml-scalar-spacing-s); margin-top: var(--akml-scalar-spacing-s); }
    .akml-ai-form-hint { color: var(--akml-text-secondary); font-size: 11px; font-style: italic; }
    .akml-ai-form input:disabled { background-color: var(--akml-surface-inputreadonly); color: var(--akml-text-disabled); }
    .akml-ai-status { color: var(--akml-status-info); font-style: italic; }
    .akml-ai-errors { color: var(--akml-status-danger); padding-left: var(--akml-scalar-spacing-l); margin: var(--akml-scalar-spacing-xs) 0 0 0; }
    .akml-ai-errors li { margin-bottom: 2px; }
    .akml-tool-button {
        font-family: var(--akml-type-chrome-family); font-size: var(--akml-type-chrome-size);
        background-color: var(--akml-surface-panel); color: var(--akml-text-primary);
        border: 1px solid var(--akml-border-default); border-radius: 3px;
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s); cursor: pointer;
    }
    .akml-tool-button:hover { background-color: var(--akml-surface-hover); }
</style>

@code {
    private IReadOnlyList<AiProviderConfig>? _configs;
    private string _activeId = string.Empty;
    private ProviderForm _form = new();
    private string? _status;
    private List<string> _errors = new();

    // Display names + per-provider hints live in code so the markup stays declarative.
    private static readonly (string Id, string Label)[] ProviderLabels =
    {
        ("openai",    "OpenAI"),
        ("anthropic", "Anthropic"),
        ("gemini",    "Google Gemini"),
        ("azure",     "Azure OpenAI"),
        ("ollama",    "Ollama (local)"),
        ("lmstudio",  "LM Studio (local)"),
    };

    private static string DefaultDisplayName(string id) =>
        ProviderLabels.FirstOrDefault(p => p.Id == id).Label ?? id;

    private static string ModelPlaceholder(string id) => id switch
    {
        "openai"    => "gpt-4.1",
        "anthropic" => "claude-sonnet-4-6",
        "gemini"    => "gemini-2.5-flash",
        "azure"     => "gpt-4.1 (your deployment name)",
        "ollama"    => "llama3.1:8b",
        "lmstudio"  => "lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF",
        _ => string.Empty,
    };

    private static bool RequiresEndpoint(string id) => id is "azure" or "ollama" or "lmstudio";

    // Local providers (Ollama, LM Studio) authenticate by network reachability, not a key.
    private static bool RequiresApiKey(string id) => id is not ("ollama" or "lmstudio");

    private static string EndpointPlaceholder(string id) => id switch
    {
        "azure"    => "https://your-resource.openai.azure.com/",
        "ollama"   => "http://localhost:11434",
        "lmstudio" => "http://localhost:1234/v1",
        _ => string.Empty,
    };

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _configs = await Vault.ListAsync();
        _activeId = await Preference.GetActiveAsync();
        StateHasChanged();
    }

    private async Task SetActiveAsync(string providerId)
    {
        _activeId = providerId;
        await Preference.SetActiveAsync(providerId);
        _status = $"Active provider: {providerId}";
        StateHasChanged();
    }

    private void EditAsync(AiProviderConfig c)
    {
        _form = new ProviderForm
        {
            ProviderId = c.ProviderId,
            DisplayName = c.DisplayName,
            Model = c.Model,
            Endpoint = c.Endpoint ?? string.Empty,
            ApiKey = string.Empty,   // never read back -- user must re-enter
        };
        _status = $"Editing {c.ProviderId}. Re-enter the API key to update it.";
        StateHasChanged();
    }

    private async Task RemoveAsync(string providerId)
    {
        await Vault.RemoveAsync(providerId);
        if (_activeId == providerId) await Preference.SetActiveAsync(string.Empty);
        _status = $"Removed {providerId}.";
        await ReloadAsync();
    }

    private async Task SubmitAsync()
    {
        _status = null;
        _errors = new List<string>();

        if (string.IsNullOrEmpty(_form.ProviderId))
        {
            _errors.Add("Provider is required.");
        }
        if (string.IsNullOrEmpty(_form.Model))
        {
            _errors.Add("Model is required.");
        }
        if (RequiresApiKey(_form.ProviderId) && string.IsNullOrEmpty(_form.ApiKey))
        {
            _errors.Add("API key is required.");
        }
        if (RequiresEndpoint(_form.ProviderId) && string.IsNullOrEmpty(_form.Endpoint))
        {
            _errors.Add($"Endpoint is required for {DefaultDisplayName(_form.ProviderId)}.");
        }
        if (_errors.Count > 0) return;

        await Vault.SetKeyAsync(_form.ProviderId, new AiProviderConfig
        {
            ProviderId = _form.ProviderId,
            DisplayName = string.IsNullOrEmpty(_form.DisplayName) ? DefaultDisplayName(_form.ProviderId) : _form.DisplayName,
            Model = _form.Model,
            Endpoint = string.IsNullOrEmpty(_form.Endpoint) ? null : _form.Endpoint,
        }, _form.ApiKey);
        _form.ApiKey = string.Empty;   // tighten the residual exposure window
        _status = $"Saved {DefaultDisplayName(_form.ProviderId)}.";
        await ReloadAsync();
    }

    private void ClearForm()
    {
        _form = new ProviderForm();
        _errors.Clear();
        _status = null;
    }

    private sealed class ProviderForm
    {
        public string ProviderId { get; set; } = "openai";
        public string DisplayName { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public string Endpoint { get; set; } = string.Empty;
        public string ApiKey { get; set; } = string.Empty;
    }
}
