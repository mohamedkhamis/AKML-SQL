    private async Task OpenFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > EditorDocumentFlow.MaxFileBytes)
        {
            Tab?.Document.RefuseTooLarge(file.Name);
            return;
        }
        byte[] bytes;
        try
        {
            await using var stream = file.OpenReadStream(EditorDocumentFlow.MaxFileBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        catch (IOException ex)
        {
            Notifications.Notify($"{file.Name} could not be read: {ex.Message}", NotificationKind.Error);
            return;
        }
        // A file that cannot be read as text opens nothing — not even an empty tab.
        var decoded = EditorDocument.DecodeFile(bytes);
        if (decoded.Error != null)
        {
            Notifications.Notify($"{file.Name} was not opened. {decoded.Error}", NotificationKind.Error);
            return;
        }

        // Spec 043 (FR-011): into the active tab when it is empty and unmodified, else into a new tab.
        var target = Tab is { IsEmpty: true, IsExecuting: false, GridHasPendingEdits: false } reuse ? reuse : null;
        if (target == null)
        {
            target = await QueryTabs.NewAsync(Tab);
            if (target == null)
            {
                Notifications.Notify(QueryTabs.LimitText + ".", NotificationKind.Info);
                return;
            }
            await AfterTabOpenedAsync(target);
        }
        if (!await target.Document.OpenAsync(bytes, file.Name)) return;
        await AfterDocumentReplacedAsync(target);
    }

    /// <summary>A new document in the tab: the old one's findings and error mark do not belong to it.</summary>
    private async Task AfterDocumentReplacedAsync(QueryTab tab)
    {
        tab.Findings = null;
        tab.ErrorMark = null;
        if (_editor != null) await _editor.ClearDiagnosticsAsync(tab.Id);
        StateHasChanged();
    }

    private async Task OnProfileChangedAsync(ProfileRecord record)
