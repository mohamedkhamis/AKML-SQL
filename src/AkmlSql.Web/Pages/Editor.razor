    private async Task OpenFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > EditorDocumentFlow.MaxFileBytes)
        {
            Document.RefuseTooLarge(file.Name);
            return;
        }
        byte[] bytes;
        try
        {
            await using var stream = file.OpenReadStream(EditorDocumentFlow.MaxFileBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        catch (IOException ex)
        {
            Notifications.Notify($"{file.Name} could not be read: {ex.Message}", NotificationKind.Error);
            return;
        }
        if (!await Document.OpenAsync(bytes, file.Name)) return;
        await AfterDocumentReplacedAsync();
    }

