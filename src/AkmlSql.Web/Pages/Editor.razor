    private async Task AfterDocumentReplacedAsync()
    {
        if (_editor != null) await _editor.ClearDiagnosticsAsync();
        _findings = null;
        _errorDiagnostic = null;
        StateHasChanged();
    }

    private async Task OnProfileChangedAsync(ProfileRecord record)
    {
        _activeProfile = record.Profile;
        _status = $"Profile changed to '{record.Name}'.";
