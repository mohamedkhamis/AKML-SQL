            Item(WorkspaceViewActions.ToggleSchema, "Schema panel", "view-toggle-schema", SchemaShown, ToggleSchemaAsync),
            Item(WorkspaceViewActions.ToggleResults, "Results pane", "view-toggle-results", l.ResultsVisible, ToggleResultsAsync),
            Item(WorkspaceViewActions.ToggleAi, "AI panel", "view-toggle-ai", AiShown, ToggleAiAsync),
            MenuItem.Separator(),
            Item(WorkspaceViewActions.MaximiseResults, l.ResultsMaximised ? "Restore results" : "Maximise results", "view-toggle-maximise", null, ToggleMaximiseResultsAsync),
            Item(WorkspaceViewActions.CyclePanes, "Next pane", "view-cycle-panes", null, () => CyclePanesAsync(false)),
            MenuItem.Separator(),
            Item(WorkspaceViewActions.ResetLayout, "Reset layout", "workspace-reset-layout", null, ResetLayoutAsync),
        };
        _viewMenu = (e.ClientX, e.ClientY + 8, items);
    }

    /// <summary>Resolve the SQL the AI actions operate on: the live editor selection, falling
    /// back to the whole document when nothing is selected (so a user can run Explain on the
    /// full script without selecting first). Evaluated lazily at action time via
    /// <see cref="AiPanel.SelectedSqlProvider"/> so it is always current.</summary>
    private async Task<string> GetAiInputSqlAsync()
    {
        if (_editor == null) return _currentText;
        var selection = await _editor.GetSelectedTextAsync();
        return string.IsNullOrWhiteSpace(selection) ? await _editor.GetTextAsync() : selection;
    }

    /// <summary>Accept an AI result: insert it at the caret as a single undoable edit (CodeMirror
    /// Ctrl+Z restores the prior text), matching how schema-tree click-to-insert already mutates
    /// the document.</summary>
    private async Task OnAiAcceptResultAsync(string text)
    {
        if (_editor == null || string.IsNullOrEmpty(text)) return;
        await _editor.InsertAtCaretAsync(text);
        _status = "AI result inserted.";
        Diagnostics.Log(DiagnosticLevel.Info, "ai", "Inserted AI result at caret.");
        StateHasChanged();
    }

    // ── Spec 027 T017/T018 (US2) — lightweight refactoring menu + preview ────────────────
    private void OpenRefactorMenu() => _showRefactorMenu = true;
    private void CloseRefactorMenu() => _showRefactorMenu = false;
    private void CloseRefactorPreview() => _refactorPreview = null;

    /// <summary>Run a lightweight op against the whole document and show its before/after.
    /// Parser-only — no engine round-trip (the op runs in <see cref="IRefactoringService"/>).</summary>
    private async Task PreviewLightweightAsync(LightweightRefactorKind kind, string label)
    {
        _showRefactorMenu = false;
        _pendingRefactorKind = kind;
        _refactorTitle = label;
        try
        {
            // Whole-document scope (selStart/selLen = 0); the op's Apply mirrors the engine.
            _refactorPreview = await Refactoring.PreviewLightweightAsync(kind, _currentText);
        }
        catch (Exception ex)
        {
            _status = $"Refactor preview failed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "refactor", _status);
            _refactorPreview = null;
        }
        StateHasChanged();
    }

    /// <summary>Commit the previewed lightweight refactoring — replace the editor content as a
    /// single undoable edit (CodeMirror Ctrl+Z restores the prior text).</summary>
    private async Task ApplyLightweightAsync()
    {
        if (_refactorPreview is not { Changed: true } || _editor == null)
        {
            _refactorPreview = null;
            return;
        }
        var after = await Refactoring.ApplyLightweightAsync(_pendingRefactorKind, _currentText);
        await _editor.SetTextAsync(after);
        _currentText = after;
        _refactorPreview = null;
        _status = $"Applied: {_refactorTitle}.";
        Diagnostics.Log(DiagnosticLevel.Info, "refactor", _status);
        StateHasChanged();
    }

    // ── Spec 027 T020/T021/T022 (US3) — heavyweight (bridge) refactorings ─────────────────
    private void OpenHeavyDialog(HeavyOp op)
    {
        _showRefactorMenu = false;
        _refactorTitle = op.Label;
        _heavyInput = op;
        StateHasChanged();
    }

    private void CloseHeavyDialog() => _heavyInput = null;
    private void CloseHeavyPreview() => _heavyPreview = null;

    /// <summary>Run the bridge preview for a heavyweight op using the collected inputs.</summary>
    private async Task HeavyPreviewAsync(RefactorInputDialog.RefactorInputs inputs)
    {
        var op = _heavyInput;
        _heavyInput = null;
        if (op == null) return;
        _heavyInputs = inputs;
        try
        {
            // Pin the exact text the preview offsets are computed against, so the later apply
            // reconstructs from THIS text — not whatever the editor holds after the user may have
            // typed while the confirm dialog was open (stale offsets would corrupt the document).
            _heavyPreviewDocText = _currentText;
            var request = new RefactorPreviewRequest
            {
                SessionId = string.Empty,
                OperationType = op.OperationType,
                DocumentText = _currentText,
                OriginalIdentifier = inputs.OriginalIdentifier,
                NewName = inputs.NewName,
                ExtractedUnitName = inputs.ExtractedUnitName,
            };
            var response = await Refactoring.PreviewAsync(request, CancellationToken.None);
            if (response == null)
            {
                // HeavyAvailable was true at menu time but the bridge dropped; surface a status.
                _status = "Heavyweight refactoring is unavailable (engine not reachable).";
                Diagnostics.Log(DiagnosticLevel.Warn, "refactor", _status);
            }
            else
            {
                _heavyPreview = response;
            }
        }
        catch (Exception ex)
        {
            _status = $"Refactor preview failed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "refactor", _status);
        }
        StateHasChanged();
    }

    /// <summary>Commit a previewed heavyweight refactoring: send the approved changes over the
    /// bridge, then replace the editor content with the applied result.</summary>
    private async Task ApplyHeavyAsync()
    {
        var preview = _heavyPreview;
        var inputs = _heavyInputs;
        _heavyPreview = null;
        if (preview is not { CanApply: true } || _editor == null) return;

        var op = HeavyweightOps.FirstOrDefault(o => o.Label == _refactorTitle);
        try
        {
            var apply = new RefactorApplyRequest
            {
                SessionId = string.Empty,
                OperationType = op?.OperationType ?? 0,
                ApprovedChanges = preview.Changes,
                // The engine reconstructs UpdatedDocumentText by applying the approved changes onto
                // this original text (change offsets are absolute into it). Use the text captured at
                // PREVIEW time (not the live _currentText) so the offsets stay valid even if the user
                // edited while the confirm dialog was open. Without any text the engine applies onto an
                // empty buffer and returns a truncated document, which we'd write back — wiping work.
                DocumentText = _heavyPreviewDocText,
            };
            var response = await Refactoring.ApplyAsync(apply, CancellationToken.None);
            if (response is { Success: true } && !string.IsNullOrEmpty(response.UpdatedDocumentText))
            {
                await _editor.SetTextAsync(response.UpdatedDocumentText);
                _currentText = response.UpdatedDocumentText;
                _status = $"Applied: {_refactorTitle} ({response.AppliedCount} change(s)).";
            }
            else
            {
                _status = response == null
                    ? "Heavyweight refactoring is unavailable (engine not reachable)."
                    : $"Refactor apply reported no document change ({_refactorTitle}).";
            }
            Diagnostics.Log(DiagnosticLevel.Info, "refactor", _status);
        }
        catch (Exception ex)
        {
            _status = $"Refactor apply failed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "refactor", _status);
        }
        StateHasChanged();
    }

    // ── Spec 041 (R37) — page-scoped keys ─────────────────────────────────────────────────────────

    /// <summary>Install the document-level key listener for the commands this page registered. Only
    /// those keys are claimed, so a key whose command is not built yet still does what the browser does.</summary>
    private async Task InitWorkspaceKeysAsync()
    {
        try
        {
            _workspaceModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-workspace.js");
            _selfRef = DotNetObjectReference.Create(this);
            var bindings = WorkspaceKeyMap.For(_contextActions.Select(a => a.Id));
            await _workspaceModule.InvokeVoidAsync("initKeys", _selfRef, bindings);
            await _workspaceModule.InvokeVoidAsync("observeWorkspace", _workspaceEl, _selfRef);
            _uiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
            await _uiModule.InvokeVoidAsync("installHelpTooltips");
        }
        catch (JSDisconnectedException) { /* tab closing */ }
        catch (JSException ex)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "editor", $"Keyboard shortcuts unavailable: {ex.Message}");
        }
    }

    /// <summary>Called by akml-workspace.js for a claimed key. Runs the registered command, unless it
    /// says it is not available right now (Execute while a query runs).</summary>
    [JSInvokable]
    public async Task OnWorkspaceKey(string commandId)
    {
        var action = _contextActions.FirstOrDefault(a => a.Id == commandId)
                     ?? Commands.Snapshot().FirstOrDefault(a => a.Id == commandId);
        if (action == null || !action.IsAvailable) return;
        await action.Run();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Spec 030 — drop our ⌘P palette actions FIRST so a late palette open can't run a closure
        // over the editor we're tearing down.
        _commandRegistration?.Dispose();
        // Spec 041 — stop claiming the editor page's keys before anything else is torn down.
        if (_workspaceModule != null)
        {
            try
            {
                await _workspaceModule.InvokeVoidAsync("disposeKeys");
                await _workspaceModule.InvokeVoidAsync("unobserveWorkspace");
                await _workspaceModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* tab closing */ }
        }
        _selfRef?.Dispose();
        // Spec 030 — Phase 5: drop the connection-state subscription so the disposed page isn't
        // re-rendered on a later connect/disconnect.
        SqlConn.StateChanged -= OnSqlConnStateChanged;
        Layout.Changed -= OnLayoutChanged;
        Document.Changed -= OnDocumentChanged;
        _analyseCts?.Cancel();
        _analyseCts?.Dispose();
        await SessionStore.FlushAsync();
        await Diagnostics.FlushAsync();
        if (_uiModule != null)
        {
            try { await _uiModule.InvokeVoidAsync("disposeHelpTooltips"); await _uiModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* tab closing */ }
        }
    }
}
