    /// <summary>web History "Re-execute": when navigated to with <c>?autorun=1</c>, run the restored
    /// document once. The restored text lands AFTER firstRender (the session restore is async), so we
    /// wait — across renders — until <see cref="_initialText"/> is populated rather than firing on
    /// firstRender (where it is still empty). The flag stays PENDING until the connection is up — on a
    /// hard-reload/connection race the restored text can land before
    /// <see cref="ISqlConnectionService.IsConnected"/> flips true, so a later render (when the connection
    /// comes up) retries. It is CONSUMED exactly once we are connected, regardless of whether the run
    /// proceeds. If a manual execute is already in flight at that moment the autorun is SUPPRESSED (not
    /// duplicated): the flag was already cleared, so the post-manual-run re-render cannot re-fire it.
    /// After a run proceeds the URL flag is stripped so a manual refresh doesn't re-run.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page's commands are registered at the end of OnInitializedAsync, which can finish after the
        // first render: claim the keys on the first render that has them, so F5 never reaches the browser.
        if (!_keysInitialized && _contextActions.Count > 0)
        {
            _keysInitialized = true;
            await InitWorkspaceKeysAsync();
        }

        if (_focusAfterRender is { } focusId && _workspaceModule != null)
        {
            _focusAfterRender = null;
            try { await _workspaceModule.InvokeVoidAsync("focusTestId", focusId); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }

        // Wait for the async restore to populate the document; don't consume the flag until it has.
        if (!_autorunPending || string.IsNullOrWhiteSpace(_initialText)) return;
        if (!SqlConn.IsConnected) return;   // stay pending until the connection is up
        _autorunPending = false;            // connected -> consume exactly once
        if (_executing) return;             // a manual run is already in flight -> don't double-run

        _executing = true;
        try { await RunSqlAsync(_initialText, 1); }
        finally { _executing = false; _activeQueryId = null; }

        Nav.NavigateTo(new Uri(Nav.Uri).GetLeftPart(UriPartial.Path), replace: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelExecuteAsync()
    {
        var qid = _activeQueryId;
        if (!string.IsNullOrEmpty(qid))
        {
            await QueryExec.CancelAsync(qid, CancellationToken.None);
        }
    }

    /// <summary>After a successful inline-CRUD Apply, re-run the last query so the grid refreshes
    /// (and the tints clear). Run-immediately — no confirm.</summary>
    private async Task OnAppliedReExecuteAsync()
    {
        if (string.IsNullOrWhiteSpace(_lastExecutedSql) || !SqlConn.IsConnected) return;

        // Refresh by re-running the query ONLY when it is a single read-only SELECT. Re-running a
        // multi-statement batch or any mutating statement would REPEAT its side effects on the
        // persistent connection: a `CREATE TABLE #t; …; SELECT` errors ("object already exists") and,
        // worse, an `INSERT …; SELECT` would DUPLICATE the inserted rows. The Apply already committed
        // and the grid already shows the committed values with tints cleared (ResetEditState ran before
        // this callback), so skipping the auto-refresh is safe — the user can re-Execute manually to
        // pick up server-side recomputes (triggers / computed columns).
        if (!QueryRefreshSafety.IsSingleReadOnlySelect(_lastExecutedSql)) return;

        // Share the same reentry guard as ExecuteAsync so a manual Execute can't race the
        // auto-refresh on the serial connection (and vice-versa).
        if (_executing) return;
        _executing = true;
        try
        {
            _activeQueryId = Guid.NewGuid().ToString("N");
            Workspace.Begin();
            var result = await QueryExec.ExecuteAsync(_lastExecutedSql, _maxRows, _timeoutSeconds, _activeQueryId, CancellationToken.None);
            ShowResult(result, _selectionStartLine, chooseTab: false); // keep the user on the tab they are on.
        }
        finally
        {
            _executing = false;
            _activeQueryId = null;
            StateHasChanged();
        }
    }

    // Spec 041 (R52, FR-052): the quick control changes this session only; the saved defaults live in
    // Settings › Queries (saving one there clears the override).
    private void OnMaxRowsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && v > 0)
        {
            _maxRows = Math.Clamp(v, 1, 100_000);
            ExecSettings.SessionOverride = new SessionOverride
            {
                MaxRows = _maxRows,
                CommandTimeoutSeconds = ExecSettings.SessionOverride?.CommandTimeoutSeconds,
            };
        }
    }

    private void OnTimeoutChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && v > 0)
        {
            _timeoutSeconds = Math.Clamp(v, 1, 600);
            ExecSettings.SessionOverride = new SessionOverride
            {
                MaxRows = ExecSettings.SessionOverride?.MaxRows,
                CommandTimeoutSeconds = _timeoutSeconds,
            };
        }
    }

