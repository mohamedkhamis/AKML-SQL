        // The body's $SELECTEDTEXT$ token receives the current selection; remaining
        // $Name$/$CURSOR$ tab-stops are driven by the editor's snippet expander.
        var body = string.Join("\n", snippet.Body);
        await _editor.SurroundSelectionAsync(body);
        Diagnostics.Log(DiagnosticLevel.Info, "snippets", $"Surrounded with '{snippet.Metadata.Shortcode}'.");
    }

    // ── Spec 041 (R33–R38) — the workspace: View commands, splitters, folding ──────────────────────

    // The palette's check marks say what is on screen, like the View menu: a folded panel is not checked.
    WorkspaceLayout IWorkspaceViewHost.Layout => Layout.Current with { SchemaVisible = SchemaShown, AiVisible = AiShown };

    public Task ToggleNavAsync() => Layout.SetAsync(WorkspaceLayoutFields.NavVisible, !Layout.Current.NavVisible);

    public Task ToggleSchemaAsync()
    {
        if (Layout.Current.SchemaAutoHide)
        {
            _schemaPeek = !_schemaPeek;
            StateHasChanged();
            return Task.CompletedTask;
        }
        return SchemaShown ? HidePanelAsync(WorkspacePanel.Schema) : ShowPanelAsync(WorkspacePanel.Schema);
    }

    public Task ToggleAiAsync() => AiShown ? HidePanelAsync(WorkspacePanel.Ai) : ShowPanelAsync(WorkspacePanel.Ai);

    public Task ToggleResultsAsync() => Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, !Layout.Current.ResultsVisible);

    /// <summary>
    /// Show a side panel at its previous size (FR-043): it becomes the panel that folds last, and when the
    /// window is too narrow even for it alone it shows anyway until the width changes — a click is never a no-op.
    /// </summary>
    private async Task ShowPanelAsync(WorkspacePanel panel)
    {
        _keep = panel;
        string field = panel == WorkspacePanel.Schema ? WorkspaceLayoutFields.SchemaVisible : WorkspaceLayoutFields.AiVisible;
        bool visible = panel == WorkspacePanel.Schema ? Layout.Current.SchemaVisible : Layout.Current.AiVisible;
        if (!visible) await Layout.SetAsync(field, true);
        var fold = Fold;
        if (panel == WorkspacePanel.Schema ? fold.SchemaFolded : fold.AiFolded) _forced = panel;
        else if (_forced != panel) _forced = WorkspacePanel.None;
        StateHasChanged();
    }

    private Task HidePanelAsync(WorkspacePanel panel)
    {
        if (_keep == panel) _keep = WorkspacePanel.None;
        if (_forced == panel) _forced = WorkspacePanel.None;
        return Layout.SetAsync(panel == WorkspacePanel.Schema ? WorkspaceLayoutFields.SchemaVisible : WorkspaceLayoutFields.AiVisible, false);
    }

    /// <summary>Enter/Space on a splitter: collapse its region (<see cref="WorkspacePanel.None"/> = results) and
    /// move focus to the strip it leaves.</summary>
    private async Task CollapseFromSplitterAsync(WorkspacePanel panel)
    {
        if (panel == WorkspacePanel.None) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, false);
        else await HidePanelAsync(panel);
        _focusAfterRender = panel switch
        {
            WorkspacePanel.Schema => "workspace-edge-left",
            WorkspacePanel.Ai => "workspace-edge-right",
            _ => "workspace-edge-bottom",
        };
        StateHasChanged();
    }

    /// <summary>An edge strip: its region back at its previous size, and focus on the splitter beside it.</summary>
    private async Task RestoreFromStripAsync(WorkspacePanel panel)
    {
        if (panel == WorkspacePanel.None) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
        else await ShowPanelAsync(panel);
        _focusAfterRender = panel switch
        {
            WorkspacePanel.Schema => "workspace-splitter-left",
            WorkspacePanel.Ai => "workspace-splitter-right",
            _ => "workspace-splitter-bottom",
        };
        StateHasChanged();
    }

