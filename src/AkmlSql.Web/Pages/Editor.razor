        catch (Exception)
        {
            // An engine style whose engine is not answering: format with the default until the
            // style picker hands the style over (it does once the engine answers).
            _activeProfile = null;
        }

        // T044: load analyser settings.
        if (_disposed) return;
        var settings = await AnalysisSettings.GetAsync();
        if (_disposed) return;
        _autoAnalyseOnFormat = settings.AutoAnalyseOnFormat;
        _analysisEnabled = settings.Enabled;
        _problemsFilter = settings.ProblemsFilter;

        // T048: restore the diagnostics ring buffer.
        await Diagnostics.RestoreAsync();
        if (_disposed) return;
        Diagnostics.Log(DiagnosticLevel.Info, "editor", "Editor page mounted.");

        // Spec 025 US4 / spec 030 loop fix: point the schema tree at the ACTIVE SQL connection's
        // (server, database) — the SAME key MainLayout passes to SchemaSync.StartAsync, so the tree
        // finds the snapshot the sync populated. Re-evaluated on every SQL connection state change
        // (OnSqlConnStateChanged) and every tab switch.
        RefreshSchemaTarget();

        // Spec 030 — Phase 5: seed the execute caps from the store.
        // Spec 041 (R52): the toolbar shows the effective caps — this session's quick-control override, else the
        // defaults saved in Settings › Queries. The grid options come from the saved defaults only.
        var execSettings = await ExecSettings.GetEffectiveAsync();
        if (_disposed) return;
        _maxRows = execSettings.MaxRows;
        _timeoutSeconds = execSettings.CommandTimeoutSeconds;
        _showColumnTypes = execSettings.ShowColumnTypes;
        _retainLineBreaksOnCopy = execSettings.RetainLineBreaksOnCopy;
        SqlConn.StateChanged += OnSqlConnStateChanged;
        Bridge.StateChanged += OnBridgeStateChanged;
        ConnManager.Closed += OnConnectDialogClosed;
        // The saved connections (the tabs' "not saved" mark) are read without holding up the page: the commands — and with them
        // the keys the page claims — are registered at once, as before, and the tooltips follow when the read ends.
        _ = ReloadSavedConnectionsAsync();

        // Spec 030 — register this page's context actions with the ⌘P palette. These close over the
        // live editor + page handlers; the registration token is disposed in DisposeAsync.
        _commandRegistration = Commands.Register(_contextActions);

        // Spec 043 (FR-009): the tab shown now connects again when that needs no password.
        _ = InvokeAsync(() => ReattachIfQuietAsync(Tab));
    }

    // Spec 042 (FR-092): what this connection kind may use. Stateless, so it follows a switch of connection by itself.
    private SurfaceGate? _surfaces;
    private SurfaceGate Surfaces => _surfaces ??= new SurfaceGate(DialectGate, Notifications);

    private void OnSqlConnStateChanged()
    {
        RefreshSchemaTarget();
        // Another server, database, login or kind for the active tab: its last run's outcome in the status bar describes the old
        // one, and its problems were found for the old dialect - clear the one, and read the document again for the other.
        if (Tab is { } tab)
        {
            int generation = tab.Session.ConnectionGeneration;
            if (_seenGenerations.TryGetValue(tab.Id, out var seen) && seen != generation)
            {
                if (!tab.IsExecuting) tab.Run = RunSnapshot.Idle;
                Workspace.ClearOutcome();
                ScheduleFindingsRefresh(tab);
            }
            _seenGenerations[tab.Id] = generation;
        }
        InvokeAsync(StateHasChanged);
    }

    // The connection generation each tab was last seen under (a change clears its outcome and re-reads its problems).
    private readonly Dictionary<string, int> _seenGenerations = new();

    // The Problems list is a snapshot of the last Analyse. When the connection changes kind or server it is read again for the
    // new connection, quietly: no tab switch, no notification, and not counted as an Analyse.
    private CancellationTokenSource? _refreshFindingsCts;

    private void ScheduleFindingsRefresh(QueryTab tab)
    {
        if (tab.Findings == null || !_analysisEnabled) return;
        _refreshFindingsCts?.Cancel();
        var cts = _refreshFindingsCts = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(800, cts.Token);
                // T034: only the tab on screen is analysed (the analyser follows the active tab's dialect and session).
                if (!ReferenceEquals(tab, Tab))
                {
                    tab.AnalysisPending = true;
                    return;
                }
                var findings = await Analyser.AnalyseAsync(tab.Text, null, cts.Token);
                if (cts.IsCancellationRequested || _disposed || tab.Findings == null) return;
                tab.Findings = findings;
                await ShowDiagnosticsAsync(tab);
                StateHasChanged();
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                Diagnostics.Log(DiagnosticLevel.Warn, "analyser", $"The problems could not be refreshed: {ex.Message}");
            }
        });
    }

    /// <summary>
    /// Align the schema-tree target with the live SQL connection so its (server, database) lookup key
    /// matches what MainLayout passes to <c>SchemaSync.StartAsync</c> (<c>SqlConn.Server</c> /
    /// <c>SqlConn.Database</c>). Cleared when no SQL connection is open — the tree then offers to connect
    /// (spec 041 FR-048).
    /// </summary>
    private void RefreshSchemaTarget()
    {
        if (SqlConn.IsConnected && !string.IsNullOrEmpty(SqlConn.Server) && !string.IsNullOrEmpty(SqlConn.Database))
        {
            _activeServerIdentity = SqlConn.SchemaIdentity ?? SqlConn.Server;
            _activeDatabaseName = SqlConn.Database;
        }
        else
        {
            _activeServerIdentity = null;
            _activeDatabaseName = null;
        }
    }

    // ── Spec 030 — Phase 5: execute + caps + apply-refresh ───────────────────────────────────────

    private Task ExecuteAsync() => Tab is { } tab ? ExecuteTabAsync(tab) : Task.CompletedTask;

    /// <summary>
    /// Run the tab's query. Reads the LIVE editor text (selection-or-whole-doc) and runs it on the tab's own session.
    /// Spec 043: the tab is captured before the first await (plan › Design notes › Execute), so switching tabs while it runs
    /// changes nothing about where the reply goes; a tab with no live connection connects first (FR-009, US1 scenario 7).
    /// Triggered by the toolbar button, F5 and the CM6 Mod-Enter keymap (via EditorComponent.OnExecute).
    /// </summary>
    private async Task ExecuteTabAsync(QueryTab tab)
    {
        if (tab.IsExecuting || _editor == null || tab.IsClosing) return;
        // Claim the tab's slot BEFORE any await so a second trigger (toolbar + Mod-Enter) can't reenter
        // through the JS-interop awaits below. The finally always releases it.
        tab.IsExecuting = true;
        tab.CancelRequested = false;
        try
        {
            // LIVE text — selection if any, else the whole document — and where it starts, so an error's
            // line maps back to the document (spec 041 R24).
            // The completion list is not left open over the editor while the query runs.
            await _editor.CloseCompletionAsync();
            var (sql, startLine, startColumn) = await ReadExecuteTextAsync(tab);
            if (string.IsNullOrWhiteSpace(sql)) return;

            // Review WEB-08: an Apply waiting for its reply owns the grid's edits; a new result would orphan them.
            if (RefuseWhileApplying(tab)) return;

            // Spec 041 (FR-015): a new result replaces the grid, so its pending edits go — ask first.
            if (!await ConfirmDiscardPendingEditsAsync(tab)) return;

            // A connected tab while the link to the engine is down: nothing can be sent, and the engine may well still hold the
            // session (spec 043 edge case: a link drop changes nothing), so the tab stays as it is.
            if (tab.Session.IsConnected && Bridge.State != BridgeState.Open)
            {
                Notifications.Notify(EngineAwayText, NotificationKind.Warning);
                return;
            }

            if (!await EnsureConnectedAsync(tab)) return;

            // Cancel, or a close of the tab, while it was connecting: the query is not sent.
            if (tab.IsClosing || tab.CancelRequested)
            {
                if (!tab.IsClosing) Notifications.Notify("Cancelled before it ran.", NotificationKind.Info);
                return;
            }

            await RunSqlAsync(tab, sql, startLine, startColumn);
        }
        finally
        {
            await EndRunAsync(tab);
        }
    }

    /// <summary>A run of <paramref name="tab"/> ended: its slot is free; a tab closed while it ran releases its session now.</summary>
    private async Task EndRunAsync(QueryTab tab)
    {
        tab.IsExecuting = false;
        tab.CancelRequested = false;
        tab.ActiveQueryId = null;
        tab.RunStartedAt = null;
        tab.Session.IsBusy = false;
        if (tab.IsClosing) await ReleaseAsync(tab);
        if (!_disposed) StateHasChanged();
        // The page that started the run may be gone (History and back): the page on screen now shows the finished run.
        QueryTabs.NotifyChanged();
    }

    internal const string EngineAwayText =
        "The engine cannot be reached right now, so the query was not sent. The query tab keeps its connection; run it again once the status bar shows Live.";

    private async Task<(string Sql, int StartLine, int StartColumn)> ReadExecuteTextAsync(QueryTab tab)
    {
        if (_editor == null || !IsShown(tab)) return (tab.Text, 1, 1);
        var selection = await _editor.GetSelectionInfoAsync();
        if (!string.IsNullOrWhiteSpace(selection.Text))
            return (selection.Text, Math.Max(1, selection.StartLine), Math.Max(1, selection.StartColumn));
        return (await _editor.GetTextAsync(), 1, 1);
    }

    private async Task RunSqlAsync(QueryTab tab, string sql, int startLine, int startColumn)
    {
        await ClearErrorMarkAsync(tab);
        var session = tab.Session;
        tab.LastExecutedSql = sql;
        tab.ActiveQueryId = Guid.NewGuid().ToString("N");
        BeginRun(tab);
        if (ReferenceEquals(tab, Tab) && !Layout.Current.ResultsVisible) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
        StateHasChanged();

        // Only a request the engine received can say the engine lost the session (a reply made in the browser cannot).
        bool sent = Bridge.State == BridgeState.Open && session.IsConnected;
        var result = await QueryExec.ExecuteAsync(session, sql, _maxRows, _timeoutSeconds, tab.ActiveQueryId, CancellationToken.None);
        ShowResult(tab, result, startLine, startColumn, chooseTab: true, engineAnswered: sent);

        // Record into SQL History (fire-and-forget) — NoConnection isn't recorded (nothing ran). Spec 043 (FR-010): under the tab's
        // name and its own history session key.
        if (WebHistoryLogic.ShouldRecord(result.Status))
        {
            // Spec 041 (R27): the database the script ended in (a USE moves it).
            var rec = WebHistoryLogic.BuildRecordRequest(sql, result, session.Server, result.CurrentDatabase ?? session.Database,
                tab.Document.SessionKey ?? string.Empty, tab.Name, session.Kind);
            _ = History.RecordAsync(rec, CancellationToken.None);
        }

        if (result.Status != ExecuteStatus.Ok)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "execute", $"Execute status {result.Status}: {result.ErrorMessage}");
        }
    }

    /// <summary>Spec 043 (T036): the tab's run starts — its own clock and status; the status bar shows it while the tab is active.</summary>
    private void BeginRun(QueryTab tab)
    {
        var now = Workspace.Now;
        tab.RunStartedAt = now;
        tab.Session.IsBusy = true;
        tab.Run = RunSnapshot.Running(now);
        if (ReferenceEquals(tab, Tab)) Workspace.Show(tab.Run);
    }

    private void ShowResult(QueryTab tab, ExecuteQueryResult result, int startLine, int startColumn, bool chooseTab, bool engineAnswered = true)
    {
        tab.Result = result;
        tab.ResultGeneration = tab.Session.ConnectionGeneration;
        tab.ResultReceivedAt = DateTimeOffset.Now;
        tab.SelectionStartLine = startLine;
        tab.SelectionStartColumn = startColumn;
        bool active = ReferenceEquals(tab, Tab);
        // The results tab is the layout's: only the tab on screen moves it.
        if (chooseTab && active)
        {
            _resultsTab = result.ResultSets.Length > 0 && result.Status == ExecuteStatus.Ok
                ? ResultsPaneComponent.ResultsTab
                : ResultsPaneComponent.MessagesTab;
        }
        tab.Run = RunSnapshot.Of(result, tab.RunStartedAt);
        if (active) Workspace.Show(tab.Run);
        tab.ExecuteVersion++;
        tab.LastExecuteStatus = result.Status;

        // Spec 043 (edge case "the engine is lost"): no connection on the engine's side — the tab shows disconnected and keeps its
        // binding; its next run, or showing it when no password is needed, reconnects.
        if (result.Status == ExecuteStatus.NoConnection && engineAnswered) SqlConn.MarkConnectionLost(tab.Session);
        // The run's own USE (or a lost connection) moved the tab's connection generation: that is not a change the outcome
        // describes another target for, so switching back keeps it (FR-005).
        _seenGenerations[tab.Id] = tab.Session.ConnectionGeneration;

        // Spec 042 (FR-043): a PostgreSQL run that created, altered or dropped something shows in the explorer without a manual
        // refresh. The engine says when it has started reloading its catalog (SchemaChangeSignal); this waits for it to settle and
        // fetches the result. The explorer is the active tab's.
        if (active && tab.Session.Kind == AkmlSql.Core.DatabaseKind.PostgreSql && SchemaChangeSignal.RefetchAfter(result))
            _ = RefreshSchemaAfterRunAsync();
    }

    private async Task RefreshSchemaAfterRunAsync()
    {
        try { await SchemaSync.RefreshAsync(); }
        catch (Exception ex) { Diagnostics.Log(DiagnosticLevel.Warn, "schema-sync", $"Refresh after a run failed: {ex.Message}"); }
    }

    /// <summary>The engine understands Parse (it advertises execute.v2).</summary>
    private bool SupportsParse => Array.IndexOf(Bridge.EngineCapabilities ?? Array.Empty<string>(), "execute.v2") >= 0;

    private bool CanParse => !Running && SqlConn.IsConnected && SupportsParse;

    private async Task ParseAsync()
    {
        if (Tab is not { } tab || tab.IsExecuting || _editor == null || !CanParse) return;
        tab.IsExecuting = true;
        try
        {
            var (sql, startLine, startColumn) = await ReadExecuteTextAsync(tab);
            if (string.IsNullOrWhiteSpace(sql)) return;
            if (RefuseWhileApplying(tab)) return;
            if (!await ConfirmDiscardPendingEditsAsync(tab)) return;

            await ClearErrorMarkAsync(tab);
            tab.ActiveQueryId = Guid.NewGuid().ToString("N");
            BeginRun(tab);
            StateHasChanged();
            bool sent = Bridge.State == BridgeState.Open && tab.Session.IsConnected;
            var result = await QueryExec.ParseAsync(tab.Session, sql, _timeoutSeconds, tab.ActiveQueryId, CancellationToken.None);
            ShowResult(tab, result, startLine, startColumn, chooseTab: false, engineAnswered: sent);
            if (ReferenceEquals(tab, Tab)) _resultsTab = ResultsPaneComponent.MessagesTab;
        }
        finally
        {
            await EndRunAsync(tab);
        }
    }

    private async Task OnNavigateToLineAsync(int line)
    {
        if (_editor == null || Tab is not { } tab) return;
        await _editor.GotoLineAsync(line);
        var result = tab.Result;
        var message = result?.MessageDetails?
            .FirstOrDefault(m => ExecuteLineMapper.DocumentLine(tab.SelectionStartLine, result, m) == line);
        var text = message != null ? AkmlSql.Core.Text.SqlMessageText.Format(message) : "Error from the last run.";
        tab.ErrorMark = new EditorDiagnostic(line, 3, text, Source: "execute");
        await ShowDiagnosticsAsync(tab);
    }

    private async Task OnNavigateToPositionAsync(DocumentPosition position)
    {
        if (_editor == null || Tab is not { } tab) return;
        await _editor.GotoPositionAsync(position.Line, position.Column);
        var result = tab.Result;
        var message = result?.MessageDetails?.FirstOrDefault(m =>
            ExecuteLineMapper.DocumentLine(tab.SelectionStartLine, result, m) == position.Line
            && ExecuteLineMapper.DocumentColumn(tab.SelectionStartColumn, m) == position.Column);
        var text = message != null ? AkmlSql.Core.Text.SqlMessageText.Format(message) : "Error from the last run.";
        tab.ErrorMark = new EditorDiagnostic(position.Line, 3, text, StartColumn: position.Column, Source: "execute");
        await ShowDiagnosticsAsync(tab);
    }

    private async Task ClearErrorMarkAsync(QueryTab tab)
    {
        if (tab.ErrorMark == null) return;
        tab.ErrorMark = null;
        await ShowDiagnosticsAsync(tab);
    }

    private async Task ShowDiagnosticsAsync(QueryTab tab)
    {
        if (_editor == null || _disposed) return;
        var shown = new List<EditorDiagnostic>(EditorDiagnostics.FromIssues(tab.Findings?.Issues));
        if (tab.ErrorMark != null) shown.Add(tab.ErrorMark);
        // Spec 043: a reply for a tab the user left meanwhile goes into that tab's kept editor state.
        await _editor.SetDiagnosticsAsync(shown, tab.Id);
    }

    private async Task GoToProblemAsync(bool forward)
    {
        if (_editor == null) return;
        if (!await _editor.GoToProblemAsync(forward))
            Notifications.Notify(Tab?.Findings?.Issues is { Length: > 0 } ? "No more problems." : "No problems to go to. Run Analyse (Ctrl+K, Ctrl+L).", NotificationKind.Info);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        // The page's commands are built before the first await of OnInitializedAsync: the first render claims their keys,
        // so F5 never reaches the browser, even while the page still loads.
        if (!_keysInitialized && _contextActions.Count > 0)
        {
            _keysInitialized = true;
            await InitWorkspaceKeysAsync();
        }

        if (_focusAfterRender is { } focusId && _workspaceModule != null)
        {
            _focusAfterRender = null;
            try { await _workspaceModule.InvokeVoidAsync("focusTestId", focusId); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }

        // Spec 043: the editor shows the active tab (its first show seeds it with the tab's text). A tab being closed is never
        // shown again: the close shows the next one.
        if (_editor != null && Tab is { IsClosing: false } tab && _editor.CurrentTabId != tab.Id) await ShowTabAsync(tab);

        await RunAutorunAsync();
    }

    /// <summary>
    /// web History "Re-execute" (spec 043 R11: in its own tab): run the tab's query once. The flag stays PENDING until the tab's
    /// connection is up — a restored tab reconnects on its own when that needs no password — and is CONSUMED exactly once it is,
    /// whether the run proceeds or not. A run already in flight in that tab SUPPRESSES it rather than doubling it.
    /// </summary>
    private async Task RunAutorunAsync()
    {
        if (Tab is not { AutorunPending: true } tab || string.IsNullOrWhiteSpace(tab.Text)) return;
        if (!tab.Session.IsConnected) return;   // stay pending until the tab's connection is up
        tab.AutorunPending = false;             // connected -> consume exactly once
        var kindRequired = tab.AutorunKind;
        var autorunSql = tab.AutorunSql;
        tab.AutorunKind = null;
        tab.AutorunSql = null;
        await QueryTabs.PersistAsync(tab);
        if (tab.IsExecuting) return;            // a manual run is already in flight -> don't double-run
        // Review of US1: only the query History asked for runs. A tab edited since is someone's draft: it is never run unasked.
        if (autorunSql == null || !string.Equals(tab.Text, autorunSql, StringComparison.Ordinal)) return;

        // History re-executed it on a kind of server the tab is not connected to: a script written for one kind of server is never
        // run on the other. It stays open, unrun, and the user is told why.
        if (kindRequired is { } kind && kind != (int)tab.Session.Kind)
        {
            Notifications.Notify($"This query ran on {WebHistoryLogic.KindLabel(kind)}. The connection is {WebHistoryLogic.KindLabel((int)tab.Session.Kind)}, so it was opened but not run.",
                NotificationKind.Info);
            return;
        }

        tab.IsExecuting = true;
        try { await RunSqlAsync(tab, tab.Text, 1, 1); }
        finally { await EndRunAsync(tab); }
    }

    private void StripAutorunFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        if (uri.Query.Contains("autorun=", StringComparison.Ordinal)) Nav.NavigateTo(uri.GetLeftPart(UriPartial.Path), replace: true);
    }

    private async Task CancelExecuteAsync()
    {
        if (Tab is not { } tab) return;
        var qid = tab.ActiveQueryId;
        if (string.IsNullOrEmpty(qid))
        {
            // Still connecting (a restored tab reconnecting): the query is not sent once the connect ends.
            if (tab.IsExecuting) tab.CancelRequested = true;
            return;
        }
        await QueryExec.CancelAsync(tab.Session, qid, CancellationToken.None);
    }

    private async Task OnAppliedReExecuteAsync(QueryTab tab)
    {
        if (string.IsNullOrWhiteSpace(tab.LastExecutedSql) || !tab.Session.IsConnected || tab.IsClosing) return;

        // PostgreSQL (spec 042, FR-133): the write returned the rows as the server stored them and the grid already shows
        // them, so the script is not run again - not even a single SELECT - and only the written rows were ever read back.
        if (tab.Session.Kind == AkmlSql.Core.DatabaseKind.PostgreSql) return;

        // Refresh by re-running the query ONLY when it is a single read-only SELECT. Re-running a
        // multi-statement batch or any mutating statement would REPEAT its side effects on the
        // persistent connection: a `CREATE TABLE #t; …; SELECT` errors ("object already exists") and,
        // worse, an `INSERT …; SELECT` would DUPLICATE the inserted rows. The Apply already committed
        // and the grid already shows the committed values with tints cleared (ResetEditState ran before
        // this callback), so skipping the auto-refresh is safe — the user can re-Execute manually to
        // pick up server-side recomputes (triggers / computed columns).
        if (!QueryRefreshSafety.IsSingleReadOnlySelect(tab.LastExecutedSql)) return;

        // Share the tab's reentry guard with Execute so a manual Execute can't race the
        // auto-refresh on the tab's serial connection (and vice-versa).
        if (tab.IsExecuting) return;
        tab.IsExecuting = true;
        try
        {
            tab.ActiveQueryId = Guid.NewGuid().ToString("N");
            BeginRun(tab);
            bool sent = Bridge.State == BridgeState.Open && tab.Session.IsConnected;
            var result = await QueryExec.ExecuteAsync(tab.Session, tab.LastExecutedSql, _maxRows, _timeoutSeconds, tab.ActiveQueryId, CancellationToken.None);
            ShowResult(tab, result, tab.SelectionStartLine, tab.SelectionStartColumn, chooseTab: false, engineAnswered: sent); // keep the user on the tab they are on.
        }
        finally
        {
            await EndRunAsync(tab);
        }
    }

    // Spec 041 (R52, FR-052): the quick control changes this session only; the saved defaults live in
    // Settings › Queries (saving one there clears the override).
    private void OnMaxRowsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && v > 0)
        {
            _maxRows = Math.Clamp(v, 1, 100_000);
            ExecSettings.SessionOverride = new SessionOverride
            {
                MaxRows = _maxRows,
                CommandTimeoutSeconds = ExecSettings.SessionOverride?.CommandTimeoutSeconds,
            };
        }
    }

    private void OnTimeoutChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v) && v > 0)
        {
            _timeoutSeconds = Math.Clamp(v, 1, 600);
            ExecSettings.SessionOverride = new SessionOverride
            {
                MaxRows = ExecSettings.SessionOverride?.MaxRows,
                CommandTimeoutSeconds = _timeoutSeconds,
            };
        }
    }

    private bool RefuseWhileApplying(QueryTab tab)
    {
        if (!_panes.TryGetValue(tab.Id, out var pane) || !pane.IsApplying) return false;
        Notifications.Notify("Wait for the grid's changes to finish applying.", NotificationKind.Info);
        return true;
    }

    private async Task<bool> ConfirmDiscardPendingEditsAsync(QueryTab tab)
    {
        if (_disposed || !_panes.TryGetValue(tab.Id, out var pane)) return true;
        return await ConfirmDiscardAsync(pane.PendingEditCount);
    }

    private async Task<bool> ConfirmDiscardAsync(int n)
    {
        if (n == 0) return true;
        return await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = $"Discard {n} pending edit{(n == 1 ? "" : "s")}?",
            Message = "The changes in the results grid have not been applied. Discard them?",
            ConfirmLabel = "Discard",
            CancelLabel = "Keep editing",
            Destructive = true,
        });
    }

    private async Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        // Spec 043: leaving the page unmounts every tab's grids, so their pending edits are counted together.
        int pending = QueryTabs.Tabs.Sum(t => _panes.TryGetValue(t.Id, out var p) ? p.PendingEditCount : 0);
        if (!await ConfirmDiscardAsync(pending)) context.PreventNavigation();
    }

    private IEnumerable<CommandAction> BuildContextActions()
    {
        // Spec 041 (R37, FR-028): F5 and Ctrl+F5. While a query runs neither is offered (the key does nothing).
        // Spec 043 (US1 scenario 7): a tab with no live connection runs too; it connects first.
        yield return new CommandAction
        {
            Id = "editor:execute", Title = "Execute", Group = CommandGroup.Action,
            Icon = "play", Shortcut = "F5", Run = ExecuteAsync,
            IsEnabled = () => Tab is { IsExecuting: false },
        };
        yield return new CommandAction
        {
            Id = "editor:parse", Title = "Parse (check syntax on the server)", Group = CommandGroup.Action,
            Icon = "file-check", Shortcut = "Ctrl+F5", Run = ParseAsync,
            IsEnabled = () => CanParse,
        };
        yield return new CommandAction
        {
            Id = "editor:format", Title = "Format SQL", Group = CommandGroup.Action,
            Icon = "wand-sparkles", Shortcut = "Ctrl+K Ctrl+F", Run = FormatAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:analyse", Title = "Analyse SQL", Group = CommandGroup.Action,
            Icon = "search-check", Shortcut = "Ctrl+K Ctrl+L", Run = AnalyseAsync,
        };
        // Spec 041 (T200, R39): through the palette — CodeMirror's own F8 for this is the Schema panel's key.
        yield return new CommandAction
        {
            Id = "editor:next-problem", Title = "Next problem", Group = CommandGroup.Action,
            Icon = "arrow-down", Run = () => GoToProblemAsync(forward: true),
        };
        yield return new CommandAction
        {
            Id = "editor:previous-problem", Title = "Previous problem", Group = CommandGroup.Action,
            Icon = "arrow-up", Run = () => GoToProblemAsync(forward: false),
        };
        yield return new CommandAction
        {
            Id = "editor:refactor", Title = "Refactor…", Group = CommandGroup.Action,
            Icon = "replace", Run = () => { OpenRefactorMenu(); StateHasChanged(); return Task.CompletedTask; },
            // Spec 042 (FR-092): off on a PostgreSQL connection, with the reason on the palette row.
            IsEnabled = () => Surfaces.IsEnabled(WorkspaceSurface.Refactor),
            DisabledReason = () => UnsupportedSurfaces.Reason(WorkspaceSurface.Refactor, DialectGate.Kind),
        };
        yield return new CommandAction
        {
            Id = "editor:new", Title = "New query", Group = CommandGroup.File,
            Icon = "file-plus", Shortcut = WorkspaceKeyMap.DisplayFor("editor:new"), Run = NewDocumentAsync,
            // Spec 043 (FR-013): at the limit the palette says why.
            IsEnabled = () => !AtTabLimit,
            DisabledReason = () => AtTabLimit ? QueryTabs.LimitText : null,
        };
        yield return new CommandAction
        {
            Id = "editor:open", Title = "Open file…", Group = CommandGroup.File,
            Icon = "folder-open", Shortcut = WorkspaceKeyMap.DisplayFor("editor:open"), Run = OpenFilePickerAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:save", Title = "Save", Group = CommandGroup.File,
            Icon = "save", Shortcut = WorkspaceKeyMap.DisplayFor("editor:save"), Run = SaveAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:saveas", Title = "Save as…", Group = CommandGroup.File,
            Icon = "save-all", Shortcut = WorkspaceKeyMap.DisplayFor("editor:saveas"), Run = SaveAsAsync,
        };
        // Spec 043 (FR-012, contracts/web-ui.md §2): the query tabs from the keyboard and the palette.
        yield return new CommandAction
        {
            Id = "editor:close-tab", Title = "Close query tab", Group = CommandGroup.File,
            Icon = "x", Shortcut = WorkspaceKeyMap.DisplayFor("editor:close-tab"), Run = CloseActiveTabAsync,
            IsEnabled = () => Tab != null,
        };
        yield return new CommandAction
        {
            Id = "editor:next-tab", Title = "Next query tab", Group = CommandGroup.View,
            Icon = "arrow-right", Shortcut = WorkspaceKeyMap.DisplayFor("editor:next-tab"), Run = () => StepTabAsync(+1),
            IsEnabled = () => QueryTabs.Tabs.Count > 1,
        };
        yield return new CommandAction
        {
            Id = "editor:previous-tab", Title = "Previous query tab", Group = CommandGroup.View,
            Icon = "arrow-left", Shortcut = WorkspaceKeyMap.DisplayFor("editor:previous-tab"), Run = () => StepTabAsync(-1),
            IsEnabled = () => QueryTabs.Tabs.Count > 1,
        };
        yield return new CommandAction
        {
            Id = "editor:surround", Title = "Surround selection with…", Group = CommandGroup.Action,
            Icon = "brackets", Shortcut = "Ctrl+K Ctrl+S", Run = OpenSurroundPickerAsync,
        };
    }

    /// <summary>
    /// Spec 043 (R6): the editor reports a change with the tab it was typed in, which may no longer be the active one by the time
    /// the report is handled. The tab's text, modified state and record follow it.
    /// </summary>
    private async Task OnTabTextChangedAsync(EditorTabText change)
    {
        if (change.TabId == null) return;   // before the editor shows a tab (its first, empty change): not the user's
        var tab = QueryTabs.Tabs.FirstOrDefault(t => t.Id == change.TabId);
        if (tab == null) return;            // closed meanwhile
        tab.Text = change.Text;
        // An edit before History's Re-execute ran: the run is off (the text is no longer that query).
        if (tab.AutorunPending && !string.Equals(change.Text, tab.AutorunSql, StringComparison.Ordinal))
        {
            tab.AutorunPending = false;
            tab.AutorunKind = null;
            tab.AutorunSql = null;
        }
        if (ReferenceEquals(tab, Tab)) SchemaSync.ReportEditorActive();   // spec 041 (R40, N27): keeps the 30 s schema poll from idling out
        await ClearErrorMarkAsync(tab);
        tab.Document.OnTextChanged(change.Text);
        // T051 debounced save (the store applies its own 500 ms debounce): the whole tab record — text, name, modified state,
        // history session key, engine session id and connection binding.
        await QueryTabs.PersistAsync(tab);
    }

    // ── Spec 041 (R64, FR-072) — documents: New, Open, Save, Save as ────────────────────────────────────

    // ── Spec 043 (R1, R6, R10) — the query tabs ───────────────────────────────────────────────────────────

    /// <summary>A tab was added, closed, renamed or activated (here, from History, or by a reset in Settings).</summary>
    private void OnTabsChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        foreach (var tab in QueryTabs.Tabs) Attach(tab);
        if (Tab is { } active)
        {
            Workspace.SetDocument(active.Name, active.IsModified);
            if (_editor != null && _editor.CurrentTabId != active.Id)
            {
                await ShowTabAsync(active);
                RefreshSchemaTarget();
            }
        }
        StateHasChanged();
    });

    /// <summary>The tab's document flow reads and writes its text through this page's editor (New, Open, Save, Save as).</summary>
    private void Attach(QueryTab tab)
    {
        if (!_attached.Add(tab.Id)) return;
        tab.Document.Attach(new TabText(this, tab), () => ConfirmDiscardPendingEditsAsync(tab));
    }

    /// <summary>One tab's text: the editor's live text while the tab is shown, its kept text otherwise.</summary>
    private sealed class TabText : IEditorText
    {
        private readonly Editor _page;
        private readonly QueryTab _tab;

        public TabText(Editor page, QueryTab tab)
        {
            _page = page;
            _tab = tab;
        }

        public async Task<string> GetTextAsync() => _page.IsShown(_tab) ? await _page._editor!.GetTextAsync() : _tab.Text;

        public async Task SetTextAsync(string text)
        {
            _tab.Text = text ?? string.Empty;
            if (_page._disposed || _page._editor == null) return;
            // The shown tab reports the change like a keystroke; another tab's kept state changes quietly.
            if (_page.IsShown(_tab)) await _page._editor.SetTextAsync(_tab.Text);
            else await _page._editor.SetTextAsync(_tab.Text, _tab.Id);
        }
    }

    private bool IsShown(QueryTab tab) => !_disposed && _editor != null && _editor.CurrentTabId == tab.Id;

    private static AkmlSql.Core.DatabaseKind KindOf(QueryTab? tab) =>
        tab == null ? AkmlSql.Core.DatabaseKind.SqlServer
        : tab.Session.IsConnected ? tab.Session.Kind
        : tab.Session.Binding?.Kind ?? AkmlSql.Core.DatabaseKind.SqlServer;

    // Spec 043 (contracts/web-ui.md §1): the strip — the active tab keeps the doc-name / doc-modified ids of spec 041.
    private IReadOnlyList<TabItem> DocTabs => QueryTabs.Tabs.Select(t =>
    {
        bool active = ReferenceEquals(t, Tab);
        return new TabItem(t.Id, t.Name, TestId: "doc-tab",
            Title: t.CheckingBeforeClose ? $"{t.Name} — checking for an open transaction before it closes…" : TabTitle(t.Name, t.Session, _savedConnections),
            IsModified: t.IsModified,
            LabelTestId: active ? "doc-name" : null, ModifiedTestId: active ? "doc-modified" : null);
    }).ToList();

    /// <summary>
    /// A query tab's tooltip: its name, where it connects, and the tab keys. Spec 043 (edge case "a saved connection that a tab
    /// uses is deleted"; review of US1, gap G3): a connection that is none of the saved ones — its entry was deleted or changed,
    /// or it was never saved — says "not saved"; one saved after it was connected does not. Nothing is said while the saved list
    /// is unknown (<paramref name="saved"/> null).
    /// </summary>
    internal static string TabTitle(string name, SqlSessionState s, IReadOnlyList<SavedSqlConnection>? saved)
    {
        string? where = s.IsConnected ? $"{s.Server}.{s.Database}"
            : s.Binding is { } b ? $"{b.Server}.{b.Database} (not connected)"
            : null;
        if (where != null && saved != null && s.Binding is { } bound && !IsSaved(bound, saved))
            where += " (not saved)";
        return (where == null ? name : $"{name} — {where}") + TabKeysHelp;
    }

    // A connection is saved when the row it was connected from still describes it (a USE may have moved its database), or — for
    // a connection made from typed values, or saved after it connected — when some row describes it. A tab whose row was deleted
    // counts as saved only through another row for the same database too: a row for another database is not "its" connection.
    internal static bool IsSaved(ConnectionBinding bound, IReadOnlyList<SavedSqlConnection> saved)
    {
        if (bound.SavedConnectionId is { Length: > 0 } id)
        {
            if (saved.FirstOrDefault(c => c.Id == id) is { } own) return bound.SameConnectionAs(own);
            return saved.Any(c => bound.SameConnectionAs(c) && string.Equals(c.Database, bound.Database, StringComparison.OrdinalIgnoreCase));
        }
        return saved.Any(bound.SameConnectionAs);
    }

    // The saved connections, for the tabs' "not saved" mark. Read when the page opens and each time the Connect to database
    // dialog closes (it can save, change or delete one); the store is optional, as a test host may not have it.
    private IReadOnlyList<SavedSqlConnection>? _savedConnections;

    private async Task LoadSavedConnectionIdsAsync()
    {
        if (Services.GetService(typeof(ISavedSqlConnectionStore)) is not ISavedSqlConnectionStore store) return;
        try
        {
            _savedConnections = await store.ListAsync();
        }
        catch (Exception ex)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "editor", $"The saved connections could not be read: {ex.Message}");
        }
    }

    private void OnConnectDialogClosed(bool connected) => _ = InvokeAsync(ReloadSavedConnectionsAsync);

    private async Task ReloadSavedConnectionsAsync()
    {
        await LoadSavedConnectionIdsAsync();
        if (!_disposed) StateHasChanged();
    }

    // Spec 043 (FR-012): the keyboard help of a query tab (its tooltip, and the focus help of akml-ui.js) lists the tab keys.
    internal static readonly string TabKeysHelp =
        $" · Next / previous tab: {WorkspaceKeyMap.DisplayFor("editor:next-tab")} / {WorkspaceKeyMap.DisplayFor("editor:previous-tab")}"
        + $" · Close: {WorkspaceKeyMap.DisplayFor("editor:close-tab")} or Delete";

    private string ExecuteTitle =>
        Running ? "A query is running"
        : SqlConn.IsConnected ? WorkspaceKeyMap.TitleFor("Execute", "editor:execute") + " — runs the selection or the whole document"
        : Tab?.Session.Binding != null ? WorkspaceKeyMap.TitleFor("Execute", "editor:execute") + " — connects this query tab again, then runs"
        : WorkspaceKeyMap.TitleFor("Execute", "editor:execute") + " — asks for a connection, then runs";

    /// <summary>Spec 043 (plan › Tab switch): the editor shows the tab's kept state, or its text the first time, in its dialect.</summary>
    private async Task ShowTabAsync(QueryTab tab)
    {
        if (_editor == null || _disposed) return;
        await _editor.SwitchTabAsync(tab.Id, tab.Text, KindOf(tab));
        // A tab this page has not shown yet (a reload, or back from History) gets its findings and error mark back.
        if (_shownTabs.Add(tab.Id) && (tab.Findings != null || tab.ErrorMark != null)) await ShowDiagnosticsAsync(tab);
        // A tab formatted or refreshed while another was shown is analysed now that it is shown, for its own dialect and session
        // (T034) — whichever way it came on screen: a click, a key, the close of the tab after it, a page coming back.
        if (ReferenceEquals(tab, Tab) && tab.AnalysisPending)
        {
            tab.AnalysisPending = false;
            await AnalyseTabAsync(tab, quiet: true);
        }
    }

    private Task ActivateTabByIdAsync(string id) =>
        QueryTabs.Tabs.FirstOrDefault(t => t.Id == id) is { } tab ? ActivateTabAsync(tab) : Task.CompletedTask;

    /// <summary>
    /// Spec 043 (FR-005, plan › Tab switch): the tab becomes active — the connection service, the status bar and the saved set
    /// follow (IQueryTabs), the editor shows its state, the Schema panel its connection — and it reconnects when that needs no
    /// password (FR-009). Nothing here waits on the server, so a switch is immediate.
    /// </summary>
    private async Task ActivateTabAsync(QueryTab tab)
    {
        if (_disposed || ReferenceEquals(tab, Tab) || tab.IsClosing) return;
        await QueryTabs.ActivateAsync(tab);
        await ShowTabAsync(tab);
        if (!_seenGenerations.ContainsKey(tab.Id)) _seenGenerations[tab.Id] = tab.Session.ConnectionGeneration;
        RefreshSchemaTarget();
        StateHasChanged();
        await ReattachIfQuietAsync(tab);
    }

    /// <summary>Next / previous query tab (Ctrl+Alt+PageDown / PageUp), wrapping as the strip's arrows do.</summary>
    private Task StepTabAsync(int step)
    {
        var tabs = QueryTabs.Tabs;
        if (tabs.Count < 2 || Tab == null) return Task.CompletedTask;
        int at = Math.Max(0, tabs.ToList().IndexOf(Tab));
        return ActivateTabAsync(tabs[(at + step + tabs.Count) % tabs.Count]);
    }

    /// <summary>
    /// Spec 043 (FR-009, R2): a restored tab connects again when it is shown, if that needs no password (Windows authentication
    /// or a password the engine remembers). Otherwise it waits for its first run or an explicit Connect, so showing a tab never
    /// asks for a password.
    /// </summary>
    private async Task ReattachIfQuietAsync(QueryTab? tab)
    {
        if (tab == null || _disposed || tab.IsClosing) return;
        var s = tab.Session;
        if (s.IsConnected || !s.NeedsReattach || !s.CanReconnectAlone || Bridge.State != BridgeState.Open) return;
        var result = await ReattachAsync(tab);
        if (!result.Ok) Diagnostics.Log(DiagnosticLevel.Warn, "sql-connect", $"{tab.Name}: the connection was not restored: {result.Error}");
        if (!_disposed) StateHasChanged();
    }

    // One reattach per tab at a time: a run that needs the connection waits for the one already on its way.
    private async Task<ConnectResult> ReattachAsync(QueryTab tab)
    {
        if (_reattachTasks.TryGetValue(tab.Id, out var pending)) return await pending;
        var task = SqlConn.ReattachAsync(tab.Session, null, CancellationToken.None);
        _reattachTasks[tab.Id] = task;
        try { return await task; }
        finally { _reattachTasks.Remove(tab.Id); }
    }

    // The engine came back (or the page opened before it did): the tab on screen reconnects when it needs no password.
    private void OnBridgeStateChanged(BridgeState state)
    {
        if (state == BridgeState.Open) _ = InvokeAsync(() => ReattachIfQuietAsync(Tab));
    }

    /// <summary>
    /// Spec 043 (FR-009, US1 scenarios 6 and 7): a run needs its tab's connection. A restored tab connects again — through the
    /// Connect to database dialog, filled in and asking only for the password, when the engine holds none; a tab with no
    /// connection opens the dialog. The run goes on only once the tab is connected.
    /// </summary>
    private async Task<bool> EnsureConnectedAsync(QueryTab tab)
    {
        var s = tab.Session;
        if (s.IsConnected) return true;
        if (s.NeedsReattach && s.Binding is { } binding)
        {
            if (s.CanReconnectAlone && Bridge.State == BridgeState.Open)
            {
                var result = await ReattachAsync(tab);
                if (s.IsConnected) return true;
                // Closed or cancelled while it connected again: nothing to report and nothing to ask.
                if (tab.IsClosing || tab.CancelRequested) return false;
                if (!result.PasswordRequired)
                {
                    Notifications.Notify($"{tab.Name} could not connect to {binding.Server}: {result.Error}", NotificationKind.Error);
                    return false;
                }
            }
            return await ConnectThroughDialogAsync(tab, binding);
        }
        return await ConnectThroughDialogAsync(tab, null);
    }

    private async Task<bool> ConnectThroughDialogAsync(QueryTab tab, ConnectionBinding? prefill)
    {
        if (tab.IsClosing || tab.CancelRequested) return false;
        var closed = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        void OnClosed(bool connected) => closed.TrySetResult(connected);
        ConnManager.Closed += OnClosed;
        try
        {
            ConnManager.Open(tab.Session, prefill);
            bool connected = await closed.Task;
            return connected && tab.Session.IsConnected && !tab.IsClosing;
        }
        finally
        {
            ConnManager.Closed -= OnClosed;
        }
    }

    private Task CloseTabByIdAsync(string id) =>
        QueryTabs.Tabs.FirstOrDefault(t => t.Id == id) is { } tab ? CloseTabAsync(tab) : Task.CompletedTask;

    private Task CloseActiveTabAsync() => Tab is { } tab ? CloseTabAsync(tab) : Task.CompletedTask;

    /// <summary>
    /// Spec 043 (FR-007, T050): close a query tab. A run still in flight asks first; then pending grid edits; then an open or
    /// aborted transaction warns as Disconnect does (contracts/web-ui.md §1: before the save question, so a cancelled rollback never
    /// saves); then unsaved text asks Save / Don't save / Cancel. The engine releases the tab's session; a run in flight is asked to
    /// cancel, and its session is released when its reply (or deadline) ends it. The tab before it becomes active, as in SSMS.
    /// </summary>
    private async Task CloseTabAsync(QueryTab tab)
    {
        // One close at a time per tab (review of US1): a second ×, Delete or Ctrl+Alt+W while this one still asks or checks starts
        // nothing — two would each ask to save, and the second would ask about a tab already gone.
        if (_disposed || tab.IsClosing || !_closesAsking.Add(tab.Id)) return;
        try
        {
            await CloseTabCoreAsync(tab);
        }
        finally
        {
            _closesAsking.Remove(tab.Id);
        }
    }

    private readonly HashSet<string> _closesAsking = new(StringComparer.Ordinal);

    private async Task CloseTabCoreAsync(QueryTab tab)
    {
        if (RefuseWhileApplying(tab)) return;
        bool askedRunning = false;
        if (tab.IsExecuting)
        {
            if (!await ConfirmCloseRunningAsync(tab)) return;
            askedRunning = true;
        }
        if (!await ConfirmDiscardPendingEditsAsync(tab)) return;
        bool runningAtCheck = tab.IsExecuting;
        var transaction = await ConfirmCloseTransactionAsync(tab);
        if (transaction == CloseTransactionAnswer.Kept) return;
        if (tab.IsModified)
        {
            var choice = await Dialogs.ChooseAsync(new DialogRequest
            {
                Title = "Close query tab",
                Message = $"Save changes to {tab.Name}?",
                ConfirmLabel = "Save",
                AlternateLabel = "Don't save",
                CancelLabel = "Cancel",
                DialogId = "doc-close-dialog",
                ConfirmTestId = "doc-close-save",
                AlternateTestId = "doc-close-discard",
                CancelTestId = "doc-close-cancel",
            });
            if (choice == DialogChoice.Cancel) return;
            if (choice == DialogChoice.Confirm && !await SaveTabAsync(tab)) return;
        }
        if (tab.IsClosing || !QueryTabs.Tabs.Contains(tab)) return;   // closed while a question was open
        // A run that ended while a question was open may have left a transaction open (FR-007: the warning comes before the close)
        // — asked only when no transaction question was answered already.
        if (runningAtCheck && !tab.IsExecuting && transaction == CloseTransactionAnswer.NothingToAsk)
        {
            if (await ConfirmCloseTransactionAsync(tab) == CloseTransactionAnswer.Kept) return;
            if (tab.IsClosing || !QueryTabs.Tabs.Contains(tab)) return;
        }
        // A run started while a question was open is asked about as any running query is.
        if (tab.IsExecuting && !askedRunning)
        {
            if (!await ConfirmCloseRunningAsync(tab)) return;
            if (tab.IsClosing || !QueryTabs.Tabs.Contains(tab)) return;
        }

        bool wasActive = ReferenceEquals(tab, Tab);
        tab.IsClosing = true;
        tab.CancelRequested = true;   // a run still connecting is not sent
        _panes.Remove(tab.Id);
        _attached.Remove(tab.Id);
        _shownTabs.Remove(tab.Id);
        _seenGenerations.Remove(tab.Id);
        _formatGates.Remove(tab.Id);
        if (_analyseCts.Remove(tab.Id, out var analysing)) analysing.Cancel();
        // The tabs first (the tab before it becomes active), then the editor forgets the closed tab's state: a render between
        // the two never shows the closing tab again.
        await QueryTabs.CloseAsync(tab);
        if (_editor != null) await _editor.CloseTabAsync(tab.Id);
        if (Tab is { } next)
        {
            await ShowTabAsync(next);
            if (wasActive) RefreshSchemaTarget();
        }
        StateHasChanged();

        if (tab.IsExecuting)
        {
            if (tab.ActiveQueryId is { } qid) _ = QueryExec.CancelAsync(tab.Session, qid, CancellationToken.None);   // best effort
        }
        else
        {
            await ReleaseAsync(tab);
        }
        if (wasActive) await ReattachIfQuietAsync(Tab);
    }

    // Spec 043 edge case "closing a tab whose query is running": the app asks; the tab counts toward the limit until released.
    private Task<bool> ConfirmCloseRunningAsync(QueryTab tab) => Dialogs.ConfirmAsync(new DialogRequest
    {
        Title = "Close a running query",
        Message = $"{tab.Name} is still running a query. Close the tab?",
        Details = new[]
        {
            "Closing the tab cancels the query: the engine stops the statement that is running, and the batches after it do not run.",
            "Its results are not shown. Anything it has not committed is rolled back when the tab's connection closes.",
        },
        ConfirmLabel = "Close tab",
        Destructive = true,
        DialogId = "doc-close-running",
    });

    private async Task<bool> SaveTabAsync(QueryTab tab)
    {
        try { return await tab.Document.SaveAsync(); }
        catch (JSException ex)
        {
            Notifications.Notify($"The file could not be saved: {ex.Message}", NotificationKind.Error);
            Diagnostics.Log(DiagnosticLevel.Error, "editor", $"Save failed: {ex.Message}");
            return false;
        }
    }

    private enum CloseTransactionAnswer { NothingToAsk, RollBack, Kept }

    /// <summary>How long a close waits for a SQL Server session to say whether it holds a transaction before it goes on without
    /// asking (the engine away, a server that does not answer, a statement still holding the session).</summary>
    private static readonly TimeSpan CloseProbeLimit = TimeSpan.FromSeconds(3);

    // FR-007: closing drops the tab's session, and with it any open transaction. The engine rolls it back; it never commits.
    // A PostgreSQL session knows its state from every reply. A SQL Server one is asked now (gap G1), as SSMS asks when a query
    // window closes: asking after every run would reset @@ROWCOUNT and @@ERROR for the user's next batch. The question waits at
    // most CloseProbeLimit; the tab says it is checking meanwhile. A tab whose run is still in flight is not asked (the question
    // would wait for the run); the close-running question already said what closing does.
    private async Task<CloseTransactionAnswer> ConfirmCloseTransactionAsync(QueryTab tab)
    {
        var s = tab.Session;
        if (!s.IsConnected) return CloseTransactionAnswer.NothingToAsk;
        var state = s.TransactionState;
        if (state == AkmlSql.Core.TransactionState.None && !tab.IsExecuting && s.Kind != AkmlSql.Core.DatabaseKind.PostgreSql)
        {
            tab.CheckingBeforeClose = true;
            StateHasChanged();
            try
            {
                using var limit = new CancellationTokenSource(CloseProbeLimit);
                state = await QueryExec.ProbeTransactionStateAsync(s, limit.Token) ?? state;
            }
            finally
            {
                tab.CheckingBeforeClose = false;
                if (!_disposed) StateHasChanged();
            }
        }
        if (state == AkmlSql.Core.TransactionState.None) return CloseTransactionAnswer.NothingToAsk;
        var aborted = state == AkmlSql.Core.TransactionState.Aborted;
        return await Dialogs.ConfirmAsync(new DialogRequest
        {
            Title = aborted ? "Aborted transaction" : "Open transaction",
            Message = (aborted ? $"{tab.Name} has a transaction that an error aborted. " : $"{tab.Name} has an open transaction. ")
                + "Closing the tab rolls it back. Nothing is committed.",
            ConfirmLabel = "Roll back and close",
            Destructive = true,
            DialogId = "doc-close-transaction",
        }) ? CloseTransactionAnswer.RollBack : CloseTransactionAnswer.Kept;
    }

    // The engine closes the tab's connection and forgets its session and schema cache (R5).
    // The engine closes the tab's connection and forgets its session and schema cache (R5); the window gives up its lease. The
    // user is told what the close did to an open transaction (FR-007: as Disconnect tells a SQL Server session afterwards), and
    // when the engine could not be told (the release is sent when the engine is back).
    private async Task ReleaseAsync(QueryTab tab)
    {
        // Only a tab whose session the engine may hold (connected in this page, or a stored session from an earlier page) has anything
        // to warn about; a new tab that never reached the engine has none, whatever connection it inherited.
        var s = tab.Session;
        bool couldHoldConnection = s.IsConnected || s.MayBeOnEngine;
        DisconnectResult? result = null;
        try { result = await SqlConn.DisconnectSessionAsync(s, release: true, CancellationToken.None); }
        catch (Exception ex) { Diagnostics.Log(DiagnosticLevel.Warn, "editor", $"{tab.Name}: its session was not released: {ex.Message}"); }
        await QueryTabs.ReleaseLeaseAsync(tab);
        // Told even when the page is gone (the tab closed while its run was in flight, and the user moved on): notices outlive pages.
        if (result == null) return;
        if (result.RolledBack)
            Notifications.Notify($"{tab.Name} is closed. Its open transaction was rolled back; nothing was committed.", NotificationKind.Warning);
        else if (result.Warning == SqlConnectionService.DisconnectUnconfirmed && couldHoldConnection)
            Notifications.Notify($"{tab.Name} is closed in this browser, but the engine could not be reached. Keep this page open until the engine is back: its connection, with any open transaction, is closed then.", NotificationKind.Warning);
    }

    /// <summary>
    /// Spec 043 (FR-011): a query or a file goes to a new tab, unless the active tab is empty and unmodified (then it takes it).
    /// A new tab starts on the active tab's connection (FR-002). Null at the tab limit (the user is told).
    /// </summary>
    private async Task<QueryTab?> OpenInTabAsync(string text, string? name)
    {
        if (Tab is { IsEmpty: true, IsExecuting: false, GridHasPendingEdits: false } reuse)
        {
            await reuse.Document.ReplaceUnmodifiedAsync(text, name);
            reuse.Text = text;
            await AfterDocumentReplacedAsync(reuse);
            return reuse;
        }
        var tab = await QueryTabs.NewAsync(Tab, text, name);
        if (tab == null)
        {
            Notifications.Notify(QueryTabs.LimitText + ".", NotificationKind.Info);
            return null;
        }
        await AfterTabOpenedAsync(tab);
        return tab;
    }

    private async Task AfterTabOpenedAsync(QueryTab tab)
    {
        Attach(tab);
        await ShowTabAsync(tab);
        _seenGenerations[tab.Id] = tab.Session.ConnectionGeneration;
        RefreshSchemaTarget();
        StateHasChanged();
        _ = InvokeAsync(() => ReattachIfQuietAsync(tab));   // FR-002: at once when no password is needed
    }

    /// <summary>Spec 043 (FR-002): New query is a new tab on the active tab's connection.</summary>
    private async Task NewDocumentAsync()
    {
