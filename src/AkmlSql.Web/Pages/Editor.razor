    // Review WEB-10: each Format takes a ticket; only the latest one's reply, for the same document and dialect, may change it.
    internal const string FormatSupersededStatus =
        "The document changed while it was being formatted, so the result was not applied. Format again.";

    private async Task FormatAsync()
    {
        if (_editor == null || Tab is not { } tab) return;
        if (!_formatGates.TryGetValue(tab.Id, out var gate)) _formatGates[tab.Id] = gate = new FormatRequestGate();
        try
        {
            // The live text (not the debounced copy), the tab's document and the dialect it is formatted for: a PostgreSQL format
            // crosses the bridge, and the reply can arrive after the user typed, opened another document, switched kind or
            // switched tabs. Spec 043: the reply goes to the tab it was asked for, shown or not.
            var kind = tab.Session.Kind;
            var ticket = gate.Begin(await _editor.GetTextAsync(), tab.Document.SessionKey ?? string.Empty, kind);
            var result = await Formatter.FormatAsync(ticket.Text, _activeProfile);
            if (!gate.IsLatest(ticket) || _editor == null || tab.IsClosing) return;   // a newer Format owns the document now
            if (result.Success && (!gate.Applies(ticket, tab.Document.SessionKey ?? string.Empty, tab.Session.Kind)
                                   || !await _editor.ReplaceTextIfUnchangedAsync(ticket.Text, result.FormattedText, tab.Id)))
            {
                _status = FormatSupersededStatus;
                Notifications.Notify(_status, NotificationKind.Info);
                Diagnostics.Log(DiagnosticLevel.Info, "formatter", _status);
                StateHasChanged();
                return;
            }
            if (result.Success)
            {
                bool shown = IsShown(tab);
                tab.Text = result.FormattedText;
                if (!shown)
                {
                    // A tab's kept state changes without a text report: its modified state and record follow here.
                    tab.Document.OnTextChanged(tab.Text);
                    await QueryTabs.PersistAsync(tab);
                }
                _status = result.WasModified ? "Formatted." : "Already canonical.";
                _hasFormatted = true;
                _formatVersion++;
                Diagnostics.Log(DiagnosticLevel.Info, "formatter", _status);
                if (_autoAnalyseOnFormat && _analysisEnabled)   // a format never announces that analysis is off
                {
                    await AnalyseTabAsync(tab);
                }
            }
            else
            {
                _status = $"Format failed: {string.Join("; ", result.Diagnostics.Select(d => d.Message))}";
                Diagnostics.Log(DiagnosticLevel.Warn, "formatter", _status);
            }
        }
        catch (DocumentTooLargeException ex)
        {
            _status = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "formatter", _status);
        }
        catch (Exception ex)
        {
            _status = $"Format crashed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "formatter", _status, new { Exception = ex.GetType().Name });
        }
        StateHasChanged();
    }

    private Task AnalyseAsync() => Tab is { } tab ? AnalyseTabAsync(tab) : Task.CompletedTask;

    private async Task AnalyseTabAsync(QueryTab tab, bool quiet = false)
    {
        bool active = ReferenceEquals(tab, Tab);
        // T034: the analyser reads the dialect (and a PostgreSQL analysis the engine session) of the ACTIVE tab, so a tab that is
        // not shown is analysed when it is shown again, never through another tab's dialect.
        if (!active)
        {
            tab.AnalysisPending = true;
            return;
        }
        // Spec 041 (FR-034, FR-055): with code analysis off, Analyse says so (the Problems tab offers to turn
        // it on) — never "No problems found", which would be a claim about a document nobody analysed.
        var analysis = await AnalysisSettings.GetAsync();
        _analysisEnabled = analysis.Enabled;
        if (!_analysisEnabled)
        {
            tab.Findings = null;
            await ShowDiagnosticsAsync(tab);
            // A quiet re-analysis (a tab shown, a connection changed) only drops the stale findings; it never switches the results
            // tab, opens the panel or announces anything.
            if (quiet)
            {
                StateHasChanged();
                return;
            }
            _hasAnalysed = true;
            _analyseVersion++;
            if (active)
            {
                _resultsTab = ResultsPaneComponent.ProblemsTab;
                if (!Layout.Current.ResultsVisible) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
            }
            Notifications.Notify("Code analysis is off.", NotificationKind.Info);
            StateHasChanged();
            return;
        }

        if (_analyseCts.TryGetValue(tab.Id, out var previous)) previous.Cancel();
        var cts = _analyseCts[tab.Id] = new CancellationTokenSource();
        try
        {
            // The live text of the tab on screen (the kept text of another).
            var text = IsShown(tab) ? await _editor!.GetTextAsync() : tab.Text;
            // The analyser reads the dialect (and a PostgreSQL analysis the session) of the active tab: a switch during the read
            // above leaves this tab to be analysed when it is shown again (T034).
            if (!ReferenceEquals(tab, Tab))
            {
                tab.AnalysisPending = true;
                return;
            }
            tab.Findings = await Analyser.AnalyseAsync(text, null, cts.Token);
            _hasAnalysed = true;
            _analyseVersion++;
            await ShowDiagnosticsAsync(tab);
            var issueCount = tab.Findings.Issues?.Length ?? 0;
            // Spec 041 (FR-034): findings open the Problems tab (its badge counts them); none says so in a
            // notification, so the user knows the analyser ran.
            if (issueCount > 0)
            {
                if (ReferenceEquals(tab, Tab) && !quiet)
                {
                    _resultsTab = ResultsPaneComponent.ProblemsTab;
                    if (!Layout.Current.ResultsVisible) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
                }
            }
            else if (!quiet) Notifications.Notify("No problems found.", NotificationKind.Success);
            Diagnostics.Log(DiagnosticLevel.Info, "analyser",
                issueCount == 0 ? "No problems." : $"{issueCount} problem(s) found.");
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request.
        }
        catch (DocumentTooLargeException ex)
        {
            _status = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "analyser", _status);
        }
        catch (Exception ex)
        {
            _status = $"Analyse crashed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "analyser", _status, new { Exception = ex.GetType().Name });
        }
        finally
        {
            if (_analyseCts.TryGetValue(tab.Id, out var current) && ReferenceEquals(current, cts)) _analyseCts.Remove(tab.Id);
            cts.Dispose();
        }
        StateHasChanged();
    }

