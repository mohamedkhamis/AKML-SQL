    /// <summary>Spec 030 — the editor's context-action contributions to the ⌘P palette.</summary>
    private IEnumerable<CommandAction> BuildContextActions()
    {
        // Spec 041 (R37, FR-028): F5 and Ctrl+F5. While a query runs neither is offered (the key does nothing).
        yield return new CommandAction
        {
            Id = "editor:execute", Title = "Execute", Group = CommandGroup.Action,
            Icon = "play", Shortcut = "F5", Run = ExecuteAsync,
            IsEnabled = () => !_executing && SqlConn.IsConnected,
        };
        yield return new CommandAction
        {
            Id = "editor:parse", Title = "Parse (check syntax on the server)", Group = CommandGroup.Action,
            Icon = "file-check", Shortcut = "Ctrl+F5", Run = ParseAsync,
            IsEnabled = () => CanParse,
        };
        yield return new CommandAction
        {
            Id = "editor:format", Title = "Format SQL", Group = CommandGroup.Action,
            Icon = "wand-sparkles", Shortcut = "Ctrl+K Ctrl+F", Run = FormatAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:analyse", Title = "Analyse SQL", Group = CommandGroup.Action,
            Icon = "search-check", Shortcut = "Ctrl+K Ctrl+L", Run = AnalyseAsync,
        };
        // Spec 041 (T200, R39): through the palette — CodeMirror's own F8 for this is the Schema panel's key.
        yield return new CommandAction
        {
            Id = "editor:next-problem", Title = "Next problem", Group = CommandGroup.Action,
            Icon = "arrow-down", Run = () => GoToProblemAsync(forward: true),
        };
        yield return new CommandAction
        {
            Id = "editor:previous-problem", Title = "Previous problem", Group = CommandGroup.Action,
            Icon = "arrow-up", Run = () => GoToProblemAsync(forward: false),
        };
        yield return new CommandAction
        {
            Id = "editor:refactor", Title = "Refactor…", Group = CommandGroup.Action,
            Icon = "replace", Run = () => { OpenRefactorMenu(); StateHasChanged(); return Task.CompletedTask; },
        };
        yield return new CommandAction
        {
            Id = "editor:new", Title = "New query", Group = CommandGroup.File,
            Icon = "file-plus", Shortcut = WorkspaceKeyMap.DisplayFor("editor:new"), Run = NewDocumentAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:open", Title = "Open file…", Group = CommandGroup.File,
            Icon = "folder-open", Shortcut = WorkspaceKeyMap.DisplayFor("editor:open"), Run = OpenFilePickerAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:save", Title = "Save", Group = CommandGroup.File,
            Icon = "save", Shortcut = WorkspaceKeyMap.DisplayFor("editor:save"), Run = SaveAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:saveas", Title = "Save as…", Group = CommandGroup.File,
            Icon = "save-all", Shortcut = WorkspaceKeyMap.DisplayFor("editor:saveas"), Run = SaveAsAsync,
        };
        yield return new CommandAction
        {
            Id = "editor:surround", Title = "Surround selection with…", Group = CommandGroup.Action,
            Icon = "brackets", Shortcut = "Ctrl+K Ctrl+S", Run = OpenSurroundPickerAsync,
        };
    }

    private async Task OnTextChangedAsync(string newText)
    {
        _currentText = newText;
        SchemaSync.ReportEditorActive();   // spec 041 (R40, N27): keeps the 30 s schema poll from idling out
        if (!_documentLoaded) return;
        Document.OnTextChanged(newText);
        // T051 debounced save (the store applies its own 500 ms debounce). Routed through
        // EditorSessionKeys.BuildTextChangeRecord so the session key — and (spec 041) the document's name,
        // modified state and counter — are carried forward: SaveAsync overwrites the whole persisted record.
        await SessionStore.SaveAsync(EditorSessionKeys.BuildTextChangeRecord(
            SessionKey, newText, await ProfileStore.GetActiveIdAsync(),
            Document.Name, Document.IsModified, Document.NextDefaultNumber));
    }

