    private async Task OnSchemaObjectActionAsync(SchemaObjectAction action)
    {
        var name = SchemaObjectScripts.Name(action.Kind, action.SchemaName, action.Object.ObjectName);
        switch (action.Command)
        {
            case SchemaObjectCommand.InsertName:
                await OnSchemaObjectClickedAsync(name);
                return;
            case SchemaObjectCommand.CopyName:
                bool copied = false;
                try
                {
                    _uiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/akml-ui.js");
                    copied = await _uiModule.InvokeAsync<bool>("copyText", name);
                }
                catch (JSException ex) { Diagnostics.Log(DiagnosticLevel.Warn, "editor", $"Copy name: {ex.Message}"); }
                Notifications.Notify(copied ? $"Copied {name}." : "The name could not be copied.", copied ? NotificationKind.Success : NotificationKind.Error);
                return;
        }

        var script = SchemaObjectScripts.Script(action.Command, action.Kind, action.SchemaName, action.Object);
        if (script == null) return;
        // Spec 043 (FR-011): as SSMS, a script opens as a new query tab (or in the active tab when it is empty), on the explorer's
        // connection; Select Top 1000 Rows also runs it there.
        var tab = await OpenInTabAsync(script, null);
        if (tab == null) return;
        if (action.Command == SchemaObjectCommand.SelectTop) await ExecuteTabAsync(tab);
    }

