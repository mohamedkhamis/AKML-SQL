    private async Task FormatAsync()
    {
        try
        {
            var result = Formatter.Format(_currentText, _activeProfile);
            if (result.Success && _editor != null)
            {
                await _editor.SetTextAsync(result.FormattedText);
                _currentText = result.FormattedText;
                _status = result.WasModified ? "Formatted." : "Already canonical.";
                _hasFormatted = true;
                _formatVersion++;
                Diagnostics.Log(DiagnosticLevel.Info, "formatter", _status);
                if (_autoAnalyseOnFormat && _analysisEnabled)   // a format never announces that analysis is off
                {
                    await AnalyseAsync();
                }
            }
            else
            {
                _status = $"Format failed: {string.Join("; ", result.Diagnostics.Select(d => d.Message))}";
                Diagnostics.Log(DiagnosticLevel.Warn, "formatter", _status);
            }
        }
        catch (DocumentTooLargeException ex)
        {
            _status = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "formatter", _status);
        }
        catch (Exception ex)
        {
            _status = $"Format crashed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "formatter", _status, new { Exception = ex.GetType().Name });
        }
        StateHasChanged();
    }

    private async Task AnalyseAsync()
    {
        // Spec 041 (FR-034, FR-055): with code analysis off, Analyse says so (the Problems tab offers to turn
        // it on) — never "No problems found", which would be a claim about a document nobody analysed.
        var analysis = await AnalysisSettings.GetAsync();
        _analysisEnabled = analysis.Enabled;
        if (!_analysisEnabled)
        {
            _findings = null;
            await ShowDiagnosticsAsync();
            _hasAnalysed = true;
            _analyseVersion++;
            _resultsTab = ResultsPaneComponent.ProblemsTab;
            if (!Layout.Current.ResultsVisible) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
            Notifications.Notify("Code analysis is off.", NotificationKind.Info);
            StateHasChanged();
            return;
        }

        _analyseCts?.Cancel();
        _analyseCts = new CancellationTokenSource();
        try
        {
            _findings = await Analyser.AnalyseAsync(_currentText, null, _analyseCts.Token);
            _hasAnalysed = true;
            _analyseVersion++;
            await ShowDiagnosticsAsync();
            var issueCount = _findings.Issues?.Length ?? 0;
            // Spec 041 (FR-034): findings open the Problems tab (its badge counts them); none says so in a
            // notification, so the user knows the analyser ran.
            if (issueCount > 0)
            {
                _resultsTab = ResultsPaneComponent.ProblemsTab;
                if (!Layout.Current.ResultsVisible) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
            }
            else Notifications.Notify("No problems found.", NotificationKind.Success);
            Diagnostics.Log(DiagnosticLevel.Info, "analyser",
                issueCount == 0 ? "No problems." : $"{issueCount} problem(s) found.");
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request.
        }
        catch (DocumentTooLargeException ex)
        {
            _status = ex.Message;
            Diagnostics.Log(DiagnosticLevel.Error, "analyser", _status);
        }
        catch (Exception ex)
        {
            _status = $"Analyse crashed: {ex.Message}";
            Diagnostics.Log(DiagnosticLevel.Error, "analyser", _status, new { Exception = ex.GetType().Name });
        }
        StateHasChanged();
    }

