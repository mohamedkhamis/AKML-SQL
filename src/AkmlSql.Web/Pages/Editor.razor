    private void OpenViewMenu(MouseEventArgs e)
    {
        var l = Layout.Current;
        MenuItem Item(string id, string label, string testId, bool? isChecked, Func<Task> run) => new()
        {
            Label = label, TestId = testId, IsChecked = isChecked, Shortcut = WorkspaceKeyMap.DisplayFor(id),
            OnSelect = async () => { await run(); StateHasChanged(); },
        };
        var items = new List<MenuItem>
        {
            Item(WorkspaceViewActions.ToggleNav, "Navigation bar", "view-toggle-nav", l.NavVisible, ToggleNavAsync),
            Item(WorkspaceViewActions.ToggleSchema, "Schema panel", "view-toggle-schema", SchemaShown, ToggleSchemaAsync),
            Item(WorkspaceViewActions.ToggleResults, "Results pane", "view-toggle-results", l.ResultsVisible, ToggleResultsAsync),
            Item(WorkspaceViewActions.ToggleAi, "AI panel", "view-toggle-ai", AiShown, ToggleAiAsync),
            MenuItem.Separator(),
            Item(WorkspaceViewActions.MaximiseResults, l.ResultsMaximised ? "Restore results" : "Maximise results", "view-toggle-maximise", null, ToggleMaximiseResultsAsync),
            Item(WorkspaceViewActions.CyclePanes, "Next pane", "view-cycle-panes", null, () => CyclePanesAsync(false)),
            MenuItem.Separator(),
            Item(WorkspaceViewActions.ResetLayout, "Reset layout", "workspace-reset-layout", null, ResetLayoutAsync),
            MenuItem.Separator(),
            Item("editor:saveas", "Save as…", "view-saveas", null, SaveAsAsync),
        };
        _viewMenu = (e.ClientX, e.ClientY + 8, items);
    }

    private AiErrorInfo? GetLastExecuteError()
    {
        if (SqlConn.Kind != AkmlSql.Core.DatabaseKind.PostgreSql) return null;
        var error = Tab?.Result?.MessageDetails?.FirstOrDefault(m => m.Kind == ExecuteMessageKind.Error);
        return error == null ? null : new AiErrorInfo(error.Text, 0, error.SqlState, error.Detail, error.Hint);
    }

