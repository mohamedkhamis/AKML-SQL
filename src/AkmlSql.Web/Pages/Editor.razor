@page "/"
@page "/editor"
@*
    Spec 021 (web edition) -- M2 task T033, T040, T046. The main editor page.
    Wires:
      * EditorComponent (CodeMirror)
      * ProfilePickerComponent (top nav)
      * ProblemsListComponent (right side panel)
      * Formatter and analyser services (in-process)
      * Editor session persistence (debounced)
      * Keybindings: claimed by wwwroot/js/akml-workspace.js from the WorkspaceKeyMap table (spec 041
        R37) — Ctrl+K Ctrl+F (Format), Ctrl+K Ctrl+L (Analyse), Ctrl+K Ctrl+S (Surround), Ctrl+S (Save)
*@
@using AkmlSql.Core.Ipc.Messages
@using AkmlSql.Formatting.Profiles
@using AkmlSql.Web.Services
@using AkmlSql.Web.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@implements IWorkspaceViewHost
@inject IFormatterService Formatter
@inject IAnalyserService Analyser
@inject IProfileStore ProfileStore
@inject IAnalysisSettingsStore AnalysisSettings
@inject IEditorSessionStore SessionStore
@inject IDiagnosticsRingBuffer Diagnostics
@inject IThemeService Theme
@inject IJSRuntime JS
@inject ISnippetStore Snippets
@inject IRefactoringService Refactoring
@inject ICommandRegistry Commands
@inject ISqlConnectionService SqlConn
@inject IQueryExecutionService QueryExec
@inject IExecutionSettingsStore ExecSettings
@inject IHistoryService History
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject IWorkspaceStatus Workspace
@inject INotificationService Notifications
@inject IEngineBridge Bridge
@inject IWorkspaceLayoutStore Layout
@inject IConnectionManagerController ConnManager
@inject IQueryTabs QueryTabs
@inject ISchemaSync SchemaSync
@inject IDialectGate DialectGate
@inject IServiceProvider Services

@* Spec 041 (R64, FR-089): the title SSMS's window reads like — orders-audit* - SERVER.db - AKML SQL. *@
@* Spec 043: the active query tab's. *@
<PageTitle>@(Tab == null ? "AKML SQL" : EditorDocument.TitleFor(Tab.Name, Tab.IsModified, SqlConn.IsConnected ? SqlConn.Server : null, SqlConn.IsConnected ? SqlConn.Database : null))</PageTitle>

@* Spec 041 (FR-015) — leaving the page asks before dropping the results grid's pending edits. Review WEB-09: so does a
   reload, a closed tab or a link to another site (the browser's own prompt), but only while there are edits to lose.
   Spec 043: in any query tab's grids. *@
<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" ConfirmExternalNavigation="@AnyPendingEdits" />

<div class="akml-editor-page">
    @* Spec 041 (FR-081): SSMS's grouping — database | Execute, Parse | Format, Analyse | Refactor, AI | documents |
       View — each button an icon, a label and a "Name (Keys)" tooltip from WorkspaceKeyMap. The aria-labels are
       load-bearing: tests and assistive technology find "Format" by that exact name. *@
    <div class="akml-editor-toolbar" role="toolbar" aria-label="Editor">
        @* Spec 041 (R28, FR-082): the database, first — as SSMS's "Available Databases" box. *@
        <DatabaseSelectorComponent IsRunning="Running" />
        <span class="akml-toolbar-sep" aria-hidden="true"></span>

        @* Spec 030 — Phase 5: Execute + advisory resource caps. F5 (spec 041) and Mod-Enter (CM6 keymap)
           also run it; while a query runs Execute is not offered (FR-027). *@
        @* Spec 043 (US1 scenario 7): a tab with no live connection runs too — it connects first (its own connection again, or
           the Connect to database dialog), then runs. *@
        <button type="button" class="akml-btn akml-tool-button-run" data-testid="execute-button"
                aria-label="@(Running ? "Running" : "Execute")"
                @onclick="ExecuteAsync" disabled="@(Running || Tab == null)"
                title="@ExecuteTitle">
            <Icon Name="@(Running ? "loader-circle" : "play")" Class="@(Running ? "akml-spin akml-run-icon" : "akml-run-icon")" />
            <span>@(Running ? "Running…" : "Execute")</span>
        </button>
        @* While a query runs, Cancel takes Parse's place (Parse cannot run then anyway), so the toolbar does not reflow
           and push the last buttons onto a second row. *@
        @if (Running)
        {
            @* Spec 043 (review of US1): since the engine answers a page's requests side by side (R3), Cancel reaches a statement that
               is running, not only one still queued. *@
            <button type="button" class="akml-btn" data-testid="execute-cancel" @onclick="CancelExecuteAsync" aria-label="Cancel"
                    title="Cancel: the engine stops the statement that is running, and the batches after it do not run.">
                <Icon Name="x" /><span>Cancel</span>
            </button>
        }
        else
        {
            @* Spec 041 (R21, FR-035) — the server's syntax check, without running anything. *@
            <button type="button" class="akml-btn" data-testid="parse-button" aria-label="Parse"
                    @onclick="ParseAsync" disabled="@(!CanParse)"
                    title="@(!SqlConn.IsConnected ? "Parse needs a database connection" : SupportsParse ? WorkspaceKeyMap.TitleFor("Parse", "editor:parse") + " — checks the syntax on the server without running it" : "Parse needs a newer engine")">
                <Icon Name="file-check" /><span>Parse</span>
            </button>
        }
        <span class="akml-toolbar-sep" aria-hidden="true"></span>

        <button type="button" class="akml-btn" data-testid="format-button" aria-label="Format" @onclick="FormatAsync"
                title="@WorkspaceKeyMap.TitleFor("Format", "editor:format")">
            <Icon Name="wand-sparkles" /><span>Format</span>
        </button>
        <ProfilePickerComponent OnProfileChanged="OnProfileChangedAsync" />
        <button type="button" class="akml-btn" data-testid="analyse-button" aria-label="Analyse" @onclick="AnalyseAsync"
                title="@WorkspaceKeyMap.TitleFor("Analyse", "editor:analyse")">
            <Icon Name="search-check" /><span>Analyse</span>
        </button>
        <span class="akml-toolbar-sep" aria-hidden="true"></span>

        @* Spec 042 (FR-092): the refactorings are written for T-SQL; on a PostgreSQL connection the button is off and says why. *@
        <button type="button" class="akml-btn" data-testid="refactor-button" aria-label="Refactor" aria-haspopup="menu"
                disabled="@(!Surfaces.IsEnabled(WorkspaceSurface.Refactor))"
                data-unavailable="@Surfaces.Unavailable(WorkspaceSurface.Refactor)"
                @onclick="OpenRefactorMenu" title="@Surfaces.Tooltip(WorkspaceSurface.Refactor, WorkspaceKeyMap.TitleFor("Refactor", "editor:refactor"))">
            <Icon Name="replace" /><span>Refactor</span><Icon Name="chevron-down" Size="12" />
        </button>
        <button type="button" class="akml-btn @(AiShown ? "is-active" : null)" data-testid="ai-button" aria-label="AI"
                aria-pressed="@(AiShown ? "true" : "false")" @onclick="ToggleAiAsync" title="AI assistance">
            <Icon Name="bot" /><span>AI</span><Icon Name="chevron-down" Size="12" />
        </button>
        @* Spec 041 (R64, FR-072): documents as SSMS has them. Ctrl+N / Ctrl+O are the browser's: the keys gain Alt. *@
        <span class="akml-toolbar-sep" aria-hidden="true"></span>

        @* Spec 043 (FR-013): at 20 tabs New query is off and says why. *@
        <button type="button" class="akml-btn" data-testid="doc-new" aria-label="New" @onclick="NewDocumentAsync"
                disabled="@AtTabLimit" title="@(AtTabLimit ? QueryTabs.LimitText : WorkspaceKeyMap.TitleFor("New query", "editor:new"))">
            <Icon Name="file-plus" /><span>New</span>
        </button>
        @* The Snippets idiom: the label opens the file picker; the Open command clicks the input (akml-ui.js). *@
        <label class="akml-btn" data-testid="doc-open" title="@(WorkspaceKeyMap.TitleFor("Open", "editor:open") + " — a .sql file")">
            <Icon Name="folder-open" /><span>Open</span>
            <InputFile id="akml-doc-open-input" class="akml-visually-hidden" accept=".sql,.txt"
                       data-testid="doc-open-input" OnChange="OpenFileAsync" />
        </label>
        <button type="button" class="akml-btn" data-testid="doc-save" aria-label="Save" @onclick="SaveAsync"
                title="@WorkspaceKeyMap.TitleFor("Save", "editor:save")">
            <Icon Name="save" /><span>Save</span>
        </button>
        <button type="button" class="akml-btn" data-testid="doc-saveas" aria-label="Save as" @onclick="SaveAsAsync"
                title="@WorkspaceKeyMap.TitleFor("Save as", "editor:saveas")">
            <Icon Name="save-all" /><span>Save as</span>
        </button>
        <span class="akml-toolbar-sep" aria-hidden="true"></span>

        @* Spec 041 (R38, FR-042) — every panel toggle, with its key; the same commands as the palette. *@
        <button type="button" class="akml-btn" data-testid="view-menu" aria-label="View" @onclick="OpenViewMenu" aria-haspopup="menu"
                title="View — show or hide panels">
            <Icon Name="panel-bottom" /><span>View</span><Icon Name="chevron-down" Size="12" />
        </button>
        <span class="akml-caps">
            <label title="Maximum rows to fetch (the engine re-clamps to its ceiling)">rows
                <input type="number" class="akml-caps-input" data-testid="caps-maxrows" min="1" max="100000"
                       value="@_maxRows" @onchange="OnMaxRowsChanged" />
            </label>
            <label title="Command timeout in seconds (the engine re-clamps to its ceiling)">timeout
                <input type="number" class="akml-caps-input" data-testid="caps-timeout" min="1" max="600"
                       value="@_timeoutSeconds" @onchange="OnTimeoutChanged" />
            </label>
        </span>
        <span class="akml-editor-spacer"></span>
        @if (!string.IsNullOrEmpty(_status))
        {
            <span class="akml-editor-status">@_status</span>
        }
    </div>
    @* Spec 041 (R33, FR-040–FR-046) — one CSS grid: Schema left, editor centre, results under the editor, AI
       right. Every size is a CSS variable written from the remembered layout fitted to the window; a hidden or
       folded side panel leaves an edge strip; the results host is always mounted (hidden by class) so its
       pending edits survive. *@
    <div @ref="_workspaceEl" class="@WorkspaceClass" style="@WorkspaceStyle" data-testid="workspace" data-splitter-host>
        @* The side panels stay mounted while hidden, so the tree keeps what was expanded and the chat its
           conversation; the AI dock mounts the first time it is shown. *@
        <div class="akml-ws-schema @(SchemaShown ? null : SchemaPeeking ? "akml-ws-schema--overlay" : "akml-ws-hidden")" id="akml-ws-schema"
             data-testid="workspace-schema" role="region" aria-label="Schema" tabindex="-1"
             style="@(SchemaPeeking ? $"width: {Fitted.SchemaWidth}px;" : null)" @onkeydown="OnSchemaPanelKeyDown">
            <SchemaTreeComponent Kind="@(SqlConn.IsConnected ? SqlConn.Kind : AkmlSql.Core.DatabaseKind.SqlServer)"
                                     ServerCanonicalIdentity="@_activeServerIdentity"
                                 DatabaseName="@_activeDatabaseName"
                                 SessionId="@(SqlConn.IsConnected ? SqlConn.SessionId : null)"
                                 OnObjectClicked="OnSchemaObjectClickedAsync"
                                 OnObjectAction="OnSchemaObjectActionAsync"
                                 OnConnectRequested="() => ConnManager.Open()"
                                 Pinned="@(!Layout.Current.SchemaAutoHide)" OnPinToggled="ToggleSchemaPinAsync" OnClose="CloseSchemaPanelAsync" />
        </div>
        @if (SchemaShown)
        {
            <div class="akml-ws-sl">
                <SplitterComponent Id="left" Side="left" Value="Fitted.SchemaWidth" Min="Limits.SchemaMinWidth" Max="SchemaMax"
                                   Controls="akml-ws-schema" Label="Resize the Schema panel" CssVar="--akml-ws-left" Host="_workspaceEl"
                                   TestId="workspace-splitter-left"
                                   OnCommitted="px => Layout.SetAsync(WorkspaceLayoutFields.SchemaWidth, px)"
                                   OnReset="() => Layout.SetAsync(WorkspaceLayoutFields.SchemaWidth, Limits.SchemaDefaultWidth)"
                                   OnCollapseToggled="@(() => CollapseFromSplitterAsync(WorkspacePanel.Schema))" />
            </div>
        }
        else
        {
            <button type="button" class="akml-ws-edge akml-ws-edge--left @(SchemaPeeking ? "is-active" : null)" data-testid="workspace-edge-left"
                    title="Show Schema (F8)" aria-expanded="@(SchemaPeeking ? "true" : "false")"
                    @onclick="OnSchemaStripClickAsync">Schema</button>
        }

        <div class="akml-ws-centre" id="akml-ws-centre" @onfocusin="CloseSchemaPeekQuietly" @onpointerdown="CloseSchemaPeekQuietly">
            @* Spec 043 (contracts/web-ui.md §1, R10): the query tabs, as SSMS has them — each its name, * while it has unsaved
               changes, and a close button. The active tab keeps the doc-name / doc-modified ids of spec 041's document bar. *@
            <TabStrip Tabs="DocTabs" ActiveId="@Tab?.Id" ActiveIdChanged="ActivateTabByIdAsync" AriaLabel="Query tabs"
                      IdPrefix="doc" Name="doc" Closable="true" OnClose="CloseTabByIdAsync" Class="akml-doctabs" />
            @* One editor shows the active tab (R6); the other tabs' panels are empty placeholders their tabs point at. *@
            @foreach (var other in QueryTabs.Tabs)
            {
                if (ReferenceEquals(other, Tab)) continue;
                <div role="tabpanel" id="@TabStrip.PanelId("doc", other.Id)" aria-labelledby="@TabStrip.TabId("doc", other.Id)" hidden></div>
            }
            <div class="akml-ws-editor" role="tabpanel" id="@(Tab == null ? null : TabStrip.PanelId("doc", Tab.Id))"
                 aria-labelledby="@(Tab == null ? null : TabStrip.TabId("doc", Tab.Id))">
                <EditorComponent @ref="_editor" OnTabTextChanged="OnTabTextChangedAsync" OnExecute="ExecuteAsync" Kind="@KindOf(Tab)" />
            </div>
        </div>

        @if (Fitted.ResultsVisible && !Fitted.ResultsMaximised)
        {
            <div class="akml-ws-hsplit">
                <SplitterComponent Id="bottom" Side="bottom" Value="ResultsPx" Min="Limits.ResultsMinHeight" Max="ResultsMax"
                                   Controls="akml-ws-results" Label="Resize the results pane" CssVar="--akml-ws-results" Host="_workspaceEl"
                                   TestId="workspace-splitter-bottom"
                                   OnCommitted="px => Layout.SetAsync(WorkspaceLayoutFields.ResultsHeight, px)"
                                   OnReset="ResetResultsHeightAsync"
                                   OnCollapseToggled="@(() => CollapseFromSplitterAsync(WorkspacePanel.None))" />
            </div>
        }
        <div class="akml-ws-results" id="akml-ws-results" @onpointerdown="CloseSchemaPeekQuietly">
            @if (!Fitted.ResultsVisible)
            {
                <button type="button" class="akml-ws-edge akml-ws-edge--bottom" data-testid="workspace-edge-bottom"
                        title="Show results (Ctrl+R)" @onclick="@(() => RestoreFromStripAsync(WorkspacePanel.None))">Results</button>
            }
            @* Spec 030 — Phase 5 / spec 041 (R34): Results, Messages and Problems tabs. Always mounted.
               Spec 043 (R7, contracts/web-ui.md §3): one pane per query tab, each mounted while its tab lives (hidden when the
               tab is not active), so a tab's pending grid edits, sort and selection survive a switch. *@
            <div class="akml-ws-results-host @(Fitted.ResultsVisible ? null : "akml-ws-hidden")" data-testid="workspace-results"
                 role="region" aria-label="Results" tabindex="-1">
                @foreach (var paneTab in QueryTabs.Tabs)
                {
                    var t = paneTab;
                    bool shown = ReferenceEquals(t, Tab);
                    <div class="akml-ws-results-tabpane" @key="t.Id" hidden="@(!shown)" data-tab-id="@t.Id">
                        <ResultsPaneComponent @ref="_panes[t.Id]" IdPrefix="@($"akml-results-{t.Id}")" IsActive="shown" RunStartedAt="t.RunStartedAt" Session="t.Session"
                                              Result="t.Result" IsRunning="t.IsExecuting" FrozenReason="@FrozenReasonOf(t)" ActiveTab="@_resultsTab" ActiveTabChanged="OnResultsTabChangedAsync"
                                              Findings="t.Findings" AnalysisEnabled="_analysisEnabled" OnEnableAnalysis="EnableAnalysisAsync" ProblemsDefaultFilter="_problemsFilter"
                                              OnJumpToIssue="OnJumpToIssueAsync" OnSuppressLine="OnSuppressLineAsync" OnSuppressGlobal="OnSuppressGlobalAsync"
                                              SelectionStartLine="t.SelectionStartLine" SelectionStartColumn="t.SelectionStartColumn" ReceivedAt="t.ResultReceivedAt"
                                              OnNavigateToLine="OnNavigateToLineAsync" OnNavigateToPosition="OnNavigateToPositionAsync"
                                              OnApplied="@(() => OnAppliedReExecuteAsync(t))" DocumentName="@t.Name"
                                              ShowColumnTypes="_showColumnTypes" RetainLineBreaksOnCopy="_retainLineBreaksOnCopy"
                                              HasPendingEditsChanged="@(pending => OnGridPendingEditsChanged(t, pending))" />
                    </div>
                }
            </div>
        </div>

        @if (AiShown)
        {
            <div class="akml-ws-sr">
                <SplitterComponent Id="right" Side="right" Value="Fitted.AiWidth" Min="Limits.AiMinWidth" Max="AiMax"
                                   Controls="akml-ws-ai" Label="Resize the AI panel" CssVar="--akml-ws-right" Host="_workspaceEl"
                                   TestId="workspace-splitter-right"
                                   OnCommitted="px => Layout.SetAsync(WorkspaceLayoutFields.AiWidth, px)"
                                   OnReset="() => Layout.SetAsync(WorkspaceLayoutFields.AiWidth, Limits.AiDefaultWidth)"
                                   OnCollapseToggled="@(() => CollapseFromSplitterAsync(WorkspacePanel.Ai))" />
            </div>
        }
        else
        {
            <button type="button" class="akml-ws-edge akml-ws-edge--right" data-testid="workspace-edge-right"
                    title="Show AI panel" @onclick="@(() => RestoreFromStripAsync(WorkspacePanel.Ai))">AI</button>
        }
        @{ _aiMounted |= AiShown; }
        @if (_aiMounted)
        {
            @* Spec 028 (M6) — the AI dock: Actions / Chat. The action panel operates on the live editor selection
               (or the whole document); Accept inserts the result at the caret. *@
            <div class="akml-ws-ai akml-ai-dock @(AiShown ? null : "akml-ws-hidden")" id="akml-ws-ai" data-testid="workspace-ai"
                 role="region" aria-label="AI assistance" tabindex="-1">
                @* Spec 041 (R58, FR-070): the one tab strip; the close button sits beside the tablist (ARIA allows only
                   tabs inside it). *@
                <div class="akml-ai-tabs" data-testid="ai-dock">
                    <TabStrip Tabs="AiTabs" ActiveId="@Layout.Current.AiTab" ActiveIdChanged="@(id => Layout.SetAsync(WorkspaceLayoutFields.AiTab, id))"
                              AriaLabel="AI assistance" IdPrefix="ai" Name="ai">
                        <Trailing>
                            <button type="button" class="akml-btn akml-btn--icon akml-btn--ghost" data-testid="ai-close" @onclick="ToggleAiAsync"
                                    title="Close AI panel" aria-label="Close AI panel"><Icon Name="x" Size="14" /></button>
                        </Trailing>
                    </TabStrip>
                </div>
                <div class="akml-ai-dock-body" role="tabpanel" id="@TabStrip.PanelId("ai", Layout.Current.AiTab)"
                     aria-labelledby="@TabStrip.TabId("ai", Layout.Current.AiTab)">
                    @if (Layout.Current.AiTab == WorkspaceLayout.AiTabChat)
                    {
                        <AiChatPanel />
                    }
                    else
                    {
                        <AiPanel SelectedSqlProvider="@GetAiInputSqlAsync" OnAcceptResult="OnAiAcceptResultAsync" LastErrorProvider="GetLastExecuteError" />
                    }
                </div>
            </div>
        }
    </div>

    @if (_viewMenu != null)
    {
        <ContextMenu Items="_viewMenu.Value.Items" X="_viewMenu.Value.X" Y="_viewMenu.Value.Y" OnClose="() => _viewMenu = null"
                     TestId="view-menu-list" AriaLabel="View" />
    }

    @* Spec 041 — execute markers for Playwright: execute-complete's data-version grows per finished run
       (data-status = its ExecuteStatus); execute-running exists while one runs. *@
    @* Spec 043: the active query tab's. *@
    @if (Tab is { ExecuteVersion: > 0 } marked) { <span data-testid="execute-complete" data-version="@marked.ExecuteVersion" data-status="@marked.LastExecuteStatus" hidden></span> }
    @if (Running) { <span data-testid="execute-running" hidden></span> }

    @* Spec 024 T004: completion markers for Playwright. `_hasFormatted` / `_hasAnalysed`
       latch to true on the first successful Format / Analyse; `_formatVersion` /
       `_analyseVersion` increment per success so a test can detect a *repeat* operation
       (e.g. Scenario 4 in `specs/024-m2-web-closure/contracts/playwright-harness-contract.md`,
       which reformats after a profile switch). The simple attached-only pattern still
       works: `await Page.WaitForSelectorAsync("[data-testid='format-complete']")`.
       Edge-trigger pattern for repeats: capture `data-version` before the action and
       wait for it to change. *@
    @if (_hasFormatted) { <span data-testid="format-complete" data-version="@_formatVersion" hidden></span> }
    @if (_hasAnalysed) { <span data-testid="analyse-complete" data-version="@_analyseVersion" hidden></span> }

    @* Spec 027 T012 (US1) — surround-with picker. Opened by Ctrl+K, Ctrl+S; lists the
       surround-capable snippets and wraps the current selection on pick. *@
    @if (_showSurroundPicker)
    {
        <div class="akml-scrim" @onclick="CloseSurroundPicker">
            <div class="akml-dialog akml-picker" role="dialog" aria-modal="true" aria-label="Surround selection with…" @onclick:stopPropagation="true" data-testid="surround-picker">
                <div class="akml-dialog-header"><h2 class="akml-dialog-title">Surround selection with…</h2></div>
                @if (_surroundSnippets.Count == 0)
                {
                    <p class="akml-picker-empty">No surround-with snippets available.</p>
                }
                else
                {
                    <ul class="akml-picker-list">
                        @foreach (var s in _surroundSnippets)
                        {
                            <li class="akml-picker-item" @onclick="@(() => ApplySurroundAsync(s))">
                                <span class="akml-picker-code">@s.Metadata.Shortcode</span>
                                <span class="akml-picker-title">@s.Metadata.Title</span>
                            </li>
                        }
                    </ul>
                }
                <div class="akml-dialog-footer">
                    <button class="akml-btn" @onclick="CloseSurroundPicker">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* Spec 027 T017 (US2) — refactoring menu. Lists all ten lightweight (offline) ops;
       choosing one previews it, then the preview panel commits or cancels. Heavyweight
       (US3 / T020) entries are appended to this menu, gated by the bridge capability. *@
    @if (_showRefactorMenu)
    {
        <div class="akml-scrim" @onclick="CloseRefactorMenu">
            <div class="akml-dialog akml-picker" role="dialog" aria-modal="true" aria-label="Refactor" @onclick:stopPropagation="true" data-testid="refactor-menu">
                <div class="akml-dialog-header"><h2 class="akml-dialog-title">Refactor</h2></div>
                <ul class="akml-picker-list">
                    @foreach (var op in LightweightOps)
                    {
                        <li class="akml-picker-item" @onclick="@(() => PreviewLightweightAsync(op.Kind, op.Label))">
                            <span class="akml-picker-title">@op.Label</span>
                        </li>
                    }
                    @* Spec 027 T020 (US3) — heavyweight (schema-aware) ops. Enabled only when a
                       live engine advertises refactoring.heavy; otherwise shown disabled with a
                       reason (gated, never silently absent — FR-017). *@
                    <li class="akml-picker-sep">Schema-aware (requires engine)</li>
                    @foreach (var op in HeavyweightOps)
                    {
                        @if (Refactoring.HeavyAvailable)
                        {
                            <li class="akml-picker-item" @onclick="@(() => OpenHeavyDialog(op))">
                                <span class="akml-picker-title">@op.Label</span>
                            </li>
                        }
                        else
                        {
                            <li class="akml-picker-item akml-picker-disabled"
                                title="Requires a paired engine advertising 'refactoring.heavy'.">
                                <span class="akml-picker-title">@op.Label</span>
                                <span class="akml-picker-gate">engine</span>
                            </li>
                        }
                    }
                </ul>
                <div class="akml-dialog-footer">
                    <button class="akml-btn" @onclick="CloseRefactorMenu">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* Spec 027 T018 (US2) — lightweight refactoring preview. *@
    @if (_refactorPreview != null)
    {
        <RefactorPreviewPanel Title="@_refactorTitle"
                              Preview="_refactorPreview"
                              OnApply="ApplyLightweightAsync"
                              OnCancel="CloseRefactorPreview" />
    }

    @* Spec 027 T021 (US3) — heavyweight input dialog (rename / extract). *@
    @if (_heavyInput != null)
    {
        <RefactorInputDialog Title="@_refactorTitle"
                             NeedsOriginalIdentifier="_heavyInput.NeedsOriginalIdentifier"
                             NeedsNewName="_heavyInput.NeedsNewName"
                             NeedsUnitName="_heavyInput.NeedsUnitName"
                             OnSubmit="HeavyPreviewAsync"
                             OnCancel="CloseHeavyDialog" />
    }

    @* Spec 027 T022 (US3) — heavyweight (bridge) preview. *@
    @if (_heavyPreview != null)
    {
        <RefactorPreviewPanel Title="@_refactorTitle"
                              Heavy="_heavyPreview"
                              OnApply="ApplyHeavyAsync"
                              OnCancel="CloseHeavyPreview" />
    }
</div>

<style>
    .akml-editor-page {
        display: flex;
        flex-direction: column;
        height: 100%;
        outline: none;
        position: relative;   /* positioning context for the surround/refactor overlay */
    }
    .akml-editor-toolbar {
        display: flex;
        flex-wrap: wrap;   /* a narrow window gets a second row, never a button out of view (spec 041) */
        align-items: center;
        gap: var(--akml-scalar-spacing-s);
        padding: var(--akml-scalar-spacing-xs) var(--akml-scalar-spacing-s);
