@code {
    private EditorComponent? _editor;
    private string _initialText = string.Empty;
    private string _currentText = string.Empty;
    // Query-session grouping key (T9) -- minted/persisted once per page load by EditorSessionKeys,
    // then threaded through every debounced session save and every history record so a reload keeps
    // landing in the SAME history session.
    private string _sessionKey = string.Empty;

    /// <summary>The history session key: the document's, which New and Open renew (spec 041 R64).</summary>
    private string SessionKey => Document.SessionKey ?? _sessionKey;

    // Text changes before the document is loaded (the editor's first, empty change) are not the user's.
    private bool _documentLoaded;
    private IJSObjectReference? _uiModule;
    private CodeAnalysisResponse? _findings;
    private EditorDiagnostic? _errorDiagnostic;   // spec 041 (FR-023): the error line the user last went to
    private FormattingProfile? _activeProfile;
    private string? _status;
    private CancellationTokenSource? _analyseCts;
    private bool _autoAnalyseOnFormat = true;
    // Spec 024 T004: completion markers for the Playwright suite. The `_has*` flags
    // attach the data-testid span; the `_*Version` counters increment per success so
    // a repeat-operation test (Scenario 4 in playwright-harness-contract.md) can wait
    // for the version attribute to change rather than for re-attach.
    private bool _hasFormatted;
    private bool _hasAnalysed;
    private int _formatVersion;
    private int _analyseVersion;
    // Spec 025 US4 — schema tree wiring. The active connection's server identity +
    // database name drive the cache lookup; both refresh on OnInitializedAsync.
    private string? _activeServerIdentity;
    private string? _activeDatabaseName;

    // Spec 041 (R33–R38) — the workspace: the remembered layout (IWorkspaceLayoutStore) fitted to the measured
    // workspace, and the side panels a narrow window folds away (derived, never stored). The AI dock's open
    // state and tab are part of the layout now (they were page-only before).
    private static readonly WorkspaceLayoutLimits Limits = WorkspaceLayoutLimits.Default;
    private ElementReference _workspaceEl;
    private int _wsWidth;
    private int _wsHeight;
    // The side panel the user last opened by hand folds last (so opening AI at 1440 px folds Schema rather than
    // doing nothing); one opened by hand in a window too narrow even for it alone shows until the width changes.
    private WorkspacePanel _keep;
    private WorkspacePanel _forced;
    private bool _aiMounted;
    private static readonly IReadOnlyList<TabItem> AiTabs = new[]
    {
        new TabItem(WorkspaceLayout.AiTabActions, "Actions", TestId: "ai-tab-actions"),
        new TabItem(WorkspaceLayout.AiTabChat, "Chat", TestId: "ai-tab-chat"),
    };
    // A splitter's Enter collapses its panel and puts focus on the strip; the strip's Enter puts it back on the
    // splitter — so the keyboard can collapse and restore without hunting for focus.
    private string? _focusAfterRender;
    private (double X, double Y, IReadOnlyList<MenuItem> Items)? _viewMenu;

    /// <summary>The remembered layout corrected for the workspace as measured (until measured: as remembered).</summary>
    private WorkspaceLayout Fitted => _wsWidth > 0
        ? WorkspaceLayout.Fit(Layout.Current, _wsWidth, _wsHeight, Limits)
        : Layout.Current;

    private WorkspaceFold Fold => _wsWidth > 0 ? WorkspaceLayout.Fold(Fitted, _wsWidth, Limits, _keep) : WorkspaceFold.None;

    private bool SchemaShown => Fitted.SchemaVisible && (!Fold.SchemaFolded || _forced == WorkspacePanel.Schema);

    private bool AiShown => Fitted.AiVisible && (!Fold.AiFolded || _forced == WorkspacePanel.Ai);

    private int SchemaMax => Math.Max(Limits.SchemaMinWidth,
        (_wsWidth > 0 ? _wsWidth : 1600) - Limits.EditorMinWidth - Limits.SplitterTrack - (AiShown ? Fitted.AiWidth + Limits.SplitterTrack : Limits.EdgeStrip));

    private int AiMax => Math.Max(Limits.AiMinWidth,
        (_wsWidth > 0 ? _wsWidth : 1600) - Limits.EditorMinWidth - Limits.SplitterTrack - (SchemaShown ? Fitted.SchemaWidth + Limits.SplitterTrack : Limits.EdgeStrip));

    private int ResultsMax => Math.Max(Limits.ResultsMinHeight, (_wsHeight > 0 ? _wsHeight : 900) - Limits.EditorMinHeight - Limits.SplitterTrack);

    /// <summary>The results pane's height: as sized, or 38 % of the workspace until the user sizes it.</summary>
    private int ResultsPx => Fitted.ResultsHeight ?? (int)Math.Round((_wsHeight > 0 ? _wsHeight : 600) * Limits.ResultsDefaultFraction);

    private string WorkspaceClass => Fitted.ResultsVisible && Fitted.ResultsMaximised ? "akml-workspace akml-workspace--maximised" : "akml-workspace";

    private string WorkspaceStyle
    {
        get
        {
            var f = Fitted;
            string left = SchemaShown ? $"{f.SchemaWidth}px" : $"{Limits.EdgeStrip}px";
            string right = AiShown ? $"{f.AiWidth}px" : $"{Limits.EdgeStrip}px";
            string results = f.ResultsVisible ? $"{ResultsPx}px" : $"{Limits.EdgeStrip}px";
            return $"--akml-ws-left:{left};--akml-ws-vsplit-l:{(SchemaShown ? Limits.SplitterTrack : 0)}px;"
                + $"--akml-ws-right:{right};--akml-ws-vsplit-r:{(AiShown ? Limits.SplitterTrack : 0)}px;"
                + $"--akml-ws-results:{results};--akml-ws-hsplit:{(f.ResultsVisible && !f.ResultsMaximised ? Limits.SplitterTrack : 0)}px;"
                + $"--akml-ws-editor-min:{Limits.EditorMinWidth}px;--akml-ws-editor-min-h:{(f.ResultsMaximised ? 0 : Limits.EditorMinHeight)}px";
        }
    }

    // Spec 027 T012 (US1) — surround-with picker state.
    private bool _showSurroundPicker;
    private List<WebSnippet> _surroundSnippets = new();

    // Spec 027 T017/T018 (US2) — lightweight refactoring menu + preview state.
    private bool _showRefactorMenu;
    private LightweightPreview? _refactorPreview;
    private string _refactorTitle = string.Empty;
    private LightweightRefactorKind _pendingRefactorKind;

    // The ten lightweight (parser-only, offline) operations, in menu order.
    private static readonly (LightweightRefactorKind Kind, string Label)[] LightweightOps =
    {
        (LightweightRefactorKind.ExpandInsertColumns,    "Expand INSERT columns"),
        (LightweightRefactorKind.ExpandUpdateColumns,    "Expand UPDATE columns"),
        (LightweightRefactorKind.ConvertOldStyleJoins,   "Convert old-style joins"),
        (LightweightRefactorKind.EncapsulateBeginEnd,    "Encapsulate in BEGIN/END"),
        (LightweightRefactorKind.RemoveSemicolons,       "Remove semicolons"),
        (LightweightRefactorKind.ReplaceDeprecatedSyntax,"Replace deprecated syntax"),
        (LightweightRefactorKind.ExpandExecParameters,   "Expand EXEC parameters"),
        (LightweightRefactorKind.ConvertSpExecutesql,    "Convert sp_executesql"),
        (LightweightRefactorKind.AddGroupByColumns,      "Add GROUP BY columns"),
        (LightweightRefactorKind.Unformat,               "Unformat"),
    };

    // Spec 027 T020/T021/T022 (US3) — the three PRD-named heavyweight (bridge-only) ops.
    // OperationType ints match RefactorOperationType: SafeRename=0, ExtractToProc=2,
    // ParameterizeValues=7. Each declares which RefactorInputDialog fields it needs.
    private sealed record HeavyOp(string Label, int OperationType,
        bool NeedsOriginalIdentifier, bool NeedsNewName, bool NeedsUnitName);

    private static readonly HeavyOp[] HeavyweightOps =
    {
        new("Smart Rename",        OperationType: 0, NeedsOriginalIdentifier: true, NeedsNewName: true,  NeedsUnitName: false),
        new("Parameterize Values", OperationType: 7, NeedsOriginalIdentifier: false, NeedsNewName: false, NeedsUnitName: false),
        new("Extract Procedure",   OperationType: 2, NeedsOriginalIdentifier: false, NeedsNewName: false, NeedsUnitName: true),
    };

    private HeavyOp? _heavyInput;                       // non-null while the input dialog is open
    private RefactorPreviewResponse? _heavyPreview;     // non-null while the bridge preview is shown
    private RefactorInputDialog.RefactorInputs? _heavyInputs;   // captured dialog values for apply
    private string _heavyPreviewDocText = string.Empty; // the exact text the preview offsets refer to

    // Spec 030 — ⌘P command palette context-action registration. Closures over this page's live
    // state (the editor, the snippet store). Disposed on unmount so the palette can never run a
    // command against a torn-down editor.
    private IDisposable? _commandRegistration;
    private IReadOnlyList<CommandAction> _contextActions = Array.Empty<CommandAction>();
    private bool _keysInitialized;

    // Spec 041 (R37) — page-scoped key capture. akml-workspace.js claims the WorkspaceKeyMap keys of the
    // commands this page registered and calls OnWorkspaceKey; removed again on unmount.
    private IJSObjectReference? _workspaceModule;
    private DotNetObjectReference<Editor>? _selfRef;

    // Spec 030 — Phase 5: query execution + results pane state.
    private ResultsPaneComponent? _resultsPane;
    private ExecuteQueryResult? _result;
    private string _resultsTab = ResultsPaneComponent.ResultsTab;
    private DateTimeOffset _resultReceivedAt = DateTimeOffset.Now;
    private int _selectionStartLine = 1;
    private int _executeVersion;
    private int _lastExecuteStatus;
    private bool _analysisEnabled = true;
    private ProblemsFilter? _problemsFilter;
    private bool _executing;
    private int _maxRows = 1000;
    private int _timeoutSeconds = 30;
    private bool _showColumnTypes;
    private bool _retainLineBreaksOnCopy;
    private string? _activeQueryId;
    private string _lastExecutedSql = string.Empty;
    // web History "Re-execute": set from the ?autorun=1 query flag; consumed once the restored
    // document is populated (which happens AFTER firstRender via the async session restore).
    private bool _autorunPending;

    protected override async Task OnInitializedAsync()
    {
        // web History "Re-execute" intent — read before any await so it is known by the first render.
        _autorunPending = new Uri(Nav.Uri).Query.Contains("autorun=1");

        // T034: apply the persisted theme as soon as we have services. The shim is wired
        // for "system" already (index.html runs apply('system') inline), so this is an
        // upgrade only when the user has stored a non-system preference.
        await Theme.InitializeAsync();

        // Spec 041 (R36, FR-045) — the remembered workspace: which regions show, their sizes, the tabs.
        Layout.Changed += OnLayoutChanged;
        await Layout.LoadAsync();
        _resultsTab = Layout.Current.ResultsTab;

        // T051: restore the last editor session.
        var restored = await SessionStore.RestoreAsync();
        if (restored != null)
        {
            _initialText = restored.DocumentText;
            _currentText = restored.DocumentText;
        }

        // T9: get-or-create the persisted query-session grouping key, reusing the SAME record
        // just restored above (avoids a second IndexedDB round-trip) -- mints/persists a fresh
        // key on first use or after a reset.
        _sessionKey = await EditorSessionKeys.GetOrCreateAsync(SessionStore, restored);

        // Spec 041 (R64): the document — its name, modified state and default-name counter.
        await Document.LoadAsync(restored);
        Document.AdoptSessionKey(_sessionKey);
        Document.Attach(this, ConfirmDiscardPendingEditsAsync);
        Document.Changed += OnDocumentChanged;
        _documentLoaded = true;
        Workspace.SetDocument(Document.Name, Document.IsModified);

        // T038: load the active profile.
        var activeId = await ProfileStore.GetActiveIdAsync();
        try
        {
            var active = await ProfileStore.GetAsync(activeId);
            _activeProfile = active?.Profile;
        }
        catch (Exception)
        {
            // An engine style whose engine is not answering: format with the default until the
            // style picker hands the style over (it does once the engine answers).
            _activeProfile = null;
        }

        // T044: load analyser settings.
        var settings = await AnalysisSettings.GetAsync();
        _autoAnalyseOnFormat = settings.AutoAnalyseOnFormat;
        _analysisEnabled = settings.Enabled;
        _problemsFilter = settings.ProblemsFilter;

        // T048: restore the diagnostics ring buffer.
        await Diagnostics.RestoreAsync();
        Diagnostics.Log(DiagnosticLevel.Info, "editor", "Editor page mounted.");

        // Spec 025 US4 / spec 030 loop fix: point the schema tree at the ACTIVE SQL connection's
        // (server, database) — the SAME key MainLayout passes to SchemaSync.StartAsync, so the tree
        // finds the snapshot the sync populated. The previous code keyed the tree off the engine
        // pairing record (host:port) with a hard-coded "master" database, which never matched the
        // cache — the tree stayed "not yet loaded" and mislabelled the database even when connected
        // to e.g. Northwind. Re-evaluated on every SQL connection state change (OnSqlConnStateChanged).
        RefreshSchemaTarget();

        // Spec 030 — Phase 5: seed the execute caps from the store, and re-render the Execute button's
        // enabled state when the SQL connection comes/goes.
        // Spec 041 (R52): the toolbar shows the effective caps — this session's quick-control override, else the
        // defaults saved in Settings › Queries. The grid options come from the saved defaults only.
        var execSettings = await ExecSettings.GetEffectiveAsync();
        _maxRows = execSettings.MaxRows;
        _timeoutSeconds = execSettings.CommandTimeoutSeconds;
        _showColumnTypes = execSettings.ShowColumnTypes;
        _retainLineBreaksOnCopy = execSettings.RetainLineBreaksOnCopy;
        SqlConn.StateChanged += OnSqlConnStateChanged;

        // Spec 030 — register this page's context actions with the ⌘P palette. These close over the
        // live editor + page handlers; the registration token is disposed in DisposeAsync.
        _contextActions = BuildContextActions().Concat(WorkspaceViewActions.Build(this)).ToList();
        _commandRegistration = Commands.Register(_contextActions);
    }

    private void OnSqlConnStateChanged()
    {
        RefreshSchemaTarget();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Align the schema-tree target with the live SQL connection so its (server, database) lookup key
    /// matches what MainLayout passes to <c>SchemaSync.StartAsync</c> (<c>SqlConn.Server</c> /
    /// <c>SqlConn.Database</c>). Cleared when no SQL connection is open — the tree then offers to connect
    /// (spec 041 FR-048).
    /// </summary>
    private void RefreshSchemaTarget()
    {
        if (SqlConn.IsConnected && !string.IsNullOrEmpty(SqlConn.Server) && !string.IsNullOrEmpty(SqlConn.Database))
        {
            _activeServerIdentity = SqlConn.Server;
            _activeDatabaseName = SqlConn.Database;
        }
        else
        {
            _activeServerIdentity = null;
            _activeDatabaseName = null;
        }
    }

    // ── Spec 030 — Phase 5: execute + caps + apply-refresh ───────────────────────────────────────

    /// <summary>
    /// Run the query. Reads the LIVE editor text (selection-or-whole-doc, NOT the 500ms-debounced
    /// _currentText) exactly like GetAiInputSqlAsync, builds an ExecuteQueryRequest with the canonical
    /// SessionId + advisory caps, and hands the status-bearing result to the results pane. Triggered by
    /// the toolbar button AND the CM6 Mod-Enter keymap (via EditorComponent.OnExecute).
    /// </summary>
    private async Task ExecuteAsync()
    {
        if (_executing || _editor == null) return;
        // Claim the slot BEFORE any await so a second trigger (toolbar + Mod-Enter) can't reenter
        // through the two JS-interop awaits below. The finally always releases it.
        _executing = true;
        try
        {
            if (!SqlConn.IsConnected)
            {
                _status = "Connect to a SQL Server first (Connect button / palette).";
                return;
            }

            // LIVE text — selection if any, else the whole document — and where it starts, so an error's
            // line maps back to the document (spec 041 R24).
            var (sql, startLine) = await ReadExecuteTextAsync();
            if (string.IsNullOrWhiteSpace(sql)) return;

            // Spec 041 (FR-015): a new result replaces the grid, so its pending edits go — ask first.
            if (!await ConfirmDiscardPendingEditsAsync()) return;

            await RunSqlAsync(sql, startLine);
        }
        finally
        {
            _executing = false;
            _activeQueryId = null;
            StateHasChanged();
        }
    }

    /// <summary>The selection, or the whole document when it is empty or only whitespace, and the document
    /// line it starts on.</summary>
    private async Task<(string Sql, int StartLine)> ReadExecuteTextAsync()
    {
        if (_editor == null) return (string.Empty, 1);
        var selection = await _editor.GetSelectionInfoAsync();
        if (!string.IsNullOrWhiteSpace(selection.Text)) return (selection.Text, Math.Max(1, selection.StartLine));
        return (await _editor.GetTextAsync(), 1);
    }

    /// <summary>Runs <paramref name="sql"/> through the engine, shows the result, and records it in
    /// SQL History (best-effort). Shared by the toolbar/F5/Mod-Enter execute and the web History
    /// "Re-execute" autorun. The caller owns the <c>_executing</c> guard.</summary>
    private async Task RunSqlAsync(string sql, int startLine)
    {
        _lastExecutedSql = sql;
        _activeQueryId = Guid.NewGuid().ToString("N");
        Workspace.Begin();
        if (!Layout.Current.ResultsVisible) await Layout.SetAsync(WorkspaceLayoutFields.ResultsVisible, true);
        StateHasChanged();

        var result = await QueryExec.ExecuteAsync(sql, _maxRows, _timeoutSeconds, _activeQueryId, CancellationToken.None);
        ShowResult(result, startLine, chooseTab: true);

        // Record into SQL History (fire-and-forget) — NoConnection isn't recorded (nothing ran).
        if (WebHistoryLogic.ShouldRecord(result.Status))
        {
            // Spec 041 (R27): the database the script ended in (a USE moves it).
            var rec = WebHistoryLogic.BuildRecordRequest(sql, result, SqlConn.Server, result.CurrentDatabase ?? SqlConn.Database, SessionKey, Document.Name);
            _ = History.RecordAsync(rec, CancellationToken.None);
        }

        if (result.Status != ExecuteStatus.Ok)
        {
            Diagnostics.Log(DiagnosticLevel.Warn, "execute", $"Execute status {result.Status}: {result.ErrorMessage}");
        }
    }

    /// <summary>
    /// Spec 041 (FR-020) — hand a reply to the results pane and the status bar. With
    /// <paramref name="chooseTab"/> the pane shows Results when there is at least one set and no error,
    /// otherwise Messages.
    /// </summary>
    private void ShowResult(ExecuteQueryResult result, int startLine, bool chooseTab)
    {
        _result = result;
        _resultReceivedAt = DateTimeOffset.Now;
        _selectionStartLine = startLine;
        if (chooseTab)
        {
            _resultsTab = result.ResultSets.Length > 0 && result.Status == ExecuteStatus.Ok
                ? ResultsPaneComponent.ResultsTab
                : ResultsPaneComponent.MessagesTab;
        }
        Workspace.Complete(result);
        _executeVersion++;
        _lastExecuteStatus = result.Status;
    }

    /// <summary>The engine understands Parse (it advertises execute.v2).</summary>
    private bool SupportsParse => Array.IndexOf(Bridge.EngineCapabilities ?? Array.Empty<string>(), "execute.v2") >= 0;

    private bool CanParse => !_executing && SqlConn.IsConnected && SupportsParse;

    /// <summary>Spec 041 (R21, FR-035) — the server checks the script's syntax; nothing runs, nothing is
    /// recorded in History. The Messages tab says how it went.</summary>
    private async Task ParseAsync()
    {
        if (_executing || _editor == null || !CanParse) return;
        _executing = true;
        try
        {
            var (sql, startLine) = await ReadExecuteTextAsync();
            if (string.IsNullOrWhiteSpace(sql)) return;
            if (!await ConfirmDiscardPendingEditsAsync()) return;

            _activeQueryId = Guid.NewGuid().ToString("N");
            Workspace.Begin();
            StateHasChanged();
            var result = await QueryExec.ParseAsync(sql, _timeoutSeconds, _activeQueryId, CancellationToken.None);
            ShowResult(result, startLine, chooseTab: false);
            _resultsTab = ResultsPaneComponent.MessagesTab;
        }
        finally
        {
            _executing = false;
            _activeQueryId = null;
            StateHasChanged();
        }
    }

