        var all = await Snippets.ListAsync(SqlConn.IsConnected ? SqlConn.Kind : AkmlSql.Core.DatabaseKind.SqlServer);
        _surroundSnippets = all.Where(s => s.Metadata.SurroundsWith).ToList();
