<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AkmlSql.Web</RootNamespace>
    <AssemblyName>AkmlSql.Web</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec 021 M2 T041: expose internal Services types (FormatterService etc.) to bUnit tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AkmlSql.Web.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkmlSql.Core\AkmlSql.Core.csproj" />
    <ProjectReference Include="..\AkmlSql.Formatting\AkmlSql.Formatting.csproj" />
    <ProjectReference Include="..\AkmlSql.Web.Shared\AkmlSql.Web.Shared.csproj" />
    <!--
      AkmlSql.Analyzer is NOT referenced. It is the CLI executable (OutputType=Exe) and
      pulls AkmlSql.Engine transitively, which drags OpenAI, ClosedXML, OpenXml and SqlClient
      into the WASM bundle. The actual analysis library extraction lands as a new task
      (analogous to M5 IntelliSense extraction) tracked in
      specs/021-web-edition/M1-SPIKE-RESULTS.md under "Open follow-ups".
    -->
  </ItemGroup>

</Project>
