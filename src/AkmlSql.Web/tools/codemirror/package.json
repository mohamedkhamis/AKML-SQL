{
  "name": "akml-codemirror-vendor",
  "private": true,
  "version": "1.0.0",
  "description": "Vendors CodeMirror 6 into wwwroot/lib/codemirror/akml-cm.js so the web editor loads from 'self' instead of the esm.sh CDN (on-prem / offline / strict-CSP support). Run: npm install && npm run build.",
  "type": "module",
  "scripts": {
    "build": "esbuild cm-entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../wwwroot/lib/codemirror/akml-cm.js"
  },
  "dependencies": {
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/autocomplete": "^6",
    "@codemirror/search": "^6",
    "@codemirror/lint": "^6",
    "@lezer/highlight": "^1"
  },
  "devDependencies": {
    "esbuild": "^0.24"
  }
}
