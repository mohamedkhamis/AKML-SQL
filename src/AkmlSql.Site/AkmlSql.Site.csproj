<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AkmlSql.Site</RootNamespace>
    <AssemblyName>AkmlSql.Site</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.*" />
    <PackageReference Include="Markdown.ColorCode" Version="3.0.*" />
    <!-- Analytics storage (spec: site metrics): plain ADO.NET SQLite, no EF Core. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
  </ItemGroup>

  <!--
    Spec 034 T003: docs content ingestion (contracts/docs-content.md), split by kind (S3):
      - *.md            → Content/docs/        (parsed at startup; NEVER served statically)
      - image assets    → Content/docs-assets/ (served at /docs-assets by Program.cs)
    Only passive raster images are ingestible: svg is deliberately excluded — an SVG with an
    embedded <script> would otherwise be served as active same-origin content. The exclusion
    lists mirror appsettings.json Docs:Exclusions.
  -->
  <ItemGroup>
    <DocsSource Include="../../doc/**/*.md" />
    <DocsSource Remove="../../doc/_Prompt-Gap/**" />
    <DocsSource Remove="../../doc/Phase-One/**" />
    <DocsSource Remove="../../doc/superpowers/**" />
    <DocsSource Remove="../../doc/WEB/**" />
    <DocsSource Remove="../../doc/**/progress.md" />
    <DocsSource Remove="../../doc/**/bugs.md" />
    <DocsSource Remove="../../doc/**/manual-test-plan.md" />
    <DocsSource Remove="../../doc/**/codebase-audit-*.md" />
    <!-- C4: clearly-internal top-level trackers / test plans / campaigns (see appsettings). -->
    <DocsSource Remove="../../doc/**/spec-*-progress.md" />
    <DocsSource Remove="../../doc/**/spec-*-manual-tests.md" />
    <DocsSource Remove="../../doc/**/test-coverage-plan.md" />
    <DocsSource Remove="../../doc/**/*-campaign-*.md" />
    <DocsSource Remove="../../doc/**/MinMax-Installation-and-Testing-Guide.md" />
    <Content Include="@(DocsSource)"
             Link="Content/docs/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <DocsAsset Include="../../doc/**/*.png" />
    <DocsAsset Include="../../doc/**/*.jpg" />
    <DocsAsset Include="../../doc/**/*.jpeg" />
    <DocsAsset Include="../../doc/**/*.gif" />
    <DocsAsset Include="../../doc/**/*.webp" />
    <DocsAsset Remove="../../doc/_Prompt-Gap/**" />
    <DocsAsset Remove="../../doc/Phase-One/**" />
    <DocsAsset Remove="../../doc/superpowers/**" />
    <DocsAsset Remove="../../doc/WEB/**" />
    <Content Include="@(DocsAsset)"
             Link="Content/docs-assets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
