@page "/download"
@using System.Globalization
@using AkmlSql.Site.Releases
@using AkmlSql.Site.Settings
@inject ReleasesManifest Manifest
@inject ReleaseAvailability Availability
@inject SiteSettingsStore Settings

@* Spec 034 T016 (US1): FR-003 download page driven by wwwroot/releases.json via the
   singleton ReleasesManifest (T012). Failure behavior per contracts/releases-json.md:
   missing/invalid/empty manifest renders a friendly fallback plus the repo
   /releases/latest link — never an error page. Static SSR only.

   Spec 038: rebuilt in the shape a product download page usually takes — one decisive call to
   action with the size on it, the specs as a scannable table rather than prose, verification
   folded away until wanted, and older versions in a table instead of a stack of cards. The
   previous layout buried the button under a definition list and a paragraph of SmartScreen
   guidance. *@

<PageTitle>Download — AKML SQL</PageTitle>
<HeadContent>
    <meta name="description" content="Download AKML SQL for SQL Server Management Studio 22 and Visual Studio 2026. Free, open source, with SHA-256 verification and previous releases." />
    <meta property="og:title" content="Download" />
    <meta property="og:description" content="Download AKML SQL for SQL Server Management Studio 22 and Visual Studio 2026. Free, open source, with SHA-256 verification and previous releases." />
</HeadContent>

<div class="page-body container">

@* DL-001: an entry in releases.json is not proof the installer exists. If the advertised file is
   missing from the downloads folder, fall through to the same friendly fallback used when there is
   no manifest at all — a broken primary CTA is worse than an honest "not available yet". *@
@if (_latest is { } latest)
{
    <section class="download-hero release-card release-card-latest" aria-labelledby="latest-release-heading">
        <div class="download-hero-main">
            <p class="eyebrow">Download</p>
            <h1 id="latest-release-heading">AKML SQL for SSMS and Visual Studio</h1>
            <p class="download-hero-lead">
                One installer covers SQL Server Management Studio 22 and Visual Studio 2026.
                Free and open source under the MIT license.
            </p>

            <p class="cta-row">
                @* DL-004: download-track.js upgrades this link to the CDN URL and beacons the click
                   to /dl-count — the visitor goes straight to the CDN, the metric still lands. *@
                <a class="btn btn-primary btn-lg download-tracked" href="@ReleaseAvailability.TrackedUrl(latest)"
                   data-file="@System.IO.Path.GetFileName(latest.DownloadUrl)"
                   data-cdn-url="@latest.CdnUrl">
                    Download AKML SQL
                    @if (_latestSize is { } heroSize)
                    {
                        <span class="btn-sub">Windows · @heroSize</span>
                    }
                </a>
                @if (latest.ReleaseNotesUrl is not null)
                {
                    <a class="btn btn-secondary" href="@latest.ReleaseNotesUrl" target="_blank" rel="noopener noreferrer">Release notes</a>
                }
            </p>

            <p class="download-hero-meta">
                Version <strong>@latest.Version</strong>
                <span class="download-meta-sep">·</span>
                Released <time datetime="@latest.ReleasedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@latest.ReleasedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</time>
            </p>
        </div>
    </section>

    @if (latest.NotesSummary is not null)
    {
        <section class="download-panel" aria-labelledby="whats-new-heading">
            <h2 id="whats-new-heading">What's in this release</h2>
            <p>@latest.NotesSummary</p>
        </section>
    }

    <section class="download-panel" aria-labelledby="requirements-heading">
        <h2 id="requirements-heading">Requirements</h2>
        <table class="spec-table">
            <tbody>
                <tr>
                    <th scope="row">Supported hosts</th>
                    <td>
                        <ul class="host-badges">
                            @foreach (var host in latest.SupportedHosts)
                            {
                                <li>@host</li>
                            }
                        </ul>
                    </td>
                </tr>
                @if (latest.MinimumOsVersion is not null)
                {
                    @* U23: "Windows 10.0 or later" reads like an API version — trim a trailing ".0". *@
                    <tr>
                        <th scope="row">Operating system</th>
                        <td>Windows @DisplayOsVersion(latest.MinimumOsVersion) or later</td>
                    </tr>
                }
                @* DL-003: download size is something people check before clicking. Read from the
                   file, so it cannot be stale. *@
                @if (_latestSize is { } size)
                {
                    <tr>
                        <th scope="row">Download size</th>
                        <td>@size</td>
                    </tr>
                }
                <tr>
                    <th scope="row">File</th>
                    <td><code>@System.IO.Path.GetFileName(latest.DownloadUrl)</code></td>
                </tr>
            </tbody>
        </table>
    </section>

    @* Verification is standard practice but not something most visitors act on, so it is available
       rather than prominent — the same treatment a vendor download page gives a checksum. *@
    <details class="download-panel hash-block">
        <summary><h2 class="download-panel-summary">Verify this download</h2></summary>
        <p class="hash-hint">
            Compare the SHA-256 of the file you downloaded against this digest.
            @* U22: copy affordance — hidden by default, revealed by js/copy-hash.js
               (CSP-clean external script, so no-JS users never see a dead button). *@
            <button type="button" class="copy-hash-btn" data-copy-target="latest-sha256">Copy</button>
        </p>
        <code id="latest-sha256">@latest.Sha256Hash</code>
        <p class="hash-hint">
            In PowerShell:
            <code class="hash-cmd">Get-FileHash .\@System.IO.Path.GetFileName(latest.DownloadUrl) -Algorithm SHA256</code>
        </p>
    </details>

    <section class="download-panel" aria-labelledby="getting-started-heading">
        <h2 id="getting-started-heading">Getting started</h2>
        <p>
            New here? The <a href="/docs">documentation</a> covers installation and first steps, and
            the <a href="/features">feature overview</a> shows what the extension adds to SSMS and
            Visual Studio.
        </p>
    </section>

    @* U22: static SSR renders this into the page body; script-src 'self' allows it. *@
    <script src="@Assets["js/copy-hash.js"]" defer></script>
    <script src="@Assets["js/download-track.js"]" defer></script>

    @* DL-001: only list previous releases that can actually be downloaded. A table rather than a
       stack of cards: older versions are a reference list people scan, not content they read. *@
    @if (_previousReleases.Count > 0)
    {
        <section class="release-history" aria-labelledby="previous-releases-heading">
            <h2 id="previous-releases-heading">Previous versions</h2>
            <div class="table-scroll">
                <table class="spec-table release-table">
                    <thead>
                        <tr>
                            <th scope="col">Version</th>
                            <th scope="col">Released</th>
                            <th scope="col">Hosts</th>
                            <th scope="col"><span class="visually-hidden">Download</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var release in _previousReleases)
                        {
                            <tr class="release-card">
                                <td><strong>@release.Version</strong></td>
                                <td>
                                    <time datetime="@release.ReleasedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@release.ReleasedAt.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</time>
                                </td>
                                <td>@string.Join(", ", release.SupportedHosts)</td>
                                <td class="release-table-action">
                                    <a class="download-tracked" href="@ReleaseAvailability.TrackedUrl(release)"
                                       data-file="@System.IO.Path.GetFileName(release.DownloadUrl)"
                                       data-cdn-url="@release.CdnUrl">Download</a>
                                    <details class="hash-block hash-block-inline">
                                        <summary>SHA-256</summary>
                                        <code>@release.Sha256Hash</code>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
else
{
    @* contracts/releases-json.md: missing/unreadable file, invalid JSON, or an empty
       releases array all land here. *@
    <header class="page-header">
        <p class="eyebrow">Download</p>
        <h1>Download AKML SQL</h1>
    </header>
    <div class="notice" role="status">
        <h2>No public release available yet</h2>
        <p>
            The first installer release will be published right here. In the meantime you can
            get the latest build from the
            <a href="https://github.com/mohamedkhamis/AKML-SQL/releases/latest" target="_blank" rel="noopener noreferrer">latest release on GitHub</a>.
        </p>
    </div>
}

</div>

@code {
    /// <summary>U23: display form of the minimum OS version — trims a trailing ".0"
    /// so "10.0" renders as the consumer-facing "Windows 10 or later".</summary>
    private static string DisplayOsVersion(string version) =>
        version.EndsWith(".0", StringComparison.Ordinal) ? version[..^2] : version;

    /// <summary>The release shown in the primary card, or null when nothing is downloadable.</summary>
    private Release? _latest;

    /// <summary>Display size of the primary release, resolved once (null for a CDN-only release).</summary>
    private string? _latestSize;

    /// <summary>
    /// DL-001: older releases that can still actually be downloaded. An entry whose file has been
    /// cleaned up AND has no CDN mirror is dropped rather than offered as a dead link. URL
    /// construction lives in ReleaseAvailability.TrackedUrl so the page and the availability check
    /// agree on what "served locally" means.
    /// </summary>
    private IReadOnlyList<Release> _previousReleases = [];

    /// <summary>
    /// Spec 038 T021 (US1): resolve the whole release list ONCE per render.
    /// <para>
    /// This was an expression-bodied property (<c>private List&lt;Release&gt; PreviousReleases =&gt; …</c>)
    /// evaluated twice — once by <c>@@if (PreviousReleases.Count > 0)</c> and again by the
    /// <c>@@foreach</c> — so every release was probed on the filesystem twice. With 16 releases that
    /// was ~32 existence probes to render one download button. Fields resolved here cost one pass.
    /// </para>
    /// <para>
    /// Availability is still resolved per render, not cached across requests: installers are dropped
    /// into the folder between deploys, so presence must stay live (the DL-001 contract).
    /// </para>
    /// </summary>
    protected override void OnInitialized()
    {
        if (!Manifest.IsAvailable)
        {
            return;
        }

        // Spec 038 T033 (US2): the owner's visibility choice is applied BEFORE any availability
        // probe, so per-render work follows what is SHOWN rather than what is published (contract
        // R2.1). With "latest only" a hundred-release manifest costs a single probe.
        //
        // Settings.Current is an in-memory snapshot — the render path never touches SQLite, so a
        // settings failure can neither break nor slow the site's primary call to action (FR-016a).
        var settings = Settings.Current;
        var releases = ReleaseVisibility.Apply(settings.Visibility, settings.VisibilityCount, Manifest.Releases);

        var latest = releases.Count > 0 ? releases[0] : null;

        if (latest is null || !Availability.IsDownloadable(latest))
        {
            // contracts/releases-json.md: fall through to the friendly fallback, never an error page.
            return;
        }

        _latest = latest;
        _latestSize = Availability.DisplaySize(latest);

        // "Latest only" renders NO history section at all -- not an empty one (contract R2.2).
        if (settings.Visibility == ReleaseVisibilityMode.LatestOnly)
        {
            return;
        }

        var previous = new List<Release>();
        for (var i = 1; i < releases.Count; i++)
        {
            if (Availability.IsDownloadable(releases[i]))
            {
                previous.Add(releases[i]);
            }
        }

        _previousReleases = previous;
    }
}
