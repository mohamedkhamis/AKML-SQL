@page "/admin"
@layout AdminLayout
@using System.Globalization
@using AkmlSql.Site.Admin
@using AkmlSql.Site.Analytics
@using AkmlSql.Site.Releases
@using Microsoft.Extensions.Options
@inject AnalyticsStore Store
@inject IOptions<DownloadsOptions> DownloadsConfig
@inject GeoLookup Geo
@inject IOptions<AnalyticsOptions> AnalyticsConfig
@inject AkmlSql.Site.Settings.SiteSettingsStore SiteSettings

@* Admin metrics dashboard. Static SSR; the charts are PURE CSS — bar heights come from the
   precomputed .bar-h-* bucket classes in site.css (strict CSP: no inline styles).

   ADM-003: the window is a query-string value, which keeps the page static-SSR while making a
   chosen range bookmarkable and shareable. *@

<PageTitle>Dashboard — AKML SQL Admin</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@* Spec 038 (US4): AdminLayout now owns the page wrapper, the section navigation, the shared
   reporting window and sign-out. This page keeps only what it actually reports. *@
<header class="page-header admin-header-row">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Site metrics</h1>
        <p class="page-intro">
            Page visits and installer downloads over the last @AdminDashboardOptions.Label(_days).
            Automated traffic — crawlers and scripted clients — is excluded from the visitor figures and reported separately. Installer downloads still count a scripted fetch, which is a real acquisition.
        </p>
        @* Spec 038 T096: this paragraph must state what the site ACTUALLY does. Before this feature
           it read "full IP addresses are never stored ... No cookies are set for visitors" — both
           halves became false the moment the consent gate shipped, and a false privacy claim shown
           to the owner is how a false one ends up shown to visitors. Kept in step with
           /privacy, which PrivacyPageTests pins to the same configured retention value. *@
        <p class="admin-privacy">
            <strong>Privacy:</strong> for visitors who <em>accept</em> tracking, the full IP address
            and a persistent id cookie are stored for @_identifiableRetentionDays days, then erased
            while the visit itself is kept. For everyone else — declined, or not yet answered —
            neither is ever written: only a per-day salted hash (for unique counting), the network
            prefix (<code>@($"/{IpAnonymizer.IPv4PrefixBits}")</code> IPv4,
            <code>@($"/{IpAnonymizer.IPv6PrefixBits}")</code> IPv6) and the country derived at write
            time. No city, region or finer location is ever kept.
            Rows older than @_retentionDays days are deleted entirely.
        </p>
    </div>
</header>

@* ADM-007: export. The range selector itself moved to AdminLayout, which shares one window
   across every portal section (FR-032). *@
<nav class="admin-toolbar" aria-label="Export">
    <a class="admin-export" href="/admin/metrics.csv?days=@_days" download>Export CSV</a>
</nav>

<section class="admin-stats" aria-label="Key metrics">
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.VisitsToday</p>
        <p class="admin-stat-label">Visits today</p>
    </div>
    @* ADM-002: the per-day salted IP hash existed so this was countable without storing an IP;
       nothing had ever used it. *@
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.UniqueVisitorsToday</p>
        <p class="admin-stat-label">Unique today</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.VisitsLast7Days</p>
        <p class="admin-stat-label">Visits · 7 days</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.VisitsWindow</p>
        <p class="admin-stat-label">Visits · @_summary.Days days</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.DownloadsWindow</p>
        <p class="admin-stat-label">Downloads · @_summary.Days days</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.DownloadsTotal</p>
        <p class="admin-stat-label">Downloads · total</p>
    </div>
    @* Crawlers and scripted clients, shown rather than silently discarded — a spike here
       explains an otherwise quiet week. Excluded from every visitor figure above. *@
    <div class="admin-stat admin-stat-muted">
        <p class="admin-stat-value">@_summary.AutomatedVisitsWindow</p>
        <p class="admin-stat-label">Automated · @_summary.Days days</p>
    </div>
</section>

<Chart Title="Visits" Series="_summary.DailyVisits" Secondary="_summary.DailyUniqueVisitors"
       SecondaryLabel="unique visitors" Days="_summary.Days" IdPrefix="visits" />

@* ADM-005: downloads previously had only two scalars — the conversion metric that matters most
   had no trend at all. *@
<Chart Title="Downloads" Series="_summary.DailyDownloads" Days="_summary.Days" IdPrefix="downloads" />

@* Session shape: what page-view counts alone cannot say. *@
<section class="admin-stats admin-stats-secondary" aria-label="Engagement">
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.Sessions</p>
        <p class="admin-stat-label">Sessions · @_summary.Days days</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.PagesPerSession.ToString("0.00", CultureInfo.InvariantCulture)</p>
        <p class="admin-stat-label">Pages / session</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.BounceRatePercent.ToString("0.#", CultureInfo.InvariantCulture)%</p>
        <p class="admin-stat-label">Bounce rate</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@FormatDuration(_summary.AverageSessionSeconds)</p>
        <p class="admin-stat-label">Avg. session</p>
    </div>
</section>

<div class="admin-tables">
    <section class="admin-panel" aria-labelledby="top-pages-heading">
        <h2 id="top-pages-heading">Top pages · @_summary.Days days</h2>
        @if (_summary.TopPages.Count == 0)
        {
            <p class="admin-empty">No visits recorded yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>Path</th><th class="admin-num">Visits</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _summary.TopPages)
                        {
                            <tr><td>@row.Key</td><td class="admin-num">@row.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ADM-002: ua_family was recorded on every row and never displayed. *@
    <section class="admin-panel" aria-labelledby="browsers-heading">
        <h2 id="browsers-heading">Browsers · @_summary.Days days</h2>
        @if (_summary.BrowserMix.Count == 0)
        {
            <p class="admin-empty">No visits recorded yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>Browser</th><th class="admin-num">Visits</th><th class="admin-num">Share</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _summary.BrowserMix)
                        {
                            <tr>
                                <td>@row.Key</td>
                                <td class="admin-num">@row.Count</td>
                                <td class="admin-num">@Share(row.Count)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="admin-panel" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading">Downloads by file</h2>
        @if (_summary.DownloadsByFile.Count == 0)
        {
            <p class="admin-empty">No downloads recorded yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>File</th><th class="admin-num">Downloads</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _summary.DownloadsByFile)
                        {
                            <tr><td>@row.Key</td><td class="admin-num">@row.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="admin-panel" aria-labelledby="referrers-heading">
        <h2 id="referrers-heading">Top referrers · @_summary.Days days</h2>
        @if (_summary.TopReferrers.Count == 0)
        {
            <p class="admin-empty">No external referrers recorded yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>Host</th><th class="admin-num">Visits</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _summary.TopReferrers)
                        {
                            <tr><td>@row.Key</td><td class="admin-num">@row.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <MetricTable Id="countries" Heading="@($"Countries · {_summary.Days} days")" KeyHeader="Country"
                 Rows="_summary.Countries" Total="_summary.Countries.Sum(r => r.Count)"
                 Empty="@(_geoAvailable ? "No located visits yet." : "No geo database installed — see Analytics:GeoDatabasePath.")" />

    <MetricTable Id="devices" Heading="@($"Devices · {_summary.Days} days")" KeyHeader="Device"
                 Rows="_summary.Devices" Total="_summary.Devices.Sum(r => r.Count)" Empty="No visits recorded yet." />

    <MetricTable Id="os" Heading="@($"Operating systems · {_summary.Days} days")" KeyHeader="OS"
                 Rows="_summary.OperatingSystems" Total="_summary.OperatingSystems.Sum(r => r.Count)" Empty="No visits recorded yet." />

    <MetricTable Id="languages" Heading="@($"Languages · {_summary.Days} days")" KeyHeader="Language"
                 Rows="_summary.Languages" Total="_summary.Languages.Sum(r => r.Count)" Empty="No language data recorded yet." />

    @* Campaign attribution: what actually connects a download back to the link that produced it. *@
    <MetricTable Id="campaigns" Heading="@($"Campaigns · {_summary.Days} days")" KeyHeader="Campaign / medium"
                 Rows="_summary.Campaigns" Total="_summary.Campaigns.Sum(r => r.Count)"
                 Empty="No UTM-tagged links seen yet — add ?utm_source=… to a shared link." />

    <MetricTable Id="referrer-urls" Heading="@($"Referring pages · {_summary.Days} days")" KeyHeader="URL"
                 Rows="_summary.ReferrerUrls" Total="_summary.ReferrerUrls.Sum(r => r.Count)"
                 Empty="No external referring pages recorded yet." />

    <MetricTable Id="entry-pages" Heading="@($"Entry pages · {_summary.Days} days")" KeyHeader="Path"
                 Rows="_summary.EntryPages" CountHeader="Sessions" Empty="No sessions recorded yet." />

    <MetricTable Id="exit-pages" Heading="@($"Exit pages · {_summary.Days} days")" KeyHeader="Path"
                 Rows="_summary.ExitPages" CountHeader="Sessions" Empty="No sessions recorded yet." />

    <MetricTable Id="slow-pages" Heading="@($"Slowest pages · {_summary.Days} days")" KeyHeader="Path"
                 Rows="_summary.SlowestPages" CountHeader="Mean ms"
                 Empty="Not enough samples yet (a page needs at least 3 views)." />

    @* ADM-008: broken inbound links. Only 2xx responses were tracked before, so these were
       invisible — and they are the one failure the owner can actually fix. *@
    <section class="admin-panel" aria-labelledby="notfound-heading">
        <h2 id="notfound-heading">Broken links · @_summary.Days days</h2>
        @if (_summary.TopNotFound.Count == 0)
        {
            <p class="admin-empty">No missing pages requested — nothing to fix.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>Requested path</th><th class="admin-num">404s</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _summary.TopNotFound)
                        {
                            <tr><td>@row.Key</td><td class="admin-num">@row.Count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="admin-panel" aria-labelledby="files-heading">
        <h2 id="files-heading">Files in the downloads folder</h2>
        <p class="admin-path"><code>@DownloadsConfig.Value.Folder</code></p>
        @if (_files.Count == 0)
        {
            <p class="admin-empty">No installer files present.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>Name</th><th class="admin-num">Size</th><th>Last write (UTC)</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var file in _files)
                        {
                            <tr>
                                <td><a href="/dl/@file.Name">@file.Name</a></td>
                                <td class="admin-num">@ReleaseAvailability.FormatSize(file.SizeBytes)</td>
                                <td>@file.LastWriteUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>


@code {
    private AnalyticsSummary _summary = null!;
    private IReadOnlyList<DownloadFileInfo> _files = [];
    private int _days = AdminDashboardOptions.DefaultDays;
    private bool _geoAvailable;
    private int _retentionDays;

    /// <summary>Spec 038: read from the live setting, so this paragraph cannot drift from behaviour.</summary>
    private int _identifiableRetentionDays;

    /// <summary>
    /// ADM-003: reporting window from <c>?days=</c>; clamped, never trusted raw.
    /// <para>
    /// Bound as a STRING, not an <c>int?</c>: Blazor's query-string binder throws on a value it
    /// cannot parse, so <c>?days=banana</c> returned a 500 before any clamping could run — a
    /// mangled link or a crawler could break the owner's dashboard. Parsing here means every
    /// malformed value lands on the default instead.
    /// </para>
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "days")]
    public string? Days { get; set; }

    protected override void OnParametersSet()
    {
        _days = AdminDashboardOptions.NormalizeDays(
            int.TryParse(Days, NumberStyles.Integer, CultureInfo.InvariantCulture, out var requested)
                ? requested
                : null);
        _geoAvailable = Geo.IsAvailable;
        _retentionDays = AnalyticsConfig.Value.RetentionDays;
        _identifiableRetentionDays = SiteSettings.Current.IdentifiableRetentionDays;
        _summary = Store.GetSummary(_days);
        _files = DownloadsInfo.List(DownloadsConfig.Value.Folder);
    }

    /// <summary>Session length as "1m 42s" / "38s"; 0 renders as a dash.</summary>
    private static string FormatDuration(double seconds) => seconds switch
    {
        <= 0 => "—",
        < 60 => $"{seconds:0}s",
        _ => $"{(int)(seconds / 60)}m {(int)(seconds % 60):00}s",
    };

    /// <summary>Share of window visits, for the browser table.</summary>
    private string Share(long count) =>
        _summary.VisitsWindow <= 0
            ? "—"
            : (count * 100.0 / _summary.VisitsWindow).ToString("0.#", CultureInfo.InvariantCulture) + "%";
}
