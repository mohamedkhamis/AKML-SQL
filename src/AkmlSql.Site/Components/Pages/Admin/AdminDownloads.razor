@page "/admin/downloads"
@layout AdminLayout
@using System.Globalization
@using AkmlSql.Site.Admin
@using AkmlSql.Site.Analytics
@inject AnalyticsStore Store
@inject GeoLookup Geo

@* Spec 038 T069 (US3): downloads lead the portal, because downloads are what the owner asked to
   see. Country, version and trend — the three questions actually being asked.

   Charts are the existing pure-CSS component: bar heights come from precomputed .bar-h-* bucket
   classes, because the site CSP forbids inline styles. No chart library. *@

<PageTitle>Downloads — AKML SQL Admin</PageTitle>

<header class="page-header">
    <p class="eyebrow">Admin</p>
    <h1>Downloads</h1>
    <p class="page-intro">
        Installer downloads for @Range.Phrase.
        A scripted fetch (curl, PowerShell) counts — it is a real acquisition. A crawler does not.
    </p>
</header>

<section class="admin-stats" aria-label="Download totals">
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.DownloadsWindow.ToString("N0", CultureInfo.InvariantCulture)</p>
        <p class="admin-stat-label">In window</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.DownloadsLast7Days.ToString("N0", CultureInfo.InvariantCulture)</p>
        <p class="admin-stat-label">Last 7 days</p>
    </div>
    <div class="admin-stat">
        <p class="admin-stat-value">@_summary.DownloadsTotal.ToString("N0", CultureInfo.InvariantCulture)</p>
        <p class="admin-stat-label">All time</p>
    </div>
    <div class="admin-stat">
        @* Resolved countries only. Counting the explicit "Unknown" bucket as a country read as
           "1 country" on a deployment where the geo database is absent and nothing has a country
           at all — a number that is worse than useless because it looks like data. *@
        <p class="admin-stat-value">@_resolvedCountryCount.ToString("N0", CultureInfo.InvariantCulture)</p>
        <p class="admin-stat-label">Countries</p>
    </div>
</section>

<nav class="admin-toolbar" aria-label="Export">
    <a class="admin-export" href="@AdminNav.WithRange("/admin/downloads.csv", Range)" download>Export CSV</a>
</nav>

@if (Range.IsSingleDay)
{
    @* One day is one bar on a daily chart, which says nothing; split it by hour instead. *@
    <HourlyChart IdPrefix="downloads" Title="Downloads" Caption="@($"{Range.Phrase}, hour by hour")" Values="_summary.HourlyDownloads" />
}
else
{
    <Chart IdPrefix="downloads" Title="Downloads per day" Days="Range.Days" Series="_summary.DailyDownloads" />
}

@if (!_hasAnyCountry && _summary.DownloadsWindow > 0)
{
    @* Two very different situations produce the same all-Unknown table, and saying the wrong one is
       worse than saying nothing: either no database is installed, or one is installed but no
       download has been recorded since. The banner has to tell them apart -- it claimed the former
       for hours after the database went live. *@
    <div class="notice" role="status">
        @if (!_geoAvailable)
        {
            <h2>No country database installed</h2>
            <p>
                Every download below is grouped under <strong>Unknown</strong> because the offline
                country database is not installed on this server.
            </p>
            <p>
                Run <code>scripts/update-geoip.ps1</code> to install it — the default source needs
                no account or licence key.
            </p>
        }
        else
        {
            <h2>No country data yet</h2>
            <p>
                The country database <strong>is</strong> installed, but no download in this window
                was recorded after it went live. Country is resolved when a download is recorded, so
                earlier rows can never be given one — only downloads from now on will have a country.
            </p>
        }
    </div>
}

<div class="admin-tables">
    <section class="admin-panel" aria-labelledby="country-heading">
        <h2 id="country-heading">By country</h2>
        @if (_countries.Count == 0)
        {
            <p class="admin-empty">No downloads in this window.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Country</th>
                            <th scope="col" class="admin-num">Downloads</th>
                            <th scope="col" class="admin-num">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _countries)
                        {
                            <tr>
                                <td class="admin-key">
                                    @row.Label
                                    @if (row.CountryCode is not null)
                                    {
                                        <span class="admin-choice-hint"> (@row.CountryCode)</span>
                                    }
                                </td>
                                <td class="admin-num">@row.Count.ToString("N0", CultureInfo.InvariantCulture)</td>
                                <td class="admin-num">@row.SharePercent.ToString("0.#", CultureInfo.InvariantCulture)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="admin-panel" aria-labelledby="version-heading">
        <h2 id="version-heading">By release</h2>
        @if (_versions.Count == 0)
        {
            <p class="admin-empty">No downloads in this window.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Version</th>
                            <th scope="col">File</th>
                            <th scope="col" class="admin-num">Downloads</th>
                            <th scope="col" class="admin-num">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _versions)
                        {
                            <tr>
                                <td class="admin-key">@row.Label</td>
                                <td class="admin-key">@(row.File ?? "—")</td>
                                <td class="admin-num">@row.Count.ToString("N0", CultureInfo.InvariantCulture)</td>
                                <td class="admin-num">@row.SharePercent.ToString("0.#", CultureInfo.InvariantCulture)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "days")]
    private string? DaysQuery { get; set; }

    /// <summary>The reporting range from <c>?days=</c> (see <see cref="AdminDashboardOptions.ResolveRange"/>).</summary>
    private ReportRange Range => AdminDashboardOptions.ResolveRange(DaysQuery);

    /// <summary>The range resolved once per request, so every figure describes the same instant.</summary>
    private ReportWindow _window = default!;

    private AnalyticsSummary _summary = default!;
    private IReadOnlyList<DownloadCountryRow> _countries = [];
    private IReadOnlyList<DownloadVersionRow> _versions = [];
    private bool _hasAnyCountry;
    private int _resolvedCountryCount;
    private bool _geoAvailable;

    protected override void OnInitialized()
    {
        _window = Store.ResolveWindow(Range);
        _summary = Store.GetSummary(_window);
        _countries = Store.GetDownloadsByCountry(_window);
        _versions = Store.GetDownloadsByVersion(_window);
        _hasAnyCountry = _countries.Any(c => c.CountryCode is not null);
        _resolvedCountryCount = _countries.Count(c => c.CountryCode is not null);
        _geoAvailable = Geo.IsAvailable;
    }
}
