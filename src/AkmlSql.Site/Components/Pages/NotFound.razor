@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — AKML SQL</PageTitle>
<HeadContent>
    <meta name="description" content="The page you are looking for does not exist or may have moved." />
    <meta property="og:title" content="Page not found" />
    <meta property="og:description" content="The page you are looking for does not exist or may have moved." />
</HeadContent>

<div class="page-body container">
    <header class="page-header">
        <p class="eyebrow">404</p>
        <h1>Page not found</h1>
        <p class="page-intro">The page you are looking for does not exist or may have moved.</p>
    </header>
    <p class="cta-row">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/docs">Browse documentation</a>
    </p>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Re-executed requests already carry 404; a direct request for /not-found must too, or the
    // page is a soft 404 that search engines index.
    protected override void OnInitialized()
    {
        if (HttpContext is { Response.HasStarted: false })
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
