@page "/privacy"
@using AkmlSql.Site.Consent
@using AkmlSql.Site.Settings
@using Microsoft.AspNetCore.Antiforgery
@inject SiteSettingsStore Settings
@inject IAntiforgery Antiforgery

@* Spec 038 T048 (US5): the published privacy notice, plus withdrawal and deletion (FR-039/FR-045).

   The retention number below is read from the SAME configuration the store enforces
   (SiteSettingsStore.Current.IdentifiableRetentionDays), never hard-coded. That is what makes
   PrivacyPageTests able to fail the build when the notice and the behaviour drift apart — a privacy
   notice that quietly stops matching what the site does is worse than no notice (SC-013). *@

<PageTitle>Privacy — AKML SQL</PageTitle>
<HeadContent>
    <meta name="description" content="What the AKML SQL site collects, why, how long it is kept, and how to have it removed." />
</HeadContent>

<div class="page-body container">
<header class="page-header">
    <p class="eyebrow">Privacy</p>
    <h1>What this site collects</h1>
    <p class="page-intro">
        AKML SQL is free and open source. The site records enough to know whether anyone is using it
        and where they are — nothing is sold, shared, or sent to an advertising network.
    </p>
</header>

@if (Forgotten is not null)
{
    <div class="notice" role="status">
        <h2>Done</h2>
        <p>
            @if (Forgotten > 0)
            {
                <span>@Forgotten record@(Forgotten == 1 ? "" : "s") deleted, and this browser will no longer be recognised.</span>
            }
            else
            {
                <span>Nothing was stored about this browser. It will not be recognised on future visits.</span>
            }
        </p>
    </div>
}

<section class="doc-section" aria-labelledby="everyone-heading">
    <h2 id="everyone-heading">Recorded for every visitor</h2>
    <p>This is what the site records whether or not you agree to anything:</p>
    <ul>
        <li>The page you visited, when, and which site linked you here.</li>
        <li>
            Your country, worked out from your IP address <em>on this server</em> — never a city or
            an address, and never sent to anyone else.
        </li>
        <li>Your browser, operating system and device type.</li>
        <li>Which installer you downloaded, if you downloaded one.</li>
        <li>
            A shortened form of your IP address (the network, not the machine), and a one-way hash
            of the full address that is re-scrambled every day so it cannot be used to follow you
            between days.
        </li>
    </ul>
    <p>None of this identifies you personally, and it is never linked into a profile.</p>
</section>

<section class="doc-section" aria-labelledby="consent-heading">
    <h2 id="consent-heading">Recorded only if you agree</h2>
    <p>If you accept the request shown on your first visit, two further things are stored:</p>
    <ul>
        <li><strong>Your full IP address.</strong></li>
        <li>
            <strong>A cookie holding a random id</strong> (<code>akml.vid</code>), which lets the
            site recognise this browser on later visits and join your visits and downloads into one
            history.
        </li>
    </ul>
    <p>
        Both are kept for <strong>@RetentionDays days</strong>, then erased automatically. The visit
        itself is kept longer as an anonymous statistic, with those two values removed.
    </p>
    <p>
        If you decline, neither is ever stored, no id cookie is issued, and the site works exactly
        the same — including downloads. Your refusal is remembered in a second cookie
        (<code>akml.consent</code>) purely so you are not asked again.
    </p>
</section>

<section class="doc-section" aria-labelledby="why-heading">
    <h2 id="why-heading">Why</h2>
    <p>
        To know which countries the software is used in, whether a new release is being picked up,
        and whether the site is worth translating. It is read by one person — the author — and by
        nobody else.
    </p>
</section>

<section class="doc-section" aria-labelledby="remove-heading">
    <h2 id="remove-heading">Change your mind</h2>
    <p>
        This removes the id cookie from this browser and deletes every record held against it. It
        takes effect immediately and cannot be undone.
    </p>
    <form method="post" action="/privacy/forget">
        @if (RequestToken is not null)
        {
            <input type="hidden" name="__RequestVerificationToken" value="@RequestToken" />
        }
        <button type="submit" class="btn btn-secondary">Withdraw consent and delete my data</button>
    </form>
    <p class="admin-choice-hint">
        For anything else — a copy of what is held, or a question — email the address on the
        <a href="https://github.com/mohamedkhamis/AKML-SQL" target="_blank" rel="noopener noreferrer">project page</a>.
    </p>
</section>

@* DB-IP's IP-to-Country Lite is CC BY 4.0, which REQUIRES attribution. It sits here because this
   is the page that explains how the country is worked out, and because an attribution nobody can
   find is not an attribution. *@
<section class="doc-section" aria-labelledby="geo-heading">
    <h2 id="geo-heading">Where the country comes from</h2>
    <p>
        Your country is looked up on this server against an offline database — your address is never
        sent to a third-party geolocation service. The database is
        <a href="https://db-ip.com" target="_blank" rel="noopener noreferrer">IP to Country Lite by DB-IP</a>,
        used under the
        <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">Creative Commons Attribution 4.0 International Licence</a>.
    </p>
</section>

@* The feedback form collects the only free text and the only email address on the site, so what
   happens to them is stated here -- the form itself links to this section. *@
<section class="doc-section" id="feedback" aria-labelledby="feedback-privacy-heading">
    <h2 id="feedback-privacy-heading">If you send feedback</h2>
    <p>
        When you use the <a href="/feedback">feedback form</a>, your message, what it is about, the page
        you came from, and your country and browser type are stored so the problem can be understood.
        Your email address is stored only if you enter one, and is used only to reply to that message.
        Your IP address is not stored with it, and nothing links the message to your visits.
    </p>
    <p>
        Messages are kept until the developer deletes them. A notification may be sent by email to the
        developer; it contains the same information. To have a message removed, send another one asking
        for it, or write through the project's GitHub page.
    </p>
</section>

@* The installed product reports errors to this site (/api/client-errors), on by default since the
   installer's options page defaulted to it. What that sends is stated here, and the installer's
   options page links to this anchor -- so it must stay true to TelemetryScrubber and TelemetryBatch. *@
<section class="doc-section" id="app" aria-labelledby="app-heading">
    <h2 id="app-heading">The AKML SQL app: error reports and updates</h2>
    <p>
        When something goes wrong inside AKML SQL, it sends an <strong>anonymous error report</strong> to
        this site so the problem can be found and fixed. A report contains the error message, where in
        AKML SQL it happened, the AKML SQL and Windows versions, the name of the program it happened in
        (such as SSMS), and a random installation number that is not linked to you.
    </p>
    <p>
        It never contains your queries, your data, or your connection details. User, computer, server and
        database names, file paths under your user folder, email and IP addresses are removed from the
        error text <em>before</em> it leaves your computer. Only errors are sent, never ordinary activity.
    </p>
    <p>
        Error reports are on by default. Turn them off in the installer, or later in SSMS
        under <strong>Tools &gt; AKML SQL &gt; Options &gt; General</strong>.
    </p>
    <p>
        To check for updates, AKML SQL downloads a small version file from this site once a day. That
        request carries only the version you have.
    </p>
</section>

<section class="doc-section" aria-labelledby="cookies-heading">
    <h2 id="cookies-heading">Cookies in full</h2>
    <table class="admin-table">
        <thead>
            <tr><th scope="col">Name</th><th scope="col">Purpose</th><th scope="col">Lifetime</th></tr>
        </thead>
        <tbody>
            <tr>
                <td><code>akml.consent</code></td>
                <td>Remembers your choice so you are not asked again. Set whichever way you answer.</td>
                <td>@ConsentCookies.LifetimeDays days</td>
            </tr>
            <tr>
                <td><code>akml.vid</code></td>
                <td>Recognises this browser on return visits. Only set if you accept.</td>
                <td>@ConsentCookies.LifetimeDays days</td>
            </tr>
            <tr>
                <td><code>akml.admin</code></td>
                <td>Sign-in session for the site owner's admin area. Never set for visitors.</td>
                <td>8 hours</td>
            </tr>
        </tbody>
    </table>
</section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "forgotten")]
    private int? Forgotten { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestToken { get; set; }

    /// <summary>
    /// Read from the live setting, never a literal — this is what keeps the notice honest when the
    /// owner changes retention (SC-013, contract C7.3).
    /// </summary>
    private int RetentionDays => Settings.Current.IdentifiableRetentionDays;

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            RequestToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
        }
    }
}
