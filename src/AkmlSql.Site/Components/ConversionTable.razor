@using System.Globalization
@using AkmlSql.Site.Analytics

@* One conversion breakdown: visitors, how many downloaded, and the rate as a figure and a meter.
   The meter width comes from the precomputed .bar-w-* classes (strict CSP: no inline styles). *@

<div class="insights-table-block">
    <h3 id="@($"{Id}-heading")">@Heading</h3>
    @if (Rows.Count == 0)
    {
        <p class="admin-empty">No visits in this period.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="admin-table" aria-labelledby="@($"{Id}-heading")">
                <thead>
                    <tr>
                        <th scope="col">@KeyHeader</th>
                        <th scope="col" class="admin-num">Visitors</th>
                        <th scope="col" class="admin-num">Downloaded</th>
                        <th scope="col" class="admin-num">Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr>
                            <td class="admin-key">@row.Label</td>
                            <td class="admin-num">@row.Visitors.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="admin-num">@row.Downloaders.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="admin-num insights-rate">
                                <span>@row.ConversionPercent.ToString("0.#", CultureInfo.InvariantCulture)%</span>
                                <span class="insights-meter" aria-hidden="true"><span class="insights-meter-fill bar-w-@WidthBucket(row.ConversionPercent)"></span></span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Heading { get; set; } = "";
    [Parameter, EditorRequired] public string KeyHeader { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<ConversionRow> Rows { get; set; } = [];

    /// <summary>A conversion percentage to a 5% width bucket; any non-zero rate stays visible.</summary>
    private static int WidthBucket(double percent)
    {
        if (percent <= 0)
        {
            return 0;
        }

        var bucket = (int)Math.Round(percent / 5.0, MidpointRounding.AwayFromZero) * 5;
        return Math.Clamp(bucket, 5, 100);
    }
}
