@inherits LayoutComponentBase
@layout MainLayout
@using AkmlSql.Site.Admin
@using AkmlSql.Site.Analytics
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@inject ReportClock Clock
@inject IServiceProvider Services

@* Spec 038 (US4): the admin portal shell — persistent navigation, one shared reporting window, and
   sign-out, on every portal page. Before this, /admin, /admin/errors and /admin/login were three
   loose pages each repeating their own chrome.

   Nested inside MainLayout on purpose: the portal keeps the site header and footer, exactly as the
   dashboard did before. Only the portal-specific chrome is added here.

   The window travels in the query string (?days=), never in session state — that keeps every portal
   page static SSR and makes a chosen range bookmarkable and shareable, which is the same reasoning
   AdminDashboardOptions already documents for the dashboard. Every link below is built with
   AdminNav.WithRange so the range survives navigation (FR-032).

   /admin/login deliberately does NOT use this layout: a sign-in page must not display navigation to
   sections the visitor cannot reach (contract A3.5). *@

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="admin-shell page-body container">
    <div class="admin-shell-bar">
        <nav class="admin-nav" aria-label="Admin sections">
            <ul class="admin-nav-list">
                @foreach (var section in AdminNav.Sections)
                {
                    var active = AdminNav.IsActive(section, CurrentPath);
                    <li>
                        @if (active)
                        {
                            <a href="@AdminNav.WithRange(section.Route, Range)"
                               aria-current="page"
                               class="is-current"
                               title="@section.Description">@section.Title@Badge(section)</a>
                        }
                        else
                        {
                            <a href="@AdminNav.WithRange(section.Route, Range)"
                               title="@section.Description">@section.Title@Badge(section)</a>
                        }
                    </li>
                }
            </ul>
        </nav>

        <form method="post" action="/admin/logout" class="admin-signout">
            <button type="submit" class="btn btn-secondary">Sign out</button>
        </form>
    </div>

    @* FR-032 second clause: the active window is visible on every section, so a screenshot is never
       ambiguous about the range it describes. *@
    <nav class="admin-toolbar" aria-label="Reporting window">
        <span class="admin-toolbar-label" id="admin-range-label">Window</span>
        <ul class="admin-ranges" aria-labelledby="admin-range-label">
            @foreach (var range in ReportRange.All)
            {
                <li>
                    @if (range.Key == Range.Key)
                    {
                        <a href="@AdminNav.WithRange(CurrentPath, range)" aria-current="true" class="is-current">@range.Label</a>
                    }
                    else
                    {
                        <a href="@AdminNav.WithRange(CurrentPath, range)">@range.Label</a>
                    }
                </li>
            }
        </ul>
        @* Names the actual days and the timezone. "Today" is only unambiguous once it says whose
           today it is -- the reports used to use UTC, three hours behind the owner in summer. *@
        <span class="admin-range-active">@Clock.Resolve(Range).Describe()</span>
    </nav>

    @Body
</div>

@code {
    /// <summary>Path of the request, used to mark the active section and rebuild range links.</summary>
    private string CurrentPath { get; set; } = "/admin";

    /// <summary>Open feedback messages, for the badge; null when it could not be read.</summary>
    private long? _openFeedback;

    /// <summary>
    /// The count beside "Feedback", so new messages are visible from every section rather than
    /// only to someone who thinks to open the inbox. Nothing is shown at zero.
    /// </summary>
    private RenderFragment Badge(AdminSection section) => builder =>
    {
        if (section.Route != "/admin/feedback" || _openFeedback is not > 0)
        {
            return;
        }

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "admin-badge");
        builder.AddContent(2, _openFeedback.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
        builder.CloseElement();
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "visually-hidden");
        builder.AddContent(5, _openFeedback == 1 ? " open message" : " open messages");
        builder.CloseElement();
    };

    /// <summary>The reporting range in force, shared by every section.</summary>
    private ReportRange Range { get; set; } = ReportRange.Default;

    protected override void OnParametersSet()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        CurrentPath = uri.AbsolutePath;

        // A bad query string must not break the owner's portal: ResolveRange falls back to the
        // default for anything it does not recognise, and clamps an absurd number (contract A4.4).
        QueryHelpers.ParseQuery(uri.Query).TryGetValue("days", out var raw);
        Range = AdminDashboardOptions.ResolveRange(raw.ToString());

        // Resolved optionally and guarded: the badge is a convenience on every portal page, and a
        // locked or unreadable database must cost the badge, not the page.
        try
        {
            _openFeedback = Services.GetService(typeof(AkmlSql.Site.Feedback.FeedbackStore)) is AkmlSql.Site.Feedback.FeedbackStore store
                ? store.CountOpen()
                : null;
        }
        catch (Microsoft.Data.Sqlite.SqliteException)
        {
            _openFeedback = null;
        }
    }
}
