@* Inline 24px stroke glyphs for the feature cards (Home + /features). Pure SVG,
   stroke="currentColor" so site.css token-colors them via .feature-card-icon — no
   inline styles, no external assets, CSP-clean by construction. Decorative: the card
   heading names the feature, so the svg is aria-hidden. *@

@switch (Name)
{
    case "intellisense":
        @* Lightning bolt: fast, schema-aware completion. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
        break;
    case "formatting":
        @* Aligned text lines: the formatting pipeline. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 6h16" />
            <path d="M4 10h10" />
            <path d="M4 14h16" />
            <path d="M4 18h7" />
        </svg>
        break;
    case "analysis":
        @* Shield with check: static analysis guarding quality. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 2.5 20 6v6c0 5-3.4 8.7-8 9.5-4.6-.8-8-4.5-8-9.5V6l8-3.5z" />
            <path d="m8.8 12 2.2 2.2 4.2-4.4" />
        </svg>
        break;
    case "refactoring":
        @* Magic wand with a four-point spark. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M17 2l.9 2.6 2.6.9-2.6.9L17 9l-.9-2.6-2.6-.9 2.6-.9L17 2z" />
            <path d="M5 19l9-9" />
            <path d="m12.5 12.5 1.5 1.5" />
        </svg>
        break;
    case "snippets":
        @* Scissors: cut-and-keep snippet libraries. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="6" cy="6" r="3" />
            <circle cx="6" cy="18" r="3" />
            <path d="M20 4 8.1 15.9" />
            <path d="m14.5 14.5 5.5 5.5" />
            <path d="M8.1 8.1 12 12" />
        </svg>
        break;
    case "history":
        @* Clock: crash-safe query history. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
        </svg>
        break;
    case "ai":
        @* Sparkles: AI assistance. *@
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 3l1.8 6.2L20 11l-6.2 1.8L12 19l-1.8-6.2L4 11l6.2-1.8L12 3z" />
            <path d="M18.5 15l.9 3.1 3.1.9-3.1.9-.9 3.1-.9-3.1-3.1-.9 3.1-.9.9-3.1z" />
        </svg>
        break;
}

@code {
    /// <summary>Glyph key: intellisense | formatting | analysis | refactoring | snippets | history | ai.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}
