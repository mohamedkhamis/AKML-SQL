<?xml version="1.0" encoding="utf-8"?>
<!-- The publish step adds the aspNetCore handler and module to this file. Only IIS-level settings
     the app cannot make itself belong here: IIS adds X-Powered-By after the app has written its
     response, so ASP.NET Core cannot remove it. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
