<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>AkmlSql.Ssms20</RootNamespace>
    <AssemblyName>AkmlSql.Ssms20</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <LangVersion>latest</LangVersion>
    <CreateVsixContainer>false</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <!-- Prevent VSIX/CTO cross-contamination during parallel solution builds -->
    <CopyVsixExtensionFiles>false</CopyVsixExtensionFiles>
    <IsVsixProject>false</IsVsixProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="15.9.3" ExcludeAssets="runtime" />
    <!-- Pin to 15.8.525 — wildcard 15.* is safe but explicit versions prevent future surprises -->
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" Version="15.8.525" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="15.8.525" ExcludeAssets="runtime" />
    <!-- Override the transitive CoreUtility 16.0.112 pulled by Microsoft.VisualStudio.SDK 15.9.3.
         SSMS 20 only ships CoreUtility 15.0.0.0; loading 16.0.0.0 causes MEF scanning failure.
         NU1605 suppressed because this intentional downgrade is required for SSMS 20 compatibility. -->
    <PackageReference Include="Microsoft.VisualStudio.CoreUtility" Version="15.8.525" ExcludeAssets="runtime" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="15.9.3084" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkmlSql.Core\AkmlSql.Core.csproj" />
  </ItemGroup>

  <Import Project="..\AkmlSql.Shell.Shared\AkmlSql.Shell.Shared.projitems" Label="Shared" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" />

  <!-- Disable VSIX targets that cause cross-contamination in parallel solution builds.
       We use Inno Setup for deployment, not VSIX containers. VSCT compilation and
       PkgDef generation still work; only VSIX manifest/extension file tasks are skipped. -->
  <Target Name="CreateVsixManifestResourceFile" />
  <Target Name="CopyVsixExtensionFiles" />
  <Target Name="GetVsixDeploymentPath" />
  <Target Name="DeployVsixExtensionFiles" />
  <!-- VSSDK 15.x requires MergeCtoResource to embed the CTO into VSPackage.resources.
       Unlike VSSDK 17.x, the ResourceName property on VSCTCompile alone is not sufficient.
       Build individually (not via solution) to avoid CTO cross-contamination. -->

  <ItemGroup>
    <VSCTCompile Include="AkmlSqlSsms20.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </Content>
  </ItemGroup>

</Project>
