<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AkmlSql.Core</RootNamespace>
    <AssemblyName>AkmlSql.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="Nullable" Version="1.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- ProtectedData (DPAPI) is needed on both targets: the NuGet package provides the
       netstandard2.0 polyfill and the net10.0 Windows-desktop binding. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

</Project>
