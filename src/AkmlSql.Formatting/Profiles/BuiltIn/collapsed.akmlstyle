{
  "metadata": {
    "id": "3f8a2b1c-9d4e-4f6a-8b2c-031c011a95ed",
    "schemaVersion": 1,
    "name": "Collapsed",
    "description": "Built-in style generated from Redgate style \u0027Collapsed\u0027 via spec-031 importer",
    "author": "AKML SQL",
    "version": "1.0.0",
    "created": "2026-07-16T00:00:00Z",
    "modified": "2026-07-16T00:00:00Z",
    "basedOn": "SQL Prompt Import",
    "isBuiltIn": true,
    "skipValidation": false,
    "enableIdempotencyCheck": true
  },
  "whitespace": {
    "tabStyle": "spaces",
    "tabSize": 4,
    "indentStyle": "block",
    "maxLineWidth": 200,
    "wrapLongLines": true,
    "lineBreakBeforeClause": true,
    "lineBreakAfterClause": false,
    "lineBreakBeforeComma": false,
    "lineBreakAfterComma": true,
    "emptyLineBetweenStatements": 1,
    "emptyLineBeforeGO": true,
    "emptyLineAfterGO": true,
    "preserveEmptyLinesAfterBatch": true,
    "blankLinesBeforeGoCount": 0,
    "preserveEmptyLines": true,
    "maxConsecutiveEmptyLines": 2,
    "trailingWhitespace": "remove",
    "finalNewline": "ensure",
    "spaceAfterComma": true,
    "spaceAroundOperators": true,
    "spaceAroundBooleanOperators": true,
    "spaceInsideParentheses": false,
    "spaceBeforeParentheses": true,
    "lineBreakAfterSemicolon": true,
    "semicolonPlacement": "none",
    "emptyLinesAfterBatchSeparator": 1
  },
  "casing": {
    "reservedKeywords": "UPPERCASE",
    "builtInFunctions": "UPPERCASE",
    "builtInDataTypes": "UPPERCASE",
    "systemObjects": "lowercase",
    "globalVariables": "AsIs",
    "localVariables": "AsIs",
    "identifiers": "AsIs",
    "syncWithDatabase": false,
    "camelCaseDictionary": true,
    "applyOnTyping": true
  },
  "list": {
    "commaPosition": "trailing",
    "alignItemsAcrossClauses": true,
    "alignAliases": false,
    "oneItemPerLine": true,
    "collapseShortLists": true,
    "collapseThreshold": 60,
    "indentListItems": true,
    "alignDataTypesInDDL": true,
    "alignValuesInInsert": true,
    "spaceAfterListComma": true,
    "placeSubsequentItemsOnNewLines": "always",
    "spaceBeforeComma": false,
    "commaAlignment": "toList",
    "alignItemsToTabStops": false
  },
  "parenthesis": {
    "openOnSameLine": true,
    "closeOnNewLine": "false",
    "collapseShort": true,
    "collapseThreshold": 160,
    "indentContents": false,
    "spaceInside": false,
    "removeRedundant": false,
    "createTableColumns": "newLine",
    "procedureParameters": "newLine",
    "subqueryStyle": "indent",
    "style": "compactSimple"
  },
  "dml": {
    "selectItemsOnNewLine": true,
    "selectStarOnSameLine": true,
    "fromOnNewLine": true,
    "whereOnNewLine": true,
    "andOrNewLine": "before",
    "andOrIndent": "alignWithWhere",
    "groupByOnNewLine": true,
    "havingOnNewLine": true,
    "orderByOnNewLine": true,
    "topOnSameLine": true,
    "distinctOnSameLine": true,
    "intoOnNewLine": true,
    "valuesOnNewLine": true,
    "setOnNewLine": true,
    "deleteFromOnSameLine": true,
    "mergeWhenOnNewLine": true,
    "collapseShortStatements": true,
    "collapseThreshold": 200,
    "collapseShortSubqueries": true,
    "subqueryCollapseThreshold": 160,
    "rightAlignClauses": false,
    "clauseIndentation": "none",
    "insertColumnListFormat": "onePerLine",
    "valuesFormat": "onePerLine",
    "newLineAfterDistinctTop": false
  },
  "join": {
    "onNewLine": true,
    "indentJoin": true,
    "onConditionNewLine": true,
    "onConditionIndent": "toJoin",
    "multipleOnConditions": "newLine",
    "emptyLineBeforeJoin": false,
    "alignJoinKeyword": "left",
    "joinTypeStyle": "explicit",
    "crossApplyNewLine": true,
    "onConditionIndentMode": "indentedFromJoin"
  },
  "ddl": {
    "createTableColumnsOnNewLine": true,
    "alignDataTypes": true,
    "alignConstraints": true,
    "constraintsOnNewLine": false,
    "inlineConstraintStyle": "sameLine",
    "tableConstraintsSeparate": true,
    "firstParameterOnNewLine": "auto",
    "parameterAlignment": "aligned",
    "alignParameterDataTypes": true,
    "alignParameterDefaults": true,
    "asOnNewLine": true,
    "beginOnNewLine": true,
    "collapseShortDDL": true,
    "collapseThreshold": 160,
    "constraintColumnsOnNewLine": "ifLongerThanWrap",
    "parenthesisStyle": "compactSimple",
    "indentParenContents": false
  },
  "controlFlow": {
    "beginOnNewLine": true,
    "endOnNewLine": true,
    "indentBetweenBeginEnd": true,
    "collapseShortIfElse": true,
    "collapseThreshold": 120,
    "elseOnNewLine": true,
    "elseAlignWithIf": true,
    "tryCatchOnNewLine": true,
    "indentBeginEndKeywords": false
  },
  "case": {
    "whenOnNewLine": true,
    "thenOnNewLine": false,
    "elseOnNewLine": true,
    "endOnNewLine": true,
    "indentWhen": true,
    "alignThen": true,
    "collapseShortCase": true,
    "collapseThreshold": 160,
    "firstWhenOnNewLine": "always",
    "whenAlignment": "indentedFromCase",
    "expressionOnNewLine": true,
    "endAlignment": "toCase",
    "thenAlignment": "indentedFromWhen"
  },
  "cte": {
    "withOnNewLine": true,
    "cteBodyIndent": false,
    "commaBeforeCte": false,
    "emptyLineBetweenCtes": true,
    "placeColumnsOnNewLine": "never",
    "asOnNewLine": true,
    "parenthesisStyle": "compactSimple",
    "placeNameOnNewLine": false,
    "indentName": false,
    "columnAlignment": "leftAligned"
  },
  "expression": {
    "booleanOperatorNewLine": "before",
    "betweenOnOneLine": true,
    "inListStyle": "multiLine",
    "inListThreshold": 60,
    "existsSubqueryIndent": "indent"
  },
  "operators": {
    "alignment": "inlineWithStatement",
    "betweenOnNewLine": true,
    "andBetweenOnNewLine": false,
    "betweenAndAlignment": "toBetween"
  },
  "inStatements": {
    "alignment": "stacked",
    "placeItemsOnNewLine": "never",
    "spaceAroundContents": false
  },
  "functionCalls": {
    "placeParametersOnNewLine": "never",
    "indentParameters": true,
    "spaceAroundParentheses": false,
    "spaceAroundArgumentList": false,
    "spaceBetweenEmptyParentheses": false
  },
  "comments": {
    "multilineFormatting": "preserve",
    "recognizeCommonPatterns": true
  },
  "declare": {
    "oneDeclarationPerLine": false,
    "alignDataTypes": true,
    "alignDefaultValues": true,
    "equalsOnNewLine": false
  },
  "insertStatements": {
    "columns": {
      "parenthesisStyle": "expandedToStatement",
      "indentContents": true,
      "placeSubsequentItemsOnNewLines": "always"
    },
    "values": {
      "parenthesisStyle": "compactToStatement",
      "indentContents": false,
      "placeSubsequentItemsOnNewLines": "never"
    }
  },
  "formatActions": {
    "applyLayout": true,
    "applyCasing": true,
    "insertSemicolons": false,
    "removeSemicolons": false,
    "expandWildcards": false,
    "qualifyObjectNames": false,
    "addAsKeyword": true,
    "addSquareBrackets": false
  }
}