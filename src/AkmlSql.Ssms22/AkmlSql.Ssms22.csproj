<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AkmlSql.Ssms22</RootNamespace>
    <AssemblyName>AkmlSql.Ssms22</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);VS_SDK_17</DefineConstants>
    <!-- Prevent VSIX container creation (we use Inno Setup installer) -->
    <CreateVsixContainer>false</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <!-- Prevent VSIX/CTO cross-contamination during parallel solution builds -->
    <CopyVsixExtensionFiles>false</CopyVsixExtensionFiles>
    <IsVsixProject>false</IsVsixProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" Version="17.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="17.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.*" PrivateAssets="all" />
    <!-- Spec 029: DPAPI for SqlCredentialStore. Reaches the shell transitively via AkmlSql.Core
         (netstandard2.0); this explicit ref guarantees the assembly deploys into the extension folder. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkmlSql.Core\AkmlSql.Core.csproj" />
  </ItemGroup>

  <!-- VSToolsPath fallback probe. The BuildTools .props import (via obj\*.nuget.g.props)
       normally sets VSToolsPath to the NuGet package's tools dir, but VS's auto-restore
       intermittently drops the VSSDK packages from project.assets.json — removing that
       import — while the MSBuild.exe.Config fallback path
       (C:\Program Files (x86)\MSBuild\Microsoft\VisualStudio\v18.0) has no VSSDK targets
       on this machine -> MSB4226 on the import below. Probe the NuGet cache directly;
       only kicks in when the normal resolution points at a location without the targets. -->
  <PropertyGroup>
    <VSToolsPath Condition="!Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets') and Exists('$(UserProfile)\.nuget\packages\microsoft.vssdk.buildtools\17.14.2142\tools\VSSDK\Microsoft.VsSDK.targets')">$(UserProfile)\.nuget\packages\microsoft.vssdk.buildtools\17.14.2142\tools</VSToolsPath>
  </PropertyGroup>

  <Import Project="..\AkmlSql.Shell.Shared\AkmlSql.Shell.Shared.projitems" Label="Shared" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" />

  <!-- Microsoft.VsSDK.targets defaults ResourceManifest/CtoFileManifest/CtoCacheFile from
       $(IntermediateOutputPath), which is still EMPTY when this import is evaluated in an
       SDK-style project (IntermediateOutputPath is only assigned later by
       Microsoft.NET.DefaultOutputPaths.targets). The defaults therefore collapse to
       drive-root paths (\ctoFiles.json, \resources.json, \mergeCto.cache) shared by every
       VSSDK project on the machine: the first shell project to build leaves its CTO name in
       C:\ctoFiles.json and the next project reads it -> VSSDK1307 "Could not read cto data".
       Pin all three to this project's real intermediate path (evaluates to
       obj\<Configuration>\net472\, matching IntermediateOutputPath). -->
  <PropertyGroup>
    <ResourceManifest>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\resources.json</ResourceManifest>
    <CtoFileManifest>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\ctoFiles.json</CtoFileManifest>
    <CtoCacheFile>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\mergeCto.cache</CtoCacheFile>
  </PropertyGroup>

  <!-- Disable VSIX targets that cause cross-contamination in parallel solution builds.
       We use Inno Setup for deployment, not VSIX containers. VSCT compilation and
       PkgDef generation still work; only VSIX manifest/extension file tasks are skipped. -->
  <Target Name="CreateVsixManifestResourceFile" />
  <Target Name="CopyVsixExtensionFiles" />
  <Target Name="GetVsixDeploymentPath" />
  <Target Name="DeployVsixExtensionFiles" />
  <!-- Override MergeCtoResource to prevent CTO cross-contamination in parallel builds.
       With MergeWithCTO=false, the CTO merge into VSPackage.resources is not needed.
       The VSCT compiler already registers the CTO as Menus.ctmenu embedded resource
       via the VSCTCompile item's ResourceName property. -->
  <!-- MergeCtoResource restored: needed for CTO embedding in all VSSDK versions -->

  <ItemGroup>
    <VSCTCompile Include="AkmlSqlSsms22.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </Content>
  </ItemGroup>

</Project>
