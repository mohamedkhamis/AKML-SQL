<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidAkmlSqlPackage">
    <Menus>
      <!-- Top-level menu on the main menu bar (SQL Prompt style) -->
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu" priority="0x700" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuBarGroup"/>
        <Strings>
          <ButtonText>AKML SQL</ButtonText>
        </Strings>
      </Menu>

      <!-- Toolbar — SQL Prompt style, docked at top of SSMS -->
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbar" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>AKML SQL</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Custom group on the main menu bar — makes AKML SQL a top-level menu -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuBarGroup" priority="0x0900">
        <Parent guid="guidVsMenuBar" id="IDM_VS_MENU_BAR"/>
      </Group>

      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup" priority="0x0600">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu"/>
      </Group>

      <!-- Toolbar button groups -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup" priority="0x0000">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbar"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidAkmlSqlCmdSet" id="cmdAbout" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>About AKML SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdCheckUpdate" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>Check for Updates</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdOptions" priority="0x0300" type="Button">
