        </Strings>
      </Button>
      <!-- Spec 040 (T106) — AKML SQL › Active Style: one slot per style (text, check and
           visibility set from ActiveStyleCache when the menu opens) plus Edit Styles…. US7 regroups them.
           Each slot has its own text and canonical name: the Active Style popup is built with DTE
           (Command.AddControl), and with all 30 named "Style" every control was bound to slot 0
           (the same name, all visible, all choosing the first style). -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdActiveStyleSlot0" priority="0x0680" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlActiveStyleGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
