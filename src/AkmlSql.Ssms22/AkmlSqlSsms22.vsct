      <Button guid="guidAkmlSqlCmdSet" id="CmdNavigateMatchingPair" priority="0x0808" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Navigate Matching Pair</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdGridFind" priority="0x0809" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Find in Results Grid</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdGridExport" priority="0x080A" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Export Results Grid</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdCrudGeneration" priority="0x080B" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Generate CRUD Procedures</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdDocumentOutline" priority="0x080C" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Document Outline</ButtonText>
        </Strings>
      </Button>

      <!-- Phase 10: SQL Prompt Core Parity -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdSnippetManager" priority="0x0810" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Snippet Manager</ButtonText>
        </Strings>
      </Button>
      <!-- Spec 030 T045 — Surround With needs a command-table entry so the Ctrl+K,Ctrl+S KeyBinding
           resolves (a KeyBinding without a Button/Command is ignored). Mirrors CmdBookmarkToggle. -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdSnippetSurroundWith" priority="0x0812" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Surround Selection With Snippet…</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdBookmarkToggle" priority="0x0811" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Toggle Bookmark</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdBookmarkNext" priority="0x0812" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Next Bookmark</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdBookmarkPrev" priority="0x0813" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Previous Bookmark</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdSplitTable" priority="0x0814" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Split Table</ButtonText>
        </Strings>
      </Button>

      <!-- Phase 9: AI Assistance -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdTextToSql" priority="0x0900" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Text to SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiExplain" priority="0x0901" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Explain SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiFix" priority="0x0902" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Fix SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiOptimize" priority="0x0903" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Optimize SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiIndexAnalysis" priority="0x0904" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Index Analysis</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiChatPanel" priority="0x0905" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Chat Panel</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- The top-level AKML SQL menu is created programmatically by
         AkmlSqlPackage.EnsureTopLevelMenu (which has a once-per-process guard
         and a reuse-existing check). We do NOT add a Tools > External Tools
         fallback here — in the past it caused every menu item to appear twice. -->

    <!-- Toolbar buttons — SQL Prompt style quick access -->
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="cmdFormatDocument" priority="0x0100">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdHistoryPanel" priority="0x0200">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdDocumentOutline" priority="0x0300">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdObjectSearch" priority="0x0400">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdCommandPalette" priority="0x0500">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdAiChatPanel" priority="0x0600">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="cmdOptions" priority="0x0700">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
  </CommandPlacements>

  <!-- Keyboard shortcut: Ctrl+K, Y for Format Document (chord key binding) -->
  <KeyBindings>
    <!-- SQL Prompt parity: Ctrl+Shift+D refreshes the schema cache for the active editor -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="cmdRefreshCache"
                editor="guidVSStd97" key1="D" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="cmdFormatDocument"
                editor="guidVSStd97" key1="K" mod1="Control" key2="Y" mod2="None" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="cmdUnformat"
                editor="guidVSStd97" key1="B" mod1="Control" key2="U" mod2="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdHistoryPanel"
                editor="guidVSStd97" key1="H" mod1="Control Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdRestoreClosedTab"
                editor="guidVSStd97" key1="T" mod1="Control Shift" />
    <!-- Phase 8 keyboard shortcuts -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdCommandPalette"
                editor="guidVSStd97" key1="P" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdExecuteCurrentStatement"
                editor="guidVSStd97" key1="VK_RETURN" mod1="Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdGoToDefinition"
                editor="guidVSStd97" key1="VK_F12" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdPeekDefinition"
                editor="guidVSStd97" key1="VK_F12" mod1="Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdFindReferences"
                editor="guidVSStd97" key1="VK_F12" mod1="Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdObjectSearch"
                editor="guidVSStd97" key1="T" mod1="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdNavigateNextStatement"
                editor="guidVSStd97" key1="VK_NEXT" mod1="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdNavigatePrevStatement"
                editor="guidVSStd97" key1="VK_PRIOR" mod1="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdNavigateMatchingPair"
                editor="guidVSStd97" key1="VK_OEM_6" mod1="Control" />
    <!-- Phase 9: AI Assistance -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdTextToSql"
                editor="guidVSStd97" key1="G" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiExplain"
                editor="guidVSStd97" key1="E" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiFix"
                editor="guidVSStd97" key1="R" mod1="Shift Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiOptimize"
                editor="guidVSStd97" key1="O" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiChatPanel"
                editor="guidVSStd97" key1="A" mod1="Control Shift" />
    <!-- Phase 10: SQL Prompt Core Parity -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdBookmarkToggle"
                editor="guidVSStd97" key1="K" mod1="Control" key2="K" mod2="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdBookmarkNext"
                editor="guidVSStd97" key1="K" mod1="Control" key2="N" mod2="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdBookmarkPrev"
                editor="guidVSStd97" key1="K" mod1="Control" key2="P" mod2="Control" />
    <!-- Spec 030 T045 — Surround With (FR-034): Ctrl+K, Ctrl+S. SSMS has no native Surround With chord. -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdSnippetSurroundWith"
                editor="guidVSStd97" key1="K" mod1="Control" key2="S" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <!-- Define IDM_VS_MENU_BAR (0x0081) — not exposed by vsshlids.h in all SDK versions -->
    <GuidSymbol name="guidVsMenuBar" value="{D309F791-903F-11D0-9EFC-00A0C911004F}">
      <IDSymbol name="IDM_VS_MENU_BAR" value="0x0081" />
    </GuidSymbol>

    <GuidSymbol name="guidAkmlSqlPackage" value="{A1B2C3D4-1111-2222-3333-444455556666}" />
    <GuidSymbol name="guidAkmlSqlCmdSet" value="{A1B2C3D4-1111-2222-3333-444455557777}">
      <IDSymbol name="AkmlSqlMenu" value="0x1000" />
      <IDSymbol name="AkmlSqlMenuGroup" value="0x1020" />
      <IDSymbol name="AkmlSqlMenuBarGroup" value="0x1030" />
      <IDSymbol name="AkmlSqlToolbar" value="0x1040" />
      <IDSymbol name="AkmlSqlToolbarGroup" value="0x1050" />
      <IDSymbol name="cmdAbout" value="0x0100" />
      <IDSymbol name="cmdCheckUpdate" value="0x0101" />
      <IDSymbol name="cmdOptions" value="0x0102" />
      <!-- Spec 020 US3 T059 — Format Styles editor launcher -->
      <IDSymbol name="cmdFormatStyles" value="0x0916" />
      <!-- Spec 030 T053 — Manage Code Analysis Rules dialog -->
      <IDSymbol name="cmdManageRules" value="0x0917" />
      <!-- Spec 030 T067 — editor-context refactor commands -->
      <IDSymbol name="cmdInlineExec" value="0x0918" />
      <IDSymbol name="cmdInsertToUpdate" value="0x0919" />
      <IDSymbol name="cmdInlineStoredProcedure" value="0x090E" />
      <IDSymbol name="cmdScriptAsAlter" value="0x0909" />
      <IDSymbol name="cmdShowFindInvalidObjects" value="0x090D" />
      <!-- Spec 030 T062 — database-wide Smart Rename (reuses existing CmdSafeRename id) -->
      <IDSymbol name="cmdSafeRename" value="0x0400" />
      <IDSymbol name="cmdToggleCodeAnalysis" value="0x091A" />
      <IDSymbol name="cmdDisableFormattingForSelection" value="0x0914" />
      <IDSymbol name="cmdSendFeedback" value="0x0103" />
      <IDSymbol name="cmdViewLogs" value="0x0104" />
      <IDSymbol name="cmdRefreshCache" value="0x0105" />
      <IDSymbol name="cmdFormatDocument" value="0x0200" />
      <IDSymbol name="cmdFormatSelection" value="0x0201" />
      <IDSymbol name="cmdUnformat" value="0x021E" />
