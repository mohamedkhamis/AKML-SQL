        <Strings>
          <ButtonText>Send Feedback</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdViewLogs" priority="0x0500" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>View Logs</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdRefreshCache" priority="0x0550" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>Refresh Schema Cache</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdFormatDocument" priority="0x0600" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Format Document</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdFormatSelection" priority="0x0601" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Format Selection</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdUnformat" priority="0x0602" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Unformat Document</ButtonText>
        </Strings>
      </Button>
      <!-- Spec 030 T087 — Bulk Format wizard (FR-046) -->
      <Button guid="guidAkmlSqlCmdSet" id="cmdBulkFormat" priority="0x0603" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>Bulk Format...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdHistoryPanel" priority="0x0700" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>SQL History</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdRestoreClosedTab" priority="0x0701" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Restore Closed Tab</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdCloseUnmodified" priority="0x0702" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Close All Unmodified</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdDuplicateTab" priority="0x0703" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Duplicate Tab</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdPinTab" priority="0x0704" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Pin Tab</ButtonText>
        </Strings>
      </Button>

      <!-- Phase 8 — Productivity Toolkit -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdCommandPalette" priority="0x0800" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Command Palette</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdExecuteCurrentStatement" priority="0x0801" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Execute Current Statement</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdExecuteToCursor" priority="0x0802" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Execute to Cursor</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdGoToDefinition" priority="0x0803" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Go To Definition</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdPeekDefinition" priority="0x0803" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Peek Definition</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdFindReferences" priority="0x0804" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Find All References</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdObjectSearch" priority="0x0805" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Object Search</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdNavigateNextStatement" priority="0x0806" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Navigate Next Statement</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdNavigatePrevStatement" priority="0x0807" type="Button">
