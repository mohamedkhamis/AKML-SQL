  <CommandPlacements>
    <!-- The top-level AKML SQL menu is created programmatically by
         AkmlSqlPackage.EnsureTopLevelMenu (which has a once-per-process guard
         and a reuse-existing check). We do NOT add a Tools > External Tools
         fallback here — in the past it caused every menu item to appear twice. -->

    <!-- Toolbar buttons — SQL Prompt style quick access -->
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="cmdFormatDocument" priority="0x0100">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdHistoryPanel" priority="0x0200">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdDocumentOutline" priority="0x0300">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdObjectSearch" priority="0x0400">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdCommandPalette" priority="0x0500">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="CmdAiChatPanel" priority="0x0600">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
    <CommandPlacement guid="guidAkmlSqlCmdSet" id="cmdOptions" priority="0x0700">
      <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup"/>
    </CommandPlacement>
  </CommandPlacements>

  <!-- Keyboard shortcut: Ctrl+K, Y for Format Document (chord key binding) -->
  <KeyBindings>
    <!-- SQL Prompt parity: Ctrl+Shift+D refreshes the schema cache for the active editor -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="cmdRefreshCache"
                editor="guidVSStd97" key1="D" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="cmdFormatDocument"
                editor="guidVSStd97" key1="K" mod1="Control" key2="Y" mod2="None" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="cmdUnformat"
                editor="guidVSStd97" key1="B" mod1="Control" key2="U" mod2="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdHistoryPanel"
                editor="guidVSStd97" key1="H" mod1="Control Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdRestoreClosedTab"
                editor="guidVSStd97" key1="T" mod1="Control Shift" />
    <!-- Phase 8 keyboard shortcuts -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdCommandPalette"
                editor="guidVSStd97" key1="P" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdExecuteCurrentStatement"
                editor="guidVSStd97" key1="VK_RETURN" mod1="Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdGoToDefinition"
                editor="guidVSStd97" key1="VK_F12" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdPeekDefinition"
                editor="guidVSStd97" key1="VK_F12" mod1="Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdFindReferences"
                editor="guidVSStd97" key1="VK_F12" mod1="Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdObjectSearch"
                editor="guidVSStd97" key1="T" mod1="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdNavigateNextStatement"
                editor="guidVSStd97" key1="VK_NEXT" mod1="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdNavigatePrevStatement"
                editor="guidVSStd97" key1="VK_PRIOR" mod1="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdNavigateMatchingPair"
                editor="guidVSStd97" key1="VK_OEM_6" mod1="Control" />
    <!-- Phase 9: AI Assistance -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdTextToSql"
                editor="guidVSStd97" key1="G" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiExplain"
                editor="guidVSStd97" key1="E" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiFix"
                editor="guidVSStd97" key1="R" mod1="Shift Alt" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiOptimize"
                editor="guidVSStd97" key1="O" mod1="Control Shift" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdAiChatPanel"
                editor="guidVSStd97" key1="A" mod1="Control Shift" />
    <!-- Phase 10: SQL Prompt Core Parity -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdBookmarkToggle"
                editor="guidVSStd97" key1="K" mod1="Control" key2="K" mod2="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdBookmarkNext"
                editor="guidVSStd97" key1="K" mod1="Control" key2="N" mod2="Control" />
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdBookmarkPrev"
                editor="guidVSStd97" key1="K" mod1="Control" key2="P" mod2="Control" />
    <!-- Spec 030 T045 — Surround With (FR-034): Ctrl+K, Ctrl+S. SSMS has no native Surround With chord. -->
    <KeyBinding guid="guidAkmlSqlCmdSet" id="CmdSnippetSurroundWith"
                editor="guidVSStd97" key1="K" mod1="Control" key2="S" mod2="Control" />
  </KeyBindings>

