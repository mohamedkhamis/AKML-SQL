      <IDSymbol name="AkmlSqlAssistGroup" value="0x1112" />
      <IDSymbol name="AkmlSqlSettingsGroup" value="0x1113" />
      <IDSymbol name="AkmlSqlActiveStyleGroup" value="0x1120" />
      <IDSymbol name="AkmlSqlActiveStyleEditGroup" value="0x1121" />
      <IDSymbol name="AkmlSqlFormattingGroup" value="0x1122" />
      <IDSymbol name="AkmlSqlRefactorGroup" value="0x1123" />
