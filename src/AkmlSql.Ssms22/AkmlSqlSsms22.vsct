<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidAkmlSqlPackage">
    <Menus>
      <!-- Top-level menu on the main menu bar (SQL Prompt style) -->
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu" priority="0x700" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuBarGroup"/>
        <Strings>
          <ButtonText>AKML SQL</ButtonText>
        </Strings>
      </Menu>

      <!-- Spec 040 (T181) — the AKML SQL menu's submenus, mirroring contracts/ui.md §2 and
           AkmlMenuTable (the DTE-built menu SSMS 22 shows). CommandName keeps each one's command-bar
           name unique: "Tools", "Help" and others are also the names of VS's own menus. -->
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlActiveStyleMenu" priority="0x0300" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>Active Style</ButtonText>
          <CommandName>AKML SQL Active Style</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingMenu" priority="0x0400" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <Strings>
          <ButtonText>Formatting</ButtonText>
          <CommandName>AKML SQL Formatting</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorMenu" priority="0x0100" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlCodeGroup"/>
        <Strings>
          <ButtonText>Refactor</ButtonText>
          <CommandName>AKML SQL Refactor</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateMenu" priority="0x0200" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlCodeGroup"/>
        <Strings>
          <ButtonText>Navigate</ButtonText>
          <CommandName>AKML SQL Navigate</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsMenu" priority="0x0200" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHistoryGroup"/>
        <Strings>
          <ButtonText>Tabs</ButtonText>
          <CommandName>AKML SQL Tabs</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlAiMenu" priority="0x0100" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlAssistGroup"/>
        <Strings>
          <ButtonText>AI</ButtonText>
          <CommandName>AKML SQL AI</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsMenu" priority="0x0200" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlAssistGroup"/>
        <Strings>
          <ButtonText>Tools</ButtonText>
          <CommandName>AKML SQL Tools</CommandName>
        </Strings>
      </Menu>
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpMenu" priority="0x0200" type="Menu">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlSettingsGroup"/>
        <Strings>
          <ButtonText>Help</ButtonText>
          <CommandName>AKML SQL Help</CommandName>
        </Strings>
      </Menu>

      <!-- Toolbar — SQL Prompt style, docked at top of SSMS -->
      <Menu guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbar" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>AKML SQL</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Custom group on the main menu bar — makes AKML SQL a top-level menu -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuBarGroup" priority="0x0900">
        <Parent guid="guidVsMenuBar" id="IDM_VS_MENU_BAR"/>
      </Group>

      <!-- Spec 040 (T181) — the AKML SQL menu in separated groups (contracts/ui.md §2). The first
           group keeps the old AkmlSqlMenuGroup id; the buttons with no handler stay in it, invisible
           (Text to SQL, AI Optimize, AI Index Analysis, CRUD, Find in Results Grid, Split Table). -->
      <!-- Format Document, Format Selection, Active Style, Formatting -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup" priority="0x0600">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu"/>
      </Group>
      <!-- Refactor, Navigate -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlCodeGroup" priority="0x0700">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu"/>
      </Group>
      <!-- SQL History, Tabs -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlHistoryGroup" priority="0x0800">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu"/>
      </Group>
      <!-- AI, Tools -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlAssistGroup" priority="0x0900">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu"/>
      </Group>
      <!-- Options, Help -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlSettingsGroup" priority="0x0A00">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenu"/>
      </Group>
      <!-- Active Style: the 30 style slots -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlActiveStyleGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlActiveStyleMenu"/>
      </Group>
      <!-- Active Style: Edit Styles -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlActiveStyleEditGroup" priority="0x0200">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlActiveStyleMenu"/>
      </Group>
      <!-- Formatting -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingMenu"/>
      </Group>
      <!-- Refactor -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorMenu"/>
      </Group>
      <!-- Navigate: definitions, search, statements, outline -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateMenu"/>
      </Group>
      <!-- Navigate: bookmarks -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlBookmarkGroup" priority="0x0200">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateMenu"/>
      </Group>
      <!-- Tabs -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsMenu"/>
      </Group>
      <!-- AI (the commands hide themselves while AI is off) -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlAiGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlAiMenu"/>
      </Group>
      <!-- Tools: palette and execution -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsRunGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsMenu"/>
      </Group>
      <!-- Tools: snippets -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsSnippetGroup" priority="0x0200">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsMenu"/>
      </Group>
      <!-- Tools: code analysis -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsAnalysisGroup" priority="0x0300">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsMenu"/>
      </Group>
      <!-- Tools: results grid -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsGridGroup" priority="0x0400">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsMenu"/>
      </Group>
      <!-- Help: feedback, logs, schema cache -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpSupportGroup" priority="0x0100">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpMenu"/>
      </Group>
      <!-- Help: Check for Updates, About (last) -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpAboutGroup" priority="0x0200">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpMenu"/>
      </Group>

      <!-- Toolbar button groups -->
      <Group guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbarGroup" priority="0x0000">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolbar"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidAkmlSqlCmdSet" id="cmdAbout" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpAboutGroup"/>
        <Strings>
          <ButtonText>About AKML SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdCheckUpdate" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpAboutGroup"/>
        <Strings>
          <ButtonText>Check for Updates</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdOptions" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlSettingsGroup"/>
        <Strings>
          <ButtonText>Options</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdFormatStyles" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingGroup"/>
        <Strings>
          <ButtonText>Format Styles...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdManageRules" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsAnalysisGroup"/>
        <Strings>
          <ButtonText>Manage Code Analysis Rules...</ButtonText>
        </Strings>
      </Button>
      <!-- Spec 030 T067 — editor-context refactor commands -->
      <Button guid="guidAkmlSqlCmdSet" id="cmdInlineExec" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup"/>
        <Strings>
          <ButtonText>Inline EXEC</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdInsertToUpdate" priority="0x0500" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup"/>
        <Strings>
          <ButtonText>Convert INSERT to UPDATE</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdInlineStoredProcedure" priority="0x0400" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup"/>
        <Strings>
          <ButtonText>Inline Stored Procedure</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdScriptAsAlter" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup"/>
        <Strings>
          <ButtonText>Script as ALTER</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdShowFindInvalidObjects" priority="0x0700" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup"/>
        <Strings>
          <ButtonText>Find Invalid Objects</ButtonText>
        </Strings>
      </Button>
      <!-- Spec 030 T062 — database-wide Smart Rename (FR-018). Declaring the button lets the
           Command Palette's dte.Commands.Raise resolve CmdSafeRename (it had no VSCT entry before). -->
      <Button guid="guidAkmlSqlCmdSet" id="cmdSafeRename" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlRefactorGroup"/>
        <Strings>
          <ButtonText>Smart Rename (Database-wide)</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdToggleCodeAnalysis" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsAnalysisGroup"/>
        <Strings>
          <ButtonText>Toggle Code Analysis</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdDisableFormattingForSelection" priority="0x0400" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingGroup"/>
        <Strings>
          <ButtonText>Disable Formatting for Selection</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdSendFeedback" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpSupportGroup"/>
        <Strings>
          <ButtonText>Send Feedback</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdViewLogs" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpSupportGroup"/>
        <Strings>
          <ButtonText>View Logs</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdRefreshCache" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHelpSupportGroup"/>
        <Strings>
          <ButtonText>Refresh Schema Cache</ButtonText>
          <CanonicalName>.Edit.RefreshSchemaCache</CanonicalName>
          <LocalizedCanonicalName>.Edit.RefreshSchemaCache</LocalizedCanonicalName>
        </Strings>
      </Button>
      <!-- Spec 040 (T181) — pinned canonical names. AKML_SQL.FormatDocument is what the editor
           toolbar and the completion popup run (dte.ExecuteCommand) and Edit.RefreshSchemaCache what
           Ctrl+Shift+D runs; both now hold whatever the menu nesting. The DTE menu binds a control to
           its command by name, so the commands whose text is also one of SSMS's own commands (Format
           Selection, Go To / Peek Definition, Find All References, the bookmarks) get unique names. -->
      <Button guid="guidAkmlSqlCmdSet" id="cmdFormatDocument" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Format Document</ButtonText>
          <CanonicalName>.AKML_SQL.FormatDocument</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.FormatDocument</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdFormatSelection" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Format Selection</ButtonText>
          <CanonicalName>.AKML_SQL.FormatSelection</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.FormatSelection</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="cmdUnformat" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Unformat Document</ButtonText>
        </Strings>
      </Button>
      <!-- Spec 030 T087 — Bulk Format wizard (FR-046) -->
      <Button guid="guidAkmlSqlCmdSet" id="cmdBulkFormat" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlFormattingGroup"/>
        <Strings>
          <ButtonText>Bulk Format...</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdHistoryPanel" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlHistoryGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>SQL History</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdRestoreClosedTab" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Restore Closed Tab</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdCloseUnmodified" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Close All Unmodified</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdDuplicateTab" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Duplicate Tab</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdPinTab" priority="0x0400" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlTabsGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Pin Tab</ButtonText>
        </Strings>
      </Button>

      <!-- Phase 8 — Productivity Toolkit -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdCommandPalette" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsRunGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Command Palette</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdExecuteCurrentStatement" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsRunGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Execute Current Statement</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdExecuteToCursor" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsRunGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Execute to Cursor</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdGoToDefinition" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Go To Definition</ButtonText>
          <CanonicalName>.AKML_SQL.GoToDefinition</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.GoToDefinition</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdPeekDefinition" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Peek Definition</ButtonText>
          <CanonicalName>.AKML_SQL.PeekDefinition</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.PeekDefinition</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdFindReferences" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Find All References</ButtonText>
          <CanonicalName>.AKML_SQL.FindAllReferences</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.FindAllReferences</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdObjectSearch" priority="0x0400" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Object Search</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdNavigateNextStatement" priority="0x0500" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Navigate Next Statement</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdNavigatePrevStatement" priority="0x0600" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Navigate Previous Statement</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdNavigateMatchingPair" priority="0x0700" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Navigate Matching Pair</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdGridFind" priority="0x0809" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Find in Results Grid</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdGridExport" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsGridGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Export Results Grid</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdCrudGeneration" priority="0x080B" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Generate CRUD Procedures</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdDocumentOutline" priority="0x0800" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlNavigateGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Document Outline</ButtonText>
        </Strings>
      </Button>

      <!-- Phase 10: SQL Prompt Core Parity -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdSnippetManager" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsSnippetGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Snippet Manager</ButtonText>
        </Strings>
      </Button>
      <!-- Spec 030 T045 — Surround With needs a command-table entry so the Ctrl+K,Ctrl+S KeyBinding
           resolves (a KeyBinding without a Button/Command is ignored). Mirrors CmdBookmarkToggle. -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdSnippetSurroundWith" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlToolsSnippetGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Surround Selection With Snippet…</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdBookmarkToggle" priority="0x0100" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlBookmarkGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Toggle Bookmark</ButtonText>
          <CanonicalName>.AKML_SQL.ToggleBookmark</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.ToggleBookmark</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdBookmarkNext" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlBookmarkGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Next Bookmark</ButtonText>
          <CanonicalName>.AKML_SQL.NextBookmark</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.NextBookmark</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdBookmarkPrev" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlBookmarkGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Previous Bookmark</ButtonText>
          <CanonicalName>.AKML_SQL.PreviousBookmark</CanonicalName>
          <LocalizedCanonicalName>.AKML_SQL.PreviousBookmark</LocalizedCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdSplitTable" priority="0x0814" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Split Table</ButtonText>
        </Strings>
      </Button>

      <!-- Phase 9: AI Assistance -->
      <Button guid="guidAkmlSqlCmdSet" id="CmdTextToSql" priority="0x0900" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>AI: Text to SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiExplain" priority="0x0200" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlAiGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Explain SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiFix" priority="0x0300" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlAiGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>AI: Fix SQL</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAkmlSqlCmdSet" id="CmdAiOptimize" priority="0x0903" type="Button">
        <Parent guid="guidAkmlSqlCmdSet" id="AkmlSqlMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
