<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AkmlSql.PostgreSql</RootNamespace>
    <AssemblyName>AkmlSql.PostgreSql</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Spec 042 (PostgreSQL support). Everything that is pure PostgreSQL language and reference work:
      the parser wrapper, the documentation-derived reference, completion, formatting, analysis rules,
      snippets and safety checks. The data path (Npgsql: sessions, catalog, execution, CRUD,
      credentials) lives in AkmlSql.Engine/PostgreSql so the engine stays the only process that opens
      database connections.

      Engine-only: this library carries a native parser (libpg_query through pgsqlparser) and is
      deliberately NOT referenced by AkmlSql.Web, so the browser bundle gains no native code and no
      reference data. The web edition reaches all of it through the engine protocol (research R18).
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pgsqlparser" Version="2.1.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Serilog" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkmlSql.Core\AkmlSql.Core.csproj" />
    <ProjectReference Include="..\AkmlSql.IntelliSense\AkmlSql.IntelliSense.csproj" />
    <ProjectReference Include="..\AkmlSql.Analysis\AkmlSql.Analysis.csproj" />
    <ProjectReference Include="..\AkmlSql.Formatting\AkmlSql.Formatting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated reference and the PostgreSQL snippet pack ship inside the assembly. -->
    <EmbeddedResource Include="Reference\*.json" />
    <EmbeddedResource Include="Snippets\*.akmlsnippet" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AkmlSql.PostgreSql.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AkmlSql.Engine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
