<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AkmlSql.Engine</RootNamespace>
    <AssemblyName>AkmlSql.Engine</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- SingleFile disabled: Microsoft.Data.SqlClient native SNI interop is incompatible
         with single-file extraction. The Engine runs as a background process so multiple
         files in the Engine directory are acceptable. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Preserve types for MessagePack, SqlClient native interop, and JSON reflection -->
  <ItemGroup>
    <TrimmerRootAssembly Include="AkmlSql.Core" />
    <TrimmerRootAssembly Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.102.0" />
    <PackageReference Include="ClosedXML" Version="0.105.*" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />

    <!-- Spec 026 (M4 closure) C2: host the web-edition engine as the AkmlSqlWebEngine Windows
         service so `sc start` reaches SERVICE_RUNNING (a bare console exe times out with 1053).
         AddWindowsService falls back to console lifetime when not SCM-hosted. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />

    <!-- Phase 9: AI Assistance -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
    <PackageReference Include="Mscc.GenerativeAI" Version="3.1.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkmlSql.AI\AkmlSql.AI.csproj" />
    <ProjectReference Include="..\AkmlSql.Analysis\AkmlSql.Analysis.csproj" />
    <ProjectReference Include="..\AkmlSql.Core\AkmlSql.Core.csproj" />
    <ProjectReference Include="..\AkmlSql.Formatting\AkmlSql.Formatting.csproj" />
    <ProjectReference Include="..\AkmlSql.IntelliSense\AkmlSql.IntelliSense.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec 030 T041 (FR-031): ship the built-in snippet pack next to the engine binary so
         SnippetRequestHandler loads it from <AppContext.BaseDirectory>/snippets at runtime. The data
         files live in SnippetPack/ (kept distinct from the Snippets/ source-code folder so the glob is
         case-safe) and Link into the output as snippets/ to match the runtime path. The installer ships
         the whole engine publish output recursively (AkmlSqlSetup.iss), so they ride along; hot-swap too. -->
    <Content Include="SnippetPack\*.akmlsnippet" Link="snippets\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Spec 021 M0.2 T012: expose internal types (TypedHandlerAdapter) to the engine tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AkmlSql.Engine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
