<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AkmlSql.Analyzer</RootNamespace>
    <AssemblyName>AkmlSql.Analyzer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Spec 047 (CLI-001): .casettings and the explicit settings file are read with reflection-based System.Text.Json,
         which a trimmed app turns off by default. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Spec 047 (CLI-001): RuleRegistry finds the analysis rules by reflection (GetTypes + Activator), and nothing references
       them statically, so the trimmer removed every rule and the shipped exe reported "No issues found" for any SQL. Root the
       rules' assembly, and Core for the settings models. scripts/test-analyzer-cli.ps1 checks the published exe on every
       release build. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="AkmlSql.Analysis" />
    <TrimmerRootAssembly Include="AkmlSql.Core" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AkmlSql.Engine.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkmlSql.Core\AkmlSql.Core.csproj" />
    <ProjectReference Include="..\AkmlSql.Engine\AkmlSql.Engine.csproj" />
  </ItemGroup>

</Project>
