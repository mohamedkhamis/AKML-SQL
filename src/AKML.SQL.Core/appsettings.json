{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Grpc": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 16777216,
      "MaxConcurrentConnections": 100
    }
  },
  "AkmlSql": {
    "MetadataCacheMinutes": 5,
    "MaxCompletionItems": 100,
    "EnableTelemetry": false,
    "LogLevel": "Information"
  }
}
