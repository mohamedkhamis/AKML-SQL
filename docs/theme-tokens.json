{
  "$schema": "./theme-tokens.schema.json",
  "version": 2,
  "description": "Single source of truth for AKML SQL theme tokens. Consumed by the WPF ThemeRegistry (spec 016) and by scripts/generate-theme-css.ps1 which emits CSS custom-property files for the web edition (spec 021). Hex values mirror src/AkmlSql.Shell.Shared/Ui/Theme/ThemePalette.cs (edit BOTH in lockstep). High-contrast values map to CSS system colors (forced-colors keywords) since the WPF surface delegates HC to Windows SystemColors at runtime. v2 (2026-06): rebranded to AKML Blue #2563EB + slate surfaces; added radius scalars and a Syntax group; UI 14px / editor 13px.",
  "groups": {
    "Surface": {
      "Akml.Brush.Surface.Canvas":          { "light": "#F1F5F9",   "dark": "#0F172A",   "highContrast": "Canvas" },
      "Akml.Brush.Surface.Panel":           { "light": "#FFFFFF",   "dark": "#1E293B",   "highContrast": "Canvas" },
      "Akml.Brush.Surface.Elevated":        { "light": "#E2E8F0",   "dark": "#334155",   "highContrast": "Canvas" },
      "Akml.Brush.Surface.Sidebar":         { "light": "#F8FAFC",   "dark": "#1E293B",   "highContrast": "ButtonFace" },
      "Akml.Brush.Surface.Input":           { "light": "#FFFFFF",   "dark": "#1E293B",   "highContrast": "Field" },
      "Akml.Brush.Surface.InputReadOnly":   { "light": "#F8FAFC",   "dark": "#334155",   "highContrast": "ButtonFace" },
      "Akml.Brush.Surface.Hover":           { "light": "#F1F5F9",   "dark": "#334155",   "highContrast": "Highlight" },
      "Akml.Brush.Surface.Selection":       { "light": "#1F2563EB", "dark": "#262563EB", "highContrast": "Highlight" },
      "Akml.Brush.Surface.SelectionStrong": { "light": "#2563EB",   "dark": "#2563EB",   "highContrast": "Highlight" }
    },
    "Text": {
      "Akml.Brush.Text.Primary":     { "light": "#0F172A", "dark": "#E2E8F0", "highContrast": "CanvasText" },
      "Akml.Brush.Text.Secondary":   { "light": "#475569", "dark": "#94A3B8", "highContrast": "GrayText" },
      "Akml.Brush.Text.Disabled":    { "light": "#94A3B8", "dark": "#64748B", "highContrast": "GrayText" },
      "Akml.Brush.Text.Placeholder": { "light": "#94A3B8", "dark": "#64748B", "highContrast": "GrayText" },
      "Akml.Brush.Text.Link":        { "light": "#2563EB", "dark": "#60A5FA", "highContrast": "LinkText" },
      "Akml.Brush.Text.OnAccent":    { "light": "#FFFFFF", "dark": "#FFFFFF", "highContrast": "HighlightText" },
      "Akml.Brush.Text.OnDanger":    { "light": "#FFFFFF", "dark": "#FFFFFF", "highContrast": "HighlightText" }
    },
    "Border": {
      "Akml.Brush.Border.Default":  { "light": "#E2E8F0", "dark": "#14FFFFFF", "highContrast": "ButtonText" },
      "Akml.Brush.Border.Strong":   { "light": "#CBD5E1", "dark": "#28FFFFFF", "highContrast": "ButtonText" },
      "Akml.Brush.Border.Subtle":   { "light": "#E2E8F0", "dark": "#0DFFFFFF", "highContrast": "GrayText" },
      "Akml.Brush.Border.Focus":    { "light": "#2563EB", "dark": "#60A5FA", "highContrast": "LinkText" },
      "Akml.Brush.Border.Splitter": { "light": "#E2E8F0", "dark": "#14FFFFFF", "highContrast": "GrayText" }
    },
    "Accent": {
      "Akml.Brush.Accent.Primary":        { "light": "#2563EB", "dark": "#2563EB", "highContrast": "Highlight" },
      "Akml.Brush.Accent.PrimaryHover":   { "light": "#1E40AF", "dark": "#3B82F6", "highContrast": "Highlight" },
      "Akml.Brush.Accent.PrimaryPressed": { "light": "#1E40AF", "dark": "#1E40AF", "highContrast": "Highlight" }
    },
    "Status": {
      "Akml.Brush.Status.Success": { "light": "#16A34A", "dark": "#4ADE80", "highContrast": "Highlight" },
      "Akml.Brush.Status.Warning": { "light": "#EA580C", "dark": "#FB923C", "highContrast": "Highlight" },
      "Akml.Brush.Status.Danger":  { "light": "#DC2626", "dark": "#F87171", "highContrast": "Highlight" },
      "Akml.Brush.Status.Info":    { "light": "#2563EB", "dark": "#60A5FA", "highContrast": "LinkText" }
    },
    "Editor": {
      "Akml.Brush.Editor.MarginBackground": { "light": "#F8FAFC", "dark": "#1E293B", "highContrast": "ButtonFace" },
      "Akml.Brush.Editor.SpinnerStroke":    { "light": "#2563EB", "dark": "#60A5FA", "highContrast": "LinkText" },
      "Akml.Brush.Editor.PopupBackground":  { "light": "#FFFFFF", "dark": "#1E293B", "highContrast": "Canvas" },
      "Akml.Brush.Editor.PopupBorder":      { "light": "#E2E8F0", "dark": "#14FFFFFF", "highContrast": "ButtonText" }
    },
    "Chat": {
      "Akml.Brush.Chat.UserBubble":      { "light": "#DBEAFE", "dark": "#1E3A5F", "highContrast": "Canvas" },
      "Akml.Brush.Chat.AssistantBubble": { "light": "#F1F5F9", "dark": "#334155", "highContrast": "ButtonFace" },
      "Akml.Brush.Chat.SystemBubble":    { "light": "#FEF3C7", "dark": "#3A3000", "highContrast": "Canvas" }
    },
    "Syntax": {
      "Akml.Brush.Syntax.Keyword":     { "light": "#2563EB", "dark": "#60A5FA", "highContrast": "LinkText" },
      "Akml.Brush.Syntax.String":      { "light": "#16A34A", "dark": "#4ADE80", "highContrast": "GrayText" },
      "Akml.Brush.Syntax.Number":      { "light": "#EA580C", "dark": "#FB923C", "highContrast": "GrayText" },
      "Akml.Brush.Syntax.Comment":     { "light": "#64748B", "dark": "#64748B", "highContrast": "GrayText", "italic": true },
      "Akml.Brush.Syntax.Function":    { "light": "#9333EA", "dark": "#C084FC", "highContrast": "LinkText" },
      "Akml.Brush.Syntax.TableColumn": { "light": "#0891C2", "dark": "#22D3EE", "highContrast": "LinkText" }
    },
    "IconBadge": {
      "Akml.Brush.IconBadge.Table":       { "light": "#E5C04B", "dark": "#E5C04B", "highContrast": "LinkText",  "letter": "T" },
      "Akml.Brush.IconBadge.View":        { "light": "#56B6C2", "dark": "#56B6C2", "highContrast": "LinkText",  "letter": "V" },
      "Akml.Brush.IconBadge.Column":      { "light": "#61AFEF", "dark": "#61AFEF", "highContrast": "LinkText",  "letter": "C" },
      "Akml.Brush.IconBadge.StoredProc":  { "light": "#C678DD", "dark": "#C678DD", "highContrast": "LinkText",  "letter": "P" },
      "Akml.Brush.IconBadge.Function":    { "light": "#D19A66", "dark": "#D19A66", "highContrast": "LinkText",  "letter": "F" },
      "Akml.Brush.IconBadge.Snippet":     { "light": "#3DD68C", "dark": "#3DD68C", "highContrast": "LinkText",  "letter": "S" },
      "Akml.Brush.IconBadge.Keyword":     { "light": "#ABB2BF", "dark": "#ABB2BF", "highContrast": "GrayText",  "letter": "K" },
      "Akml.Brush.IconBadge.Database":    { "light": "#E06C75", "dark": "#E06C75", "highContrast": "LinkText",  "letter": "D" },
      "Akml.Brush.IconBadge.Schema":      { "light": "#98C379", "dark": "#98C379", "highContrast": "LinkText",  "letter": "Sc" },
      "Akml.Brush.IconBadge.Trigger":     { "light": "#BE5046", "dark": "#BE5046", "highContrast": "LinkText",  "letter": "Tr" },
      "Akml.Brush.IconBadge.Index":       { "light": "#7F848E", "dark": "#7F848E", "highContrast": "GrayText",  "letter": "Ix" },
      "Akml.Brush.IconBadge.Synonym":     { "light": "#56B6C2", "dark": "#56B6C2", "highContrast": "LinkText",  "letter": "Sy" }
    },
    "TabColor": {
      "Akml.Brush.TabColor.Red":    { "light": "#FF4444", "dark": "#FF4444", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Amber":  { "light": "#FFB800", "dark": "#FFB800", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Green":  { "light": "#44BB44", "dark": "#44BB44", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Blue":   { "light": "#4488FF", "dark": "#4488FF", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Teal":   { "light": "#00BCD4", "dark": "#00BCD4", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Purple": { "light": "#9B59B6", "dark": "#9B59B6", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Pink":   { "light": "#E91E63", "dark": "#E91E63", "highContrast": "LinkText" },
      "Akml.Brush.TabColor.Gray":   { "light": "#808A99", "dark": "#808A99", "highContrast": "GrayText" }
    },
    "History": {
      "Akml.Brush.History.OpenIcon":       { "light": "#16A34A",   "dark": "#4ADE80",   "highContrast": "LinkText" },
      "Akml.Brush.History.ClosedIcon":     { "light": "#DC2626",   "dark": "#F87171",   "highContrast": "LinkText" },
      "Akml.Brush.History.Star.Active":    { "light": "#EA580C",   "dark": "#FB923C",   "highContrast": "LinkText" },
      "Akml.Brush.History.Star.Inactive":  { "light": "#E2E8F0",   "dark": "#14FFFFFF", "highContrast": "GrayText" },
      "Akml.Brush.History.MatchHighlight": { "light": "#4DFEF08A", "dark": "#4DDAA520", "highContrast": "Highlight" }
    }
  },
  "spacing": {
    "Akml.Scalar.Spacing.XS": 4,
    "Akml.Scalar.Spacing.S":  8,
    "Akml.Scalar.Spacing.M":  12,
    "Akml.Scalar.Spacing.L":  16
  },
  "radius": {
    "Akml.Scalar.Radius.XS":   6,
    "Akml.Scalar.Radius.S":    8,
    "Akml.Scalar.Radius.M":    12,
    "Akml.Scalar.Radius.Pill": 999
  },
  "typography": {
    "Akml.Type.Chrome":      { "family": "Segoe UI", "size": 14, "weight": "Normal" },
    "Akml.Type.ChromeTitle": { "family": "Segoe UI", "size": 14, "weight": "SemiBold" },
    "Akml.Type.Editor":      { "family": "Consolas", "size": 13, "weight": "Normal" },
    "Akml.Type.EditorGrid":  { "family": "Consolas", "size": 12, "weight": "Normal" },
    "Akml.Type.IconBadge":   { "family": "Segoe UI", "size": 9,  "weight": "SemiBold" }
  }
}
