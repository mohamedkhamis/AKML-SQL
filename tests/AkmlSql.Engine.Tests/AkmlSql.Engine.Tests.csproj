<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AkmlSql.Engine.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Spec 025 (M3 bridge closure) T014: SkippableFact lets the elevated
         LanModeRoundTrip test return "skipped" (not "errored") when the
         developer runs it without admin rights. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.*" />
    <PackageReference Include="coverlet.collector" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AkmlSql.Engine\AkmlSql.Engine.csproj" />
    <ProjectReference Include="..\..\src\AkmlSql.Analyzer\AkmlSql.Analyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec 030 T038/T041: copy the engine's built-in snippet pack into the test output so the
         shipped-pack test loads the SAME .akmlsnippet files that ship with the engine publish. -->
    <Content Include="..\..\src\AkmlSql.Engine\SnippetPack\*.akmlsnippet">
      <Link>snippets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Refactoring\Corpus\corpus01_simple_select.sql" />
    <EmbeddedResource Include="Refactoring\Corpus\corpus02_insert_update_delete.sql" />
    <EmbeddedResource Include="Refactoring\Corpus\corpus03_joins_and_aggregates.sql" />
    <EmbeddedResource Include="Refactoring\Corpus\corpus04_cte_and_subquery.sql" />
    <EmbeddedResource Include="Refactoring\Corpus\corpus05_stored_proc.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec 031 T8: local copy of the Formatting.Tests fixture (same pattern as that
         project's own "Fixtures\**" entry) so ProfileImportHandlerTests can load the
         real-world MohamedKhamis Redgate JSON export via AppContext.BaseDirectory. -->
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
