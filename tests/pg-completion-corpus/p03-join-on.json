  },
  {
    "id": "PGJON-024",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON c.customer_id = o.customer_id AND |",
    "expect": {
      "mustContain": [
        "c.company_name",
        "o.freight"
      ]
    },
    "note": "After AND"
  },
  {
    "id": "PGJON-025",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON c.customer_id = o.customer_id |",
    "expect": {
      "mustContain": [
        "AND",
        "OR",
        "JOIN",
        "WHERE",
        "ORDER BY"
