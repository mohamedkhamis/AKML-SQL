    "family": "join-on",
    "doc": "SELECT * FROM orders JOIN customers ON |",
    "expect": {
      "mustContain": [
        "orders.customer_id = customers.customer_id"
      ]
    },
    "note": "Unaliased tables qualify by name"
  },
