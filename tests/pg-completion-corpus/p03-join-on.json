  {
    "id": "PGJON-011",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o USING (|",
    "expect": {
      "mustContain": [
        "customer_id"
      ],
      "mustNotContain": [
        "freight",
        "company_name"
      ],
      "minCount": 1
    },
    "note": "USING lists the columns the two tables share"
  },
  {
    "id": "PGJON-012",
    "family": "join-on",
    "doc": "SELECT * FROM orders o JOIN order_details d USING (|",
    "expect": {
      "mustContain": [
        "order_id"
      ],
      "mustNotContain": [
        "quantity",
        "freight"
      ]
    },
    "note": "USING shared column"
  },
  {
    "id": "PGJON-013",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON c.customer_id = o.customer_id JOIN order_details d ON |",
    "expect": {
      "mustContain": [
        "o.order_id = d.order_id"
      ]
    },
    "note": "A later join relates to an earlier table"
  },
  {
    "id": "PGJON-014",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON c.customer_id = |",
    "expect": {
      "mustContain": [
        "o.customer_id",
        "c.company_name"
      ]
    },
    "note": "Right-hand side of a comparison"
  },
  {
    "id": "PGJON-015",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON c.|",
    "expect": {
      "mustContain": [
        "customer_id",
        "company_name"
      ],
      "mustNotContain": [
        "freight"
      ]
    },
    "note": "Alias dot inside ON"
  },
  {
    "id": "PGJON-016",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON o.|",
    "expect": {
      "mustContain": [
        "freight",
        "order_date"
      ],
      "mustNotContain": [
        "company_name"
      ]
    },
    "note": "Other alias inside ON"
  },
  {
    "id": "PGJON-017",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o |",
    "expect": {
      "mustContain": [
        "ON",
        "USING",
        "AS",
        "ON c.customer_id = o.customer_id"
      ],
      "mustNotContain": [
        "customers"
      ]
    },
    "note": "After the joined table: ON with the foreign key condition"
  },
  {
    "id": "PGJON-018",
    "family": "join-on",
    "doc": "SELECT * FROM customers c LEFT JOIN orders o ON |",
    "expect": {
      "mustContain": [
        "c.customer_id = o.customer_id"
      ]
    },
    "note": "LEFT JOIN"
  },
  {
    "id": "PGJON-019",
    "family": "join-on",
    "doc": "SELECT * FROM customers c CROSS JOIN |",
    "expect": {
      "mustContain": [
        "orders",
        "suppliers"
      ],
      "mustNotContain": [
        "customer_id"
      ]
    },
    "note": "CROSS JOIN takes tables"
  },
  {
    "id": "PGJON-020",
    "family": "join-on",
    "doc": "SELECT * FROM customers c NATURAL |",
    "expect": {
      "mustContain": [
        "JOIN",
        "LEFT JOIN"
      ],
      "mustNotContain": [
        "customers"
      ]
    },
    "note": "NATURAL takes a join word"
  },
  {
    "id": "PGJON-021",
    "family": "join-on",
    "doc": "SELECT * FROM customers c INNER |",
    "expect": {
      "mustContain": [
        "JOIN"
      ],
      "mustNotContain": [
        "customers"
      ]
    },
    "note": "INNER takes JOIN"
  },
  {
    "id": "PGJON-022",
    "family": "join-on",
    "doc": "SELECT * FROM customers c, LATERAL (SELECT * FROM orders o WHERE o.customer_id = c.|) x",
    "expect": {
      "mustContain": [
        "customer_id",
        "company_name"
      ],
      "mustNotContain": [
        "freight"
      ]
    },
    "note": "LATERAL sees the outer alias"
  },
  {
