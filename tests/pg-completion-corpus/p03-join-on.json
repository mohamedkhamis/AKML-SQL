      ]
    },
    "note": "orders - order_details"
  },
  {
    "id": "PGJON-005",
    "family": "join-on",
    "doc": "SELECT * FROM order_details d JOIN products p ON |",
    "expect": {
      "mustContain": [
        "d.product_id = p.product_id"
      ]
    },
    "note": "order_details - products"
  },
  {
