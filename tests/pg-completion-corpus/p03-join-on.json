[
  {
    "id": "PGJON-001",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN |",
    "expect": {
      "mustContain": [
        "orders",
        "products"
      ]
    },
    "note": "JOIN lists tables"
  },
  {
    "id": "PGJON-002",
    "family": "join-on",
    "doc": "SELECT * FROM customers c JOIN orders o ON |",
    "expect": {
      "mustContain": [
        "c.customer_id = o.customer_id",
        "c.company_name",
        "o.freight"
      ]
    },
    "note": "The foreign key predicate leads"
  },
  {
    "id": "PGJON-003",
    "family": "join-on",
    "doc": "SELECT * FROM orders o JOIN customers c ON |",
    "expect": {
      "mustContain": [
        "o.customer_id = c.customer_id"
      ]
    },
    "note": "Foreign key, other direction"
  },
