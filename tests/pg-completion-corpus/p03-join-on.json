      "mustContain": [
        "p.category_id = c.category_id"
      ]
    },
    "note": "products - categories"
  },
  {
    "id": "PGJON-007",
    "family": "join-on",
    "doc": "SELECT * FROM products p JOIN suppliers s ON |",
    "expect": {
      "mustContain": [
        "p.supplier_id = s.supplier_id"
      ]
    },
    "note": "products - suppliers"
  },
  {
    "id": "PGJON-008",
    "family": "join-on",
    "doc": "SELECT * FROM orders o JOIN employees e ON |",
    "expect": {
      "mustContain": [
        "o.employee_id = e.employee_id"
      ]
    },
    "note": "orders - employees"
