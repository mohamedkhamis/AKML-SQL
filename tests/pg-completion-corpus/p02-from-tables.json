[
  {
    "id": "PGFRM-001",
    "family": "from-tables",
    "doc": "SELECT * FROM |",
    "expect": {
      "mustContain": [
        "customers",
        "orders",
        "products",
        "vw_customer_orders",
        "mv_product_sales",
        "orders_order_id_seq"
      ],
      "mustNotContain": [
        "archive_orders",
        "customer_id"
      ],
      "minCount": 10
    },
    "note": "Tables, views, materialized views and sequences; no columns, no procedures"
  },
  {
    "id": "PGFRM-002",
    "family": "from-tables",
    "doc": "select * from |",
    "expect": {
      "mustContain": [
        "customers",
        "suppliers",
        "shippers"
      ],
      "mustNotContain": [
        "Quantity"
      ],
      "minCount": 3
    },
    "note": "Lower-case keywords still trigger table completion"
  },
  {
    "id": "PGFRM-003",
