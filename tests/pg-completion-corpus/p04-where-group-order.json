[
  {
    "id": "PGWHR-001",
    "family": "where-group-order",
    "doc": "SELECT * FROM customers WHERE |",
    "expect": {
      "mustContain": [
        "country",
        "city",
        "NOT",
        "EXISTS",
        "NULL"
      ],
      "mustNotContain": [
        "WHERE",
        "FROM"
      ],
      "minCount": 11
    },
    "note": "Predicate start: columns and operand keywords"
  },
  {
