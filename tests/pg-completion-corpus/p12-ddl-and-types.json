[
  {
    "id": "PGDDL-001",
    "family": "ddl-and-types",
    "doc": "CREATE |",
    "expect": {
      "mustContain": [
        "TABLE",
        "INDEX",
        "VIEW",
        "FUNCTION",
        "SEQUENCE",
        "SCHEMA",
        "MATERIALIZED VIEW",
        "UNIQUE INDEX",
        "OR REPLACE FUNCTION"
      ],
      "mustNotContain": [
        "customers"
      ],
      "minCount": 10
    },
    "note": "CREATE takes an object kind"
  },
  {
    "id": "PGDDL-002",
    "family": "ddl-and-types",
    "doc": "CREATE TABLE |",
    "expect": {
      "mustNotContain": [
        "customers",
        "orders",
        "SELECT"
      ]
    },
    "note": "A new name: nothing to suggest"
  },
  {
