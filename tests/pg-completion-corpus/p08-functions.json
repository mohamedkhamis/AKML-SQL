[
  {
    "id": "PGFUN-001",
    "family": "functions",
    "doc": "SELECT | FROM customers",
    "expect": {
      "mustContain": [
        "count",
        "lower",
        "coalesce",
        "now"
      ],
      "mustNotContain": [
        "GETDATE",
        "ISNULL"
      ]
    },
    "note": "Everyday functions in the select list"
  },
