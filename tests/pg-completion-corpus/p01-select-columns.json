[
  {
    "id": "PGSEL-001",
    "family": "select-columns",
    "doc": "SELECT | FROM customers",
    "expect": {
      "mustContain": [
        "customer_id",
        "company_name",
        "country"
      ],
      "mustNotContain": [
        "product_name",
        "freight"
      ],
      "minCount": 11
    },
    "note": "Bare select list is scoped to the table in FROM"
  },
  {
    "id": "PGSEL-002",
