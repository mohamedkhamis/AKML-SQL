  {
    "id": "PGSEL-031",
    "family": "select-columns",
    "doc": "SELECT d.| FROM (SELECT customer_id AS cid, country FROM customers) d",
    "expect": {
      "mustContain": [
        "cid",
        "country"
      ],
      "mustNotContain": [
        "customer_id"
      ],
      "minCount": 2
    },
    "note": "Derived table exposes its output names"
  },
  {
    "id": "PGSEL-032",
