  {
    "id": "PGSEL-022",
    "family": "select-columns",
    "doc": "SELECT DISTINCT | FROM customers",
    "expect": {
      "mustContain": [
        "country",
        "city"
      ],
      "mustNotContain": [
        "freight"
      ]
    },
    "note": "After DISTINCT columns still offered"
  },
  {
    "id": "PGSEL-023",
    "family": "select-columns",
    "doc": "SELECT DISTINCT ON (|) * FROM orders",
    "expect": {
      "mustContain": [
        "customer_id",
        "order_date"
      ],
      "mustNotContain": [
        "company_name"
      ]
    },
    "note": "DISTINCT ON takes columns"
  },
  {
    "id": "PGSEL-024",
    "family": "select-columns",
    "doc": "SELECT count(*) FILTER (WHERE |) FROM orders",
    "expect": {
      "mustContain": [
        "freight",
        "order_date"
      ],
      "mustNotContain": [
        "company_name"
      ]
    },
    "note": "FILTER (WHERE ...) takes columns"
  },
  {
