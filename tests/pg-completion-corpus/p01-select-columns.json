      "mustContain": [
        "AS",
        "FROM"
      ],
      "mustNotContain": [
        "country"
      ]
    },
    "note": "After an expression: AS and FROM, not more columns"
  },
  {
    "id": "PGSEL-034",
    "family": "select-columns",
    "doc": "SELECT | FROM customers",
    "expect": {
      "mustNotContain": [
        "FROM",
        "WHERE",
        "GROUP BY"
      ]
    },
    "note": "No clause keywords before an expression"
  },
  {
