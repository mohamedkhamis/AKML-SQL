[
  {
    "id": "EXEC-001",
    "family": "exec-procs",
    "doc": "EXEC |",
    "expect": {
      "mustContain": ["usp_GetCustomerOrders", "usp_UpdateProductPrice"],
      "mustNotContain": ["NoSuchProc", "CustomerName"],
      "minCount": 2
    },
    "note": "bare EXEC with empty prefix suggests dbo stored procedures, not columns"
  },
  {
    "id": "EXEC-002",
    "family": "exec-procs",
