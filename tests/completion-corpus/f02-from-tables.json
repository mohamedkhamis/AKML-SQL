[
  {
    "id": "FROMTB-001",
    "family": "from-tables",
    "doc": "SELECT * FROM |",
    "expect": {
      "mustContain": ["Customers", "Orders", "Products"],
      "mustNotContain": ["NoSuchTable", "usp_GetCustomerOrders"],
      "minCount": 3
    },
    "note": "Bare FROM with empty prefix lists tables; procs must not appear as FROM targets"
  },
  {
    "id": "FROMTB-002",
    "family": "from-tables",
    "doc": "select * from |",
    "expect": {
      "mustContain": ["Suppliers", "Shippers"],
