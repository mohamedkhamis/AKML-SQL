L   2  -: from   dbo.orders o&#xD;&#xD;
      +: from   dbo.orders o&#xD;
L   3  -: inner join   dbo.customers c&#xD;&#xD;
      +: inner join   dbo.customers c&#xD;
L   4  -:     on c.customerid = o.customerid&#xD;&#xD;
      +:     on c.customerid = o.customerid&#xD;
L   5  -: left outer join   dbo.employees e&#xD;&#xD;
      +: left outer join   dbo.employees e&#xD;
L   6  -:     on e.employeeid = o.employeeid&#xD;&#xD;
      +:     on e.employeeid = o.employeeid&#xD;
L   7  -: inner join   dbo.shippers s&#xD;&#xD;
      +: inner join   dbo.shippers s&#xD;
L   8  -:     on s.shipperid = o.shipvia&#xD;&#xD;
      +:     on s.shipperid = o.shipvia&#xD;
L   9  -: where  o.shipcountry = 'Mexico';&#xD;&#xD;
      +: where  o.shipcountry = 'Mexico';&#xD;
</Message>
