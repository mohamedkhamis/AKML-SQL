      +:     ) as source on target.productid = source.productid&#xD;
L   6  -: when matched&#xD;&#xD;
      +: when matched&#xD;
L   7  -:     and target.unitsinstock &gt;= source.sold then update&#xD;&#xD;
      +:     and target.unitsinstock &gt;= source.sold then update&#xD;
L   8  -: set    target.unitsinstock = target.unitsinstock - source.sold&#xD;&#xD;
