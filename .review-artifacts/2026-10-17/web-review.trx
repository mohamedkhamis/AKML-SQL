L  10  -: set    target.unitsinstock = 0&#xD;&#xD;
      +: set    target.unitsinstock = 0&#xD;
L  11  -: when not matched by target then insert (productname, unitsinstock) values (N'unknown', 0);&#xD;&#xD;
      +: when not matched by target then insert (productname, unitsinstock) values (N'unknown', 0);&#xD;
