{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akmlsql.com/schemas/config.json",
  "title": "AKML SQL User Configuration",
  "description": "Schema for %AppData%\\AKML SQL\\config.json",
  "type": "object",
  "required": ["configVersion", "autoUpdateEnabled", "telemetryEnabled", "installId"],
  "properties": {
    "configVersion": {
      "type": "integer",
      "description": "Schema version for future migration",
      "const": 1
    },
    "autoUpdateEnabled": {
      "type": "boolean",
      "description": "Whether to check for updates on IDE startup",
      "default": true
    },
    "telemetryEnabled": {
      "type": "boolean",
      "description": "Whether anonymous usage telemetry is sent (opt-in only)",
      "default": false
    },
    "lastUpdateCheck": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last update check",
      "default": null
    },
    "installId": {
      "type": "string",
      "format": "uuid",
      "description": "Anonymous installation identifier (auto-generated on first run)"
    },
    "installedTargets": {
      "type": "array",
      "description": "List of IDE targets where the extension is installed",
      "items": {
        "type": "object",
        "required": ["ideType", "version", "architecture", "extensionsPath", "installedAt"],
        "properties": {
          "ideType": {
            "type": "string",
            "enum": ["SSMS", "VisualStudio"]
          },
          "version": {
            "type": "string",
            "description": "IDE version identifier",
            "examples": ["20", "21", "22", "2019", "2022", "2026"]
          },
          "architecture": {
            "type": "string",
            "enum": ["x86", "x64"]
          },
          "extensionsPath": {
            "type": "string",
            "description": "Full path where extension files were deployed"
          },
          "installedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of installation"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
